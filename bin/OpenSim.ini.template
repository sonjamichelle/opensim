	create_region_enable_voice = false
	create_region_public = false

	;; --------------------------------------------------
	;; region_file_template
	;; --------------------------------------------------
	;;
	;; Template for region INI files created via XML-RPC.
	;;
	;; NOTE:
	;;    File system writes triggered remotely
	;;    No validation of placement or naming collisions
