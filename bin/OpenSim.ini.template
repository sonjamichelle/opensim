[PacketPool]
	;; ==================================================================
	;; PACKET POOLING  (NETWORK LAYER — DO NOT TOUCH)
	;; ==================================================================
	;;
	;; EXTREME CAUTION
	;;
	;; This section operates at the *UDP receive and packet decode layer*.
	;; It directly affects how the simulator receives, processes, and
	;; reuses network packets from viewers.
	;;
	;; If you do NOT understand UDP packet lifecycles, memory reuse,
	;; and concurrency, YOU SHOULD NOT CHANGE ANYTHING HERE.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SECTION IS
	;; ------------------------------------------------------------------
	;;
	;; Packet pooling controls whether OpenSim REUSES internal network
	;; packet objects instead of constantly allocating and discarding them.
	;;
	;; This code runs at the same level as:
	;;   - UDP socket receive buffers
	;;   - LLUDP packet decode paths
	;;   - Viewer-to-simulator network IO
	;;
	;; This section is NOT:
	;;   - A gameplay feature
	;;   - A bandwidth throttle
	;;   - A viewer performance setting
	;;   - A general-purpose lag fix
	;;
	;; This section IS:
	;;   - A low-level memory and networking optimization
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; OpenSim processes thousands of UDP packets per second per region:
	;;   - Avatar movement
	;;   - Object updates
	;;   - Script events
	;;   - Texture and asset traffic
	;;
	;; Without packet reuse:
	;;   - New objects are constantly allocated
	;;   - Memory churn increases
	;;   - Garbage collection pauses become more frequent
	;;
	;; Packet pooling exists to:
	;;   - Reduce allocations
	;;   - Reduce GC pressure
	;;   - Improve frame-time consistency under load
	;;
	;; On a correctly functioning system:
	;;   - It is safe
	;;   - It is invisible
	;;   - It should NEVER require tuning
	;;
	;; ------------------------------------------------------------------
	;; WHY YOU SHOULD NOT TOUCH THIS
	;; ------------------------------------------------------------------
	;;
	;; Misconfiguring packet pooling can cause:
	;;   - Random viewer disconnects
	;;   - Avatars freezing or desyncing
	;;   - Corrupted or missing object updates
	;;   - Phantom packet loss
	;;   - "Viewer bugs" that are actually server-side
	;;
	;; These failures:
	;;   - Do NOT crash the simulator
	;;   - Do NOT produce clean log errors
	;;   - Are extremely difficult to diagnose
	;;
	;; When this breaks, users will blame:
	;;   - Viewers
	;;   - Scripts
	;;   - Physics
	;;   - "Lag"
	;;
	;; The real cause will be silent network corruption.
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; DO NOT:
	;;   - Change these values to "fix lag"
	;;   - Experiment on a live grid
	;;   - Copy values from forum posts
	;;   - Modify without a rollback plan
	;;
	;; Leave defaults unless ALL of the following are true:
	;;   - You are diagnosing a very specific packet-level issue
	;;   - You understand UDP packet reuse semantics
	;;   - You can restart regions repeatedly
	;;   - You accept user disconnects during testing
	;;
	;; ------------------------------------------------------------------
	;; SAFE OPERATION GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; DEFAULT STATE:
	;;   - Leave enabled
	;;   - Do not change
	;;
	;; TEMPORARY DEBUGGING ONLY:
	;;   - Disabling reuse may help isolate rare corruption bugs
	;;   - Expect higher CPU and memory usage
	;;   - Expect degraded performance
	;;
	;; AFTER DEBUGGING:
	;;   - Restore defaults
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY FOR NON-TECH ADMINS
	;; ------------------------------------------------------------------
	;;
	;; Treat this like a loaded firearm in a locked safe:
	;;   - It exists for a reason
	;;   - It is pointed in a safe direction by default
	;;   - You do not touch it unless you KNOW EXACTLY WHY
	;;
	;; If you do not understand this section:
	;;   - That is normal
	;;   - Leave it alone
	;;
	;; ==================================================================

	;; Reuse LLUDP packet wrapper objects.
	;; Reduces object allocations and GC pressure.
	;; Default behavior. Safe. Do not change.
	RecyclePackets = true

	;; Reuse packet payload data block objects.
	;; Further reduces memory churn.
	;; Default behavior. Safe on modern runtimes.
	RecycleDataBlocks = true

	;; Reuse the lowest-level UDP receive packet objects.
	;; This is the hottest networking code path.
	;;
	;; EFFECT:
	;;   - Significantly reduces allocation pressure
	;;   - Improves frame-time consistency under load
	;;
	;; RISK:
	;;   - Misuse can cause subtle, hard-to-debug network issues
	;;
	;; STATUS:
	;;   - Stable
	;;   - Widely used on active grids
	;;
	;; RECOMMENDED:
	;;   true
	;;
	RecycleBaseUDPPackets = true

[InterestManagement]
 	;; ==================================================================
	;; INTEREST MANAGEMENT  (SCENE UPDATE PRIORITIZATION)
	;; ==================================================================
	;;
	;; IMPORTANT TERMINOLOGY CLARIFICATION
	;;
	;; The word "Interest" here does NOT mean:
	;;   - User interest
	;;   - Engagement
	;;   - Interaction
	;;   - Attention
	;;   - Experience
	;;
	;; In OpenSim (and SL lineage engines), "Interest Management" is an
	;; ENGINE-LEVEL CONCEPT that answers ONE QUESTION ONLY:
	;;
	;;   "What scene data should be sent to this viewer, and in what order?"
	;;
	;; This system controls HOW the simulator prioritizes, throttles,
	;; and schedules object, avatar, and movement updates per client.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SECTION CONTROLS
	;; ------------------------------------------------------------------
	;;
	;; InterestManagement affects:
	;;   - Object update priority
	;;   - Avatar movement smoothness
	;;   - Network bandwidth usage
	;;   - CPU usage for scene update sorting
	;;   - What data is sent FIRST when bandwidth is limited
	;;
	;; It directly influences:
	;;   - Perceived lag
	;;   - Avatar rubberbanding
	;;   - Objects popping in or updating late
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SECTION DOES NOT CONTROL
	;; ------------------------------------------------------------------
	;;
	;; InterestManagement does NOT:
	;;   - Control viewer UI
	;;   - Control user interaction logic
	;;   - Control permissions
	;;   - Control assets or inventory
	;;   - Control physics
	;;
	;; If you see repeated "interest" warnings in logs or viewers,
	;; it almost ALWAYS indicates:
	;;   - Network congestion
	;;   - CPU contention
	;;   - Too many updates competing for bandwidth
	;;
	;; NOT a user-experience failure.
	;;
	;; ------------------------------------------------------------------
	;; WHY THE NAME IS MISLEADING
	;; ------------------------------------------------------------------
	;;
	;; "Interest" comes from graphics and simulation engines, where
	;; it means:
	;;
	;;   "Is this object worth sending an update right now?"
	;;
	;; Unfortunately, this term leaks into admin-visible logs and
	;; causes people to troubleshoot:
	;;   - UI
	;;   - Scripts
	;;   - Viewers
	;;
	;; When the real issue is:
	;;   - Update prioritization and throttling
	;;
	;; ------------------------------------------------------------------
	;; UPDATE PRIORITIZATION STRATEGY
	;; ------------------------------------------------------------------
	;;
	;; UpdatePrioritizationScheme determines HOW update importance
	;; is calculated.
	;;
	;; Valid values:
	;;   - BestAvatarResponsiveness
	;;       Prioritizes avatar movement and nearby interactions.
	;;       Lower CPU usage.
	;;       Recommended for most grids.
	;;
	;;   - SimpleAngularDistance
	;;       Prioritizes based on angular distance from avatar.
	;;       Higher CPU usage.
	;;       Can improve spatial consistency at cost of performance.
	;;
	UpdatePrioritizationScheme = BestAvatarResponsiveness

	;; Enable dynamic reprioritization as avatar movement changes.
	;; If disabled, priorities are more static and less responsive.
	ReprioritizationEnabled = true

	;; How often (in milliseconds) priorities are recalculated.
	;; Lower values = more responsive, higher CPU cost.
	;; Higher values = more stable, less CPU usage.
	ReprioritizationInterval = 2000.0

	;; Distance (meters) at which root prims are strongly prioritized.
	;; Smaller values favor close interactions.
	RootReprioritizationDistance = 10.0

	;; Distance (meters) for child prim prioritization.
	;; Typically larger than root distance.
	ChildReprioritizationDistance = 20.0

	;; ------------------------------------------------------------------
	;; OBJECT CULLING
	;; ------------------------------------------------------------------
	;;
	;; If true, object updates outside avatar view range are not sent.
	;;
	;; WARNING:
	;;   - Viewers are also instructed to DELETE objects that leave range
	;;   - Only avatar position is considered
	;;   - Free camera movement is NOT respected
	;;
	;; EFFECT:
	;;   - Reduces bandwidth
	;;   - Increases CPU usage
	;;   - Can cause objects to vanish unexpectedly
	;;
	;; Recommended: false for most grids
	ObjectsCullingByDistance = false

	;; ------------------------------------------------------------------
	;; AVATAR UPDATE THROTTLING
	;; ------------------------------------------------------------------
	;;
	;; These settings reduce UDP traffic by skipping updates.
	;;
	;; RootTerseUpdatePeriod:
	;;   - Applies to observers in the SAME region
	;;   - n > 1 sends only every nth update
	;;   - Reduces bandwidth
	;;   - Makes other avatars appear laggier
	;;
	;; 0 = disabled (send all updates)
	RootTerseUpdatePeriod = 0

	;; ChildTerseUpdatePeriod:
	;;   - Applies to observers in OTHER regions
	;;   - Safe values up to 4 may be acceptable
	;;
	;; 0 = disabled
	ChildTerseUpdatePeriod = 0

	;; ------------------------------------------------------------------
	;; POSITION / ROTATION / VELOCITY TOLERANCES
	;; ------------------------------------------------------------------
	;;
	;; These values define how much change must occur before
	;; an update is sent.
	;;
	;; Higher values:
	;;   - Fewer updates
	;;   - Lower bandwidth usage
	;;   - Less smooth movement
	;;
	;; Lower values:
	;;   - More updates
	;;   - Higher bandwidth usage
	;;   - Smoother movement
	;;
	RootPositionUpdateTolerance = 0.05
	RootRotationUpdateTolerance = 0.1
	RootVelocityUpdateTolerance = 0.001

	;; ------------------------------------------------------------------
	;; SUMMARY
	;; ------------------------------------------------------------------
	;;
	;; InterestManagement is a SCENE UPDATE SCHEDULER.
	;;
	;; If logs or viewers mention "interest":
	;;   - Think NETWORK
	;;   - Think CPU
	;;   - Think UPDATE PRIORITY
	;;
	;; NOT user behavior.
	;; NOT UX.
	;; NOT scripts.
	;;
	;; Misunderstanding this section leads to hours of
	;; troubleshooting the wrong subsystem.
	;;
	;; ==================================================================
	;; ==================================================================
	;; INTEREST MANAGEMENT — LOG MESSAGE TRANSLATION & TROUBLESHOOTING
	;; ==================================================================
	;;
	;; PURPOSE OF THIS APPENDIX
	;; ------------------------------------------------------------------
	;; This section exists because OpenSim logs and viewer messages
	;; frequently use the word "interest" WITHOUT CONTEXT.
	;;
	;; These messages are NOT self-explanatory and routinely cause admins
	;; to troubleshoot the WRONG systems.
	;;
	;; This appendix translates common messages into:
	;;   - What the engine is actually complaining about
	;;   - What subsystem is involved
	;;   - What to check NEXT
	;;
	;; ------------------------------------------------------------------
	;; FIRST PRINCIPLE (READ THIS FIRST)
	;; ------------------------------------------------------------------
	;;
	;; "Interest" problems are NEVER about:
	;;   - User engagement
	;;   - Viewer UI
	;;   - Permissions
	;;   - Scripts directly
	;;
	;; They are ALWAYS about:
	;;   - Update prioritization
	;;   - Network saturation
	;;   - CPU contention
	;;   - Too many updates competing for delivery
	;;
	;; ------------------------------------------------------------------
	;; COMMON LOG / VIEWER MESSAGE TRANSLATIONS
	;; ------------------------------------------------------------------
	;;
	;; MESSAGE PATTERN:
	;;   "Interest list overflow"
	;;
	;; WHAT IT MEANS:
	;;   - The simulator has MORE scene updates to send
	;;     than it can schedule or transmit in time
	;;
	;; PRIMARY CAUSES:
	;;   - Too many objects generating updates
	;;   - Too many avatars in a small area
	;;   - Excessive script-driven movement
	;;   - Insufficient network bandwidth
	;;
	;; WHAT TO CHECK NEXT:
	;;   1. Region avatar count
	;;   2. Script load (especially movement / timers)
	;;   3. UDP throttles (ClientStack.LindenUDP)
	;;   4. CPU usage on the region host
	;;
	;; NOT THE PROBLEM:
	;;   - Viewer bugs
	;;   - Inventory
	;;   - Asset corruption
	;;
	;; --------------------------------------------------
	;;
	;; MESSAGE PATTERN:
	;;   "Interest processing took too long"
	;;
	;; WHAT IT MEANS:
	;;   - The simulator spent too much CPU time
	;;     sorting and prioritizing updates
	;;
	;; PRIMARY CAUSES:
	;;   - High object count
	;;   - SimpleAngularDistance prioritization enabled
	;;   - Reprioritization interval too short
	;;
	;; WHAT TO CHECK NEXT:
	;;   1. UpdatePrioritizationScheme
	;;   2. ReprioritizationInterval
	;;   3. Region object count
	;;   4. CPU saturation or steal time
	;;
	;; NOT THE PROBLEM:
	;;   - Network hardware
	;;   - Viewer draw distance
	;;
	;; --------------------------------------------------
	;;
	;; MESSAGE PATTERN:
	;;   "Viewer reports interest failure"
	;;   "Viewer interest timeout"
	;;
	;; WHAT IT MEANS:
	;;   - Viewer is not receiving expected scene updates
	;;     within acceptable time
	;;
	;; PRIMARY CAUSES:
	;;   - UDP packet loss
	;;   - Server-side bandwidth exhaustion
	;;   - Aggressive throttling
	;;
	;; WHAT TO CHECK NEXT:
	;;   1. Network interface errors
	;;   2. scene_throttle_max_bps
	;;   3. client_throttle_max_bps
	;;   4. PacketPool configuration
	;;
	;; NOT THE PROBLEM:
	;;   - User behavior
	;;   - Attachments
	;;
	;; --------------------------------------------------
	;;
	;; MESSAGE PATTERN:
	;;   "Interest update skipped"
	;;
	;; WHAT IT MEANS:
	;;   - Update was intentionally dropped to reduce load
	;;
	;; PRIMARY CAUSES:
	;;   - Terse update throttling enabled
	;;   - Position/rotation tolerances too high
	;;
	;; WHAT TO CHECK NEXT:
	;;   1. RootTerseUpdatePeriod
	;;   2. ChildTerseUpdatePeriod
	;;   3. RootPositionUpdateTolerance
	;;
	;; NOT THE PROBLEM:
	;;   - Physics glitches
	;;   - Animation bugs
	;;
	;; ------------------------------------------------------------------
	;; SYMPTOM  CAUSE  ACTION MAP
	;; ------------------------------------------------------------------
	;;
	;; SYMPTOM:
	;;   Avatars appear jerky or rubberbanding
	;;
	;; LIKELY CAUSE:
	;;   - Update throttling or tolerance too aggressive
	;;
	;; ACTION:
	;;   - Reduce RootTerseUpdatePeriod
	;;   - Lower position/rotation tolerances
	;;
	;; --------------------------------------------------
	;;
	;; SYMPTOM:
	;;   Objects pop in late or update out of order
	;;
	;; LIKELY CAUSE:
	;;   - Interest reprioritization overload
	;;
	;; ACTION:
	;;   - Increase ReprioritizationInterval
	;;   - Switch to BestAvatarResponsiveness
	;;
	;; --------------------------------------------------
	;;
	;; SYMPTOM:
	;;   Viewer reports "lag" but server FPS looks fine
	;;
	;; LIKELY CAUSE:
	;;   - Network congestion or packet scheduling delay
	;;
	;; ACTION:
	;;   - Inspect UDP throttles
	;;   - Inspect packet pooling
	;;   - Check NIC saturation
	;;
	;; --------------------------------------------------
	;;
	;; SYMPTOM:
	;;   Admin assumes "user experience issue"
	;;
	;; REALITY:
	;;   - Scene update starvation
	;;
	;; ACTION:
	;;   - STOP touching UI or viewer settings
	;;   - START inspecting network and prioritization
	;;
	;; ------------------------------------------------------------------
	;; FINAL OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; If you see the word "interest" in a log:
	;;
	;;   1. Do NOT troubleshoot users
	;;   2. Do NOT troubleshoot viewers
	;;   3. Do NOT troubleshoot inventory
	;;
	;; Instead:
	;;   - Think UPDATE QUEUES
	;;   - Think BANDWIDTH
	;;   - Think CPU TIME
	;;
	;; InterestManagement is the LAST STEP
	;; before data leaves the simulator.
	;;
	;; If it is complaining, everything BEFORE it
	;; is producing more work than the system can deliver.
	;;
	;; ==================================================================

	;; ==================================================================
	;; DIAGNOSTICS & OBSERVABILITY  (READ BEFORE ENABLING ANYTHING BELOW)
	;; ==================================================================
	;;
	;; THESE SECTIONS DO NOT FIX PROBLEMS.
	;;
	;; They DO NOT:
	;;    Improve performance
	;;    Reduce lag
	;;    Prevent crashes
	;;    Tune physics, scripts, or networking
	;;
	;; They ONLY:
	;;    Expose internal simulator state
	;;    Report timing, load, and health indicators
	;;    Provide DATA for diagnosis
	;;
	;; ------------------------------------------------------------------
	;; WHY ADMINS GET THIS WRONG
	;; ------------------------------------------------------------------
	;;
	;; Many admins enable monitoring, stats, or web endpoints because:
	;;   “It sounds important.”
	;;
	;; Then they are presented with:
	;;    Numbers
	;;    Averages
	;;    JSON blobs
	;;    Graphs
	;;
	;; …with NO CONTEXT.
	;;
	;; This leads to:
	;;    Misdiagnosis
	;;    Chasing the wrong subsystem
	;;    Disabling useful features
	;;    Blaming viewers, scripts, or physics incorrectly
	;;
	;; DATA WITHOUT CONTEXT IS NOT INSIGHT.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THESE SYSTEMS ACTUALLY TELL YOU
	;; ------------------------------------------------------------------
	;;
	;; These sections expose:
	;;    Frame timing delays
	;;    Scheduler stalls
	;;    Load consistency vs spikes
	;;    Whether the simulator is KEEPING UP or FALLING BEHIND
	;;
	;; They answer questions like:
	;;    Is the sim missing frames?
	;;    Is load bursty or sustained?
	;;    Are stalls transient or repeating?
	;;
	;; They do NOT tell you:
	;;    WHICH script is bad
	;;    WHICH object is broken
	;;    WHICH user caused it
	;;
	;; They are INDICATORS, not ROOT CAUSE.
	;;
	;; ------------------------------------------------------------------
	;; REQUIRED MINDSET BEFORE ENABLING
	;; ------------------------------------------------------------------
	;;
	;; If you enable diagnostics, you MUST also be prepared to:
	;;
	;;    Correlate timestamps with logs
	;;    Observe trends, not single values
	;;    Compare “normal” vs “degraded” states
	;;    Use these tools to ASK BETTER QUESTIONS
	;;
	;; NOT:
	;;    React to every spike
	;;    Tune values blindly
	;;    Expect automatic answers
	;;
	;; ------------------------------------------------------------------
	;; REQUIRED SUPPORTING TOOLS
	;; ------------------------------------------------------------------
	;;
	;; These features are only useful when paired with:
	;;
	;;    Server logs (with timestamps)
	;;    Knowledge of recent changes
	;;    Repeatable reproduction
	;;    Controlled observation windows
	;;
	;; Optional but helpful:
	;;    External monitoring (CPU, RAM, IO)
	;;    Alerting on sustained stalls
	;;    Historical baselines
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; Enabling diagnostics without understanding:
	;;    WILL increase noise
	;;    WILL create false alarms
	;;    WILL waste troubleshooting time
	;;
	;; That does NOT mean diagnostics are bad.
	;; It means they must be USED CORRECTLY.
	;;
	;; ------------------------------------------------------------------
	;; RULE OF THUMB
	;; ------------------------------------------------------------------
	;;
	;; If you cannot answer:
	;;   “What question am I trying to answer with this data?”
	;;
	;; THEN YOU SHOULD NOT ENABLE IT YET.
	;;
	;; ------------------------------------------------------------------
	;; PURPOSE
	;; ------------------------------------------------------------------
	;;
	;; These systems exist to help EXPERIENCED operators:
	;;    Detect impending failure
	;;    Identify patterns
	;;    Decide WHERE to look next
	;;
	;; They are instruments.
	;; Not solutions.
	;;
	;; ==================================================================

	;; ==================================================================
	;; OBSERVABILITY / METRICS  (ADVANCED ADMINISTRATION)
	;; ==================================================================
	;;
	;; IMPORTANT CONTEXT
	;; -----------------
	;; The following sections ([Monitoring], [WebStats], statistics-related
	;; options) expose LOW-LEVEL SIMULATOR METRICS.
	;;
	;; These metrics are:
	;;    Raw
	;;    Fragmented
	;;    Time-sensitive
	;;    NOT directly actionable without aggregation and context
	;;
	;; Enabling these options does NOT:
	;;    Automatically diagnose problems
	;;    Fix lag
	;;    Explain crashes
	;;
	;; They simply EXPOSE SIGNALS.
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; These metrics exist to support OBSERVABILITY, not casual inspection.
	;;
	;; Observability means:
	;;    Watching trends over time
	;;    Correlating events across regions
	;;    Detecting degradation BEFORE failure
	;;
	;; Examples of what observability enables:
	;;    Identifying regions that degrade slowly over hours or days
	;;    Detecting recurring frame stalls before watchdog resets
	;;    Correlating CPU, memory, physics, and script load
	;;    Distinguishing content issues from infrastructure issues
	;;
	;; ------------------------------------------------------------------
	;; RECOMMENDED TOOLING (OUTSIDE OPENSIM)
	;; ------------------------------------------------------------------
	;;
	;; OpenSim does NOT provide built-in dashboards or alerting.
	;;
	;; Serious operators should consider:
	;;
	;;    Prometheus
	;;       - Time-series metrics collection
	;;       - Periodically pulls exposed statistics
	;;
	;;    Grafana
	;;       - Visualization and dashboards
	;;       - Trend analysis
	;;       - Alerting on thresholds
	;;
	;; Typical architecture:
	;;   OpenSim    Metrics Endpoint / Logs
	;;              Prometheus
	;;              Grafana Dashboard
	;;
	;; This allows:
	;;    At-a-glance grid health
	;;    Historical performance analysis
	;;    Early warning of impending failures
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; If you enable monitoring or web statistics WITHOUT:
	;;    Understanding what is being measured
	;;    Aggregating data over time
	;;    Correlating multiple signals
	;;
	;; You will likely:
	;;    Draw incorrect conclusions
	;;    Chase the wrong subsystems
	;;    Misdiagnose viewer or content issues
	;;
	;; This is NORMAL.
	;;
	;; Raw metrics require interpretation.
	;;
	;; ------------------------------------------------------------------
	;; WHO SHOULD USE THIS
	;; ------------------------------------------------------------------
	;;
	;; Appropriate for:
	;;    Medium to large grids
	;;    Multi-estate deployments
	;;    Grids with recurring unexplained issues
	;;    Operators building WebUI or admin dashboards
	;;
	;; Likely unnecessary for:
	;;    Small hobby grids
	;;    Single-region experiments
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY
	;; ------------------------------------------------------------------
	;;
	;; These settings expose DATA, not ANSWERS.
	;;
	;; When paired with proper tools, they become powerful.
	;; When viewed in isolation, they are noise.
	;;
	;; Enable thoughtfully.
	;;
	;; ==================================================================

[Monitoring]
	;; ==================================================================
	;; MONITORING  — SIMULATOR HEALTH & STALL DETECTION
	;; ==================================================================
	;;
	;; THIS SECTION IS ABOUT:
	;;    Detecting simulator STALLS, not "lag"
	;;    Detecting missed or frozen simulation frames
	;;    Providing low-level heartbeat visibility
	;;
	;; THIS SECTION IS *NOT*:
	;;    A performance tuning system
	;;    A lag profiler
	;;    A user experience monitor
	;;    A replacement for OSStats, Grafana, or Prometheus
	;;
	;; ------------------------------------------------------------------
	;; WHAT PROBLEM THIS SOLVES
	;; ------------------------------------------------------------------
	;;
	;; OpenSim can appear "running" while the simulator loop is:
	;;    Blocked
	;;    Hung
	;;    Starved of CPU
	;;    Waiting on IO
	;;
	;; In these cases:
	;;    The process does NOT crash
	;;    Regions do NOT necessarily restart
	;;    Users experience:
	;;       - Frozen avatars
	;;       - Failed teleports
	;;       - Scripts not firing
	;;       - Time dilation without obvious cause
	;;
	;; Monitoring exists to answer ONE QUESTION:
	;;
	;;   "Is the simulator main loop still advancing?"
	;;
	;; ------------------------------------------------------------------
	;; Enabled
	;; ------------------------------------------------------------------
	;;
	;; When Enabled = true:
	;;
	;;    The simulator tracks time since the last completed frame
	;;    If MORE THAN 60 SECONDS pass without a frame:
	;;       - An ERROR is logged
	;;       - This indicates a *hard stall*, not normal lag
	;;
	;; THIS IS A CANARY, NOT A FIX.
	;;
	;; If this triggers, something upstream is blocking execution.
	;;
	;; COMMON CAUSES OF A MONITORING ALERT:
	;;    CPU starvation (oversubscription, steal time, bad pinning)
	;;    Deadlocks in physics or scripting
	;;    Blocking database calls
	;;    Filesystem IO stalls
	;;    Garbage collection pauses (extreme cases)
	;;
	;; WHAT IT DOES *NOT* MEAN:
	;;    It does NOT mean "high lag"
	;;    It does NOT mean "too many scripts"
	;;    It does NOT identify WHICH subsystem is stuck
	;;
	;; It only proves:
	;;    The simulator stopped making forward progress
	;;
	Enabled = true

	;; ------------------------------------------------------------------
	;; ServerStatsEnabled
	;; ------------------------------------------------------------------
	;;
	;; This option exposes additional low-level runtime statistics.
	;;
	;; WARNING:
	;;    This uses legacy framework performance counters
	;;    Originally designed for DEBUGGING, not production
	;;    Can add overhead
	;;    Can produce misleading data without context
	;;
	;; WHAT THIS IS USEFUL FOR:
	;;    Short-term diagnostics
	;;    Controlled test environments
	;;    Development and profiling
	;;
	;; WHAT THIS IS *NOT* GOOD FOR:
	;;    Long-term monitoring
	;;    Capacity planning
	;;    Automated alerting
	;;
	;; MODERN ALTERNATIVES (RECOMMENDED):
	;;    OSStats module
	;;    External metrics (Prometheus, Grafana)
	;;    Host-level monitoring (CPU, IO, network)
	;;
	;; RECOMMENDED:
	;;   false (unless you are actively debugging)
	;;
	;ServerStatsEnabled = false

	;; ==================================================================
	;; HOW TO ACTUALLY USE MONITORING (IMPORTANT)
	;; ==================================================================
	;;
	;; IF YOU SEE A MONITORING ERROR:
	;;
	;;   "More than a minute has passed since the last simulator frame"
	;;
	;; DO THIS NEXT (IN ORDER):
	;;
	;;   1. Check HOST CPU usage
	;;       - Look for 100% usage or high steal time
	;;
	;;   2. Check HOST IO wait
	;;       - Disk or network blocking the process
	;;
	;;   3. Check DATABASE latency
	;;       - Slow or locked queries
	;;
	;;   4. Check PHYSICS engine
	;;       - Especially BulletSim thread interactions
	;;
	;;   5. Check SCRIPT engine
	;;       - Deadlocks or runaway maintenance tasks
	;;
	;; DO NOT:
	;;    Restart blindly
	;;    Blame viewers
	;;    Start changing random INI values
	;;
	;; Monitoring tells you:
	;;    "Something is fundamentally stuck"
	;;
	;; It does NOT tell you:
	;;    "What setting to tweak"
	;;
	;; ==================================================================
	;; SUMMARY FOR NON-EXPERT ADMINS
	;; ==================================================================
	;;
	;; Think of Monitoring like a HEART MONITOR:
	;;
	;;    It does not cure illness
	;;    It tells you when the heart stopped beating
	;;
	;; If this triggers:
	;;    You have a *system-level problem*
	;;    Not a content problem
	;;
	;; If it never triggers:
	;;    Your simulator loop is healthy
	;;
	;; ==================================================================

[WebStats]
	;; ==================================================================
	;; WEBSTATS  — LOW-LEVEL REGION SNAPSHOT (DEBUG / DIAGNOSTIC ONLY)
	;; ==================================================================
	;;
	;; THIS MODULE PROVIDES:
	;;
	;;   A SIMPLE HTTP ENDPOINT that exposes INTERNAL REGION STATISTICS
	;;   as a JSON-like snapshot rendered in a basic web page.
	;;
	;; This is NOT a monitoring system.
	;; This is NOT a dashboard.
	;; This is NOT a performance analyzer.
	;;
	;; ------------------------------------------------------------------
	;; WHAT WEBSTATS ACTUALLY IS
	;; ------------------------------------------------------------------
	;;
	;; WebStats exposes a POINT-IN-TIME DUMP of region internals, including:
	;;
	;;    Object counts
	;;    Agent counts
	;;    Frame timing values
	;;    Script statistics
	;;    Some physics counters
	;;
	;; It is equivalent to:
	;;   “Show me the simulator’s internal counters RIGHT NOW.”
	;;
	;; It does NOT:
	;;    Track history
	;;    Detect trends
	;;    Alert on failures
	;;    Explain causality
	;;
	;; ------------------------------------------------------------------
	;; WHAT WEBSTATS IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; WebStats does NOT:
	;;
	;;    Tell you WHY a region is lagging
	;;    Tell you WHY a region crashed
	;;    Tell you WHICH script is misbehaving
	;;    Replace Monitoring, logging, or profiling
	;;
	;; Numbers here are CONTEXT-FREE.
	;;
	;; Without understanding OpenSim internals, the data is meaningless.
	;;
	;; ------------------------------------------------------------------
	;; WHY ADMINS ENABLE THIS AND GET NOTHING FROM IT
	;; ------------------------------------------------------------------
	;;
	;; Common admin reaction:
	;;
	;;   “It shows stats, so it must help diagnose problems.”
	;;
	;; Reality:
	;;
	;;    It shows raw counters
	;;    No thresholds
	;;    No baselines
	;;    No interpretation
	;;
	;; This leads to:
	;;    Guessing
	;;    False conclusions
	;;    Blaming the wrong subsystem
	;;
	;; ------------------------------------------------------------------
	;; VALID USE CASES (WHEN THIS IS ACTUALLY USEFUL)
	;; ------------------------------------------------------------------
	;;
	;; WebStats is useful ONLY when:
	;;
	;;    You already know WHAT you are looking for
	;;    You are comparing TWO STATES of the SAME REGION
	;;    You are validating that a change had an effect
	;;
	;; Examples:
	;;
	;;    Before/after script engine tuning
	;;    Verifying agent count during a load test
	;;    Confirming physics object counts
	;;    Cross-checking values reported elsewhere
	;;
	;; Think of this as:
	;;   A DIAGNOSTIC SNAPSHOT, not an explanation.
	;;
	;; ------------------------------------------------------------------
	;; SECURITY AND EXPOSURE WARNING
	;; ------------------------------------------------------------------
	;;
	;; WebStats exposes INTERNAL REGION STATE via HTTP.
	;;
	;; Risks:
	;;    Information leakage
	;;    Reconnaissance for attackers
	;;    Unauthenticated access (depends on setup)
	;;
	;; DO NOT expose this endpoint publicly.
	;;
	;; If enabled:
	;;    Bind to localhost
	;;    Restrict access via firewall or reverse proxy
	;;
	;; ------------------------------------------------------------------
	;; HOW TO ACCESS (IF ENABLED)
	;; ------------------------------------------------------------------
	;;
	;; URL format:
	;;
	;;   <LoginURI>/SStats/
	;;
	;; Example:
	;;
	;;   http://127.0.0.1:9000/SStats/
	;;
	;; Output:
	;;    Simple web page
	;;    Raw stats
	;;    Often JSON-like
	;;
	;; EXPECT:
	;;    No charts
	;;    No labels beyond variable names
	;;    No guidance
	;;
	;; ------------------------------------------------------------------
	;; RECOMMENDATION
	;; ------------------------------------------------------------------
	;;
	;; FOR MOST ADMINS:
	;;    KEEP DISABLED
	;;
	;; ENABLE ONLY IF:
	;;    You are actively diagnosing a specific issue
	;;    You know which counters matter
	;;    You are correlating with logs or Monitoring timestamps
	;;
	;; DO NOT ENABLE expecting:
	;;    Insight
	;;    Root cause analysis
	;;    Automatic answers
	;;
	;; ------------------------------------------------------------------
	;; DEFAULT
	;; ------------------------------------------------------------------
	;;
	;; Disabled by default for good reason.
	;;
		enabled = false

[Statistics]
	;; ==================================================================
	;; FRAME AVERAGING  — STATISTICS SMOOTHING (DIAGNOSTIC BEHAVIOR)
	;; ==================================================================
	;;
	;; THIS SETTING CONTROLS HOW REGION PERFORMANCE DATA IS SMOOTHED
	;;
	;; It does NOT:
	;;    Change simulator performance
	;;    Affect physics, scripts, or networking
	;;    Improve or degrade actual frame rate
	;;
	;; It ONLY affects how performance metrics are REPORTED.
	;;
	;; ------------------------------------------------------------------
	;; WHAT NumberOfFrames ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; NumberOfFrames defines the SIZE OF THE MOVING AVERAGE WINDOW
	;; used when reporting simulator statistics.
	;;
	;; The simulator records per-frame timing data and computes
	;; averages across the most recent N frames.
	;;
	;; Where:
	;;   N = NumberOfFrames
	;;
	;; Example:
	;;   NumberOfFrames = 10
	;;    Each reported value is averaged across the last 10 frames
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; Raw per-frame values fluctuate constantly due to:
	;;    Script scheduling
	;;    Physics collisions
	;;    Avatar movement
	;;    Network jitter
	;;
	;; Without averaging:
	;;    Stats would spike wildly
	;;    Output would be unreadable
	;;
	;; Averaging exists to:
	;;    Make trends visible
	;;    Reduce noise
	;;    Prevent overreaction to micro-spikes
	;;
	;; ------------------------------------------------------------------
	;; THE MISLEADING PART (THIS MATTERS)
	;; ------------------------------------------------------------------
	;;
	;; Increasing NumberOfFrames:
	;;    MAKES STATS LOOK MORE STABLE
	;;    HIDES SHORT SPIKES
	;;    DELAYS VISIBILITY OF PROBLEMS
	;;
	;; Decreasing NumberOfFrames:
	;;    MAKES STATS MORE RESPONSIVE
	;;    SHOWS SPIKES IMMEDIATELY
	;;    CAN LOOK "WORSE" even if nothing changed
	;;
	;; THIS IS A REPORTING FILTER.
	;; NOT REAL PERFORMANCE.
	;;
	;; ------------------------------------------------------------------
	;; COMMON ADMIN MISTAKE
	;; ------------------------------------------------------------------
	;;
	;; Admin sees jittery stats and thinks:
	;;   “The sim is unstable, I need to fix something.”
	;;
	;; Admin increases NumberOfFrames.
	;;
	;; Result:
	;;    Stats look smoother
	;;    Problem still exists
	;;    Detection is now delayed
	;;
	;; This leads to:
	;;    False sense of stability
	;;    Missed transient failures
	;;    Harder crash correlation
	;;
	;; ------------------------------------------------------------------
	;; VALID USE CASES
	;; ------------------------------------------------------------------
	;;
	;; LOWER VALUES (e.g. 5–10):
	;;    Debugging
	;;    Catching intermittent stalls
	;;    Correlating stats with logs
	;;
	;; HIGHER VALUES (e.g. 30–60):
	;;    Long-term trend observation
	;;    Presentation / reporting
	;;    Non-critical monitoring
	;;
	;; ------------------------------------------------------------------
	;; RECOMMENDED GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; For most grids:
	;;   10 is a reasonable default
	;;
	;; When diagnosing crashes or stalls:
	;;   LOWER the value temporarily
	;;
	;; When presenting stats visually:
	;;   HIGHER values may be acceptable
	;;
	;; ALWAYS remember:
	;;   Changing this DOES NOT FIX performance.
	;;
	;; ------------------------------------------------------------------
	;; DEFAULT
	;; ------------------------------------------------------------------
	;;
	;; Keep conservative.
	;; Change ONLY with intent.
	;;
	NumberOfFrames = 10


[MediaOnAPrim]
	;; ==================================================================
	;; MEDIA ON A PRIM (MOAP)  —  EMBEDDED WEB MEDIA SURFACES
	;; ==================================================================
	;;
	;; THIS IS NOT:
	;;    A gimmick feature
	;;    A privacy bypass by default
	;;    A viewer-side hack
	;;
	;; THIS IS:
	;;    A standardized viewer-supported system for rendering
	;;     web-based media (HTML, video, audio, interactive content)
	;;     onto the surface of in-world prims
	;;
	;; Media-On-A-Prim allows a prim face to behave like a browser surface.
	;;
	;; ==================================================================
	;; WHAT MEDIA ON A PRIM ACTUALLY DOES
	;; ==================================================================
	;;
	;; When enabled:
	;;    A prim face can host a media URL
	;;    The viewer renders that URL in a secure embedded browser
	;;    Interaction occurs through the viewer, not the simulator
	;;
	;; The simulator:
	;;    Stores media metadata
	;;    Controls permissions
	;;    Does NOT fetch or render content
	;;
	;; Rendering happens entirely client-side.
	;;
	;; ==================================================================
	;; COMMON MISCONCEPTIONS
	;; ==================================================================
	;;
	;; "This is dangerous"
	;;    Only if you do not understand permissions
	;;
	;; "This exposes the grid to web attacks"
	;;    Media is rendered in the viewer sandbox
	;;
	;; "This causes lag"
	;;    Media traffic bypasses the simulator entirely
	;;
	;; "This is just for gimmicks"
	;;    False. It is widely used in education and enterprise grids
	;;
	;; ==================================================================
	;; LEGITIMATE AND HIGH-VALUE USE CASES
	;; ==================================================================
	;;
	;; EDUCATION:
	;;    Slide decks and lecture materials
	;;    Embedded documentation and diagrams
	;;    Live demonstrations
	;;
	;; PRESENTATIONS:
	;;    Conferences
	;;    Training sessions
	;;    Product demos
	;;
	;; ENTERTAINMENT:
	;;    In-world video screens
	;;    Live streams
	;;    Interactive experiences
	;;
	;; ENTERPRISE / INSTITUTIONAL:
	;;    Dashboards
	;;    Internal tools
	;;    Policy portals
	;;
	;; ACCESSIBILITY:
	;;    External readable content
	;;    Adjustable zoom and contrast via viewer
	;;
	;; ==================================================================
	;; SECURITY AND PRIVACY REALITY
	;; ==================================================================
	;;
	;; Media-On-A-Prim does NOT:
	;;    Bypass permissions
	;;    Access user inventory
	;;    Access simulator internals
	;;
	;; Media URLs:
	;;    Are visible to users
	;;    Require explicit interaction
	;;    Obey viewer media security settings
	;;
	;; USERS CAN:
	;;    Disable media entirely in the viewer
	;;    Choose not to click or interact
	;;
	;; ==================================================================
	;; WHEN TO ENABLE
	;; ==================================================================
	;;
	;; ENABLE if:
	;;    You run educational regions
	;;    You host presentations or training
	;;    You provide in-world documentation
	;;    You want modern in-world media capability
	;;
	;; DISABLE if:
	;;    You operate a minimal sandbox grid
	;;    You explicitly forbid embedded web content
	;;
	;; ==================================================================
	;; PERFORMANCE IMPACT
	;; ==================================================================
	;;
	;; SERVER:
	;;    Negligible
	;;
	;; NETWORK:
	;;    Media traffic does NOT pass through OpenSim
	;;
	;; CLIENT:
	;;    Depends on user hardware and media content
	;;
	;; ==================================================================
	;; OPERATOR RECOMMENDATION
	;; ==================================================================
	;;
	;; Media-On-A-Prim is a mature, widely used feature.
	;;
	;; Misunderstanding it leads to unnecessary disabling
	;; and loss of legitimate functionality.
	;;
	;; Enable with knowledge, not fear.
	;;
	;; ==================================================================

    ; Enable Media-On-A-Prim support.
    ; REQUIRED for presentations, education, and in-world media surfaces.
    Enabled = true

[NPC]
	;; ==================================================================
	;; NPC  (NON-PLAYER CHARACTERS / SCRIPTED AVATARS)
	;; ==================================================================
	;;
	;; THIS SECTION IS FREQUENTLY MISUNDERSTOOD.
	;;
	;; NPCs ARE NOT:
	;;    A griefing feature by default
	;;    A stats padding trick
	;;    A viewer exploit
	;;    A toy system
	;;
	;; NPCs ARE:
	;;    Server-side scripted avatars
	;;    Fully simulated presence entities
	;;    Capable of movement, interaction, sensing, and state
	;;
	;; NPCs execute on the SERVER.
	;; They do NOT rely on a viewer connection.
	;;
	;; ==================================================================
	;; WHY NPCs EXIST
	;; ==================================================================
	;;
	;; NPCs were introduced to support:
	;;    Training simulations
	;;    Scenario-based instruction
	;;    Load and behavior modeling
	;;    Persistent population in regions
	;;
	;; This concept was PROVEN in real deployments.
	;;
	;; MOSES (Military Open Simulator Enterprise Strategy):
	;;    Used NPCs to simulate human presence
	;;    Used NPCs for stress, reaction, and decision training
	;;    Used NPCs in environments where real-world mistakes
	;;     had life-or-death consequences
	;;
	;; This is NOT theoretical.
	;; This is not a gimmick.
	;;
	;; ==================================================================
	;; WHAT NPCs ACTUALLY COST
	;; ==================================================================
	;;
	;; IMPORTANT PERFORMANCE REALITY:
	;;
	;;    An NPC is nearly as expensive as a real avatar
	;;    NPCs participate in physics
	;;    NPCs participate in interest management
	;;    NPCs receive updates and generate events
	;;
	;; NPCs are NOT lightweight bots.
	;;
	;; Excessive NPCs WILL:
	;;    Increase CPU load
	;;    Increase physics cost
	;;    Increase script scheduling pressure
	;;
	;; THIS IS WHY LIMITS EXIST.
	;;
	;; ==================================================================
	;; COMMON ADMIN MYTHS
	;; ==================================================================
	;;
	;; "NPCs are for griefing"
	;;    False. Abuse comes from scripts, not the NPC system
	;;
	;; "NPCs are for gaming search stats"
	;;    Irrelevant. Search stats are external systems
	;;
	;; "NPCs are useless immersion junk"
	;;    False. Immersion is exactly where NPCs excel
	;;
	;; "NPCs will lag my grid"
	;;    Only if misused or unbounded
	;;
	;; ==================================================================
	;; LEGITIMATE USE CASES
	;; ==================================================================
	;;
	;; TRAINING AND SIMULATION:
	;;    Emergency response drills
	;;    Crowd behavior modeling
	;;    Tactical movement simulation
	;;
	;; EDUCATION:
	;;    Instructor avatars
	;;    Guided tours
	;;    Interactive lessons
	;;
	;; IMMERSIVE ENVIRONMENTS:
	;;    Ambient population
	;;    Staff characters
	;;    Role-based actors
	;;
	;; TESTING:
	;;    Load testing without human users
	;;    Script behavior under stress
	;;
	;; ==================================================================
	;; SECURITY AND CONTROL CONSIDERATIONS
	;; ==================================================================
	;;
	;; NPC creation is SCRIPT-CONTROLLED.
	;;
	;; Poor control policies can allow:
	;;    Excessive NPC creation
	;;    NPC impersonation
	;;
	;; Proper policy requires:
	;;    Script permission discipline
	;;    NPC ownership rules
	;;    Reasonable per-scene limits
	;;
	;; ==================================================================
	;; OPERATOR GUIDANCE
	;; ==================================================================
	;;
	;; DO NOT:
	;;    Disable NPCs out of fear
	;;    Allow unlimited NPCs on production regions
	;;    Allow arbitrary cloning without oversight
	;;
	;; DO:
	;;    Limit NPC count per scene
	;;    Use NPCs intentionally
	;;    Treat NPCs as real simulated avatars
	;;
	;; NPCs are a TOOL.
	;; Like any tool, misuse causes problems.
	;;
	;; ==================================================================

    ;; Enable Non-Player Character facilities.
    ;; REQUIRED for scripted avatar simulation and training use cases.
    ;; Default is true.
    ; Enabled = true

    ;; Maximum number of NPCs allowed per scene.
    ;; NPCs are nearly as resource-heavy as real avatars.
    ;; Set to a negative value to remove the limit.
    ;; Default is 40.
    ; MaxNumberNPCsPerScene = 40

    ;; Allow creation of NPCs not owned by the script owner.
    ;; Enabling this increases flexibility but also abuse potential.
    ;; Default is true.
    ; AllowNotOwned = true

    ;; Allow NPCs to be sensed as avatars via sensors.
    ;; Required for realistic interaction and training scenarios.
    ;; Default is true.
    ; AllowSenseAsAvatar = true

    ;; Allow NPCs to be created by cloning existing avatars in region.
    ;; Useful for simulation.
    ;; Dangerous if abused.
    ;; Default is true.
    ; AllowCloneOtherAvatars = true

    ;; Control NPC group title visibility.
    ;; If true, NPCs show no group title.
    ;; If false, NPCs display "- NPC -" for identification.
    ;; Default is true.
    ; NoNPCGroup = true

[Terrain]
	;; ==================================================================
	;; TERRAIN INITIALIZATION & DELIVERY
	;; ==================================================================
	;;
	;; This section controls:
	;;    How a NEW region's terrain is initialized at creation time
	;;    How terrain data is streamed from the simulator to viewers
	;;
	;; IMPORTANT SCOPE NOTE:
	;;    These settings do NOT affect existing terrain after region creation
	;;     unless the region is wiped or recreated.
	;;    They do NOT replace terrain loading from RAW / R32 / OAR files.
	;;
	;; These are *baseline behaviors*, not terrain editing tools.

    ;; --------------------------------------------------
    ;; InitialTerrain
    ;; --------------------------------------------------
    ;;
    ;; PURPOSE:
    ;; Defines the initial terrain shape used when a region
    ;; is FIRST created and has no terrain data yet.
    ;;
    ;; VALID VALUES (CURRENTLY HARD-CODED):
    ;;    "flat"
    ;;       - Completely flat terrain at default water height
    ;;       - Best for:
    ;;            Urban builds
    ;;            Large architectural projects
    ;;            Regions intended to load terrain from files immediately
    ;;
    ;;    "pinhead-island"
    ;;       - Small raised landmass surrounded by water
    ;;       - Historically used as a visual cue that a region exists
    ;;       - Best for:
    ;;            Ocean regions
    ;;            Sandbox placeholders
    ;;            Regions where terrain will later be sculpted
    ;;
    ;; REALITY CHECK:
    ;;    This is a VERY limited choice set
    ;;    It exists mainly to prevent a "blank void" region
    ;;
    ;; LIMITATIONS:
    ;;    No noise
    ;;    No erosion
    ;;    No biome awareness
    ;;    No seed-based generation
    ;;
    ;; RECOMMENDED PRACTICE:
    ;;    Use this ONLY as a temporary placeholder
    ;;    Load real terrain via RAW/R32/OAR as soon as possible
    ;;

    InitialTerrain = "pinhead-island"

    ;; --------------------------------------------------
    ;; SendTerrainUpdatesByViewDistance
    ;; --------------------------------------------------
    ;;
    ;; PURPOSE:
    ;; Controls how terrain patches are sent to each viewer.
    ;;
    ;; WHEN FALSE (legacy behavior):
    ;;    Terrain is sent in a fixed "lawn mower" pattern
    ;;    Entire region terrain may be streamed regardless of view
    ;;    Can waste bandwidth on unseen terrain
    ;;
    ;; WHEN TRUE (modern behavior):
    ;;    Terrain patches are sent based on the avatar's view distance
    ;;    Terrain is prioritized outward from the avatar
    ;;    Reduces initial terrain load time
    ;;    Reduces unnecessary network traffic
    ;;
    ;; IMPORTANT DETAILS:
    ;;    Uses AVATAR position, not free camera
    ;;    Terrain outside view range may be delayed until needed
    ;;
    ;; BENEFITS:
    ;;    Faster region entry
    ;;    Lower bandwidth usage
    ;;    Better scalability for large regions and varregions
    ;;
    ;; COSTS:
    ;;    Slightly higher server-side bookkeeping
    ;;    Terrain may appear to "fill in" as users move
    ;;
    ;; RECOMMENDED:
    ;;    TRUE for almost all modern grids
    ;;
    ;; TODO (FUTURE IMPROVEMENT):
    ;;    Separate avatar vs camera-based terrain interest
    ;;    Terrain LOD streaming based on distance
    ;;    WebUI toggle per estate or region
    ;;    Integration with interest management tuning
    ;;
    SendTerrainUpdatesByViewDistance = True

	;; --------------------------------------------------
	;; TODO (FUTURE IMPROVEMENT):
	;; --------------------------------------------------
	;;
	;; Immediate, high-value improvement:
	;;
	;;    Add a THIRD built-in water-based initial terrain option
	;;
	;;     Proposed example:
	;;       - "open-ocean"
	;;            Flat seabed at configurable depth
	;;            No central landmass
	;;            Intended for:
	;;               - Maritime regions
	;;               - Sailing, boating, and naval aviation
	;;               - Offshore platforms
	;;               - Underwater builds
	;;
	;;     Rationale:
	;;        "pinhead-island" breaks immersion for sea-focused regions
	;;        Admins currently must:
	;;           - Manually flatten terrain
	;;           - Load custom RAW files
	;;           - Script terrain wipes
	;;        A native water-first option removes unnecessary setup steps
	;;
	;; Longer-term goals:
	;;
	;;    Replace hard-coded terrain choices with extensible generators:
	;;       - Seed-based noise
	;;       - Heightmap templates
	;;       - Biome presets (land, sea, desert, arctic, space)
	;;
	;;    Allow Estate/Region-level terrain profiles
	;;    Expose terrain presets via WebUI at region creation time
	;;    Support scripted or API-driven terrain initialization

[LandManagement]
	;; ==================================================================
	;; LAND & PARCEL MANAGEMENT  (PERFORMANCE + UX CRITICAL)
	;; ==================================================================
	;;
	;; This section controls how parcel (land ownership and permissions)
	;; data is transmitted to viewers and how parcel-related visual and
	;; administrative features behave.
	;;
	;; WHY THIS MATTERS:
	;;    Parcel data is sent to viewers as a *layer map*
	;;    On large regions or varregions, this can be expensive
	;;    Poor configuration can:
	;;       - Cause viewer stalls when editing terrain
	;;       - Increase network traffic
	;;       - Create perceived "lag" during land operations
	;;
	;; These settings directly affect:
	;;    Terraforming performance
	;;    Object editing responsiveness
	;;    Parcel boundary visualization
	;;    Admin-only land behavior
	;;
	;; This section is NOT cosmetic.
	;; Misconfiguration here can silently degrade grid performance.
	;;
	;; ==================================================================
	;; PARCEL LAYER UPDATE OPTIMIZATION
	;; ==================================================================
	;;
	;; Parcel layer data describes:
	;;    Parcel boundaries
	;;    Ownership regions
	;;    Access and ban zones
	;;
	;; By default, legacy behavior sends the ENTIRE parcel layer
	;; to the viewer whenever edits occur.
	;;
	;; On large regions, this is extremely expensive.
	;;

	;; --------------------------------------------------
	;; LimitParcelLayerUpdateDistance
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Limits how much parcel layer data is sent to the viewer
	;;   when editing terrain or objects.
	;;
	;; BEHAVIOR:
	;;   true  = Only send parcel layer data near the edit point
	;;   false = Always send the entire parcel layer
	;;
	;; PERFORMANCE IMPACT:
	;;    SIGNIFICANTLY reduces update cost on large regions
	;;    Especially important for varregions (2x2, 4x4, etc.)
	;;
	;; IMPORTANT NOTES:
	;;    This ONLY affects interactive edits (terraforming, object edits)
	;;    Other events (login, ownership changes) still send full data
	;;
	;; RECOMMENDED:
	;;   true  (almost always)
	;;
	LimitParcelLayerUpdateDistance = true

	;; --------------------------------------------------
	;; ParcelLayerViewDistance
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Defines how far (in meters) around the edit point
	;;   parcel layer data is sent when updates are limited.
	;;
	;; BEHAVIOR:
	;;    Distance is measured from the point of interaction
	;;    Only parcel data within this radius is transmitted
	;;
	;; LEGACY COMPATIBILITY:
	;;    If >= 128:
	;;       - Legacy 256x256 regions behave as before
	;;       - Full parcel layer is sent
	;;
	;; PERFORMANCE TRADEOFF:
	;;   Smaller value:
	;;      Less network traffic
	;;      Faster parcel edits
	;;      Slight delay seeing distant parcel boundaries
	;;
	;;   Larger value:
	;;      More data sent
	;;      Closer to legacy behavior
	;;
	;; RECOMMENDED:
	;;    64–128 for large varregions
	;;    128 for legacy compatibility
	;;
	ParcelLayerViewDistance = 128

	;; ==================================================================
	;; PARCEL VISUALIZATION
	;; ==================================================================

	;; --------------------------------------------------
	;; ShowParcelBansLines
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Controls whether parcel ban lines are visible in the viewer.
	;;
	;; VISUAL EFFECT:
	;;   true  = Red ban lines shown at parcel boundaries
	;;   false = No visual ban indicators
	;;
	;; USER EXPERIENCE CONSIDERATIONS:
	;;    Visible ban lines help users understand access limits
	;;    Hidden ban lines can reduce visual clutter
	;;
	;; ADMIN CONSIDERATION:
	;;    Disabling does NOT remove bans
	;;    Only affects visualization
	;;
	;; RECOMMENDED:
	;;   true  (unless designing a minimalist experience)
	;;
	ShowParcelBansLines = true

	;; --------------------------------------------------
	;; BanLineSafeHeight
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Sets how high above ground parcel ban lines extend.
	;;
	;; RANGE:
	;;    Minimum: 20m
	;;    Maximum: 5000m
	;;
	;; WHY THIS EXISTS:
	;;    Prevents flying avatars from bypassing bans
	;;    Enforces vertical access control
	;;
	;; DESIGN TRADEOFF:
	;;   Lower value:
	;;      More permissive airspace
	;;      Better for aviation-heavy regions
	;;
	;;   Higher value:
	;;      Stronger parcel enforcement
	;;      Can interfere with flight builds
	;;
	;; DEFAULT:
	;;   100m
	;;
	; BanLineSafeHeight = 100

	;; ==================================================================
	;; ADMINISTRATIVE PARCELS  (GOD / SYSTEM CONTENT)
	;; ==================================================================
	;;
	;; These settings allow a parcel to be marked as
	;; "administrator-controlled content".
	;;
	;; FUNCTIONALLY SIMILAR TO:
	;;    Linden-owned land in Second Life
	;;
	;; USE CASES:
	;;    Infrastructure parcels
	;;    System-owned land
	;;    Protected grid services
	;;    Non-user-modifiable regions
	;;
	;; REQUIRES:
	;;    Viewer God Mode enabled
	;;    Admin permissions
	;;
	;; ACCESS PATH (VIEWER):
	;;   Admin  Parcel  Set to Linden Content
	;;   (CTRL + ALT + SHIFT + C)
	;;

	;; DefaultAdministratorParcelName
	;;   Name assigned to admin parcels
	;;
	;; DefaultAdministratorGroupUUID
	;;   Group assigned as owner
	;;
	;; DefaultAdministratorOwnerUUID
	;;   Avatar UUID assigned as owner
	;;
	;; NOTE:
	;;   Leaving these unset disables default assignment.
	;;
	; DefaultAdministratorParcelName = "Admin Parcel"
	; DefaultAdministratorGroupUUID = "00000000-0000-0000-0000-000000000000"
	; DefaultAdministratorOwnerUUID = "00000000-0000-0000-0000-000000000000"

	;; ==================================================================
	;; OPERATOR SUMMARY
	;; ==================================================================
	;;
	;; This section:
	;;    Directly impacts region edit performance
	;;    Scales poorly if left at legacy defaults on large regions
	;;
	;; SAFE DEFAULTS:
	;;    LimitParcelLayerUpdateDistance = true
	;;    ParcelLayerViewDistance = 128
	;;
	;; IF YOU RUN VARREGIONS:
	;;    This section is NOT optional tuning
	;;
	;; ==================================================================

[JsonStore]
	;; JsonStore module provides structured store for scripts
	;;
	;;
	;; ==================================================================
	;; JSON STORE  (SCRIPT-ACCESSIBLE STRUCTURED DATA STORAGE)
	;; ==================================================================
	;;
	;; This module provides a PERSISTENT, STRUCTURED DATA STORE
	;; intended for use by in-world scripts.
	;;
	;; Despite the name, this has NOTHING to do with:
	;;    Logging
	;;    Viewer JSON
	;;    REST APIs
	;;    Web services
	;;    “Jason” (yes, people really ask this)
	;;
	;; The name comes from:
	;;   JavaScript Object Notation (JSON)
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS MODULE ACTUALLY IS
	;; ------------------------------------------------------------------
	;;
	;; JsonStore allows scripts to store and retrieve structured data
	;; (key/value trees) that:
	;;
	;;    Persist across region restarts
	;;    Persist across script resets
	;;    Are NOT stored in script memory
	;;
	;; Think of it as:
	;;   A SMALL, SERVER-SIDE DATABASE
	;;   that scripts can use safely
	;;
	;; WITHOUT:
	;;    Notecards
	;;    External web servers
	;;    llHTTPRequest hacks
	;;
	;; ------------------------------------------------------------------
	;; WHAT PROBLEM THIS SOLVES
	;; ------------------------------------------------------------------
	;;
	;; Historically, OpenSim scripts used:
	;;    Notecards (slow, fragile)
	;;    Script memory (volatile)
	;;    External HTTP APIs (latency, failure-prone)
	;;
	;; JsonStore exists to support:
	;;    Persistent NPC state
	;;    Vendor transaction data
	;;    Quest progression
	;;    Object configuration state
	;;    AI / behavior memory
	;;
	;; WITHOUT relying on external infrastructure.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS MODULE IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; JsonStore is NOT:
	;;    A general-purpose database
	;;    A replacement for MySQL/Postgres
	;;    A logging system
	;;    A metrics store
	;;
	;; It is deliberately LIMITED.
	;;
	;; ------------------------------------------------------------------
	;; STORAGE LOCATION & RAMIFICATIONS
	;; ------------------------------------------------------------------
	;;
	;; Data stored via JsonStore:
	;;
	;;    Is written to simulator storage
	;;    Increases disk usage
	;;    Increases persistence load on shutdown/startup
	;;
	;; BAD PRACTICE:
	;;    Storing large blobs
	;;    Treating it like infinite memory
	;;    Using it for high-frequency logging
	;;
	;; GOOD PRACTICE:
	;;    Small structured state
	;;    Configuration trees
	;;    Long-lived object state
	;;
	;; ------------------------------------------------------------------
	;; SECURITY & TRUST MODEL
	;; ------------------------------------------------------------------
	;;
	;; JsonStore data is:
	;;    Server-side
	;;    Not directly user-accessible
	;;    Only accessible through scripts
	;;
	;; HOWEVER:
	;;    Poorly written scripts can abuse it
	;;    Unlimited growth can impact storage
	;;
	;; This is WHY it is DISABLED by default.
	;;
	;; ------------------------------------------------------------------
	;; ENABLED
	;; ------------------------------------------------------------------
	;;
	;; Enables the JsonStore subsystem.
	;;
	;; DEFAULT:
	;;   false
	;;
	;; RECOMMENDED:
	;;   false unless you KNOW you need it
	;;
	;; Enable ONLY if:
	;;    You are running NPC systems
	;;    You are running vendors or quest engines
	;;    You are implementing AI-backed behaviors
	;;
		Enabled = False

	;; --------------------------------------------------
	;; EnableObjectStore
	;; --------------------------------------------------
	;;
	;; Allows scripts to directly access an OBJECT-SCOPED
	;; structured data store (SOP dynamic attributes).
	;;
	;; EFFECT:
	;;    Scripts can store structured data directly
	;;     on objects without external keys
	;;
	;; DANGER:
	;;    Poor scripting can cause unbounded growth
	;;    Harder to audit and clean up
	;;
	;; DEFAULT:
	;;   false
	;;
	;; RECOMMENDED:
	;;   false unless building advanced systems
	;;
	EnableObjectStore = False


	;; --------------------------------------------------
	;; MaxStringSpace
	;; --------------------------------------------------
	;;
	;; Limits the TOTAL amount of string data (in bytes)
	;; that can be stored per JsonStore context.
	;;
	;; 0 = UNLIMITED
	;;
	;; DANGER:
	;;    Unlimited storage can consume disk
	;;    Can mask runaway scripts
	;;
	;; SAFE PRACTICE:
	;;    Set a reasonable cap once enabled
	;;    Monitor growth
	;;
	;; EXAMPLE:
	;;   MaxStringSpace = 65536   ; 64 KB
	;;
	MaxStringSpace = 0

	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE (READ THIS)
	;; ------------------------------------------------------------------
	;;
	;; DO NOT enable JsonStore just because:
	;;    It “sounds useful”
	;;    A script complains it’s missing
	;;
	;; DO enable JsonStore if:
	;;    You control the scripts using it
	;;    You understand the data lifecycle
	;;    You have monitoring in place
	;;
	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;;  Add per-object quotas
	;;  Add admin visibility into stored data
	;;  Add cleanup tooling
	;;  Integrate with WebUI inspection
	;;
	;; JsonStore is a POWER TOOL.
	;; Treat it like one.
	;;
	;; ==================================================================

[AssetService]
	;; ==================================================================
	;; ASSET SERVICE  (BOOTSTRAP / DEFAULT ASSET SEEDING)
	;; ==================================================================
	;;
	;; These are defaults that are overwritten below in [Architecture].
	;; These defaults allow OpenSim to work out of the box with
	;; zero configuration
	;;
	;; This section defines how OpenSim initializes and seeds its
	;; Asset Service when a simulator or grid starts.
	;;
	;; These values exist to ensure OpenSim can:
	;;    Start with ZERO configuration
	;;    Provide a usable world on first boot
	;;    Ensure required system assets exist
	;;
	;; These settings are DEFAULTS.
	;; They are typically OVERRIDDEN later by:
	;;    [Architecture]
	;;    Grid / Robust service configuration
	;;
	;; DO NOT assume these are always active.
	;; DO NOT assume they are safe to remove.
	;;
	;; ------------------------------------------------------------------
	;; WHAT PROBLEM THIS SECTION SOLVES
	;; ------------------------------------------------------------------
	;;
	;; Without a default asset loader:
	;;    New grids start EMPTY
	;;    Core assets are missing
	;;    Avatars fail to render
	;;    System library content does not exist
	;;
	;; This section ensures:
	;;    Default shapes exist
	;;    Default textures exist
	;;    Default scripts and gestures exist
	;;    The grid is usable on first startup
	;;
	;; ------------------------------------------------------------------
	;; IMPORTANT DISTINCTION
	;; ------------------------------------------------------------------
	;;
	;; This section does NOT control:
	;;    Normal asset fetching
	;;    Asset storage backends (MySQL, FS, etc.)
	;;    Hypergrid asset transfer
	;;
	;; It ONLY controls:
	;;    INITIAL ASSET SEEDING
	;;
	;; Once assets are loaded, the normal Asset Service takes over.
	;;
	;; ------------------------------------------------------------------
	;; DEFAULT ASSET LOADER
	;; ------------------------------------------------------------------
	;;
	;; DefaultAssetLoader defines WHICH loader implementation
	;; is responsible for inserting default assets.
	;;
	;; The Filesystem loader reads from a local XML definition
	;; describing asset sets.
	;;
	;; This is used ONLY for:
	;;    Bootstrapping
	;;    First-time initialization
	;;
	;; It is NOT used for:
	;;    Ongoing asset management
	;;    User uploads
	;;    Runtime asset delivery
	;;
		DefaultAssetLoader = "OpenSim.Framework.AssetLoader.Filesystem.dll"

    ;; --------------------------------------------------
    ;; AssetLoaderArgs
    ;; --------------------------------------------------
    ;;
    ;; Path to the asset set definition file.
    ;;
    ;; This XML file lists:
    ;;    Which default assets exist
    ;;    Where they are located on disk
    ;;    How they should be inserted
    ;;
    ;; DEFAULT:
    ;;   assets/AssetSets.xml
    ;;
    ;; This file typically defines:
    ;;    Library textures
    ;;    Basic shapes
    ;;    Default scripts
    ;;    System gestures
    ;;
    ;; WARNING:
    ;;    If this file is missing or malformed
    ;;     initial asset seeding will fail
    ;;
    AssetLoaderArgs = "assets/AssetSets.xml"

    ;; --------------------------------------------------
    ;; AssetLoaderEnabled
    ;; --------------------------------------------------
    ;;
    ;; Controls whether the DEFAULT ASSET SET
    ;; is inserted into the asset store on startup.
    ;;
    ;; true  = Load default assets if missing
    ;; false = Do NOT auto-insert default assets
    ;;
    ;; DEFAULT:
    ;;   true
    ;;
    ;; WHY THIS EXISTS:
    ;;    Prevents empty grids
    ;;    Prevents broken avatars
    ;;    Prevents missing system content
    ;;
    ;; WHEN TO SET FALSE:
    ;;    You have already seeded assets
    ;;    You are restoring from backup
    ;;    You are cloning an existing grid
    ;;    You are certain system assets exist
    ;;
    ;; DANGER OF DISABLING TOO EARLY:
    ;;    Missing library content
    ;;    Broken inventory references
    ;;    Viewer errors on login
    ;;
    ;; IMPORTANT:
    ;; This setting ONLY prevents REINSERTION.
    ;; It does NOT delete existing assets.
    ;;
    AssetLoaderEnabled = true

	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; SAFE DEFAULT:
	;;   Leave AssetLoaderEnabled = true
	;;
	;; COMMON BEST PRACTICE:
	;;    Leave enabled for initial deployment
	;;    Disable AFTER confirming assets exist
	;;
	;; DO NOT:
	;;    Disable this on a brand new grid
	;;    Delete AssetSets.xml without replacement
	;;    Assume your database already has assets
	;;
	;; ------------------------------------------------------------------
	;; COMMON ADMIN CONFUSION
	;; ------------------------------------------------------------------
	;;
	;; "Why are assets loading every startup?"
	;;    They are NOT reloaded if they already exist
	;;
	;; "Is this duplicating assets?"
	;;    No. Assets are inserted conditionally
	;;
	;; "Can I remove this later?"
	;;    Yes, once your grid is fully seeded
	;;
	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;;  Explicit asset seed state tracking
	;;  Admin visibility into seeded assets
	;;  Safer detection of partial seed states
	;;
	;; ==================================================================

[GridService]
	;; ==================================================================
	;; GRID SERVICE  (REGION REGISTRATION / GRID TOPOLOGY)
	;; ==================================================================
	;;
	;; This section controls how regions are registered, tracked,
	;; and discovered within a grid.
	;;
	;; This is NOT a performance tuning section.
	;; This is NOT a database optimization section.
	;;
	;; This section exists to support TWO very different deployment models:
	;;    Standalone mode
	;;    Grid / Robust mode
	;;
	;; The defaults here are intentionally minimal to allow OpenSim
	;; to start with ZERO external dependencies.
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS LOOKS CONFUSING
	;; ------------------------------------------------------------------
	;;
	;; New administrators often see:
	;;
	;;   StorageProvider = "OpenSim.Data.Null.dll:NullRegionData"
	;;
	;; and assume:
	;;    Something is missing
	;;    Regions are not being stored
	;;    They must "fix" this
	;;
	;; THIS IS A FALSE IMPRESSION.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; GridService is responsible for:
	;;    Tracking region presence
	;;    Advertising regions to login services
	;;    Providing region lookup for teleports
	;;
	;; HOW it stores region data depends entirely on architecture.
	;;
	;; In STANDALONE MODE:
	;;    Regions are loaded directly from local INI files
	;;    No central grid database is required
	;;    Region persistence is handled locally
	;;
	;; Therefore:
	;;    No region storage backend is needed
	;;    No grid-wide region registry is needed
	;;
	;; The NullRegionData provider exists EXACTLY for this case.
	;;
	;; ------------------------------------------------------------------
	;; WHAT NullRegionData MEANS
	;; ------------------------------------------------------------------
	;;
	;; "Null" DOES NOT mean:
	;;    Disabled
	;;    Broken
	;;    Missing functionality
	;;
	;; It means:
	;;    Do not store region topology centrally
	;;    Rely on local configuration instead
	;;
	;; This is CORRECT behavior for:
	;;    Standalone simulators
	;;    Single-instance grids
	;;    Development environments
	;;    Local testing
	;;
	;; ------------------------------------------------------------------
	;; WHEN THIS GETS OVERRIDDEN
	;; ------------------------------------------------------------------
	;;
	;; In GRID / ROBUST MODE:
	;;    Region topology MUST be shared
	;;    Login services need to know where regions live
	;;    Hypergrid requires region lookup
	;;
	;; In those cases:
	;;    This setting is OVERRIDDEN
	;;    Usually via StandaloneCommon.ini or GridCommon.ini
	;;    A real database-backed GridService is used
	;;
	;; YOU SHOULD NOT change this here.
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; DO NOT change this value unless:
	;;    You understand OpenSim architecture modes
	;;    You are converting from standalone to grid
	;;    You have already configured Robust services
	;;
	;; Changing this prematurely can cause:
	;;    Regions failing to register
	;;    Teleports failing
	;;    Login failures
	;;    Ghost regions
	;;
	;; These failures are often SILENT and difficult to diagnose.
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY FOR ADMINS
	;; ------------------------------------------------------------------
	;;
	;; If you are running:
	;;    Standalone OpenSim
	;;    A single simulator instance
	;;
	;; THEN:
	;;    This value is CORRECT
	;;    You should leave it alone
	;;
	;; If you are running:
	;;    A multi-sim grid
	;;    Robust services
	;;
	;; THEN:
	;;    This value will be overridden elsewhere
	;;    You still should not change it here
	;;
	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;;  Make architecture mode explicit in config
	;;  Reduce admin confusion around Null providers
	;;  Provide warnings when mismatched with Robust
	;;
	;; ==================================================================

		StorageProvider = "OpenSim.Data.Null.dll:NullRegionData"

[AutoBackupModule]
	;; ==================================================================
	;; AUTO BACKUP MODULE  (MISLEADING NAME – LIMITED SCOPE)
	;; ==================================================================
	;;
	;; EXTREME CLARITY WARNING
	;;
	;; This module is NOT a full backup system.
	;; It is NOT disaster recovery.
	;; It is NOT a replacement for OAR/IAR/DB backups.
	;;
	;; The name "AutoBackupModule" causes a FALSE sense of safety.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS MODULE ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; When enabled, AutoBackupModule performs PERIODIC SNAPSHOTS of:
	;;    Region scene state
	;;    Objects and prims currently in the region
	;;
	;; This is effectively an AUTOMATED OAR-LIKE SNAPSHOT.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS MODULE DOES *NOT* DO
	;; ------------------------------------------------------------------
	;;
	;; This module does NOT back up:
	;;    User inventory (IAR)
	;;    Assets database
	;;    Users, accounts, or profiles
	;;    Grid services
	;;    Estate or parcel ownership metadata
	;;    Economy data
	;;    Groups
	;;
	;; If your asset database is lost:
	;;    These backups are USELESS
	;;
	;; If your inventory database is lost:
	;;    These backups are USELESS
	;;
	;; ------------------------------------------------------------------
	;; COMMON ADMIN MISCONCEPTION
	;; ------------------------------------------------------------------
	;;
	;; Many admins see "AutoBackup" and believe:
	;;    Their grid is protected
	;;    They can recover from failure
	;;    They no longer need manual backups
	;;
	;; THIS IS WRONG.
	;;
	;; This module ONLY protects AGAINST:
	;;    Accidental object deletion
	;;    Region-level content loss
	;;    Builder mistakes
	;;
	;; ------------------------------------------------------------------
	;; VALID USE CASES
	;; ------------------------------------------------------------------
	;;
	;; This module is appropriate for:
	;;    Active build regions
	;;    Sandbox regions
	;;    Educational build environments
	;;    Content-heavy regions under active development
	;;
	;; It is useful as a:
	;;    Convenience safety net
	;;    Short-term rollback mechanism
	;;
	;; ------------------------------------------------------------------
	;; INVALID USE CASES
	;; ------------------------------------------------------------------
	;;
	;; This module is NOT sufficient for:
	;;    Grid backups
	;;    Server failure recovery
	;;    Database corruption recovery
	;;    Ransomware protection
	;;    Operator error at the database level
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; Enabling this module MAY:
	;;    Increase disk usage
	;;    Increase I/O load
	;;    Increase save latency on large regions
	;;
	;; Large varregions WILL generate very large backup files.
	;;
	;; ------------------------------------------------------------------
	;; REQUIRED COMPLEMENTARY BACKUPS
	;; ------------------------------------------------------------------
	;;
	;; A REAL backup strategy MUST also include:
	;;    Regular database dumps (MySQL/Postgres)
	;;    Asset store backups
	;;    Inventory backups (IAR)
	;;    Off-host storage
	;;
	;; AutoBackupModule WITHOUT THESE is SECURITY THEATER.
	;;
	;; ------------------------------------------------------------------
	;; DEFAULT RECOMMENDATION
	;; ------------------------------------------------------------------
	;;
	;; New admins:
	;;    KEEP DISABLED until you understand its scope
	;;
	;; Experienced admins:
	;;    Enable selectively
	;;    Monitor disk usage
	;;    Never rely on it alone
	;;
	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;;  Rename module to avoid misleading admins
	;;  Document restore workflows explicitly
	;;  Integrate with real backup pipelines
	;;
	;; ==================================================================

    ;; Enables periodic region scene snapshots.
    ;; Default: false
    AutoBackupModuleEnabled = false

[Sounds]
	;; ==================================================================
	;; SOUND DELIVERY SYSTEM  (USER EXPERIENCE + NETWORK TRADEOFF)
	;; ==================================================================
	;;
	;; EXTREME CLARITY WARNING
	;;
	;; This section DIRECTLY affects:
	;;    User immersion
	;;    Perceived region responsiveness
	;;    Audio realism
	;;    Network traffic
	;;
	;; Poor tuning WILL cause users to report:
	;;    "Sound is broken"
	;;    "Sounds randomly cut out"
	;;    "I hear things that are far away"
	;;    "I don't hear things I should hear"
	;;
	;; These are NOT viewer bugs.
	;; These are server-side sound delivery decisions.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SYSTEM DOES
	;; ------------------------------------------------------------------
	;;
	;; OpenSim does NOT stream continuous audio like voice.
	;;
	;; Instead, it sends DISCRETE sound events to viewers:
	;;    llPlaySound
	;;    llLoopSound
	;;    collision sounds
	;;    scripted effects
	;;
	;; The simulator decides:
	;;    WHICH avatars receive a sound
	;;    WHEN it is sent
	;;    WHETHER it is culled entirely
	;;
	;; ------------------------------------------------------------------
	;; CRITICAL CONCEPT: SOUND CULLING
	;; ------------------------------------------------------------------
	;;
	;; Sounds are NOT spatially mixed on the server.
	;;
	;; The server performs a DISTANCE CHECK only.
	;;
	;; If the avatar is BEYOND MaxDistance:
	;;    The sound event is NEVER sent
	;;
	;; The viewer CANNOT hear it because it never received it.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; This setting does NOT:
	;;    Control volume
	;;    Control attenuation curves
	;;    Control stereo vs mono
	;;    Affect voice
	;;
	;; Those are viewer-side behaviors.
	;;
	;; ------------------------------------------------------------------
	;; USER EXPERIENCE IMPLICATIONS
	;; ------------------------------------------------------------------
	;;
	;; TOO LOW MaxDistance:
	;;    Sounds feel clipped
	;;    Ambient audio disappears abruptly
	;;    Vehicles lose engine audio
	;;    Weather effects feel broken
	;;
	;; TOO HIGH MaxDistance:
	;;    Users hear irrelevant sounds
	;;    Audio clutter increases
	;;    Performance impact on busy regions
	;;    Loss of spatial realism
	;;
	;; ------------------------------------------------------------------
	;; PERFORMANCE IMPLICATIONS
	;; ------------------------------------------------------------------
	;;
	;; Each sound event is:
	;;    A network message
	;;    A per-avatar delivery decision
	;;
	;; Increasing MaxDistance:
	;;    Increases number of recipients
	;;    Increases packet volume
	;;    Increases CPU cost under load
	;;
	;; This scales with:
	;;    Number of avatars
	;;    Number of sound-emitting objects
	;;
	;; ------------------------------------------------------------------
	;; DESIGN INTENT GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; Small indoor regions:
	;;    Lower distances feel more realistic
	;;
	;; Outdoor environments:
	;;    Moderate distances work best
	;;
	;; Vehicles and aircraft:
	;;    Larger distances required for immersion
	;;
	;; Event venues:
	;;    Balance immersion vs noise pollution
	;;
	;; ------------------------------------------------------------------
	;; COMMON ADMIN MISTAKES
	;; ------------------------------------------------------------------
	;;
	;;  Raising MaxDistance to "fix missing sounds"
	;;  Lowering MaxDistance to "fix lag"
	;;  Treating this as a volume control
	;;
	;; These lead to worse user experience.
	;;
	;; ------------------------------------------------------------------
	;; SAFE TUNING GUIDELINES
	;; ------------------------------------------------------------------
	;;
	;; Default behavior:
	;;    Leave as-is unless you understand your content
	;;
	;; Adjust ONLY if:
	;;    You understand where sounds originate
	;;    You understand region use cases
	;;    You test with real users present
	;;
	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;;  Per-region sound distance profiles
	;;  Sound categories with independent ranges
	;;  Estate-level presets
	;;  Better diagnostics for sound culling
	;;
	;; ==================================================================

    ;; Implementation of ISoundModule.
    ;; Default core sound module.
    Module = OpenSim.Region.CoreModules.dll:SoundModule

    ;; Maximum distance at which sound events are sent to avatars.
    ;;
    ;; IMPORTANT:
    ;;    Sounds beyond this distance are NEVER sent
    ;;    Viewer cannot hear what it never receives
    ;;
    ;; Default: 100.0 meters
    ;; Recommended: Leave default unless you understand your content
    ;;
    MaxDistance = 100.0

[ServiceThrottle]
	;; ==================================================================
	;; THROTTLE SERVICE SCHEDULER  (NETWORK + CPU SAFETY MECHANISM)
	;; ==================================================================
	;;
	;; EXTREME CAUTION
	;;
	;; This setting controls how often the *throttle service thread*
	;; wakes up to recalculate bandwidth and message limits.
	;;
	;; Changing this value can:
	;;    Destabilize network delivery
	;;    Cause bursty or stalled updates
	;;    Create phantom "lag" symptoms
	;;    Mask real performance problems
	;;
	;; This is NOT a performance tuning knob.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THE THROTTLE SERVICE ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; OpenSim uses a throttling system to:
	;;    Limit outgoing bandwidth per client
	;;    Prevent a single avatar from flooding the network
	;;    Balance updates between:
	;;       - Object updates
	;;       - Avatar movement
	;;       - Texture delivery
	;;       - Script traffic
	;;
	;; The throttle service periodically:
	;;    Recalculates per-client bandwidth budgets
	;;    Adjusts message queues
	;;    Enforces fairness under load
	;;
	;; ------------------------------------------------------------------
	;; WHAT Interval CONTROLS
	;; ------------------------------------------------------------------
	;;
	;; Interval defines how often (in milliseconds) the throttle service
	;; wakes up to perform these recalculations.
	;;
	;; Example:
	;;   Interval = 5000
	;;    Throttle service runs every 5 seconds
	;;
	;; This is NOT per-frame.
	;; This is NOT per-packet.
	;;
	;; It is a COARSE scheduling interval.
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; Throttle recalculation is:
	;;    CPU-expensive
	;;    Lock-heavy
	;;    Affects shared network state
	;;
	;; Running it too often:
	;;    Wastes CPU
	;;    Increases contention
	;;    Can reduce overall throughput
	;;
	;; Running it too rarely:
	;;    Allows unfair bandwidth usage
	;;    Causes delayed recovery from spikes
	;;    Produces bursty network behavior
	;;
	;; ------------------------------------------------------------------
	;; FAILURE MODES CAUSED BY BAD VALUES
	;; ------------------------------------------------------------------
	;;
	;; TOO LOW (e.g. < 1000 ms):
	;;    Excessive CPU usage
	;;    Thread contention
	;;    Reduced simulator frame time
	;;    Worse performance under load
	;;
	;; TOO HIGH (e.g. > 10000 ms):
	;;    Network stalls
	;;    Delayed avatar updates
	;;    Objects popping in late
	;;    Long recovery after lag spikes
	;;
	;; NONE OF THESE FAILURES LOG CLEAN ERRORS.
	;;
	;; Users will report:
	;;    "Movement is choppy"
	;;    "Things take forever to rez"
	;;    "Lag comes and goes randomly"
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; DO NOT:
	;;    Lower this to "fix lag"
	;;    Raise this to "reduce CPU"
	;;    Copy values from forums
	;;
	;; This setting interacts with:
	;;    Network conditions
	;;    Interest management
	;;    Packet pooling
	;;    Viewer behavior
	;;
	;; ------------------------------------------------------------------
	;; SAFE OPERATION GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; DEFAULT VALUE:
	;;   5000 ms
	;;
	;; This is a CONSERVATIVE, STABLE compromise.
	;;
	;; Change ONLY if:
	;;    You understand OpenSim network internals
	;;    You are diagnosing a specific throttle issue
	;;    You can reproduce the problem reliably
	;;    You can restart regions safely
	;;
	;; AFTER TESTING:
	;;    Restore default unless proven otherwise
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY FOR NON-EXPERT ADMINS
	;; ------------------------------------------------------------------
	;;
	;; This is like adjusting how often traffic lights retime themselves.
	;;
	;; If you mess with it:
	;;    Traffic may still flow
	;;    But jams will appear unpredictably
	;;
	;; If you do not understand this section:
	;;    LEAVE IT ALONE
	;;
	;; ==================================================================

	;; Default time interval (in ms) for the throttle service thread to wake up
	Interval = 5000

[Dwell]
	;; ==================================================================
	;; DWELL MODULE  (LEGACY VISIBILITY / ENGAGEMENT METRIC)
	;; ==================================================================
	;;
	;; WARNING: MISLEADING TERMINOLOGY
	;;
	;; The word "Dwell" does NOT mean:
	;;    User interest
	;;    User enjoyment
	;;    Quality of experience
	;;    Popularity in any meaningful sense
	;;
	;; "Dwell" is a VERY specific legacy metric inherited from
	;; early Second Life design decisions.
	;;
	;; ------------------------------------------------------------------
	;; WHAT DWELL ACTUALLY IS
	;; ------------------------------------------------------------------
	;;
	;; Dwell is a simple time-based counter that tracks:
	;;
	;;    How long avatars remain within a parcel or region
	;;
	;; Historically, this value was used to:
	;;    Rank places in search
	;;    Influence land visibility
	;;    Drive traffic-based discovery
	;;
	;; It is NOT intelligent.
	;; It does NOT measure interaction.
	;; It does NOT measure engagement quality.
	;;
	;; An avatar standing AFK for hours increases dwell.
	;;
	;; ------------------------------------------------------------------
	;; HISTORICAL CONTEXT
	;; ------------------------------------------------------------------
	;;
	;; Dwell originated in early SL-era systems where:
	;;    Traffic metrics were simplistic
	;;    Bots and camping chairs were common
	;;    Visibility was gamed via time accumulation
	;;
	;; This led to:
	;;    Artificial inflation
	;;    Camping farms
	;;    Misleading popularity signals
	;;
	;; Many modern grids intentionally DEVALUE or IGNORE dwell.
	;;
	;; ------------------------------------------------------------------
	;; CURRENT REALITY IN OPENSIM
	;; ------------------------------------------------------------------
	;;
	;; In modern OpenSim deployments:
	;;
	;;    Dwell is largely informational
	;;    It has NO intrinsic gameplay effect
	;;    It does NOT control permissions
	;;    It does NOT affect physics or performance
	;;
	;; Its usefulness depends entirely on:
	;;    Whether your grid uses dwell in search or discovery
	;;    Whether you expose dwell data to users
	;;    Whether you intentionally support traffic-based ranking
	;;
	;; ------------------------------------------------------------------
	;; WHAT THE DWELL MODULE DOES NOT DO
	;; ------------------------------------------------------------------
	;;
	;; Enabling this module does NOT:
	;;    Improve user experience
	;;    Improve region performance
	;;    Prevent griefing
	;;    Provide meaningful analytics
	;;
	;; It ONLY tracks accumulated avatar presence time.
	;;
	;; ------------------------------------------------------------------
	;; VALID USE CASES
	;; ------------------------------------------------------------------
	;;
	;; Dwell MAY be useful if:
	;;
	;;    Your grid implements place search ranking
	;;    You want a crude visibility metric
	;;    You are emulating classic SL-style behavior
	;;    You explicitly document dwell semantics for users
	;;
	;; Dwell is MOSTLY USELESS if:
	;;
	;;    You do not surface dwell data
	;;    You do not rank regions by traffic
	;;    You use modern analytics instead
	;;
	;; ------------------------------------------------------------------
	;; BETTER MODERN ALTERNATIVES
	;; ------------------------------------------------------------------
	;;
	;; For real insight into grid usage, consider:
	;;
	;;    Concurrent avatar counts
	;;    Session duration distributions
	;;    Event participation metrics
	;;    Script and object interaction counts
	;;    External observability tools (Prometheus, Grafana)
	;;
	;; These provide actionable data.
	;; Dwell does not.
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; If you do not KNOW why you want dwell:
	;;    You probably do not need it
	;;
	;; If you enable dwell:
	;;    Document what it means
	;;    Avoid presenting it as "popularity"
	;;    Expect it to be gamed
	;;
	;; ------------------------------------------------------------------
	;; STATUS
	;; ------------------------------------------------------------------
	;;
	;; STATUS:
	;;    Legacy metric
	;;    Still functional
	;;    Low impact
	;;    Often misunderstood
	;;
	;; FUTURE TODO:
	;;    Deprecate in favor of real analytics
	;;    Or clearly label as historical traffic metric
	;;
	;; ==================================================================

    ;; Enables the built-in basic dwell tracking module.
    ;;
    ;; This module accumulates avatar presence time for parcels/regions.
    ;; It does NOT imply engagement quality or user interest.
    ;;
    ;; Default behavior. Safe to leave enabled or disabled.
    ;;
    DwellModule = DefaultDwellModule

[ServerReleaseNotes]
	;; ==================================================================
	;; SERVER RELEASE NOTES  (OPERATOR VISIBILITY / USER COMMUNICATION)
	;; ==================================================================
	;;
	;; WHAT THIS SECTION IS
	;; ------------------------------------------------------------------
	;;
	;; This setting controls the URL shown to users when the viewer
	;; requests server release information.
	;;
	;; Typically exposed via:
	;;    Viewer "About" panels
	;;    Help or diagnostics UI
	;;    Login-time informational links
	;;
	;; It is NOT fetched automatically by the server.
	;; It is provided to the viewer as metadata.
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; This is NOT:
	;;    A required operational dependency
	;;    A health check
	;;    A version enforcement mechanism
	;;    A security feature
	;;
	;; Changing or disabling this will NOT:
	;;    Break the grid
	;;    Affect performance
	;;    Affect compatibility
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; This field exists to:
	;;    Inform users which OpenSim release the grid is based on
	;;    Provide context for known bugs or limitations
	;;    Reduce support load caused by version confusion
	;;
	;; By default, it points to the upstream OpenSim release notes.
	;;
	;; ------------------------------------------------------------------
	;; WHEN YOU MAY WANT TO CHANGE THIS
	;; ------------------------------------------------------------------
	;;
	;; You MAY want to change this URL if:
	;;
	;;    You run a forked or patched OpenSim build
	;;    You maintain grid-specific release notes
	;;    You want users to see YOUR changelog instead of upstream
	;;    You operate a managed or institutional grid
	;;
	;; Common alternatives:
	;;
	;;    Your own documentation page
	;;    A GitHub releases page
	;;    A grid status or changelog site
	;;
	;; ------------------------------------------------------------------
	;; WHEN YOU MAY WANT TO DISABLE THIS
	;; ------------------------------------------------------------------
	;;
	;; You MAY want to disable this by setting it to "" if:
	;;
	;;    You do not want users referencing upstream documentation
	;;    You operate a closed or private grid
	;;    You provide version info elsewhere
	;;
	;; NOTE:
	;; Disabling this only hides the link.
	;; It does NOT hide the actual server version.
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; Leaving this pointing at upstream OpenSim:
	;;    May confuse users if you run custom patches
	;;    May cause users to report bugs already fixed locally
	;;
	;; If you customize your grid:
	;;    Point this at YOUR release notes
	;;
	;; ------------------------------------------------------------------
	;; SAFE DEFAULT
	;; ------------------------------------------------------------------
	;;
	;; Point to the OpenSim release matching your deployment.
	;; This is safe and recommended unless you have a reason to change it.
	;;
	;; ==================================================================

    ;; URL displayed to viewers for server release information.
    ;;
    ;; Comment out or set to "" to disable entirely.
    ;;
    ServerReleaseNotesURL = "http://opensimulator.org/wiki/0.9.3.1_Release"
	
[Modules]
	;; ==================================================================
	;; MODULE LOADING AND EXTENSION INCLUSION
	;; ==================================================================
	;;
	;; THIS SECTION CONTROLS DYNAMIC MODULE LOADING.
	;;
	;; A SINGLE MISCONFIGURATION HERE CAN:
	;;    Change simulator behavior without obvious indication
	;;    Enable untrusted code
	;;    Break startup
	;;    Override core functionality
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SECTION DOES
	;; ------------------------------------------------------------------
	;;
	;; The [Modules] section defines where OpenSim looks for
	;; *additional module configuration files* at startup.
	;;
	;; These included files may:
	;;    Enable or disable modules
	;;    Override defaults defined elsewhere
	;;    Inject new services or behaviors
	;;    Modify permissions, physics, scripting, or networking
	;;
	;; Inclusion happens:
	;;    At startup
	;;    Before regions are fully initialized
	;;    Without prompting or confirmation
	;;
	;; ------------------------------------------------------------------
	;; WHAT Include-modules ACTUALLY MEANS
	;; ------------------------------------------------------------------
	;;
	;; Include-modules is a FILE GLOB.
	;;
	;; It tells OpenSim:
	;;
	;;   "Load every .ini file matching this path pattern
	;;    and merge it into the active configuration."
	;;
	;; This is NOT:
	;;    A plugin registry
	;;    A sandbox
	;;    A security boundary
	;;
	;; It is literal configuration inclusion.
	;;
	;; ------------------------------------------------------------------
	;; DEFAULT BEHAVIOR EXPLAINED
	;; ------------------------------------------------------------------
	;;
	;; Default:
	;;   addon-modules/*/config/*.ini
	;;
	;; This means:
	;;    Every subdirectory under addon-modules/
	;;    Any config/*.ini file inside it
	;;    Will be loaded automatically
	;;
	;; Example:
	;;   addon-modules/MyModule/config/MyModule.ini
	;;    WILL be loaded
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS IS RISKY
	;; ------------------------------------------------------------------
	;;
	;; Because:
	;;
	;;    There is NO validation
	;;    There is NO signing
	;;    There is NO module allowlist
	;;    Order of loading can matter
	;;
	;; A module config can:
	;;    Enable legacy services
	;;    Override security defaults
	;;    Change physics or script engines
	;;    Expose new network endpoints
	;;
	;; All WITHOUT a warning.
	;;
	;; ------------------------------------------------------------------
	;; COMMON FAILURE MODES
	;; ------------------------------------------------------------------
	;;
	;; Admins get burned here when:
	;;
	;;    Old test modules are left behind
	;;    Third party addons ship unsafe defaults
	;;    Copied configs reference missing DLLs
	;;    A module silently overrides a core setting
	;;
	;; Resulting symptoms:
	;;    "Why did this suddenly turn on?"
	;;    "Why does this behave differently now?"
	;;    "It worked yesterday"
	;;
	;; ------------------------------------------------------------------
	;; SECURITY IMPLICATIONS
	;; ------------------------------------------------------------------
	;;
	;; This mechanism can load:
	;;    Remote admin modules
	;;    REST handlers
	;;    Script extensions
	;;    Economy hooks
	;;
	;; Treat addon-modules as:
	;;    Executable configuration
	;;    NOT passive data
	;;
	;; If someone can write to this directory,
	;; they can alter simulator behavior.
	;;
	;; ------------------------------------------------------------------
	;; SAFE OPERATION GUIDELINES
	;; ------------------------------------------------------------------
	;;
	;; STRONGLY RECOMMENDED:
	;;
	;;    Version control addon-modules/
	;;    Audit every included .ini file
	;;    Remove unused or experimental modules
	;;    Do NOT blindly install addons
	;;
	;; OPTIONAL HARDENING:
	;;
	;;    Narrow the glob to specific modules
	;;    Use explicit paths instead of wildcards
	;;    Maintain a documented module inventory
	;;
	;; ------------------------------------------------------------------
	;; DO NOT:
	;; ------------------------------------------------------------------
	;;
	;;    Assume this only loads "safe" modules
	;;    Assume modules are isolated
	;;    Assume disabling a module elsewhere overrides this
	;;
	;; Inclusion always wins.
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY
	;; ------------------------------------------------------------------
	;;
	;; Include-modules is powerful.
	;; Include-modules is silent.
	;; Include-modules is dangerous if ignored.
	;;
	;; Treat addon-modules as part of your trusted codebase.
	;;
	;; ==================================================================

    ;; Include external module configuration files.
    ;; This loads ALL matching .ini files at startup.
    Include-modules = "addon-modules/*/config/*.ini"

[OSSL]
	;; ==================================================================
	;; OSSL  (OPEN SIMULATOR SCRIPTING EXTENSIONS)
	;; ==================================================================
	;;
	;; THIS SECTION CONTROLS ACCESS TO *NON-STANDARD* SCRIPT FUNCTIONS.
	;;
	;; OSSL FUNCTIONS ARE NOT LSL.
	;; OSSL FUNCTIONS ARE NOT AUTOMATICALLY DANGEROUS.
	;;
	;; THEY ARE A POWER TOOL.
	;;
	;; ------------------------------------------------------------------
	;; WHAT OSSL IS
	;; ------------------------------------------------------------------
	;;
	;; OSSL (OpenSimulator Scripting Language extensions) provides
	;; additional script functions that go BEYOND standard LSL.
	;;
	;; These functions allow scripts to:
	;;    Interact with simulator services
	;;    Access region and estate information
	;;    Perform administrative or system-aware actions
	;;    Integrate with external systems
	;;
	;; OSSL EXISTS BECAUSE:
	;;    LSL alone is intentionally limited
	;;    OpenSim is not Second Life
	;;    Grid operators need controlled extensibility
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS LINE ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; Include-osslDefaultEnable loads the DEFAULT OSSL PERMISSION POLICY.
	;;
	;; This file:
	;;   config-include/osslDefaultEnable.ini
	;;
	;; Defines:
	;;    WHICH os* functions exist
	;;    WHO may call them
	;;    UNDER WHAT CONDITIONS
	;;
	;; This line does NOT:
	;;    Enable all OSSL functions
	;;    Grant god powers to users
	;;    Automatically allow abuse
	;;
	;; It simply loads a DEFAULT RULESET.
	;;
	;; ------------------------------------------------------------------
	;; WHY OSSL IS FEARED (AND WHY THAT IS MOSTLY WRONG)
	;; ------------------------------------------------------------------
	;;
	;; OSSL gained a bad reputation because:
	;;    Early grids enabled everything blindly
	;;    Permission models were poorly understood
	;;    Some functions were dangerously powerful
	;;    Documentation was weak or misleading
	;;
	;; The RESULT:
	;;    Knee-jerk "disable everything" advice
	;;    Loss of powerful legitimate functionality
	;;
	;; ------------------------------------------------------------------
	;; REALITY CHECK
	;; ------------------------------------------------------------------
	;;
	;; OSSL IS NOT:
	;;    A single on/off switch
	;;    A security hole by default
	;;    Equivalent to giving users root access
	;;
	;; OSSL IS:
	;;    A function-level permission system
	;;    Controlled by UserLevel
	;;    Controlled by owner checks
	;;    Controlled by explicit allow/deny rules
	;;
	;; PROPERLY CONFIGURED OSSL:
	;;    Is safe
	;;    Is predictable
	;;    Enables advanced grid features
	;;
	;; ------------------------------------------------------------------
	;; HOW OSSL PERMISSIONS ACTUALLY WORK
	;; ------------------------------------------------------------------
	;;
	;; Permissions are evaluated based on:
	;;
	;;    UserLevel
	;;    Script owner
	;;    Object ownership
	;;    Explicit allow lists
	;;    Explicit deny lists
	;;
	;; MOST os* FUNCTIONS ARE:
	;;    Restricted to administrators
	;;    Restricted to estate managers
	;;    Disabled entirely by default
	;;
	;; ------------------------------------------------------------------
	;; WHAT BREAKS IF YOU DISABLE OSSL ENTIRELY
	;; ------------------------------------------------------------------
	;;
	;; Disabling OSSL completely can:
	;;
	;;    Break region automation
	;;    Break advanced vendors
	;;    Break NPC systems
	;;    Break admin tools
	;;    Break external integrations
	;;
	;; Many modern OpenSim systems ASSUME
	;; a minimally functional OSSL environment.
	;;
	;; ------------------------------------------------------------------
	;; SAFE OPERATION GUIDELINES
	;; ------------------------------------------------------------------
	;;
	;; RECOMMENDED PRACTICE:
	;;
	;;    Load the default OSSL policy
	;;    Review osslDefaultEnable.ini
	;;    Override selectively in osslEnable.ini
	;;
	;; DO NOT:
	;;    Enable everything blindly
	;;    Disable everything out of fear
	;;
	;; OSSL SHOULD BE:
	;;    Curated
	;;    Intentional
	;;    Documented
	;;
	;; ------------------------------------------------------------------
	;; COMMON ADMIN MISTAKES
	;; ------------------------------------------------------------------
	;;
	;;    Confusing OSSL with LSL
	;;    Thinking OSSL is "all or nothing"
	;;    Allowing functions without understanding scope
	;;    Disabling OSSL and breaking content
	;;
	;; ------------------------------------------------------------------
	;; SUMMARY FOR ADMINS
	;; ------------------------------------------------------------------
	;;
	;; OSSL is a scalpel, not a chainsaw.
	;;
	;; With understanding:
	;;    It is safe
	;;    It is powerful
	;;
	;; Without understanding:
	;;    Any tool is dangerous
	;;
	;; Fear is not a configuration strategy.
	;;
	;; ==================================================================

	Include-osslDefaultEnable = "config-include/osslDefaultEnable.ini"

[Architecture]
	;; ==================================================================
	;; ARCHITECTURE SELECTION  (FOUNDATIONAL / DO NOT CHANGE CASUALLY)
	;; ==================================================================
	;;
	;; THIS SECTION DEFINES HOW OPENSIM IS WIRED INTERNALLY.
	;;
	;; Changing this AFTER a grid has data WILL:
	;;    Break logins
	;;    Orphan assets
	;;    Split inventories
	;;    Invalidate regions
	;;    Make recovery painful or impossible
	;;
	;; ------------------------------------------------------------------
	;; WHAT "ARCHITECTURE" MEANS IN OPENSIM
	;; ------------------------------------------------------------------
	;;
	;; Architecture selection determines:
	;;
	;;    Which services run locally vs remotely
	;;    How assets are stored and resolved
	;;    How inventory is fetched
	;;    How regions communicate
	;;    Whether Hypergrid is possible
	;;
	;; This is NOT a cosmetic setting.
	;; This is NOT a runtime toggle.
	;;
	;; This is a CORE TOPOLOGY DECISION.
	;;
	;; ------------------------------------------------------------------
	;; INCLUDE-ARCHITECTURE EXPLAINED
	;; ------------------------------------------------------------------
	;;
	;; Include-Architecture loads a predefined architecture profile.
	;;
	;; That profile:
	;;    Includes additional .ini files
	;;    Enables specific service stacks
	;;    Changes database layout expectations
	;;    Alters login and region startup paths
	;;
	;; In other words:
	;;
	;;   This ONE LINE determines which OpenSim you are actually running.
	;;
	;; ------------------------------------------------------------------
	;; AVAILABLE ARCHITECTURES
	;; ------------------------------------------------------------------
	;;
	;; config-include/Standalone.ini
	;; --------------------------------
	;;    All services run in one process
	;;    Single simulator instance
	;;    Simplest setup
	;;    Suitable for testing and small private grids
	;;    NOT scalable
	;;
	;; config-include/StandaloneHypergrid.ini
	;; --------------------------------------
	;;    Standalone simulator with Hypergrid enabled
	;;    Still single-process services
	;;    Limited isolation
	;;    Suitable for small HG-connected grids
	;;
	;; config-include/Grid.ini
	;; -----------------------
	;;    Full grid architecture
	;;    Robust services required
	;;    Regions connect to central services
	;;    Scalable
	;;    Production-grade
	;;
	;; config-include/GridHypergrid.ini
	;; --------------------------------
	;;    Full grid architecture WITH Hypergrid
	;;    Most complex setup
	;;    Requires correct trust configuration
	;;    Suitable for public grids
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS IS DANGEROUS
	;; ------------------------------------------------------------------
	;;
	;; Each architecture:
	;;    Expects DIFFERENT database schemas
	;;    Uses DIFFERENT service endpoints
	;;    Loads DIFFERENT defaults
	;;
	;; Switching architectures:
	;;
	;;    Does NOT migrate data
	;;    Does NOT warn you
	;;    Does NOT validate compatibility
	;;
	;; You can easily end up with:
	;;    Multiple asset stores
	;;    Split inventories
	;;    Ghost users
	;;    Regions that will not start
	;;
