	region_file_template = "{0}x{1}-{2}.ini"

	;; --------------------------------------------------
	;; region_limit
	;; --------------------------------------------------
	;;
	;; Hard cap on number of regions that can be created.
	;;
	;; 0 = No limit
	;;
	;; SECURITY NOTE:
	;;    Does NOT protect against abuse
