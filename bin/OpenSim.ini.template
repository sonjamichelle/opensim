[Wind]
	;; ------------------------------------------------------------------
	;; WIND SYSTEM  (ENVIRONMENTAL PHYSICS & IMMERSION)
	;; ------------------------------------------------------------------
	;;
	;; The wind system controls environmental airflow used by:
	;;
	;;    llWind-enabled scripts
	;;    Flags, sails, foliage, particle effects
	;;    Aircraft, balloons, and flight systems
	;;    Any content designed to respond to environmental forces
	;;
	;; IMPORTANT REALITY:
	;; Wind is NOT just visual ambience.
	;; It is a SIMULATED ENVIRONMENTAL FORCE.
	;;
	;; Poor defaults have led many grids to treat wind as meaningless,
	;; which breaks the original intent of llWind-aware content.
	;;
	;; For immersive grids, RANDOM wind is NOT sufficient.
	;;

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Enables the wind simulation module.
	;;
	;; true  = Wind data is generated and exposed to scripts
	;; false = Wind is always zero
	;;
	;; NOTE:
	;; Disabling wind breaks all llWind-based content.
	;;
	enabled = true

	;; --------------------------------------------------
	;; wind_update_rate
	;; --------------------------------------------------
	;;
	;; Controls how often wind values are recalculated.
	;;
	;; Value is expressed in WORLD FRAMES.
	;; Approximate simulation rate: ~50 frames per second.
	;;
	;; EXAMPLES:
	;;   50   = Update every second
	;;   150  = Update every ~3 seconds (default)
	;;   300  = Update every ~6 seconds
	;;
	;; LOWER VALUES:
	;;    More responsive wind
	;;    Better for flight, sails, storms
	;;    Higher CPU cost
	;;
	;; HIGHER VALUES:
	;;    Slower wind changes
	;;    More stable ambience
	;;    Lower CPU cost
	;;
	;; RECOMMENDED:
	;;    100–200 for immersive environments
	;;    Lower for dynamic weather regions
	;;
	wind_update_rate = 150

	;; --------------------------------------------------
	;; wind_plugin
	;; --------------------------------------------------
	;;
	;; Selects the wind simulation model.
	;;
	;; AVAILABLE PLUGINS:
	;;
	;;   SimpleRandomWind
	;;      Default
	;;      Randomized, non-directional
	;;      Suitable ONLY for light ambience
	;;
	;;   ConfigurableWind
	;;      Deterministic base wind
	;;      Directional airflow
	;;      Supports gusts and variability
	;;      REQUIRED for immersive environments
	;;
	;; CRITICAL NOTE:
	;; SimpleRandomWind breaks the *intent* of llWind-enabled objects
	;; by providing directionless noise instead of airflow.
	;;
	;; RECOMMENDED DEFAULT FOR IMMERSIVE GRIDS:
	;;   ConfigurableWind
	;;
	;wind_plugin = SimpleRandomWind
	wind_plugin = ConfigurableWind

	;; ==================================================================
	;; CONFIGURABLE WIND PARAMETERS
	;; ==================================================================
	;;
	;; These settings apply ONLY when using ConfigurableWind.
	;;
	;; They define a BASELINE airflow that can be:
	;;    Calm
	;;    Steady
	;;    Gusty
	;;    Storm-like
	;;
	;; This allows wind to feel:
	;;    Intentional
	;;    Environmental
	;;    Region-specific
	;;

	;; --------------------------------------------------
	;; avg_strength
	;; --------------------------------------------------
	;;
	;; Average wind strength.
	;;
	;; Typical values:
	;;   0.0  = Dead calm
	;;   1.0  = Light breeze
	;;   5.0  = Strong wind
	;;   10+  = Storm conditions
	;;
	avg_strength = 3.0

	;; --------------------------------------------------
	;; avg_direction
	;; --------------------------------------------------
	;;
	;; Average wind direction in RADIANS.
	;;
	;; 0.0   = East
	;; π/2   = North
	;; π     = West
	;; 3π/2  = South
	;;
	;; NOTE:
	;; Direction matters for sails, aircraft, flags, etc.
	;;
	avg_direction = 0.0

	;; --------------------------------------------------
	;; var_strength
	;; --------------------------------------------------
	;;
	;; Variability of wind strength.
	;;
	;; 0.0 = Constant wind
	;; >0  = Gusts and lulls
	;;
	var_strength = 1.0

	;; --------------------------------------------------
	;; var_direction
	;; --------------------------------------------------
	;;
	;; Variability of wind direction.
	;;
	;; Allows wind to shift over time.
	;;
	var_direction = 90.0

	;; --------------------------------------------------
	;; rate_change
	;; --------------------------------------------------
	;;
	;; Controls how quickly wind changes over time.
	;;
	;; Lower values:
	;;    Slow, smooth transitions
	;;
	;; Higher values:
	;;    Rapid gusts
	;;    Turbulence
	;;
	rate_change = 1.0

	;; ==================================================================
	;; SIMPLERANDOMWIND PARAMETERS (LEGACY / AMBIENCE ONLY)
	;; ==================================================================

	;; --------------------------------------------------
	;; strength
	;; --------------------------------------------------
	;;
	;; Overall wind strength for SimpleRandomWind.
	;;
	;; 0.0 = No wind
	;; 1.0 = Default
	;;
	;; NOTE:
	;; This does NOT create directional airflow.
	;; It is randomized noise.
	;;
	;strength = 1.0

	;; ==================================================================
	;; DESIGN NOTE & FUTURE DIRECTION
	;; ==================================================================
	;;
	;; CURRENT LIMITATION:
	;; Wind configuration is grid-wide only.
	;;
	;; THIS BREAKS IMMERSION.
	;;
	;; REQUIRED TODO:
	;;    Support Estate-level wind presets
	;;    Support Region-level overrides
	;;
	;; USE CASES:
	;;    Open seas with variable winds and gusts
	;;    Storm regions (hurricanes, squalls)
	;;    Zero-wind environments (space, vacuum)
	;;    Flight challenge regions
	;;    Calm urban or indoor regions
	;;
	;; ------------------------------------------------------------------
	;; LONG-TERM TODO: REAL WEATHER SYSTEM
	;; ------------------------------------------------------------------
	;;
	;; Wind should be part of a larger environmental model:
	;;
	;;    Dynamic weather patterns
	;;    Cloud systems (not prim fakery)
	;;    Precipitation tied to physics and wind
	;;    Storm fronts and pressure systems
	;;    Day/night cycle integration
	;;
	;; GOAL:
	;; Replace scripted fake weather with SIMULATED ENVIRONMENTAL PHYSICS.
	;;
	;; Wind is the foundation.
	;;

[Trees]
	;; ------------------------------------------------------------------
	;; TREE SYSTEM  (PROCEDURAL VEGETATION / LEGACY)
	;; ------------------------------------------------------------------
	;;
	;; NOTE: This system is not a replacement for curated landscaping.
	;;
	;; This module implements a BASIC procedural tree system.
	;;
	;; IMPORTANT CONTEXT:
	;; This is NOT a landscaping system.
	;; This is NOT intended to replace curated builds.
	;;
	;; Historically, this module attempted to provide:
	;;    Automatically placed trees
	;;    Optional growth over time
	;;    Minimal environmental variation
	;;
	;; IN PRACTICE:
	;;    Rarely used
	;;    Almost never enabled in production
	;;    Superseded by hand-built landscaping
	;;
	;; Most grids (SL, InWorldz, Halcyon, OpenSim) do NOT use this.
	;;

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Enables the tree system.
	;;
	;; true  = Tree module loaded
	;; false = Tree system disabled
	;;
	;; NOTE:
	;; Even when enabled, trees do NOTHING unless active_trees is true
	;; or trees are explicitly spawned.
	;;
	enabled = false

	;; --------------------------------------------------
	;; active_trees
	;; --------------------------------------------------
	;;
	;; Controls whether trees are DYNAMICALLY MODIFIED over time.
	;;
	;; true  = Trees may be:
	;;            Created
	;;            Deleted
	;;            Modified
	;;            Grown
	;;
	;; false = Trees remain static
	;;
	;; REALITY:
	;;    Dynamic tree behavior has seen almost no real-world use
	;;    Visual results are crude compared to curated content
	;;
	;; SAFE DEFAULT:
	;;   false
	;;
	active_trees = false

	;; --------------------------------------------------
	;; update_rate
	;; --------------------------------------------------
	;;
	;; Interval (milliseconds) at which the tree system runs updates.
	;;
	;; Lower values:
	;;    More frequent changes
	;;    Higher CPU and network load
	;;
	;; Higher values:
	;;    Slower changes
	;;    Reduced overhead
	;;
	;; NOTE:
	;; This timer applies to ALL active trees.
	;;
	update_rate = 1000

	;; --------------------------------------------------
	;; allowGrow
	;; --------------------------------------------------
	;;
	;; Enables tree growth over time.
	;;
	;; WARNING: EXTREMELY DANGEROUS
	;;
	;; WHY:
	;; Tree growth causes OBJECT UPDATES to be broadcast.
	;;
	;; NETWORK COST FORMULA (APPROXIMATE):
	;;   NumberOfTrees × NumberOfAvatars × (1000 / update_rate)
	;;
	;; RESULT:
	;;    Massive UDP traffic
	;;    Viewer lag
	;;    Simulator congestion
	;;
	;; THIS IS WHY NO GRID USES THIS FEATURE.
	;;
	;; RECOMMENDED:
	;;   false (ALWAYS, unless you know exactly what you are doing)
	;;
	allowGrow = false

	;; ==================================================================
	;; REALITY CHECK
	;; ==================================================================
	;;
	;; This system does NOT:
	;;    Produce realistic trees
	;;    Replace hand-built landscaping
	;;    Integrate with wind or weather
	;;    Respect artistic intent
	;;
	;; For curated environments:
	;;    Static meshes
	;;    Hand-placed foliage
	;;    Scripted effects
	;;
	;; Are vastly superior.
	;;

	;; ==================================================================
	;; PLAUSIBLE MODERN USE CASE  (EXPERIMENTAL)
	;; ==================================================================
	;;
	;; The ONLY realistic future use for this system is:
	;;
	;;    Procedural / endless landscapes
	;;    Dynamically spawned regions
	;;    Large-scale exploration worlds
	;;
	;; CONDITIONS REQUIRED:
	;;    Region streaming or on-demand instancing
	;;    Persistence-aware object generation
	;;    Seed regions for boundary consistency
	;;    Server-side authority over placement
	;;
	;; WITHOUT THESE:
	;;   This system should remain disabled.
	;;

	;; ==================================================================
	;; FUTURE TODO (NON-TRIVIAL)
	;; ==================================================================
	;;
	;; If this system is ever revived, it MUST:
	;;
	;;    Be redesigned for procedural region generation
	;;    Decouple growth from per-avatar network updates
	;;    Integrate with wind and weather systems
	;;    Support deterministic seeding for persistence
	;;    Operate at region lifecycle boundaries, NOT live ticks
	;;
	;; OTHERWISE:
	;;   This remains legacy experimental code.
	;;

[VectorRender]
	;; ------------------------------------------------------------------
	;; VECTOR TEXT RENDERING  (SERVER-SIDE TEXT  TEXTURE)
	;; ------------------------------------------------------------------
	;;
	;; IMPORTANT:
	;; This section controls SERVER-SIDE text rendering only.
	;;
	;; It does NOT affect:
	;;    Viewer UI text
	;;    Chat
	;;    Hover text (llSetText)
	;;    Name tags
	;;    Viewer accessibility settings
	;;
	;; VectorRender is used ONLY when the simulator itself renders
	;; text into textures, such as:
	;;
	;;    osSetDynamicTextureData()
	;;    Scripted signs and displays
	;;    HUDs that use server-generated text
	;;
	;; In these cases, the server:
	;;    Chooses the font
	;;    Renders the text
	;;    Sends a bitmap texture to the viewer
	;;
	;; The viewer CANNOT override this font.
	;; Accessibility options DO NOT apply.
	;;

	; --------------------------------------------------
	;; font_name
	;; --------------------------------------------------
	;;
	;; Specifies the SYSTEM FONT used by the server when
	;; rendering text into textures.
	;;
	;; This must be:
	;;    Installed on the server OS
	;;    Accessible to the OpenSim process
	;;
	;; DEFAULT:
	;;   Arial
	;;
	;; RISKS:
	;;    Missing glyphs for non-Latin languages
	;;    Poor readability at small sizes
	;;    No viewer-side font scaling
	;;
	;; ACCESSIBILITY NOTE:
	;;   Server-rendered text is inherently LESS accessible
	;;   than viewer-native text.
	;;
	;; RECOMMENDED:
	;;    Use fonts with wide Unicode coverage
	;;    Avoid using server-rendered text for critical UI
	;;    Prefer viewer-native text whenever possible
	;;
	; font_name = "Arial"
	;;
	;; NOTE:
	;; Procedural worlds do not justify server-side bitmap text.
	;; Seeded persistence makes this system obsolete.
	;;
	;; STATUS:
	;; Legacy / Historical / Dead Code.
	;;
	;; This feature provides no meaningful advantage in modern OpenSim
	;; architectures and conflicts with accessibility, scalability,
	;; and persistence goals.
	;;
	;; RECOMMENDED ACTION:
	;; Remove entirely.

[LL-Functions]
	;; THIS SECTION CONTROLS:
	;;    LSL / LL function availability and limits
	;;    Script abuse and grief mitigation
	;;    Geometry, ray casting, and bounding box behavior
	;;    SL protocol compatibility shims
	;;
	;; CRITICAL NOTES:
	;;    ALL flags in this section MUST remain under [LL-Functions]
	;;    Some flags are REQUIRED for OpenSim operation
	;;    Some flags are PARTIALLY implemented
	;;    Some flags exist ONLY for SL compatibility
	;;    Some flags are UNUSED legacy baggage
	;;
	;; DO NOT assume:
	;;    SL defaults are safe
	;;    Commented options are irrelevant
	;;    “Compatibility” equals “required”
	;;
	;; ==================================================================
	;; LSL / LL FUNCTION CONTROLS, LIMITS, AND ENGINE MATH
	;; ==================================================================
	;;
	;; THIS SECTION EXISTS BECAUSE:
	;;    Viewers and scripts assume specific LL function behaviors
	;;    Some LL functions are powerful enough to be abused
	;;    Bounding boxes and ray casting need server-side constants
	;;
	;; HARD RULE:
	;;   DO NOT move ANY of these keys out of [LL-Functions].
	;;   Some are read ONLY from this section. Relocating them can break behavior.
	;;
	;; TAGS USED BELOW:
	;;   PURPOSE      = what this setting controls
	;;   REQUIRED     = whether OpenSim actively uses it today
	;;   RISK         = what can go wrong if set badly
	;;   TUNING       = what kind of values make sense and why
	;;

	;; ------------------------------------------------------------------
	;; ADMIN / GOD FUNCTION GATES
	;; ------------------------------------------------------------------

	; AllowosConsoleCommand
	; PURPOSE:
	;   Intended to allow administrator-owned scripts to execute simulator console commands.
	; REQUIRED:
	;   Not operational in current upstream behavior as commonly deployed. Treated as legacy/stub in many trees.
	; RISK:
	;   If a future tree re-enables it, this becomes a high-risk remote execution surface.
	; TUNING:
	;   Keep false unless you have audited and intentionally implemented a safe command whitelist + auth.
	; NOTE:
	;   Left commented so it cannot accidentally enable on forks that still parse it.
	; AllowosConsoleCommand = false

	; AllowGodFunctions
	; PURPOSE:
	;   Controls whether god-only LL functions are permitted at all.
	;   Example: llSetObjectPermMask() and similar god-only manipulation functions.
	; REQUIRED:
	;   Yes. Script engine permission checks consult this.
	; RISK:
	;   true can increase the blast radius of compromised high-level accounts or mis-assigned UserLevel.
	;   false can break admin tooling or scripted estate maintenance that depends on god LL functions.
	; TUNING:
	;   false on most grids unless you explicitly rely on these functions and you trust your god accounts.
	AllowGodFunctions = false

	;; ------------------------------------------------------------------
	;; LSL EMAIL SAFETY (llEmail)
	;; ------------------------------------------------------------------

	; RestrictEmail
	; PURPOSE:
	;   Restricts llEmail destination handling.
	;   If true: llEmail can only send to the email address bound to the object owner's avatar account.
	;   If false: scripts can send to any address, which is effectively an email relay capability.
	; REQUIRED:
	;   Yes, if EmailModule is enabled and llEmail is used, this gate is enforced.
	; RISK:
	;   false enables spam abuse and can get your host IP or domain reputation burned.
	;   true can break legacy content that expects llEmail to message arbitrary addresses.
	; TUNING:
	;   Public grids: set true.
	;   Private closed grids: false only if you accept the risk and you trust all content creators.
	RestrictEmail = false

	;; ------------------------------------------------------------------
	;; LISTEN ABUSE LIMITS (llListen)
	;; ------------------------------------------------------------------

	; max_listens_per_region
	; PURPOSE:
	;   Hard cap on total active llListen registrations across the entire region.
	; REQUIRED:
	;   Yes. Used to prevent runaway listener spam from crippling event dispatch.
	; RISK:
	;   Too high or unlimited allows grief objects to flood listeners and increase script event load.
	;   Too low breaks legitimate systems: vendors, HUDs, dialog controllers, roleplay meters.
	; TUNING:
	;   0 = unlimited (not recommended on public grids)
	;   Typical ranges:
	;     500 to 2000 for general-purpose regions
	;     Higher only if you know you run many listener-heavy systems and you monitor script time
	max_listens_per_region = 1000

	; max_listens_per_script
	; PURPOSE:
	;   Hard cap on llListen registrations per individual script instance.
	; REQUIRED:
	;   Yes.
	; RISK:
	;   Too high enables a single malicious script to allocate many listeners.
	;   Too low breaks multi-channel dialog systems and complex controllers.
	; TUNING:
	;   0 = unlimited (not recommended)
	;   Typical ranges:
	;     32 to 128
	max_listens_per_script = 64

	;; ------------------------------------------------------------------
	;; EXTERNAL URL LIMITS (llRequestURL / llRequestSecureURL)
	;; ------------------------------------------------------------------

	; max_external_urls_per_simulator
	; PURPOSE:
	;   Caps the number of external script-accessible HTTP callback endpoints that can exist at once
	;   across the simulator instance.
	; REQUIRED:
	;   Yes, if script URL features are enabled and used.
	; RISK:
	;   Too high allows exhaustion of ports and handler tables, and enables denial of service patterns.
	;   Too low breaks legitimate callback systems: vendors, webhooks, OAuth style flows, controllers.
	; TUNING:
	;   Typical ranges:
	;     50 to 300 on small grids
	;     Higher only if you run heavy callback-based systems and you monitor handler counts
	max_external_urls_per_simulator = 100

	;; ------------------------------------------------------------------
	;; BOUNDING BOX CALCULATION (llGetBoundingBox and engine math)
	;; ------------------------------------------------------------------

	; UseSimpleBoxesInGetBoundingBox
	; PURPOSE:
	;   Controls how llGetBoundingBox computes bounds for complex shapes.
	;   If true, uses simple prim-size boxes instead of meshed geometry for prims, sculpts, and mesh.
	; REQUIRED:
	;   Yes. Affects the computation path.
	; RISK:
	;   true can make bounds wrong, sometimes very wrong, which breaks scripted rez logic, sensors,
	;   collision avoidance, raycast targeting, and some physics assumptions.
	;   false costs more CPU for complex scenes when many scripts call llGetBoundingBox frequently.
	; TUNING:
	;   false is the safe default for correctness.
	;   true only if you have measured CPU pressure specifically from bounding box calls and accept inaccuracy.
	UseSimpleBoxesInGetBoundingBox = false

	; AddStatsInGetBoundingBox
	; PURPOSE:
	;   Adds an additional statistics vector to llGetBoundingBox return values.
	;   That vector includes counts such as objects or groups, parts, and vertices rendered.
	; REQUIRED:
	;   No for normal operation. Used for diagnostics and advanced scripted profiling.
	; RISK:
	;   Enabling can change script expectations if scripts assume a fixed return size.
	;   Also exposes scene complexity info to scripts.
	; TUNING:
	;   Keep false unless you are explicitly using the extra vector in your tooling.
	AddStatsInGetBoundingBox = false

	;; ------------------------------------------------------------------
	;; AVATAR BOUNDING BOX CONSTANTS (server-side collision and script math)
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   These constants and coefficients define the server-side avatar bounding extents in different postures.
	;;   They impact:
	;;      llGetBoundingBox return values for avatars
	;;      llCastRay hit geometry (especially when avatar capsules are involved)
	;;      various internal culling and collision approximations
	;;
	;; REQUIRED:
	;;   Yes. They are used as part of engine math.
	;;
	;; RISK:
	;;   Changing these can cause:
	;;      avatars to be targetable incorrectly
	;;      ray casts to miss or hit when they should not
	;;      physics and collision anomalies
	;;
	;; TUNING:
	;;   Treat as engine constants. Do not change unless you are doing a controlled physics math project.

	; Standing posture constants and coefficients
	LowerAvatarBoundingBoxStandingXconst = -0.275    ; PURPOSE: left extent X constant when standing
	UpperAvatarBoundingBoxStandingXconst =  0.275    ; PURPOSE: right extent X constant when standing
	LowerAvatarBoundingBoxStandingYconst = -0.35     ; PURPOSE: back extent Y constant when standing
	UpperAvatarBoundingBoxStandingYconst =  0.35     ; PURPOSE: front extent Y constant when standing
	LowerAvatarBoundingBoxStandingZconst = -0.1      ; PURPOSE: base Z constant when standing
	LowerAvatarBoundingBoxStandingZcoeff = -0.5      ; PURPOSE: base Z scaled by avatar height when standing
	UpperAvatarBoundingBoxStandingZconst =  0.1      ; PURPOSE: top Z constant when standing
	UpperAvatarBoundingBoxStandingZcoeff =  0.5      ; PURPOSE: top Z scaled by avatar height when standing

	; Ground-sitting posture constants and coefficients
	LowerAvatarBoundingBoxGroundsittingXconst = -0.3875  ; PURPOSE: left extent X constant when ground-sitting
	UpperAvatarBoundingBoxGroundsittingXconst =  0.3875  ; PURPOSE: right extent X constant when ground-sitting
	LowerAvatarBoundingBoxGroundsittingYconst = -0.5     ; PURPOSE: back extent Y constant when ground-sitting
	UpperAvatarBoundingBoxGroundsittingYconst =  0.5     ; PURPOSE: front extent Y constant when ground-sitting
	LowerAvatarBoundingBoxGroundsittingZconst = -0.05    ; PURPOSE: base Z constant when ground-sitting
	LowerAvatarBoundingBoxGroundsittingZcoeff = -0.375   ; PURPOSE: base Z scaled by avatar height when ground-sitting
	UpperAvatarBoundingBoxGroundsittingZconst =  0.5     ; PURPOSE: top Z constant when ground-sitting
	UpperAvatarBoundingBoxGroundsittingZcoeff =  0.0     ; PURPOSE: top Z scaled by avatar height when ground-sitting

	; Sitting posture constants and coefficients
	LowerAvatarBoundingBoxSittingXconst = -0.5875    ; PURPOSE: left extent X constant when sitting
	UpperAvatarBoundingBoxSittingXconst =  0.1875    ; PURPOSE: right extent X constant when sitting
	LowerAvatarBoundingBoxSittingYconst = -0.35      ; PURPOSE: back extent Y constant when sitting
	UpperAvatarBoundingBoxSittingYconst =  0.35      ; PURPOSE: front extent Y constant when sitting
	LowerAvatarBoundingBoxSittingZconst = -0.35      ; PURPOSE: base Z constant when sitting
	LowerAvatarBoundingBoxSittingZcoeff = -0.375     ; PURPOSE: base Z scaled by avatar height when sitting
	UpperAvatarBoundingBoxSittingZconst = -0.25      ; PURPOSE: top Z constant when sitting
	UpperAvatarBoundingBoxSittingZcoeff =  0.25      ; PURPOSE: top Z scaled by avatar height when sitting

	;; ------------------------------------------------------------------
	;; PRIM BOUNDING BOX SAFETY COEFFICIENTS (tortured prim worst cases)
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Safety multipliers used to avoid under-estimating bounding boxes for twisted, sheared, or tortured prims.
	;; REQUIRED:
	;;   Yes.
	;; RISK:
	;;   Lowering can cause under-sized bounds which breaks ray hits, collisions, and scripted spatial logic.
	;;   Raising increases conservative bounds which can slightly reduce precision in some script math.
	;; TUNING:
	;;   Treat as math constants. Do not change without a controlled test suite.

	PrimBoundingBoxSafetyCoefficientX = 2.414214  ; PURPOSE: safety factor for X bounds worst-case twisted/sheared
	PrimBoundingBoxSafetyCoefficientY = 2.414214  ; PURPOSE: safety factor for Y bounds worst-case twisted/sheared
	PrimBoundingBoxSafetyCoefficientZ = 1.618034  ; PURPOSE: safety factor for Z bounds worst-case tube style shapes

	;; ------------------------------------------------------------------
	;; llCastRay V3 (advanced ray casting, accuracy vs performance)
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Enables and configures a more SL-like llCastRay behavior.
	;;   It can mesh geometry for accuracy, including tortured prims, sculpts, and mesh.
	;;
	;; REQUIRED:
	;;   Optional. Only used if UseLlCastRayV3 = true.
	;;
	;; RISK:
	;;   This can be extremely CPU and memory expensive.
	;;   It can also enable script-based denial of service if you do not tune throttles.
	;;
	;; TUNING PRINCIPLES:
	;;    Keep disabled unless you specifically need V3 behavior
	;;    If enabled, keep hit counts and detail levels conservative
	;;    Use throttles to protect region performance

	UseLlCastRayV3 = false
	; PURPOSE: master switch for llCastRay V3 implementation
	; REQUIRED: no (only when you want V3)
	; RISK: enabling can increase CPU and memory use substantially

	FloatToleranceInLlCastRay = 0.00001
	; PURPOSE: acceptable floating point error tolerance in V3 calculations
	; REQUIRED: only when V3 is enabled
	; RISK: too high can cause incorrect hit resolution, too low can increase compute cost

	FloatTolerance2InLlCastRay = 0.001
	; PURPOSE: distance threshold to treat near-duplicate hits as duplicates
	; REQUIRED: only when V3 is enabled
	; RISK: too low can spam near-duplicates, too high can drop legitimate close hits

	PrimDetailLevelInLlCastRay = 1
	; PURPOSE: detail level for prim meshing used by V3 ray casting
	; VALUES: 0 low, 1 medium, 2 high, 3 highest
	; RISK: higher increases CPU

	SculptDetailLevelInLlCastRay = 1
	; PURPOSE: detail level for sculpt meshing used by V3 ray casting
	; VALUES: 0 low, 1 medium, 2 high, 3 highest
	; RISK: higher increases CPU and memory

	MeshDetailLevelInLlCastRay = 3
	; PURPOSE: detail level for mesh processing used by V3 ray casting
	; VALUES: 0 low, 1 medium, 2 high, 3 highest
	; RISK: higher can be very expensive on mesh-heavy scenes

	AvatarDetailLevelInLlCastRay = 1
	; PURPOSE: detail level of avatar capsule approximation used by V3
	; VALUES: 0 low, 1 medium, 2 high, 3 highest
	; RISK: higher increases CPU, rarely needed

	MaxHitsInLlCastRay = 16
	; PURPOSE: maximum number of hit results returned by V3
	; RISK: higher increases processing and response size

	MaxHitsPerPrimInLlCastRay = 16
	; PURPOSE: cap of hits contributed by a single prim in V3
	; RISK: higher increases worst-case cost in complex geometry

	MaxHitsPerObjectInLlCastRay = 16
	; PURPOSE: cap of hits contributed by a single object or linkset in V3
	; RISK: higher increases worst-case cost

	DetectExitHitsInLlCastRay = false
	; PURPOSE: if true, report intersections on exits from a prim surface as hits
	; RISK: can increase hit counts and CPU, rarely needed

	DoAttachmentsInLlCastRay = false
	; PURPOSE: if true, include attachments in ray testing
	; RISK: can be abused and increases CPU, usually keep false

	ThrottleTimeInMsInLlCastRay = 200
	; PURPOSE: length of throttle window, in milliseconds
	; RISK: too high can make ray scripts feel sluggish, too low allows bursts that hurt sim performance
	; TUNING: 100 to 500 is typical depending on grid load

	AvailableTimeInMsPerRegionInLlCastRay = 40
	; PURPOSE: total region time budget for llCastRay in each throttle window, scaled per 65536 m2
	; RISK: too high steals time from physics and scripts, too low causes RCERR_SIM_PERF_LOW more often

	AvailableTimeInMsPerAvatarInLlCastRay = 10
	; PURPOSE: per-avatar time budget for scripts in attachments or vehicles per throttle window
	; RISK: too high enables personal abuse, too low breaks legitimate vehicle or HUD ray tools

	RequiredAvailableTimeInMsInLlCastRay = 2
	; PURPOSE: minimum remaining time required to accept a new llCastRay call
	; RISK: too low allows overload, too high rejects too aggressively

	MaximumAvailableTimeInMsInLlCastRay = 40
	; PURPOSE: cap on maximum budget to avoid runaway budgets on varregions
	; RISK: raising can cause large regions to allocate excessive ray time

	UseMeshCacheInLlCastRay = true
	; PURPOSE: cache generated meshes for V3 ray casting to reduce repeated meshing cost
	; REQUIRED: only when V3 is enabled
	; RISK: increases memory usage, but usually improves performance on repeated ray calls

[DataSnapshot]
	;; ==================================================================
	;; DATA SNAPSHOT EXPORT (LEGACY SEARCH / METADATA DUMP)
	;; ==================================================================
	;;
	;; WHAT THIS MODULE ACTUALLY DOES:
	;;    Periodically extracts region and parcel metadata
	;;    Writes snapshot files to disk
	;;    Optionally advertises those snapshots to external consumers
	;;
	;; WHAT THIS MODULE DOES NOT DO:
	;;    Provide in-viewer search
	;;    Provide secure or authenticated access
	;;    Provide real-time results
	;;    Integrate with WebUI automatically
	;;
	;; CURRENT REALITY:
	;;    Most historical external search services are gone
	;;    Viewers do NOT consume this data
	;;    XML-RPC-based consumers are largely obsolete
	;;
	;; STATUS:
	;;   LEGACY FEATURE
	;;
	;; SAFE DEFAULT:
	;;   Disabled
	;;
	;; POTENTIAL MODERN REUSE (ADVANCED):
	;;    Offline metadata export
	;;    Internal indexing pipeline
	;;    Custom WebUI ingestion
	;;    Auditing / analytics tooling
	;;
	;; If you are not explicitly consuming these snapshot files,
	;; this module serves no purpose and should remain disabled.
	;;

	;; --------------------------------------------------
	;; index_sims
	;; --------------------------------------------------
	;;
	;; Master enable switch.
	;;
	;; true  = Enable periodic snapshot generation
	;; false = Disable module entirely
	;;
	index_sims = false

	;; --------------------------------------------------
	;; data_exposure
	;; --------------------------------------------------
	;;
	;; Controls how much metadata is exported.
	;;
	;; minimum = Only explicitly searchable content
	;; all     = All region and parcel metadata
	;;
	;; WARNING:
	;;   "all" may expose sensitive or private information.
	;;
	data_exposure = minimum

	;; --------------------------------------------------
	;; gridname
	;; --------------------------------------------------
	;;
	;; Grid identifier embedded in snapshot data.
	;;
	;; Used ONLY in grid mode.
	;; Ignored in standalone mode.
	;;
	gridname = "OSGrid"

	;; --------------------------------------------------
	;; default_snapshot_period
	;; --------------------------------------------------
	;;
	;; Snapshot generation interval, in seconds.
	;;
	;; Examples:
	;;   1200 = 20 minutes (testing)
	;;   3600 = 1 hour (production)
	;;
	default_snapshot_period = 1200

	;; --------------------------------------------------
	;; snapshot_cache_directory
	;; --------------------------------------------------
	;;
	;; Directory where snapshot files are written.
	;;
	;; Relative to bin/ unless absolute path is used.
	;;
	;; Ensure this directory is NOT publicly served unless intentional.
	;;
	snapshot_cache_directory = "DataSnapshot"

	;; --------------------------------------------------
	;; External search consumers (LEGACY)
	;; --------------------------------------------------
	;;
	;; These endpoints historically consumed snapshot metadata.
	;; Most are no longer operational.
	;;
	;; Enable ONLY if you operate your own compatible service.
	;;
	; DATA_SRV_CustomSearch = "https://your-service.example/snapshot-ingest"

	;; TODO:
	;; Replace DataSnapshot with a modern, authenticated metadata export API:
	;;    JSON output
	;;    Token-based access
	;;    WebUI integration
	;;    UserLevel-aware filtering
	;;    Explicit consent and privacy controls
	;;
	;; While this module is legacy, the snapshot files it generates CAN still be
	;; meaningfully consumed without modifying OpenSim core code.
	;;
	;; POSSIBLE CURRENT-DAY USES (NO CORE PATCHING REQUIRED):
	;;    Offline indexing of region/parcel metadata
	;;    Periodic import into external databases
	;;    Read-only WebUI displays (maps, listings, directories)
	;;    Analytics, auditing, or archival purposes
	;;
	;; CAVEATS:
	;;    Data is static (snapshot-based, not real-time)
	;;    No authentication or access control
	;;    No per-user consent model
	;;    Not suitable for public exposure as-is
	;;
	;; IMPORTANT:
	;;   These uses are STOPGAPS only.
	;;
	;; There ARE better, more secure, and more efficient ways to expose this data:
	;;    Authenticated REST APIs
	;;    WebUI-backed queries
	;;    Direct database views with role-based filtering
	;;    Event-driven metadata updates
	;;
	;; GRIDS SHOULD:
	;;    Treat DataSnapshot as a temporary compatibility tool
	;;    Plan and implement a modern replacement
	;;    Migrate consumers away from snapshot-based exports
	;;
	;; DataSnapshot should NOT be expanded or modernized further.
	;; It should eventually be retired once a proper replacement exists.

[Economy]
	;; ==================================================================
	;; ECONOMY SYSTEMS  (LEGACY CORE / THIRD-PARTY REQUIRED)
	;; ==================================================================
	;;
	;; This section controls how OpenSim presents and enforces *economic*
	;; behaviors such as uploads, land sales, object sales, and group creation.
	;;
	;; CRITICAL CONTEXT:
	;; ------------------------------------------------------------------
	;;  OpenSim CORE does NOT implement a real economy.
	;;  The default module exists ONLY to allow in-world mechanics to function.
	;;  ANY real currency handling MUST be provided by third-party modules.
	;;
	;; LEGAL / REGULATORY WARNING:
	;; ------------------------------------------------------------------
	;; Operating a grid economy tied to real-world value MAY trigger:
	;;    Financial regulations
	;;    Consumer protection laws
	;;    Tax reporting requirements
	;;    Anti-money-laundering obligations
	;;
	;; Grid operators assume ALL liability.
	;; Use of real-value currency is ENTIRELY at operator risk.
	;;
	;; RECOMMENDED:
	;; ------------------------------------------------------------------
	;;  Use a third-party provider (e.g., Gloebit) that assumes compliance burden
	;;  Avoid implementing custom real-currency systems unless legally prepared
	;;
	;; ==================================================================
	;; ECONOMY MODULE SELECTION
	;; ==================================================================

	;; economymodule
	;; ------------------------------------------------------------------
	;; Selects which economy module OpenSim will use as the PRIMARY
	;; provider of economic behavior.
	;;
	;; DEFAULT:
	;;   BetaGridLikeMoneyModule
	;;
	;; CRITICAL BEHAVIOR NOTE:
	;; ------------------------------------------------------------------
	;; This setting is ONLY effective if the specified module:
	;;    Is compiled into the simulator
	;;    Is successfully loaded at startup
	;;    Properly registers itself as the economy provider
	;;
	;; If the specified module FAILS to load:
	;;    OpenSim may silently fall back to BetaGridLikeMoneyModule
	;;    Partial economy behavior may occur
	;;    Viewer UI may become inconsistent or misleading
	;;
	;; THIRD-PARTY MODULE WARNING:
	;; ------------------------------------------------------------------
	;; Many third-party economy systems (e.g. Gloebit-style integrations):
	;;    Do NOT consistently replace this setting
	;;    May override economy behavior internally
	;;    May leave BetaGridLikeMoneyModule active for viewer signaling
	;;
	;; RESULT:
	;;    Two competing economy authorities
	;;    Inconsistent pricing, uploads, and permissions
	;;
	;; OPERATOR REQUIREMENT:
	;; ------------------------------------------------------------------
	;; When enabling a third-party economy:
	;;   1. Confirm whether it REQUIRES this value to change
	;;   2. Confirm whether it OVERRIDES this value internally
	;;   3. Confirm viewer-facing costs match backend enforcement
	;;   4. Test uploads, land sales, and scripted vendors
	;;
	;; DO NOT assume consistency.
	;; VERIFY behavior.
	;;
	;; PURPOSE OF THIS SETTING:
	;; ------------------------------------------------------------------
	;;  Defines viewer-facing economic expectations
	;;  Enables uploads, object transfers, land mechanics
	;;
	;; THIS DOES NOT:
	;; ------------------------------------------------------------------
	;;  Provide real currency handling
	;;  Provide fraud protection
	;;  Provide auditing
	;;
	;; DO NOT confuse this with a real economy.
	;;
	; economymodule = BetaGridLikeMoneyModule

	;; ==================================================================
	;; BASIC ECONOMY FLAGS (BETA MODULE ONLY)
	;; ==================================================================

	;; SellEnabled
	;; ------------------------------------------------------------------
	;; Allows objects to be sold for L$0-style prices.
	;;
	;; EFFECT:
	;;    Enables "Buy" interactions with zero cost
	;;    Used for vendors, freebies, scripted sales logic
	;;
	;; PITFALL:
	;;    Has NO fraud or abuse controls
	;;    Purely cosmetic without a real economy backend
	;;
	; SellEnabled = true

	;; ==================================================================
	;; UPLOAD / CREATION COSTS
	;; ==================================================================

	;; PriceUpload
	;; ------------------------------------------------------------------
	;; Cost to upload assets (textures, sounds, animations, etc.)
	;;
	;; EFFECT:
	;;    Viewer displays upload cost
	;;    Beta module does NOT enforce real payment
	;;
	;; COMMON USE:
	;;    Set to 0 for free creative grids
	;;    Non-zero ONLY makes sense with real economy backend
	;;
	; PriceUpload = 0

	;; PriceGroupCreate
	;; ------------------------------------------------------------------
	;; Cost to create a group.
	;;
	;; EFFECT:
	;;    Viewer shows creation cost
	;;    No enforcement without real economy module
	;;
	;; NOTE:
	;;    Group spam control is better handled via permissions/user levels
	;;
	; PriceGroupCreate = 0

	;; ==================================================================
	;; LEGACY / VIEWER-EXPECTED ECONOMY VALUES
	;; ==================================================================
	;;
	;; IMPORTANT:
	;; ------------------------------------------------------------------
	;; These values are sent to the viewer.
	;; Many exist ONLY because viewers expect them.
	;;
	;; OpenSim core DOES NOT meaningfully use most of them.
	;;
	;; They originate from Second Life (Agni) defaults.
	;;
	;; Changing them rarely produces meaningful effects.
	;; Some viewers may ignore them entirely.
	;;
	;; USE AT YOUR OWN RISK.

	; ObjectCount = 0
	; PriceEnergyUnit = 0
	; PriceObjectClaim = 0
	; PricePublicObjectDecay = 0
	; PricePublicObjectDelete = 0
	; PriceParcelClaim = 0
	; PriceParcelClaimFactor = 1

	; PriceRentLight = 0
	; TeleportMinPrice = 0
	; TeleportPriceExponent = 2
	; EnergyEfficiency = 1
	; PriceObjectRent = 0
	; PriceObjectScaleFactor = 10
	; PriceParcelRent = 0

	;; ==================================================================
	;; MESH UPLOAD BEHAVIOR (ECONOMY-INDEPENDENT)
	;; ==================================================================
	;;
	;; These settings affect asset handling, NOT currency.
	;; They apply regardless of economy module.

	;; MeshModelAllowTextureToInventory
	;; ------------------------------------------------------------------
	;; When uploading a mesh that references textures:
	;;
	;; false (default):
	;;    Textures are NOT added to inventory
	;;    Only mesh asset is created
	;;
	;; true:
	;;    Texture assets are also added to inventory
	;;
	;; USE CASE:
	;;    Useful for creator workflows
	;;    Can clutter inventory if abused
	;;
	;; NOTE:
	;;    No financial impact by itself
	;;    Independent of economy module
	;;
	; MeshModelAllowTextureToInventory = true

	;; ==================================================================
	;; OPERATOR GUIDANCE SUMMARY
	;; ==================================================================
	;;
	;; SAFE USE:
	;;    Leave BetaGridLikeMoneyModule enabled
	;;    Set all prices to 0
	;;    Use permissions and UserLevel for control
	;;
	;; REAL ECONOMY:
	;;    Use a third-party system (e.g., Gloebit)
	;;    Do NOT roll your own casually
	;;    Understand legal exposure BEFORE enabling
	;;
	;; FUTURE DIRECTION:
	;;    Core OpenSim will NOT implement real currency
	;;    Economy is intentionally externalized
	;;
	;; ==================================================================
	
[Concierge]
	;; ------------------------------------------------------------------
	;; CONCIERGE MODULE  (LEGACY / NICHE / XML-RPC DEPENDENT)
	;; ------------------------------------------------------------------
	;;
	;; ORIGINAL PURPOSE:
	;;   The Concierge module was designed for early OpenSim grids to:
	;;      Send automated welcome messages when avatars enter regions
	;;      Act as a simple "greeter bot" without in-world scripting
	;;      Notify external systems when users enter or leave regions
	;;
	;; HISTORICAL CONTEXT:
	;;    Implemented before:
	;;       - Modern scripted greeters
	;;       - Experience-based onboarding
	;;       - WebUI dashboards
	;;       - Event-driven webhook systems
	;;    Relies on XML-RPC mechanisms that are now deprecated,
	;;     removed, or disabled in many modern environments
	;;
	;; CURRENT REALITY:
	;;    Rarely used on modern grids
	;;    Poorly documented
	;;    Tightly coupled to legacy XML-RPC infrastructure
	;;    No encryption, no authentication beyond shared secrets
	;;    No role-based access control
	;;
	;; In most modern grids, this module provides NO UNIQUE functionality
	;; that cannot be achieved more safely and flexibly via:
	;;    In-world scripted greeters
	;;    Experience tools
	;;    Webhooks / REST services
	;;    WebUI-based onboarding logic
	;;
	;; STATUS:
	;;   LEGACY / NICHE
	;;
	;; RECOMMENDATION:
	;;    KEEP DISABLED on modern production grids
	;;    Do NOT rely on for security, auditing, or automation

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Enables the Concierge module.
	;;
	;; WARNING:
	;;    Enabling this exposes legacy XML-RPC endpoints
	;;    Behavior depends on deprecated subsystems
	;;
	;; Default: false
	;;
	enabled = false

	;; --------------------------------------------------
	;; whoami
	;; --------------------------------------------------
	;;
	;; Name used by the concierge when sending messages.
	;; This is NOT an avatar.
	;; This is a plain text identifier.
	;;
	;; Cosmetic only.
	;;
	;whoami = "jeeves"

	;; --------------------------------------------------
	;; password
	;; --------------------------------------------------
	;;
	;; Shared secret used for XML-RPC updates of welcome templates.
	;;
	;; SECURITY ISSUES:
	;;    Plaintext shared secret
	;;    No hashing
	;;    No per-user authentication
	;;    No TLS enforcement
	;;
	;; DO NOT expose externally.
	;;
	;password = SECRET

	;; --------------------------------------------------
	;; regions
	;; --------------------------------------------------
	;;
	;; Regular expression defining which regions are "concierged".
	;;
	;; Empty string ("") means ALL regions.
	;;
	;; Example:
	;;   regions = "^Welcome-|^Landing-"
	;;
	;; NOTE:
	;;    Regex is evaluated on region NAME
	;;    Renaming regions can silently break behavior
	;;
	;regions = ""

	;; --------------------------------------------------
	;; welcomes
	;; --------------------------------------------------
	;;
	;; Path to directory containing welcome message templates.
	;;
	;; Templates support positional substitution:
	;;   {0} = Avatar name
	;;   {1} = Region name
	;;   {2} = Concierge name (whoami)
	;;
	;; Example template content:
	;;   "Welcome {0} to {1}! Please see {2} if you need help."
	;;
	;; LIMITATIONS:
	;;    Static text only
	;;    No localization support
	;;    No conditional logic
	;;
	;; In-world scripted greeters are FAR more capable.
	;;
	;welcomes = /path/to/welcome/template/directory

	;; --------------------------------------------------
	;; broker
	;; --------------------------------------------------
	;;
	;; Optional external notification endpoint.
	;;
	;; When enabled, the concierge sends entry/exit events
	;; for avatars entering or leaving concierged regions.
	;;
	;; Substitution variables:
	;;   {0} = Region name
	;;   {1} = Region UUID
	;;
	;; Example:
	;;   broker = "https://example.com/events/{1}"
	;;
	;; MAJOR CAVEATS:
	;;    No authentication beyond obscurity
	;;    No encryption guarantees
	;;    No retry or failure handling
	;;    No rate limiting
	;;
	;; This is NOT a modern webhook system.
	;;
	;broker = "http://broker.place.com/{1}"

	;; ==================================================================
	;; TODO — CONCIERGE MODULE DEPRECATION / REPLACEMENT
	;; ==================================================================
	;;
	;; STATUS:
	;;   Legacy module retained for backward compatibility.
	;;
	;; PROBLEMS:
	;;    Depends on deprecated XML-RPC infrastructure
	;;    No modern authentication or encryption model
	;;    Overlaps entirely with scripted greeters and Experience tools
	;;    Adds attack surface with minimal functional benefit
	;;    Poor observability and no audit logging
	;;
	;; CURRENT RECOMMENDATION:
	;;    Keep disabled on all production grids
	;;
	;; FUTURE ACTION (RECOMMENDED):
	;;    Formally deprecate Concierge module
	;;    Remove XML-RPC dependencies
	;;    Replace with:
	;;       - Event-driven hooks (avatar enter/leave)
	;;       - Authenticated webhook emitters
	;;       - WebUI / service-based notification pipeline
	;;       - UserLevel-aware policy controls
	;;
	;; DESIGN NOTE:
	;;   Modern grids should NOT rely on simulator-side
	;;   greeting or notification logic without authentication,
	;;   encryption, and centralized control.
	;; ==================================================================

[Hypergrid]
    ;; ------------------------------------------------------------------
    ;; safemode   (ADVANCED / NON-TURNKEY / MISUNDERSTOOD)
    ;; ------------------------------------------------------------------
    ;;
    ;; SUMMARY
    ;; -------
    ;; safemode is NOT a general Hypergrid security feature.
    ;; It is a PARTIAL, EXPERIMENTAL policy hook intended for CLOSED,
    ;; TRUSTED Hypergrid ecosystems with custom infrastructure.
    ;;
    ;; This flag is widely misunderstood and frequently misused.
    ;;
    ;; ------------------------------------------------------------------
    ;; WHAT THIS IS
    ;; ------------------------------------------------------------------
    ;;
    ;; When enabled, safemode alters how inventory is handled when avatars
    ;; travel across Hypergrid boundaries, with the intent of limiting
    ;; asset exposure outside a controlled trust domain.
    ;;
    ;; It was designed around assumptions that are NOT true for
    ;; standard OpenSim deployments.
    ;;
    ;; ------------------------------------------------------------------
    ;; WHAT THIS IS *NOT*
    ;; ------------------------------------------------------------------
    ;;
    ;; safemode is NOT:
    ;;    A turnkey security feature
    ;;    A complete inventory protection mechanism
    ;;    A substitute for permissions, CAPS filtering, or asset policy
    ;;    Safe to enable on public or open Hypergrid grids
    ;;
    ;; Core OpenSim does NOT implement the protections people assume
    ;; this flag provides.
    ;;
    ;; ------------------------------------------------------------------
    ;; VALID (BUT RARE) USE CASES
    ;; ------------------------------------------------------------------
    ;;
    ;; safemode MAY be appropriate ONLY if ALL of the following are true:
    ;;
    ;;    All participating grids are operated by the SAME organization
    ;;     or by explicitly trusted partners
    ;;
    ;;    The Hypergrid topology is CLOSED, not public
    ;;
    ;;    Inventory export across grid boundaries is intentionally restricted
    ;;
    ;;    Users are governed by institutional policy (not casual accounts)
    ;;
    ;;    A custom or tightly controlled viewer configuration is in use
    ;;
    ;; Example environments where this *could* make sense:
    ;;
    ;;    Multi-campus university systems (statewide or international)
    ;;    Corporate or industrial training grids
    ;;    Government / defense training environments (MOSES-style)
    ;;    Research or simulation labs with strict asset controls
    ;;
    ;; ------------------------------------------------------------------
    ;; HARD REQUIREMENTS (NOT PROVIDED BY OPENSIM CORE)
    ;; ------------------------------------------------------------------
    ;;
    ;; Enabling safemode WITHOUT the following WILL cause user breakage:
    ;;
    ;;    A SPECIALIZED or controlled viewer that understands safemode semantics
    ;;    Server-side inventory and asset authorization logic
    ;;    Explicit grid-to-grid trust enforcement
    ;;    Clear user-facing policy and documentation
    ;;
    ;; Standard public viewers DO NOT fully support this mode.
    ;;
    ;; ------------------------------------------------------------------
    ;; OPERATOR WARNING
    ;; ------------------------------------------------------------------
    ;;
    ;; Enabling safemode on a normal or public Hypergrid WILL:
    ;;    Break inventory access
    ;;    Confuse users
    ;;    Create false expectations of security
    ;;    Increase support and recovery workload
    ;;
    ;; This flag does NOT prevent asset theft and does NOT harden the grid.
    ;;
    ;; ------------------------------------------------------------------
    ;; CURRENT STATUS
    ;; ------------------------------------------------------------------
    ;;
    ;;    Experimental
    ;;    Incomplete
    ;;    Effectively unusable for general-purpose production grids
    ;;
    ;; ------------------------------------------------------------------
    ;; RECOMMENDATION
    ;; ------------------------------------------------------------------
    ;;
    ;; Public grids:            KEEP FALSE
    ;; Closed institutional:    Evaluate carefully
    ;; Custom deployments:      Requires additional code and tooling
    ;;
    ;; ------------------------------------------------------------------
    ;; TODO (FUTURE DIRECTION)
    ;; ------------------------------------------------------------------
    ;;
    ;; Either:
    ;;    Remove this flag entirely
    ;; OR:
    ;;    Redesign Hypergrid security around:
    ;;       - Explicit inventory scoping
    ;;       - Capability-based permissions
    ;;       - UserLevel-aware access rules
    ;;       - Auditable asset transfer paths
    ;;
    safemode = false

	;; ==================================================================
	;; VOICE SERVICES  (EXTERNAL DEPENDENCY / OPERATOR RISK AREA)
	;; ==================================================================
	;;
	;; IMPORTANT CONTEXT
	;; -----------------
	;; Voice in OpenSim is NOT implemented natively.
	;; All voice solutions rely on THIRD-PARTY SERVICES.
	;;
	;; This introduces:
	;;    External licensing risk
	;;    Infrastructure cost
	;;    Long-term availability uncertainty
	;;
	;; Operators should treat voice as OPTIONAL and NON-CORE.
	;;
	
[FreeSwitchVoice]
	;; ==================================================================
	;; FreeSWITCH Voice
	;; ==================================================================
	;;
	;; STATUS:
	;;    Open-source
	;;    Self-hosted
	;;    Actively maintained (outside OpenSim)
	;;
	;; WHAT IT IS:
	;;   FreeSWITCH is a SIP-based PBX / VoIP platform.
	;;   OpenSim integrates with it to provide spatial voice.
	;;
	;; WHAT THIS MEANS IN PRACTICE:
	;;    You are running a REAL VoIP system
	;;    You are responsible for uptime, scaling, security
	;;    This is NOT a "flip the switch" feature
	;;
	;; REQUIREMENTS:
	;;    Dedicated FreeSWITCH server (recommended)
	;;    Proper SIP configuration
	;;    Adequate CPU, memory, and bandwidth
	;;    Firewall/NAT awareness
	;;
	;; SCALE CONSIDERATIONS:
	;;    Hobby grids: possible but fragile
	;;    Medium grids: dedicated VM strongly advised
	;;    Large grids: serious infrastructure planning required
	;;
	;; PROS:
	;;    No licensing lock-in
	;;    Full operator control
	;;    Viable long-term option
	;;
	;; CONS:
	;;    Operational complexity
	;;    Requires VoIP knowledge
	;;    Infrastructure cost
	;;
	;; COMMON USE CASES:
	;;    Institutional grids (MOSES-style)
	;;    Corporate training environments
	;;    Long-term sustainability focused grids
	;;
	;; DOCUMENTATION:
	;;   https://opensimulator.org/wiki/Freeswitch_Module
	;;

	;; Enable FreeSWITCH voice support
	; Enabled = false

	;; Service module selection:
	;; Standalone:
	; LocalServiceModule = OpenSim.Services.FreeswitchService.dll:FreeswitchService
	;;
	;; Grid / remote:
	; LocalServiceModule = OpenSim.Services.Connectors.dll:RemoteFreeswitchConnector

	;; Remote FreeSWITCH service URL (grid mode)
	; FreeswitchServiceURL = http://my.grid.server:8004/fsapi

[VivoxVoice]
	;; ==================================================================
	;; Vivox Voice
	;; ==================================================================
	;;
	;; STATUS:
	;;    Proprietary
	;;    Third-party hosted
	;;    Licensing-controlled
	;;
	;; HISTORICAL CONTEXT:
	;;   Vivox has been the de facto voice provider for SL and OpenSim.
	;;   Many OpenSim grids use grandfathered Vivox accounts.
	;;
	;; CURRENT REALITY:
	;;    Vivox has announced OpenSim support deprecation
	;;    Support may become subscription-based or removed without notice
	;;    Even grandfathered accounts are NOT guaranteed indefinitely
	;;
	;; OPERATOR RISK:
	;;    Single-vendor dependency
	;;    No self-hosting option
	;;    No migration guarantees
	;;
	;; PROS:
	;;    Minimal infrastructure burden
	;;    Mature spatial voice
	;;    Works with standard viewers
	;;
	;; CONS:
	;;    Vendor lock-in
	;;    Uncertain future
	;;    Potential sudden service loss
	;;
	;; OPERATOR ADVICE:
	;;    Do NOT rely on Vivox as a long-term guarantee
	;;    Have a contingency plan (FreeSWITCH or voice-free operation)
	;;

	;; Enable Vivox voice support
	enabled = false

	;; Vivox service endpoints
	vivox_server = www.foobar.vivox.com
	vivox_sip_uri = foobar.vivox.com

	;; Vivox admin credentials (provided by Vivox)
	vivox_admin_user = DeepThroat
	vivox_admin_password = VoiceG4te

	;; Channel type:
	;;   positional = spatial audio (default)
	;;   channel    = non-spatial conference-style
	; vivox_channel_type = positional

	;; Distance attenuation model:
	;;   0 = none
	;;   1 = inverse
	;;   2 = linear (default)
	;;   3 = exponential
	; vivox_channel_distance_model = 2

	;; Channel interaction mode:
	;;   open          = free speaking
	;;   lecture       = moderated
	;;   presentation  = speaker-focused
	;;   auditorium    = strict audience separation
	; vivox_channel_mode = "open"

	;; Attenuation roll-off rate (1.0–4.0)
	; vivox_channel_roll_off = 2.0

	;; Maximum audible distance (meters)
	; vivox_channel_max_range = 80

	;; Distance before attenuation begins
	; vivox_channel_clamping_distance = 10

	;; ==================================================================
	;; VIABLE ALTERNATIVES & TODOs
	;; ==================================================================
	;;
	;; MUMBLE (FREQUENTLY REQUESTED):
	;; ------------------------------
	;;    Client/server voice system (TeamSpeak-style)
	;;    NOT spatial by default
	;;    No native OpenSim integration
	;;    Would require:
	;;       - Custom viewer changes
	;;       - Server-side position bridging
	;;       - Authentication integration
	;;
	;; CURRENT STATUS:
	;;    Not implemented
	;;    Non-trivial engineering effort
	;;    Not a drop-in replacement
	;;
	;; TODO (FUTURE DIRECTION):
	;; -----------------------
	;;    Evaluate modern WebRTC-based spatial voice
	;;    Investigate external spatial audio engines
	;;    Consider voice as an optional pluggable service
	;;    Decouple viewer expectations from specific vendors
	;;
	;; OPERATOR REALITY CHECK:
	;; -----------------------
	;; Many successful grids operate with:
	;;    Voice disabled entirely
	;;    Text + Discord/Matrix/Zoom for events
	;;
	;; Voice is NOT a requirement for a healthy grid.

[Groups]

    ;; ------------------------------------------------------------------
    ;; GROUPS  (PERMISSIONS, COMMUNICATION, GOVERNANCE)
    ;; ------------------------------------------------------------------
    ;;
    ;; Groups are a CORE subsystem used by:
    ;;    Parcel and region permissions
    ;;    Object sharing and vendor access
    ;;    Role-based governance
    ;;    Group notices and messaging
    ;;
    ;; Groups are NOT just "chat".
    ;;
    ;; When misunderstood or left untuned, groups gain a reputation for:
    ;;    Spam
    ;;    Griefing vectors
    ;;    Unwanted mass messaging
    ;;
    ;; When configured intentionally, groups can be:
    ;;    A powerful permissions backbone
    ;;    A targeted communication channel
    ;;    A structured internal organization system
    ;;
    ;; ------------------------------------------------------------------
    ;; ENABLE GROUPS
    ;; ------------------------------------------------------------------
    ;;
    ;; Master switch for group functionality.
    ;;
    ;; false:
    ;;    No group permissions
    ;;    No group roles
    ;;    No group messaging or notices
    ;;
    ;; true:
    ;;    Enables group-based land, object, and role permissions
    ;;
    Enabled = false

    ;; ------------------------------------------------------------------
    ;; GROUPS MODULE SELECTION
    ;; ------------------------------------------------------------------
    ;;
    ;; Default:
    ;;   Default
    ;;
    ;; This is the built-in stub group implementation.
    ;; It supports BASIC group permissions but lacks advanced features.
    ;;
    ;; Flotsam GroupsModule:
    ;;    External XML-RPC based backend
    ;;    Required for full group functionality
    ;;    Adds notices, messaging, roles, membership management
    ;;
    ;; IMPORTANT:
    ;;   Most advanced group features REQUIRE Flotsam or equivalent backend.
    ;;
    Module = Default
    ; Module = GroupsModule

    ;; ------------------------------------------------------------------
    ;; GROUP NOTICES
    ;; ------------------------------------------------------------------
    ;;
    ;; Controls whether group notices are enabled.
    ;;
    ;; Notices are commonly used for:
    ;;    Announcements
    ;;    Event notifications
    ;;    Administrative messaging
    ;;
    ;; Abuse potential exists if unchecked.
    ;; Many grids restrict notice permissions to officers only.
    ;;
    ; NoticesEnabled = true

    ;; ------------------------------------------------------------------
    ;; DEBUGGING
    ;; ------------------------------------------------------------------
    ;;
    ;; Enables verbose logging of group operations.
    ;; Useful ONLY for troubleshooting.
    ;;
    DebugEnabled = false
    DebugMessagingEnabled = false

    ;; ------------------------------------------------------------------
    ;; GROUP DATA CACHING
    ;; ------------------------------------------------------------------
    ;;
    ;; Time (seconds) group data is cached before re-fetching
    ;; from the groups service.
    ;;
    ;; Lower values:
    ;;    More real-time accuracy
    ;;    Higher backend load
    ;;
    ;; Higher values:
    ;;    Reduced backend load
    ;;    Slightly stale membership data
    ;;
    ;; 0 = Disable cache entirely (NOT recommended)
    ;;
    GroupsCacheTimeout = 30

    ;; ------------------------------------------------------------------
    ;; GROUP MESSAGING
    ;; ------------------------------------------------------------------
    ;;
    ;; Controls which messaging module is used for group IMs
    ;; and whether group messaging is enabled.
    ;;
    ;; Group messaging is frequently the source of complaints,
    ;; but is also a powerful support and coordination tool
    ;; when role-restricted.
    ;;
    ; MessagingModule = GroupsMessagingModule
    ; MessagingEnabled = true

    ;; ------------------------------------------------------------------
    ;; MESSAGE DELIVERY OPTIMIZATION
    ;; ------------------------------------------------------------------
    ;;
    ;; Experimental option.
    ;;
    ;; true:
    ;;    Sends group messages only to cached ONLINE users
    ;;    Faster delivery for large groups
    ;;    More presence-service calls
    ;;
    ;; false:
    ;;    Messages sent to all members
    ;;    Offline delivery depends on messaging backend
    ;;
    ;; Flotsam groups only.
    ;;
    MessageOnlineUsersOnly = false

    ;; ------------------------------------------------------------------
    ;; FLOTSAM GROUPS BACKEND (XML-RPC)
    ;; ------------------------------------------------------------------
    ;;
    ;; Required for full group feature set:
    ;;    Roles
    ;;    Notices
    ;;    Group IMs
    ;;    Membership management
    ;;
    ;; NOTE:
    ;;   XML-RPC is LEGACY technology and introduces security
    ;;   and reliability considerations.
    ;;
    ; ServicesConnectorModule = XmlRpcGroupsServicesConnector
    ; GroupsServerURI        = http://yourxmlrpcserver.com/xmlrpc.php

    ;; ------------------------------------------------------------------
    ;; XML-RPC SECURITY KEYS
    ;; ------------------------------------------------------------------
    ;;
    ;; These keys MUST match those configured on the backend
    ;; groups service.
    ;;
    ;; Shared-secret model (legacy).
    ;;
    ; XmlRpcServiceReadKey  = 1234
    ; XmlRpcServiceWriteKey = 1234

    ;; ------------------------------------------------------------------
    ;; HTTP KEEP-ALIVE
    ;; ------------------------------------------------------------------
    ;;
    ;; Disable HTTP keep-alive for XML-RPC requests.
    ;; Only change if you KNOW your backend mishandles keep-alive.
    ;;
    ; XmlRpcDisableKeepAlive = true

    ;; ------------------------------------------------------------------
    ;; GROUP CREATION CONTROL
    ;; ------------------------------------------------------------------
    ;;
    ;; Minimum UserLevel required to create groups.
    ;;
    ;; Common strategies:
    ;;    0   = Anyone can create groups
    ;;    >0  = Restrict to trusted users
    ;;    Tie to economy (group creation fee)
    ;;
    ; LevelGroupCreate = 0
	
