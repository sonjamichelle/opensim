	;; ------------------------------------------------------------------
	;; REQUIRED FOLLOW-UP FILES
	;; ------------------------------------------------------------------
	;;
	;; Selecting an architecture is NOT enough.
	;;
	;; You MUST:
	;;
	;;    Copy the matching *Common.example file
	;;    Rename it to remove .example
	;;    Configure database and services
	;;
	;; Example:
	;;
	;;   Standalone.ini
	;;     requires
	;;   StandaloneCommon.ini
	;;
	;;   Grid.ini
	;;     requires
	;;   GridCommon.ini
	;;
	;; Failure to do this WILL cause startup or runtime errors.
