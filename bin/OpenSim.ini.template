;; This is the main configuration file for OpenSimulator.
;; If it's named OpenSim.ini then it will be loaded by OpenSimulator.
;; If it's named OpenSim.ini.example then you will need to copy it to
;; OpenSim.ini first (if that file does not already exist)
;;
;; Once you have copied OpenSim.ini.example to OpenSim.ini you will at least
;; need to set the constants in the [Const] section and pick an architecture
;; in the [Architecture] section at the end of this file. The architecture
;; will require a suitable .ini file in the config-include directory, either
;; StandaloneCommon.ini or GridCommon.ini which you can copy and modify from the
;; available .example files.
;;
;; The settings in this file are in the form "<key> = <value>".  For example,
;; save_crashes = false in the [Startup] section below.
;;
;; All settings are initially commented out and the default value used, as
;; found in OpenSimDefaults.ini.  To change a setting, first uncomment it by
;; deleting the initial semicolon (;) and then change the value.  This will
;; override the value in OpenSimDefaults.ini
;;
;; If you want to find out what configuration OpenSimulator has finished with
;; once all the configuration files are loaded then type "config show" on the
;; region console command line.
;;
;;
;; NOTES FOR DEVELOPERS REGARDING THE FORMAT OF THIS FILE
;;
;; All leading white space is ignored, but preserved.
;;
;; Double semicolons denote a text comment
;;
;; ;# denotes a configuration directive description
;;    formatted as:
;;    {option} {depends on} {question to ask} {choices} default value
;;    Any text comments following the declaration, up to the next blank line.
;;    will be copied to the generated file (NOTE: generation is not yet
;;    implemented)
;;
;;    A * in the choices list will allow an empty entry.
;;    An empty question will set the default if the dependencies are
;;    satisfied.
;;
;; ;  denotes a commented out option.
;;    Any options added to OpenSim.ini.example should be initially commented
;;    out.

[CONST]
	;; ==================================================================
	;; CONST  (GLOBAL URL AND PORT DEFINITIONS)
	;; ==================================================================
	;;
	;; THIS SECTION DEFINES GRID-WIDE CONSTANTS.
	;;
	;; Values defined here are referenced throughout OpenSim and Robust
	;; configuration files using the syntax:
	;;
	;;     ${Const|KeyName}
	;;
	;; This allows you to define critical hostnames and ports ONCE and
	;; reuse them everywhere without duplication.
	;;
	;; ------------------------------------------------------------------
	;; WHY THIS SECTION EXISTS
	;; ------------------------------------------------------------------
	;;
	;; OpenSim historically suffered from:
	;;    Hardcoded URLs scattered across multiple files
	;;    Mismatched hostnames and ports
	;;    Login failures caused by one wrong URL
	;;    Silent breakage when moving behind proxies
	;;
	;; The [Const] section exists to:
	;;    Centralize network identity
	;;    Reduce configuration drift
	;;    Make grid-wide changes safer
	;;
	;; ------------------------------------------------------------------
	;; IMPORTANT CONCEPTS
	;; ------------------------------------------------------------------
	;;
	;; PUBLIC vs PRIVATE SERVICES
	;;
	;;   PUBLIC services:
	;;      Login
	;;      Map
	;;      Capabilities advertised to viewers
	;;      Hypergrid endpoints
	;;
	;;   PRIVATE services:
	;;      Internal grid coordination
	;;      Region to Robust communication
	;;      Database-backed service calls
	;;
	;; PUBLIC endpoints MUST be reachable by viewers.
	;; PRIVATE endpoints MUST NOT be reachable from the internet.
	;;
	;; Confusing these WILL break your grid.
	;;
	;; ------------------------------------------------------------------
	;; BaseHostname
	;; ------------------------------------------------------------------
	;;
	;; Primary public hostname or IP address for your grid.
	;;
	;; This value is used to construct URLs that are ADVERTISED TO VIEWERS.
	;;
	;; REQUIREMENTS:
	;;    Must resolve via DNS for external users
	;;    Must match TLS certificates if HTTPS is used
	;;
	;; DO NOT:
	;;    Use an internal-only hostname here
	;;    Use 127.0.0.1 on a grid intended for public access
	;;
	;; EXAMPLES:
	;;   grid.example.com
	;;   sim.mygrid.org
	;;
	;; Standalone (local testing only):
	;;   127.0.0.1
	;;
	BaseHostname = "grid.mygrid.net"

	;; ------------------------------------------------------------------
	;; BaseURL
	;; ------------------------------------------------------------------
	;;
	;; Base public URL derived from BaseHostname.
	;;
	;; This is the ROOT used when constructing service endpoints that
	;; viewers and remote grids connect to.
	;;
	;; This MUST match:
	;;    The scheme viewers expect (http or https)
	;;    The externally reachable hostname
	;;
	;; ONLY CHANGE THIS IF:
	;;    You are behind a reverse proxy
	;;    You terminate TLS externally
	;;    You expose services on a different scheme or host
	;;
	;; MISMATCHES HERE CAUSE:
	;;    Login failures
	;;    Capability negotiation failures
	;;    Hypergrid travel breakage
	;;
	BaseURL = http://${Const|BaseHostname}

	;; ------------------------------------------------------------------
	;; PublicPort
	;; ------------------------------------------------------------------
	;;
	;; Externally reachable port used by PUBLIC grid services.
	;;
	;; VIEWERS CONNECT HERE.
	;;
	;; COMMON VALUES:
	;;   Standalone:
	;;     9000
	;;
	;;   Grid with Robust:
	;;     8002
	;;
	;; THIS PORT MUST:
	;;    Be open on the firewall
	;;    Be reachable from the internet
	;;
	;; IF THIS IS WRONG:
	;;    Users cannot log in
	;;    Maps may not load
	;;    Hypergrid may fail silently
	;;
	;PublicPort = "9000"
	PublicPort = "8002"

	;; ------------------------------------------------------------------
	;; PrivURL
	;; ------------------------------------------------------------------
	;;
	;; Base URL used for PRIVATE, INTERNAL services.
	;;
	;; This URL is used by:
	;;    Regions talking to Robust
	;;    Internal service connectors
	;;
	;; SECURITY REQUIREMENT:
	;;    This should NOT be publicly accessible
	;;
	;; In simple setups, this often matches BaseURL.
	;; In hardened or segmented deployments, this may:
	;;    Use a private IP
	;;    Use a different hostname
	;;    Be bound to an internal network interface
	;;
	;; BEST PRACTICE:
	;;    Keep this routable ONLY inside your trusted network
	;;
	PrivURL = ${Const|BaseURL}

	;; ------------------------------------------------------------------
	;; PrivatePort
	;; ------------------------------------------------------------------
	;;
	;; Port used for PRIVATE grid services.
	;;
	;; DEFAULT:
	;;   8003
	;;
	;; THIS PORT:
	;;    MUST be reachable by regions
	;;    MUST NOT be reachable by the public internet
	;;
	;; FIREWALL THIS PORT.
	;;
	;; EXPOSING THIS PORT CAN:
	;;    Allow unauthorized service access
	;;    Leak internal grid data
	;;    Enable service abuse
	;;
	;; Standalone:
	;;    Usually unused
	;;
	;; Grid:
	;;    Always firewall externally
	;;
	PrivatePort = "8003"

	;; ------------------------------------------------------------------
	;; SUMMARY FOR ADMINS
	;; ------------------------------------------------------------------
	;;
	;; [Const] defines your grid’s NETWORK IDENTITY.
	;;
	;; If login, map, or Hypergrid breaks:
	;;    CHECK THIS SECTION FIRST
	;;
	;; Most OpenSim “mystery failures” eventually trace back to:
	;;    Wrong hostname
	;;    Wrong port
	;;    Public and private URLs mixed together
	;;
	;; Treat this section as FOUNDATIONAL.
	;;
	;; ==================================================================

[Startup]
	;; ==================================================================
	;; STARTUP  (SIMULATOR RUNTIME INITIALIZATION)
	;; ==================================================================
	;;
	;; This section controls core runtime behavior for a simulator instance.
	;;
	;; These settings affect:
	;;    Console behavior and usability
	;;    Logging and diagnostics
	;;    Region startup and operator interaction
	;;    Persistence of command history across restarts
	;;
	;; While these options do not usually affect in-world user experience
	;; directly, they are CRITICAL for:
	;;    Debugging
	;;    Multi-instance operation
	;;    Long-term grid maintenance
	;;
	;; Misconfiguration here will not usually crash a grid, but it CAN:
	;;    Make troubleshooting harder
	;;    Cause log and history file collisions
	;;    Obscure which instance or region you are operating on
	;;
	;; ==================================================================
	;; CONSOLE BEHAVIOR
	;; ==================================================================
	;;
	;; Console prompt shown for this simulator instance.
	;;
	;; Supported tokens:
	;;   \R  = Region name
	;;   \\  = Literal backslash
	;;
	;; This is especially useful when running multiple instances in
	;; tmux, screen, or multiple terminals.
	;;
	ConsolePrompt = "Region (\R) "

	;; ------------------------------------------------------------------
	;; CONSOLE COMMAND HISTORY
	;; ------------------------------------------------------------------
	;;
	;; Enables saving console command history to disk so it persists
	;; across restarts.
	;;
	;; NOTE:
	;;   All instances using the same history file will write to it.
	;;   This can cause interleaved or confusing history when running
	;;   multiple simulators on the same host.
	;;
	;; TODO:
	;;   Add native support for per-instance history files to avoid
	;;   multiple OpenSim processes writing to one monolithic file.
	;;
	ConsoleHistoryFileEnabled = true

	;; ------------------------------------------------------------------
	;; LOG FILE LOCATION
	;; ------------------------------------------------------------------
	;;
	;; Path to the primary simulator log file.
	;;
	;; If a relative path is used, it is resolved relative to the
	;; OpenSim bin/ directory.
	;;
	;; IMPORTANT:
	;;   Multiple simulator instances writing to the same log file
	;;   WILL interleave output and complicate diagnostics.
	;;
	;; TODO:
	;;   Support per-instance log files (for example, including
	;;   instance or region identifiers in the filename).
	;;
	LogFile = OpenSim.log

	;; ------------------------------------------------------------------
	;; CONSOLE HISTORY FILE
	;; ------------------------------------------------------------------
	;;
	;; Path to the console history file.
	;;
	;; If a relative path is used, it is resolved relative to the
	;; OpenSim bin/ directory.
	;;
	;; Default behavior uses a single shared history file.
	;;
	;; TODO:
	;;   Allow automatic per-instance filenames to prevent
	;;   multi-instance collisions.
	;;
	ConsoleHistoryFile = "OpenSimConsoleHistory.txt"

	;; ------------------------------------------------------------------
	;; CONSOLE HISTORY SIZE
	;; ------------------------------------------------------------------
	;;
	;; Maximum number of command lines retained in the history file.
	;;
	;; Larger values retain more operational context at the cost of
	;; slightly larger files.
	;;
	ConsoleHistoryFileLines = 100

	;; ------------------------------------------------------------------
	;; CONSOLE HISTORY TIMESTAMPS
	;; ------------------------------------------------------------------
	;;
	;; If enabled, each command stored in the history file is prefixed
	;; with a timestamp.
	;;
	;; Useful for auditing and post-incident analysis.
	;;
	;; Default is false.
	;;
	; ConsoleHistoryTimeStamp = false
	
	;; ==================================================================
	;; RUNTIME DIAGNOSTICS, CRASH HANDLING, AND CONSOLE AUTOMATION
	;; ==================================================================
	;;
	;; This section controls:
	;;   - How OpenSim records crashes
	;;   - Where crash diagnostics are written
	;;   - Whether a PID file is created for supervisors
	;;   - Which console commands are run at startup, shutdown, or on a timer
	;;
	;; These settings DO NOT improve performance.
	;; They exist to help OPERATORS diagnose problems, automate maintenance,
	;; and integrate OpenSim with external tooling (systemd, cron, tmux, etc).
	;;
	;; Misuse will not usually crash the simulator,
	;; but CAN lead to silent data loss, confusing behavior,
	;; or destructive automation if you are careless.
	;;
	;; ==================================================================
	;; CRASH LOGGING
	;; ==================================================================
	;;
	;; save_crashes
	;;
	;; PURPOSE:
	;;   If true, OpenSim will write a crash report to disk
	;;   when the simulator process terminates due to an
	;;   internal OpenSim exception.
	;;
	;; IMPORTANT LIMITATION:
	;;   This ONLY captures crashes caused by OpenSim-managed code.
	;;
	;;   It DOES NOT capture:
	;;     - Mono runtime crashes
	;;     - .NET runtime crashes
	;;     - Native physics engine crashes (ODE, ubOde, Bullet)
	;;     - Segfaults or hard VM termination
	;;
	;; For those, you MUST rely on:
	;;   - Full console logs
	;;   - systemd journal
	;;   - tmux/screen logs
	;;   - core dumps (if enabled)
	;;
	;; USE CASE:
	;;   - Bug reporting
	;;   - Diagnosing rare OpenSim core crashes
	;;   - Development or test grids
	;;
	;; NOT A SUBSTITUTE FOR:
	;;   - Proper logging
	;;   - Process supervision
	;;
	;; DEFAULT:
	;;   false
	;;
	save_crashes = false

	;; --------------------------------------------------
	;; crash_dir
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Directory where crash reports are written if save_crashes = true.
	;;
	;; NOTES:
	;;   - Path is relative to OpenSim bin/ unless absolute
	;;   - Directory MUST be writable by the OpenSim process
	;;
	;; DEFAULT BEHAVIOR IF UNSET:
	;;   OpenSim uses a platform-dependent default, typically:
	;;     Linux:   <opensim_root>/crashes/
	;;     Windows: C:\opensim\crashes\
	;;
	;; OPERATOR GUIDANCE:
	;;   - Use a per-instance directory if running multiple instances
	;;   - Avoid shared crash directories across sims
	;;
	crash_dir = "crashes"

	;; ==================================================================
	;; PROCESS SUPERVISION
	;; ==================================================================
	;;
	;; PIDFile
	;;
	;; PURPOSE:
	;;   Writes the OpenSim process ID to a file for use by:
	;;     - systemd
	;;     - init scripts
	;;     - watchdog wrappers
	;;     - custom supervisors
	;;
	;; THIS DOES NOTHING BY ITSELF.
	;; It ONLY matters if something external expects a PID file.
	;;
	;; REQUIREMENTS:
	;;   - Path must be writable
	;;   - MUST be unique per OpenSim instance
	;;
	;; DANGER:
	;;   Using the same PIDFile for multiple instances WILL cause
	;;   supervisors to kill the wrong process.
	;;
	;; RECOMMENDED:
	;;   Use ONLY if you know your supervisor needs it.
	;;
	;; EXAMPLE:
	;;   PIDFile = "/run/opensim/estate-moonlight.pid"
	;;
	; PIDFile = "/tmp/OpenSim.exe.pid"

	;; ==================================================================
	;; CONSOLE COMMAND AUTOMATION
	;; ==================================================================
	;;
	;; These files allow you to run NORMAL console commands
	;; automatically at defined lifecycle points.
	;;
	;; Commands are executed EXACTLY as if typed into the console.
	;; There is NO sandboxing.
	;;
	;; THIS IS POWERFUL.
	;; THIS IS ALSO DANGEROUS.
	;;
	;; ==================================================================

	;; --------------------------------------------------
	;; startup_console_commands_file
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Commands executed immediately after the simulator starts.
	;;
	;; COMMON USE CASES:
	;;   - Setting log levels
	;;   - Enabling or disabling regions
	;;   - Loading OARs on boot
	;;   - Printing status banners
	;;
	;; EXAMPLES:
	;;   set log level debug
	;;   enable region Moonlight Landing
	;;   show stats
	;;
	;; WARNINGS:
	;;   - Commands run even if regions are not fully initialized
	;;   - Bad commands WILL NOT stop startup but may fail silently
	;;
	startup_console_commands_file = "startup_commands.txt"

	;; --------------------------------------------------
	;; shutdown_console_commands_file
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Commands executed during simulator shutdown.
	;;
	;; COMMON USE CASES:
	;;   - Saving OAR backups
	;;   - Flushing caches
	;;   - Writing diagnostic output
	;;
	;; EXAMPLES:
	;;   save oar backups/region.oar
	;;   show stats
	;;
	;; CRITICAL WARNING:
	;;   - Shutdown commands DO NOT delay process termination
	;;   - Long-running operations may be interrupted
	;;   - DO NOT rely on this for guaranteed backups
	;;
	shutdown_console_commands_file = "shutdown_commands.txt"

	;; --------------------------------------------------
	;; repeating_console_commands_file
	;; --------------------------------------------------
	;;
	;; PURPOSE:
	;;   Commands executed repeatedly at a fixed interval.
	;;
	;; DEFAULT INTERVAL:
	;;   20 minutes
	;;
	;; COMMON USE CASES:
	;;   - Periodic diagnostics
	;;   - Emitting stats for log scraping
	;;   - Monitoring scripts
	;;
	;; EXAMPLES:
	;;   show stats
	;;   show uptime
	;;
	;; OPERATOR WARNING:
	;;   - This is NOT a scheduler
	;;   - Commands stack if execution overlaps
	;;   - Bad commands here can flood logs or degrade performance
	;;
	;; RECOMMENDED:
	;;   Keep commands SIMPLE and READ-ONLY
	;;
	; repeating_console_commands_file = "repeating_commands.txt"

	;; ==================================================================
	;; SUMMARY FOR ADMINS
	;; ==================================================================
	;;
	;; These settings exist to:
	;;   - Help you observe failures
	;;   - Integrate OpenSim into automation
	;;   - Assist in debugging
	;;
	;; They will NOT:
	;;   - Fix lag
	;;   - Improve stability by themselves
	;;   - Replace proper monitoring
	;;
	;; Treat console automation like a loaded chainsaw:
	;;   - Extremely useful
	;;   - Extremely unforgiving
	;;
	;; ==================================================================

	;; --------------------------------------------------
	;; PERIODIC TIMER SCRIPT (AUTOMATION HOOK)
	;; --------------------------------------------------
	;;
	;; This optional mechanism allows OpenSim to execute an
	;; external SCRIPT FILE at a fixed time interval.
	;;
	;; IMPORTANT:
	;;   This is NOT the same as repeating_console_commands_file.
	;;   This executes an external script, not console commands.
	;;
	;; The script is typically used for:
	;;   - External monitoring hooks
	;;   - Maintenance tasks
	;;   - Integration with system tools (cron-like behavior)
	;;   - Logging, backups, or health checks
	;;
	;; ------------------------------------------------------------------
	;; timer_Script
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Specifies the filename of a script to execute periodically.
	;;
	;; BEHAVIOR WHEN SET:
	;;   - OpenSim will spawn the script as a child process
	;;   - Execution occurs at every timer_Interval
	;;   - Script runs OUTSIDE OpenSim, not inside the simulator
	;;
	;; REQUIREMENTS:
	;;   - File must exist
	;;   - File must be executable by the OpenSim user
	;;   - Path is relative to OpenSim bin/ unless absolute
	;;
	;; DANGER:
	;;   - A blocking or long-running script can pile up executions
	;;   - A failing script may silently fail unless logged externally
	;;
	;; RECOMMENDED:
	;;   Leave unset unless you intentionally need external automation.
	;;
	; timer_Script = "filename"

	;; ------------------------------------------------------------------
	;; timer_Interval
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Defines how often the timer_Script is executed.
	;;
	;; VALUE:
	;;   Time in SECONDS
	;;
	;; DEFAULT:
	;;   1200 seconds (20 minutes)
	;;
	;; EFFECTS OF CHANGING THIS VALUE:
	;;
	;;   LOWER VALUES (e.g. 60, 300):
	;;     - Script runs more frequently
	;;     - Higher system load
	;;     - Greater risk of overlapping executions
	;;
	;;   HIGHER VALUES (e.g. 3600):
	;;     - Script runs less often
	;;     - Reduced system impact
	;;     - Slower response to detected issues
	;;
	;; CRITICAL WARNING:
	;;   There is NO built-in locking or overlap prevention.
	;;   If the script runtime exceeds timer_Interval,
	;;   multiple instances may run simultaneously.
	;;
	;; SAFE PRACTICE:
	;;   - Ensure the script exits quickly
	;;   - Implement your own locking inside the script
	;;
	; timer_Interval = 1200


; ##
; ## SYSTEM
; ##

	;; ------------------------------------------------------------------
	;; CORE RUNTIME / THREADING MODEL
	;; ------------------------------------------------------------------
	;;
	;; These settings control how OpenSim executes INTERNAL asynchronous work.
	;; This includes:
	;;   - Network IO callbacks
	;;   - Asset fetches
	;;   - Script events
	;;   - Scene updates
	;;   - Background maintenance tasks

	;; MISCONFIGURATION HERE CAN:
	;;   - Cause thread starvation
	;;   - Cause runaway CPU usage
	;;   - Cause deadlocks under load
	;;   - Create "random lag" that defies profiling
	;;
	;; ------------------------------------------------------------------
	;; async_call_method
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Determines HOW OpenSim schedules asynchronous ("FireAndForget") work.
	;;
	;; VALID VALUES:
	;;
	;;   QueueUserWorkItem
	;;     - Uses the .NET ThreadPool directly
	;;     - Simple but aggressive
	;;     - Can starve critical threads under load
	;;     - Poor behavior on script-heavy or avatar-dense regions
	;;
	;;   SmartThreadPool   (RECOMMENDED)
	;;     - Uses a managed, throttled thread pool
	;;     - Better load control
	;;     - Prevents runaway thread creation
	;;     - Most stable option for production grids
	;;
	;;   Thread
	;;     - Spawns a new OS thread per job
	;;     - Least efficient
	;;     - Can DESTROY performance under load
	;;     - Only useful for debugging or legacy testing
	;;
	;; RECOMMENDED:
	;;   SmartThreadPool
	;;
	;; WARNING:
	;;   Changing this requires a simulator restart.
	;;
	async_call_method = SmartThreadPool

	;; ------------------------------------------------------------------
	;; MaxPoolThreads
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Sets the MAXIMUM number of worker threads available
	;;   to the SmartThreadPool.
	;;
	;; WHAT THIS REALLY MEANS:
	;;   This is a HARD CEILING, not a target.
	;;   Threads are created on demand up to this limit.
	;;
	;; EFFECTS OF SETTING TOO LOW:
	;;   - Tasks queue up
	;;   - Increased latency
	;;   - Scripts feel "slow"
	;;   - Asset fetch delays
	;;
	;; EFFECTS OF SETTING TOO HIGH:
	;;   - Excessive context switching
	;;   - CPU thrashing
	;;   - Cache invalidation
	;;   - Overall WORSE performance
	;;
	;; REALITY CHECK:
	;;   - This does NOT mean OpenSim will always use this many threads
	;;   - This must be balanced against CPU core count
	;;
	;; RULE OF THUMB:
	;;   - Small regions / few users: 50–150
	;;   - Medium grids: 150–300
	;;   - Large, script-heavy grids: tune carefully and monitor
	;;
	;; DANGER:
	;;   Setting this arbitrarily high is NOT "future proofing".
	;;
	MaxPoolThreads = 300

	;; ------------------------------------------------------------------
	;; JobEngineEnabled
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Enables the Job Engine, which allows SOME tasks to be
	;;   executed SERIALIZED instead of fully parallel.
	;;
	;; WHY THIS EXISTS:
	;;   Under very high concurrency (hundreds of avatars),
	;;   running everything in parallel can:
	;;     - Increase lock contention
	;;     - Increase cache misses
	;;     - Reduce overall throughput
	;;
	;; WHAT THIS DOES:
	;;   - Allows certain workloads to be batched
	;;   - Reduces contention
	;;   - Improves stability at scale
	;;
	;; EFFECT:
	;;   - Slightly higher latency for some operations
	;;   - Higher overall throughput under load
	;;
	;; RECOMMENDED:
	;;   true   (especially for medium to large grids)
	;;
	;; WHEN TO DISABLE:
	;;   - Only for debugging concurrency behavior
	;;   - Or when diagnosing unusual scheduling bugs
	;;
	JobEngineEnabled = true

	;; ------------------------------------------------------------------
	;; RegistryLocation
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Location of the OpenSim plugin/addin registry.
	;;
	;; WHAT IS STORED HERE:
	;;   - Information about installed addins
	;;   - Repository metadata
	;;
	;; DEFAULT:
	;;   "." (current working directory, usually bin/)
	;;
	;; IMPORTANT:
	;;   OpenSim MUST have read/write access to this path.
	;;
	;; RISK IF MISCONFIGURED:
	;;   - Plugins fail to load
	;;   - Addins disappear after restart
	;;   - Silent module failures
	;;
	;; RECOMMENDATION:
	;;   Leave as "." unless you KNOW you need to relocate it.
	;;
	RegistryLocation = "."

	;; ------------------------------------------------------------------
	;; ConfigDirectory
	;; ------------------------------------------------------------------
	;;
	;; PURPOSE:
	;;   Location where module addins store THEIR configuration.
	;;
	;; WHY THIS EXISTS:
	;;   Allows addin configuration to be stored OUTSIDE bin/
	;;   so it survives OpenSim updates and reinstalls.
	;;
	;; DEFAULT:
	;;   "." (bin/)
	;;
	;; COMMON ADVANCED USE:
	;;   Set this to a persistent path such as:
	;;     ../config-addins
	;;     /var/lib/opensim/config
	;;
	;; REQUIREMENTS:
	;;   - Directory MUST exist
	;;   - OpenSim MUST have read/write access
	;;
	;; CONSEQUENCES OF MOVING IT:
	;;   - Existing addin configs may need migration
	;;   - Mismatched paths can cause modules to reset to defaults
	;;
	;; RECOMMENDATION:
	;;   Leave default unless you are deliberately separating config from binaries.
	;;
	ConfigDirectory = "."

;; ##
;; ## CLIENTS
;; ##

	;; ------------------------------------------------------------------
	;; CLIENT NETWORK STACK SELECTION
	;; ------------------------------------------------------------------
	;;
	;; This setting defines WHICH CLIENT PROTOCOL STACK OpenSim uses
	;; to communicate with viewers.
	;;
	;; This is NOT a cosmetic choice.
	;; This determines:
	;;   - How viewers connect
	;;   - How movement updates are sent
	;;   - How objects, avatars, and terrain are streamed
	;;   - How capabilities (CAPS) are negotiated
	;;
	;; In practical terms:
	;;   THIS IS THE VIEWER COMPATIBILITY SWITCH.
	;;
	;; ------------------------------------------------------------------
	;; WHAT "CLIENT STACK" MEANS
	;; ------------------------------------------------------------------
	;;
	;; A client stack implements:
	;;   - Login handshake behavior
	;;   - UDP packet formats
	;;   - Viewer message decoding
	;;   - CAPS endpoint expectations
	;;
	;; If the client stack does not match what the viewer expects:
	;;   - Login may fail
	;;   - Avatars may freeze
	;;   - Objects may not rez
	;;   - Inventory may behave erratically
	;;
	;; This is NOT something to casually experiment with.
	;;
	;; ------------------------------------------------------------------
	;; LindenUDP (DEFAULT / REQUIRED)
	;; ------------------------------------------------------------------
	;;
	;; OpenSim.Region.ClientStack.LindenUDP.dll
	;;
	;; This implements the Linden Lab–style UDP protocol used by:
	;;   - Second Life–derived viewers
	;;   - Firestorm
	;;   - Singularity
	;;   - Alchemy
	;;   - Most OpenSim-compatible viewers
	;;
	;; This is the ONLY client stack suitable for:
	;;   - Public grids
	;;   - Hypergrid connectivity
	;;   - Modern viewer compatibility
	;;
	;; STATUS:
	;;   - Actively used
	;;   - Well-tested
	;;   - REQUIRED for normal operation
	;;
	;; ------------------------------------------------------------------
	;; WHEN WOULD YOU EVER CHANGE THIS?
	;; ------------------------------------------------------------------
	;;
	;; In almost ALL cases:
	;;   YOU SHOULD NOT.
	;;
	;; Legitimate reasons to change this are EXTREMELY RARE and include:
	;;
	;;   - Research environments
	;;   - Experimental protocol development
	;;   - Custom viewers with a custom client stack
	;;   - Historical/legacy forks with non-standard protocols
	;;
	;; If you are not writing your OWN viewer:
	;;   YOU DO NOT NEED TO TOUCH THIS.
	;;
	;; ------------------------------------------------------------------
	;; WHAT HAPPENS IF YOU CHANGE THIS INCORRECTLY
	;; ------------------------------------------------------------------
	;;
	;; Possible outcomes include:
	;;   - All viewers fail to log in
	;;   - Viewers connect but see nothing
	;;   - Continuous disconnect/reconnect loops
	;;   - Silent failures with no useful log errors
	;;
	;; This is one of the FASTEST ways to completely break a grid.
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; This setting is NOT:
	;;   - A performance optimization
	;;   - A bandwidth control
	;;   - A lag fix
	;;
	;; Changing it will NOT:
	;;   - Improve FPS
	;;   - Reduce CPU usage
	;;   - Improve physics
	;;
	;; It ONLY changes how clients talk to the simulator.
	;;
	;; ------------------------------------------------------------------
	;; RECOMMENDED SETTING
	;; ------------------------------------------------------------------
	;;
	;; For ALL normal OpenSim grids:
	;;
	;;   OpenSim.Region.ClientStack.LindenUDP.dll
	;;
	;; Leave this EXACTLY as-is unless you are developing
	;; a custom protocol and custom viewer.
	;;
	clientstack_plugin = "OpenSim.Region.ClientStack.LindenUDP.dll"


;; ##
;; ## REGIONS
;; ##

	;; ==================================================================
	;; REGION DEFINITION & LOADING
	;; ==================================================================
	;;
	;; This section defines HOW OpenSim discovers, loads, and manages regions.
	;;
	;; These settings control:
	;;   - Where region definitions come from
	;;   - Whether regions exist at all at startup
	;;   - How simulators behave at region borders
	;;
	;; MISCONFIGURATION HERE CAN RESULT IN:
	;;   - NO regions loading
	;;   - Regions silently not appearing
	;;   - Login failures
	;;   - Broken region crossings
	;;
	;; This is CORE GRID STRUCTURE.
	;; Read before changing.
	;;

	;; ------------------------------------------------------------------
	;; region_info_source
	;; ------------------------------------------------------------------
	;;
	;; Determines WHERE OpenSim loads region definitions from.
	;;
	;; VALID VALUES:
	;;   "filesystem"  = Load region definitions from local files
	;;   "web"         = Load region definitions from a remote HTTP endpoint
	;;
	;; DEFAULT:
	;;   filesystem
	;;
	;; ------------------------------------------------------------------
	;; filesystem (RECOMMENDED / STANDARD)
	;; ------------------------------------------------------------------
	;;
	;; Regions are defined by INI or XML files on disk.
	;; This is:
	;;   - Simple
	;;   - Predictable
	;;   - Version-controllable
	;;   - Debuggable
	;;
	;; REQUIRED FOR:
	;;   - Most standalone grids
	;;   - Most production grids
	;;   - Any grid using estate/region folders
	;;
	;; ------------------------------------------------------------------
	;; web (ADVANCED / SPECIALIZED)
	;; ------------------------------------------------------------------
	;;
	;; Region definitions are fetched from a remote server.
	;;
	;; INTENDED USE CASES:
	;;   - Large dynamic grids
	;;   - Automated region provisioning
	;;   - Centralized region orchestration systems
	;;
	;; HARD REQUIREMENTS:
	;;   - Always-available web service
	;;   - Correct XML schema
	;;   - Network reliability
	;;
	;; FAILURE MODES:
	;;   - If the web endpoint is unreachable → NO regions load
	;;   - If XML is malformed → startup failure or silent ignore
	;;
	;; DO NOT USE unless you fully control the backend service.
	;;
	region_info_source = "filesystem"
	; region_info_source = "web"

	;; ------------------------------------------------------------------
	;; regionload_regionsdir
	;; ------------------------------------------------------------------
	;;
	;; Defines WHERE region definition files live on disk
	;; when region_info_source = "filesystem".
	;;
	;; PATH RESOLUTION:
	;;   - Relative paths are resolved relative to OpenSim /bin
	;;   - Absolute paths are allowed
	;;
	;; DEFAULT (if unset):
	;;   bin/Regions
	;;
	;; This supports structured layouts such as:
	;;   Regions/<EstateName>/Regions/<RegionName>.ini
	;;
	;; RECOMMENDED PRACTICE:
	;;   - Keep region definitions OUTSIDE bin/
	;;   - Separate regions by estate or instance
	;;   - Back this directory up regularly
	;;
	;; DANGER:
	;;   - Wrong path = no regions loaded
	;;   - Typos here cause silent region loss
	;;
	regionload_regionsdir = "Regions"

	;; ------------------------------------------------------------------
	;; regionload_webserver_url
	;; ------------------------------------------------------------------
	;;
	;; ONLY USED WHEN:
	;;   region_info_source = "web"
	;;
	;; Points to an HTTP endpoint returning region definitions in XML.
	;;
	;; FORMAT REQUIREMENTS:
	;;   - Same XML structure as filesystem region files
	;;   - Entire document wrapped in <Regions> root tag
	;;
	;; Example:
	;;   http://example.com/regions.xml
	;;
	;; WARNING:
	;;   - No caching by default
	;;   - Network failure = zero regions
	;;
	; regionload_webserver_url = "http://example.com/regions.xml"

	;; ------------------------------------------------------------------
	;; allow_regionless
	;; ------------------------------------------------------------------
	;;
	;; Controls whether OpenSim is allowed to start WITHOUT any regions.
	;;
	;; false = Simulator will REFUSE to start if no regions are found
	;; true  = Simulator will start even with zero regions
	;;
	;; DEFAULT:
	;;   false
	;;
	;; WHY THIS EXISTS:
	;;   - Prevents accidental "empty grid" startups
	;;   - Forces admin to notice missing regions early
	;;
	;; WHEN TO SET true:
	;;   - Headless service nodes
	;;   - Region provisioning pipelines
	;;   - Debugging grid services without regions
	;;
	;; WARNING:
	;;   Enabling this without understanding it can lead to:
	;;     - Users logging into nothing
	;;     - Admins thinking the grid is "running" when it isn't
	;;
	allow_regionless = false

	;; ------------------------------------------------------------------
	;; see_into_region
	;; ------------------------------------------------------------------
	;;
	;; Controls whether CHILD AGENTS are created across region borders.
	;;
	;; WHAT IS A CHILD AGENT:
	;;   - A lightweight representation of an avatar
	;;   - Exists in neighboring regions
	;;   - Allows seeing avatars and objects across borders
	;;
	;; true  = Neighboring regions receive limited updates
	;; false = Hard visual isolation between regions
	;;
	;; DEFAULT:
	;;   true
	;;
	;; EFFECTS WHEN ENABLED (true):
	;;   - Smoother border crossings
	;;   - Avatars visible approaching borders
	;;   - Normal OpenSim/SL-like behavior
	;;
	;; EFFECTS WHEN DISABLED (false):
	;;   - Reduced cross-region visibility
	;;   - Borders appear more "hard"
	;;   - Can break expectations for vehicles and crossings
	;;
	;; POSSIBLE USE CASES FOR false:
	;;   - Strict privacy regions
	;;   - Experimental isolation
	;;   - Performance testing in edge cases
	;;
	;; WARNING:
	;;   Disabling this may cause:
	;;     - Confusing border behavior
	;;     - Avatars popping in/out
	;;     - Broken crossings depending on viewer
	;;
	see_into_region = true

	;; ==================================================================
	;; LEGACY SIT OFFSET COMPATIBILITY
	;; ==================================================================
	;;
	;; This setting controls how OpenSim calculates the FINAL avatar
	;; position when an avatar sits on an object using llSitTarget().
	;;
	;; This affects:
	;;   - Chairs
	;;   - Furniture
	;;   - Vehicles
	;;   - Poseballs
	;;   - Multi-avatar seating systems
	;;   - Scripted animations relying on precise positioning
	;;
	;; THIS IS A USER EXPERIENCE SETTING.
	;; Changing it WILL move avatars in-world.
	;;

	;; ------------------------------------------------------------------
	;; LegacySitOffsets
	;; ------------------------------------------------------------------
	;;
	;; true  = Use LEGACY sit offset math
	;; false = Use IMPROVED sit offset math (closer to Second Life)
	;;
	;; DEFAULT (historical):
	;;   true
	;;
	;; ------------------------------------------------------------------
	;; WHAT THIS SETTING CONTROLS
	;; ------------------------------------------------------------------
	;;
	;; When an avatar sits, OpenSim calculates the final position as:
	;;
	;;   SitTarget position
	;; + offset based on avatar size
	;; + offset based on object orientation
	;; + offset based on legacy or modern math model
	;;
	;; The difference between LEGACY and IMPROVED math is HOW avatar
	;; dimensions and object transforms are applied.
	;;
	;; This does NOT affect:
	;;   - Permissions
	;;   - Animations themselves
	;;   - Viewer-side pose playback
	;;
	;; It ONLY affects WHERE the avatar appears in space.
	;;

	;; ------------------------------------------------------------------
	;; LEGACY MODE (LegacySitOffsets = true)
	;; ------------------------------------------------------------------
	;;
	;; This uses OpenSim's ORIGINAL sit math.
	;;
	;; WHY IT EXISTS:
	;;   - Early OpenSim math differed from Second Life
	;;   - Thousands of scripted objects compensated manually
	;;   - Content creators "baked in" corrective offsets
	;;
	;; RESULT:
	;;   - Old content appears correct
	;;   - New SL-authored content may look slightly off
	;;
	;; KEEP THIS SETTING IF:
	;;   - Your grid has YEARS of legacy content
	;;   - Furniture was tuned specifically for OpenSim
	;;   - You see avatars drifting when testing modern content
	;;   - You prioritize backward compatibility over SL parity
	;;
	;; RISK:
	;;   - Slight mismatch vs modern SL behavior
	;;   - New imported content may need manual adjustment
	;;
	;; THIS IS THE SAFEST OPTION FOR ESTABLISHED GRIDS.
	;;

	;; ------------------------------------------------------------------
	;; IMPROVED MODE (LegacySitOffsets = false)
	;; ------------------------------------------------------------------
	;;
	;; This uses newer math intended to more closely match
	;; Second Life sit behavior.
	;;
	;; BENEFITS:
	;;   - Better alignment with SL-authored content
	;;   - More predictable behavior for modern creators
	;;   - Cleaner math model going forward
	;;
	;; RISKS (VERY IMPORTANT):
	;;   - EXISTING content may break
	;;   - Avatars may:
	;;       * Float above chairs
	;;       * Sink into furniture
	;;       * Misalign in vehicles
	;;       * Overlap in multi-sit setups
	;;
	;; YOU SHOULD ONLY SET false IF:
	;;   - Your grid is NEW
	;;   - You control most content
	;;   - You are willing to retune furniture
	;;   - You accept widespread visual changes
	;;
	;; THIS IS NOT A DROP-IN IMPROVEMENT FOR MATURE GRIDS.
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS SETTING IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; This does NOT:
	;;   - Fix broken furniture
	;;   - Correct bad animations
	;;   - Improve performance
	;;   - Affect physics stability
	;;
	;; This WILL:
	;;   - Change how every sit looks
	;;   - Generate user complaints if changed casually
	;;
	;; Users WILL say:
	;;   "Sitting is broken"
	;; even though the system is technically working.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR RECOMMENDATION
	;; ------------------------------------------------------------------
	;;
	;; ESTABLISHED GRID:
	;;   KEEP true
	;;
	;; NEW GRID (minimal legacy content):
	;;   Consider false after testing
	;;
	;; MIXED CONTENT GRID:
	;;   KEEP true unless you plan a coordinated migration
	;;
	;; TESTING ADVICE:
	;;   - Test on a staging grid
	;;   - Test chairs, vehicles, poseballs
	;;   - Test avatars of different sizes
	;;   - Expect to re-script or re-offset content
	;;

	;; ------------------------------------------------------------------
	;; TODO (FUTURE IMPROVEMENT)
	;; ------------------------------------------------------------------
	;;
	;; Potential future enhancements:
	;;   - Per-region sit offset mode
	;;   - Per-object override flag
	;;   - Script-accessible sit math selection
	;;   - Automatic migration tools
	;;
	;; None of these exist today.
	;;
	;; This is currently a GLOBAL switch.
	;;

	; LegacySitOffsets = true

	;; ==================================================================
	;; PRIM UNDO HISTORY  (BUILDING / MEMORY TRADEOFF)
	;; ==================================================================
	;;
	;; This setting controls how many transformation states OpenSim
	;; remembers for EACH prim to support viewer-side "Undo" operations.
	;;
	;; This directly affects:
	;;   - In-world building experience
	;;   - Memory usage per region
	;;   - Scripted object editing workflows
	;;   - Bulk build / rez / modify operations
	;;
	;; This is NOT just a convenience toggle.
	;;

	;; ------------------------------------------------------------------
	;; MaxPrimUndos
	;; ------------------------------------------------------------------
	;;
	;; Maximum number of stored transformation states per prim.
	;;
	;; Each undo state stores:
	;;   - Position
	;;   - Rotation
	;;   - Scale
	;;
	;; These states are stored SERVER-SIDE.
	;;
	;; DEFAULT:
	;;   20
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; When a user edits a prim:
	;;   - Every move, rotate, or scale operation
	;;     creates a new undo snapshot
	;;
	;; Up to MaxPrimUndos snapshots are kept PER PRIM.
	;;
	;; Once the limit is reached:
	;;   - Oldest undo states are discarded
	;;
	;; This allows users to press "Undo" repeatedly in the viewer
	;; to walk backward through recent edits.
	;;

	;; ------------------------------------------------------------------
	;; MEMORY IMPLICATIONS
	;; ------------------------------------------------------------------
	;;
	;; Memory cost scales with:
	;;   - Number of prims
	;;   - Number of edits
	;;   - Number of users building simultaneously
	;;
	;; On large grids:
	;;   - Thousands of prims edited per session
	;;   - Dozens of builders
	;;   - Undo history accumulates rapidly
	;;
	;; Increasing MaxPrimUndos:
	;;   - Increases per-prim memory usage
	;;   - Increases GC pressure
	;;   - Can amplify lag during heavy build sessions
	;;
	;; This is NOT free memory.
	;;

	;; ------------------------------------------------------------------
	;; USER EXPERIENCE TRADEOFF
	;; ------------------------------------------------------------------
	;;
	;; LOWER VALUES:
	;;   - Less memory usage
	;;   - Fewer undo steps available
	;;   - Users may complain during complex builds
	;;
	;; HIGHER VALUES:
	;;   - More forgiving build workflow
	;;   - Better for precision or iterative design
	;;   - Higher memory footprint
	;;
	;; Users typically do NOT notice the difference
	;; between 20 and very high values unless they
	;; are performing long, complex edit chains.
	;;

	;; ------------------------------------------------------------------
	;; LARGE GRID CONSIDERATIONS
	;; ------------------------------------------------------------------
	;;
	;; On grids with:
	;;   - Many concurrent users
	;;   - Large collaborative builds
	;;   - High prim counts
	;;
	;; Raising this value globally can:
	;;   - Increase region memory baseline
	;;   - Worsen lag during peak build times
	;;   - Mask inefficient build workflows
	;;
	;; Undo history is duplicated across:
	;;   - Multiple regions
	;;   - Multiple simultaneous edit sessions
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS SETTING IS *NOT*
	;; ------------------------------------------------------------------
	;;
	;; This does NOT:
	;;   - Affect object permissions
	;;   - Affect saving to inventory
	;;   - Persist across region restarts
	;;   - Replace backups or OAR saves
	;;
	;; Undo history is TEMPORARY and IN-MEMORY ONLY.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR RECOMMENDATION
	;; ------------------------------------------------------------------
	;;
	;; SMALL / HOBBY GRID:
	;;   - Default (20) is usually fine
	;;
	;; LARGE / PUBLIC GRID:
	;;   - Default (20) is a good balance
	;;   - Avoid increasing unless you have headroom
	;;
	;; EDUCATION / DESIGN GRIDS:
	;;   - Consider slightly higher values ONLY if
	;;     memory usage is well understood and monitored
	;;
	;; VERY HIGH VALUES:
	;;   - NOT recommended globally
	;;   - Better solved with training or tooling
	;;

	;; ------------------------------------------------------------------
	;; TODO (FUTURE IMPROVEMENT)
	;; ------------------------------------------------------------------
	;;
	;; Potential enhancements:
	;;   - Per-user undo limits
	;;   - Per-region undo limits
	;;   - Viewer-negotiated undo depth
	;;   - Memory-aware dynamic undo pruning
	;;
	;; None of these exist today.
	;;

	MaxPrimUndos = 20

	;; ==================================================================
	;; PRIM SIZE, PHYSICS LIMITS, AND LINKSET CONSTRAINTS
	;; ==================================================================
	;;
	;; THIS SECTION DIRECTLY AFFECTS:
	;;   - Builder creativity and workflow
	;;   - Viewer behavior when resizing prims
	;;   - Physics engine stability
	;;   - Region performance and crash risk
	;;
	;; MISCONFIGURATION HERE CAN:
	;;   - Break existing content
	;;   - Cause physics explosions
	;;   - Create invisible or unselectable objects
	;;   - Induce severe lag or region instability
	;;
	;; These are NOT cosmetic limits.
	;; These are HARD SAFETY BOUNDARIES.
	;;

	;; ------------------------------------------------------------------
	;; NON-PHYSICAL PRIM SIZE LIMITS
	;; ------------------------------------------------------------------
	;;
	;; These limits apply to prims that are NOT physical.
	;; This includes the vast majority of builds:
	;;   - Buildings
	;;   - Decor
	;;   - Sculptural elements
	;;   - Megaprims
	;;
	;; These limits exist to prevent:
	;;   - Viewer math instability
	;;   - Floating-point precision loss
	;;   - Scene graph corruption
	;;

	;; Minimum allowed size for a non-physical prim.
	;;
	;; VERY SMALL VALUES:
	;;   - Enable ultra-fine detail work
	;;   - Increase risk of Z-fighting and precision artifacts
	;;   - Can create prims that are hard to select or see
	;;
	;; Setting this TOO LOW can:
	;;   - Break old viewers
	;;   - Cause rendering glitches
	;;
	;; DEFAULT: 0.001
	;;
	NonPhysicalPrimMin = 0.001

	;; Maximum allowed size for a non-physical prim.
	;;
	;; This controls "megaprims".
	;;
	;; INCREASING THIS:
	;;   - Allows very large terrain-like structures
	;;   - Enables large architectural shells
	;;
	;; RISKS:
	;;   - Extremely large prims degrade culling efficiency
	;;   - Increase viewer-side math errors
	;;   - Can cause selection and physics anomalies
	;;
	;; DEFAULT: 256
	;;
	NonPhysicalPrimMax = 256

	;; ------------------------------------------------------------------
	;; PHYSICAL PRIM SIZE LIMITS
	;; ------------------------------------------------------------------
	;;
	;; These limits apply ONLY to prims marked as PHYSICAL.
	;;
	;; PHYSICAL prims:
	;;   - Interact with the physics engine
	;;   - Participate in collision resolution
	;;   - Are significantly more expensive than non-physical prims
	;;
	;; These limits are CRITICAL for physics stability.
	;;

	;; Minimum size at which a prim is allowed to be physical.
	;;
	;; VERY SMALL PHYSICAL PRIMS:
	;;   - Cause unstable collision resolution
	;;   - Increase physics CPU load
	;;   - Can cause tunneling or jitter
	;;
	;; Setting this TOO LOW:
	;;   - Can destabilize the physics engine
	;;
	;; DEFAULT: 0.01
	;;
	PhysicalPrimMin = 0.01

	;; Maximum size for physical prims.
	;;
	;; LARGE PHYSICAL PRIMS:
	;;   - Have extremely expensive collision meshes
	;;   - Are prone to collision explosions
	;;   - Can destabilize entire regions
	;;
	;; Increasing this value is STRONGLY DISCOURAGED.
	;;
	;; DEFAULT: 64
	;;
	PhysicalPrimMax = 64

	;; ------------------------------------------------------------------
	;; PRIM SIZE CLAMPING BEHAVIOR
	;; ------------------------------------------------------------------
	;;
	;; Controls what happens when a viewer attempts to rez or resize
	;; a prim beyond the limits defined above.
	;;

	;; If false:
	;;   - Viewer requests exceeding limits are rejected
	;;   - User receives a failure or unexpected resize behavior
	;;
	;; If true:
	;;   - Oversized dimensions are silently clamped
	;;   - Viewer believes the resize succeeded
	;;   - Server enforces safety limits
	;;
	;; TRADEOFF:
	;;   - Clamping avoids user confusion
	;;   - But can hide misconfiguration or viewer bugs
	;;
	;; DEFAULT: false
	;;
	ClampPrimSize = false

	;; ------------------------------------------------------------------
	;; LINKSET SIZE LIMITS
	;; ------------------------------------------------------------------
	;;
	;; Controls how many prims may be linked together.
	;;
	;; VERY LARGE LINKSETS:
	;;   - Increase update packet size
	;;   - Increase script event fan-out
	;;   - Increase physics cost if physical
	;;
	;; Unlimited linksets are a COMMON cause of:
	;;   - Viewer lag
	;;   - Script lag
	;;   - Region instability
	;;

	;; Maximum number of prims allowed in a single linkset.
	;;
	;; VALUE MEANINGS:
	;;   <= 0  : Unlimited (DANGEROUS)
	;;   > 0   : Hard cap enforced
	;;
	;; RECOMMENDATION:
	;;   - Public grids SHOULD set a sane limit
	;;   - Unlimited linksets should be restricted
	;;
	;; DEFAULT: 0 (unlimited)
	;;
	LinksetPrims = 0

	;; ------------------------------------------------------------------
	;; SCRIPT CONTINUITY ACROSS REGION BOUNDARIES
	;; ------------------------------------------------------------------
	;;
	;; Controls whether scripts continue running when objects cross
	;; region boundaries between DIFFERENT simulators.
	;;
	;; IMPORTANT:
	;;   - This does NOT apply when regions are on the SAME simulator
	;;   - In that case scripts ALWAYS keep running
	;;

	;; If enabled:
	;;   - Script state is preserved during crossings
	;;   - Vehicles behave more naturally
	;;   - Complex moving objects function better
	;;
	;; RISKS:
	;;   - Increased complexity during region crossings
	;;   - Higher chance of script desync bugs
	;;
	;; DEFAULT: false
	;;
	; AllowScriptCrossing = false

	;; ==================================================================
	;; OPERATOR GUIDANCE
	;; ==================================================================
	;;
	;; SAFE DEFAULTS:
	;;   - Leave physical limits STRICT
	;;   - Be conservative with linkset size
	;;   - Allow large non-physical prims only if justified
	;;
	;; CREATIVE GRIDS:
	;;   - Document allowed megaprims
	;;   - Educate builders
	;;   - Monitor physics load
	;;
	;; NEVER:
	;;   - Increase PhysicalPrimMax casually
	;;   - Allow unlimited physical linksets
	;;   - Assume bigger prims are "free"
	;;
	;; ==================================================================
	;; TODO (FUTURE IMPROVEMENTS)
	;; ==================================================================
	;;
	;; Potential enhancements:
	;;   - Per-estate prim size policies
	;;   - Per-parcel prim limits
	;;   - Physics-aware dynamic scaling
	;;   - Viewer-visible limit feedback
	;;
	;; None of these exist today.
	;;
	;; ==================================================================

	;; ==================================================================
	;; SCRIPT BINARY TRUST ACROSS REGION BOUNDARIES
	;; ==================================================================
	;;
	;; THIS SETTING CONTROLS ONE OF THE MOST DANGEROUS TRUST BOUNDARIES
	;; IN THE ENTIRE OPENSIM ARCHITECTURE.
	;;
	;; It determines whether PRE-COMPILED SCRIPT BINARIES are allowed
	;; to cross region or simulator boundaries.
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS ACTUALLY DOES
	;; ------------------------------------------------------------------
	;;
	;; When TrustBinaries = true:
	;;
	;;   - Compiled script bytecode is accepted from OTHER regions
	;;   - The destination simulator EXECUTES that bytecode directly
	;;   - The script is NOT recompiled locally
	;;   - The simulator TRUSTS the source region completely
	;;
	;; This bypasses:
	;;   - Local script compilation
	;;   - Local script validation
	;;   - Any assumptions about script origin safety
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS DOES *NOT* DO
	;; ------------------------------------------------------------------
	;;
	;; This setting does NOT:
	;;   - Protect against malicious scripts
	;;   - Enforce permissions
	;;   - Restrict script capabilities
	;;   - Validate the source simulator
	;;
	;; It is NOT a sandbox.
	;; It is NOT a security feature.
	;;

	;; ------------------------------------------------------------------
	;; REAL SECURITY IMPLICATIONS
	;; ------------------------------------------------------------------
	;;
	;; If TrustBinaries = true, ANY simulator that can send objects
	;; into this region can:
	;;
	;;   - Inject compiled bytecode into your process
	;;   - Execute logic you did not compile
	;;   - Exploit differences in script engine behavior
	;;
	;; This is NOT theoretical.
	;; This is equivalent to trusting foreign executables.
	;;
	;; While OpenSim script bytecode is not native machine code,
	;; it still executes inside your simulator process and can:
	;;
	;;   - Consume CPU aggressively
	;;   - Allocate excessive memory
	;;   - Trigger engine edge cases
	;;   - Exploit unpatched script engine bugs
	;;

	;; ------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; This option exists for HISTORICAL reasons:
	;;
	;;   - Early OpenSim grids assumed full trust
	;;   - Cross-region vehicles needed state continuity
	;;   - Script recompilation caused behavior changes
	;;
	;; Modern grid architectures DO NOT share these assumptions.
	;;

	;; ------------------------------------------------------------------
	;; WHEN THIS MIGHT BE ACCEPTABLE
	;; ------------------------------------------------------------------
	;;
	;; TrustBinaries MAY be acceptable ONLY if ALL are true:
	;;
	;;   - All regions are operated by the SAME organization
	;;   - All simulators run IDENTICAL code versions
	;;   - All script authors are trusted
	;;   - No public Hypergrid access exists
	;;
	;; Examples:
	;;
	;;   - Closed research installations
	;;   - Military or MOSES-style training grids
	;;   - Internal corporate simulations
	;;
	;; Even in these cases:
	;;   - Risk remains
	;;   - Monitoring is REQUIRED
	;;

	;; ------------------------------------------------------------------
	;; WHEN THIS SHOULD NEVER BE ENABLED
	;; ------------------------------------------------------------------
	;;
	;; NEVER enable TrustBinaries on:
	;;
	;;   - Public grids
	;;   - Hypergrid-enabled grids
	;;   - Mixed-operator grids
	;;   - Any grid accepting user-generated content
	;;
	;; Doing so creates an unbounded trust relationship.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; DEFAULT:
	;;   false
	;;
	;; RECOMMENDED:
	;;   false
	;;
	;; PUBLIC GRID:
	;;   MUST remain false
	;;
	;; This setting exists for edge cases, not normal operation.
	;;

	;; ------------------------------------------------------------------
	;; TODO (FUTURE DIRECTION)
	;; ------------------------------------------------------------------
	;;
	;; A modern replacement would require:
	;;
	;;   - Signed script binaries
	;;   - Trust domains per grid
	;;   - Script origin verification
	;;   - Capability-based execution permissions
	;;
	;; NONE of these exist today.
	;;
	;; Until then:
	;;   DO NOT ENABLE
	;;
	;; ==================================================================

	TrustBinaries = false

	;; ==================================================================
	;; VIEW DISTANCE / REGION VISIBILITY CONTROL
	;; ==================================================================
	;;
	;; THIS SECTION IS FREQUENTLY MISUNDERSTOOD AND OFTEN IGNORED
	;; BY CURRENT OPENSIM BUILDS.
	;;
	;; These settings describe INTENDED behavior.
	;; Actual behavior may be clamped or overridden by:
	;;   - Viewer-side limits
	;;   - Server-side hard caps
	;;   - Cross-region performance safeguards
	;;
	;; Do NOT assume these values are honored without verification.
	;;

	;; ------------------------------------------------------------------
	;; HISTORICAL CONTEXT
	;; ------------------------------------------------------------------
	;;
	;; Originally, OpenSim exposed draw distance and region visibility
	;; as configurable server-side controls.
	;;
	;; As content complexity increased and performance problems surfaced,
	;; server-side clamping was introduced as a GLOBAL SAFETY MEASURE.
	;;
	;; This was a defensive response to real issues:
	;;   - Excessive object update traffic
	;;   - Physics and interest-management overload
	;;   - Script-heavy regions visible at extreme distances
	;;
	;; HOWEVER:
	;;   This approach treats the symptom, not the cause.
	;;

	;; ------------------------------------------------------------------
	;; IMPORTANT REALITY CHECK
	;; ------------------------------------------------------------------
	;;
	;; Current OpenSim versions may:
	;;   - Ignore these values entirely
	;;   - Clamp them silently
	;;   - Apply different limits internally than what is configured
	;;
	;; Many viewers ALSO enforce their own draw distance limits.
	;;
	;; RESULT:
	;;   Admins believe they configured behavior that never occurs.
	;;

	;; ------------------------------------------------------------------
	;; DefaultDrawDistance
	;; ------------------------------------------------------------------
	;;
	;; Intended default view distance (in meters) assigned to avatars.
	;;
	;; WHAT ADMINS EXPECT:
	;;   - View distance defaults to this value on login
	;;
	;; WHAT ACTUALLY HAPPENS:
	;;   - Many viewers override this
	;;   - Server may clamp it regardless
	;;
	;; PURPOSE TODAY:
	;;   - Mostly informational
	;;   - Viewer hint at best
	;;
	;; NOTE:
	;;   This does NOT force visibility.
	;;
	DefaultDrawDistance = 255.0

	;; ------------------------------------------------------------------
	;; MaxDrawDistance
	;; ------------------------------------------------------------------
	;;
	;; Intended absolute maximum draw distance allowed.
	;;
	;; HISTORICAL PURPOSE:
	;;   - Prevent clients from requesting excessive scene data
	;;
	;; CURRENT REALITY:
	;;   - Often hard-clamped in server code
	;;   - Admin-set values above the clamp are ignored
	;;
	;; THIS IS A POLICY DECISION, NOT A TECHNICAL LIMIT.
	;;
	;; The underlying performance issues relate to:
	;;   - Interest management
	;;   - Object prioritization
	;;   - Update throttling
	;; NOT draw distance itself.
	;;
	MaxDrawDistance = 512

	;; ------------------------------------------------------------------
	;; REGION VISIBILITY (CROSS-REGION)
	;; ------------------------------------------------------------------
	;;
	;; These settings control how far OTHER REGIONS may be seen,
	;; based on avatar position and view range.
	;;
	;; This affects:
	;;   - Horizon visibility
	;;   - Cross-region immersion
	;;   - Region crossing behavior
	;;
	;; If MaxRegionsViewDistance = 0:
	;;   - Other regions are NOT visible
	;;   - Region crossings are disabled
	;;
	;; NOTE:
	;;   Even non-zero values may be clamped or ignored.
	;;

	;; Maximum distance at which neighboring regions may be visible.
	;;
	;; Intended effect:
	;;   - Controls how many regions are considered "in scope"
	;;
	;; Reality:
	;;   - Often hard-limited internally
	;;
	MaxRegionsViewDistance = 255

	;; Minimum distance used for region visibility calculations.
	;;
	;; Intended effect:
	;;   - Prevents excessive popping at low distances
	;;
	;; Reality:
	;;   - Rarely meaningful if MaxRegionsViewDistance is clamped
	;;
	MinRegionsViewDistance = 96

	;; ------------------------------------------------------------------
	;; WHY THIS MATTERS
	;; ------------------------------------------------------------------
	;;
	;; Draw distance clamping:
	;;   - Masks deeper performance issues
	;;   - Breaks large-world immersion
	;;   - Forces "bubble world" design
	;;
	;; The real fixes live in:
	;;   - InterestManagement tuning
	;;   - Update prioritization
	;;   - Object culling strategies
	;;   - Script and physics load control
	;;
	;; View distance itself is NOT the enemy.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; DO NOT assume:
	;;   - These values are honored
	;;   - Increasing them will work
	;;
	;; DO:
	;;   - Test with real viewers
	;;   - Observe network and frame stats
	;;   - Tune interest management instead
	;;
	;; EXPECT:
	;;   - Future OpenSim versions may re-expose these controls
	;;     properly, once underlying systems improve.
	;;

	;; ------------------------------------------------------------------
	;; TODO (FUTURE DIRECTION)
	;; ------------------------------------------------------------------
	;;
	;; REQUIRED FUTURE WORK:
	;;
	;;   - Remove silent server-side clamps
	;;   - Expose explicit, documented limits
	;;   - Tie view distance to:
	;;       * InterestManagement schemes
	;;       * Per-region performance budgets
	;;       * Content complexity metrics
	;;
	;; Until then:
	;;   These settings describe INTENT, not authority.
	;;
	;; ==================================================================

	;; ==================================================================
	;; IN-WORLD RESTART BEHAVIOR
	;; ==================================================================
	;;
	;; This setting controls what happens when a region is restarted
	;; from inside the simulator (for example via console command or
	;; in-world admin tools).
	;;
	;; It does NOT affect:
	;;   - Full simulator shutdowns
	;;   - Crashes
	;;   - External restarts initiated by systemd, Monit, etc.
	;;
	;; It ONLY affects "restart region" behavior.
	;;

	;; ------------------------------------------------------------------
	;; BACKGROUND / WHY THIS EXISTS
	;; ------------------------------------------------------------------
	;;
	;; OpenSim supports restarting an individual region without stopping
	;; the entire simulator process.
	;;
	;; HOWEVER, OpenSim was historically designed around:
	;;   - Long-lived singleton services
	;;   - Shared module state
	;;   - Cross-region caches
	;;
	;; Many modules were NOT written with full teardown and reinitialization
	;; in mind.
	;;
	;; As a result, restarting a region can leave behind:
	;;   - Stale references
	;;   - Dangling event handlers
	;;   - Corrupted in-memory state
	;;   - Half-initialized modules
	;;
	;; These are not cosmetic bugs.
	;; They are lifecycle and architecture issues.
	;;

	;; ------------------------------------------------------------------
	;; WHAT "THE BUGS" ACTUALLY ARE
	;; ------------------------------------------------------------------
	;;
	;; The following classes of problems are known and historically observed
	;; when restarting regions in-place:
	;;
	;;   - Script engines not fully resetting state
	;;   - Physics engines retaining objects or terrain references
	;;   - Interest management retaining stale client mappings
	;;   - Event queues surviving region reload
	;;   - Modules assuming one-time initialization only
	;;
	;; These issues:
	;;   - Do NOT always trigger immediately
	;;   - Often surface minutes or hours later
	;;   - Appear as random lag, desync, or viewer glitches
	;;
	;; That is why they are especially dangerous.
	;;

	;; ------------------------------------------------------------------
	;; DESIGN REALITY
	;; ------------------------------------------------------------------
	;;
	;; These are NOT simple "bugs" in the sense of missing null checks.
	;;
	;; They are the result of:
	;;   - A process-wide architecture
	;;   - Modules sharing global state
	;;   - Incomplete lifecycle boundaries
	;;
	;; Some of these issues are theoretically fixable.
	;; Many would require:
	;;   - Significant refactoring
	;;   - Explicit module teardown contracts
	;;   - Breaking backward compatibility
	;;
	;; As of current OpenSim versions:
	;;   - Full, clean region restart is NOT guaranteed safe
	;;

	;; ------------------------------------------------------------------
	;; WHAT THIS SETTING DOES
	;; ------------------------------------------------------------------
	;;
	;; InworldRestartShutsDown controls the failure mode when a region
	;; restart is requested.
	;;
	;; If true:
	;;   - The ENTIRE simulator process exits
	;;   - No attempt is made to restart the region in-place
	;;
	;; If false:
	;;   - OpenSim attempts an in-process region restart
	;;   - All known lifecycle risks apply
	;;
	;; This setting chooses between:
	;;   - Process-level restart (clean slate)
	;;   - In-process restart (fast but risky)
	;;

	;; ------------------------------------------------------------------
	;; WHY SHUTTING DOWN CAN BE SAFER
	;; ------------------------------------------------------------------
	;;
	;; In modern deployments, regions are often supervised by:
	;;   - systemd
	;;   - Monit
	;;   - Docker / container runtimes
	;;
	;; In these environments:
	;;   - A process exit is detected
	;;   - The simulator is restarted cleanly
	;;
	;; This guarantees:
	;;   - All memory is reclaimed
	;;   - All modules reinitialize correctly
	;;   - No hidden state survives
	;;
	;; This trades:
	;;   - Short downtime
	;; for:
	;;   - Predictable behavior
	;;   - Long-term stability
	;;

	;; ------------------------------------------------------------------
	;; USE CASE GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; SET TO true WHEN:
	;;   - Running a single region per simulator instance
	;;   - Using process supervision (systemd, Monit, etc.)
	;;   - Stability is more important than seamless restarts
	;;
	;; SET TO false WHEN:
	;;   - Running many regions in one simulator process
	;;   - You cannot afford all regions going offline together
	;;   - You accept the risk of in-process restart bugs
	;;
	;; NOTE:
	;;   Multi-region instances gain isolation efficiency
	;;   but lose restart safety.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR WARNING (NOT FUD)
	;; ------------------------------------------------------------------
	;;
	;; If you disable this and use in-process restarts:
	;;   - TEST thoroughly
	;;   - Expect rare, delayed failures
	;;   - Do not assume a restart "fixed" a problem
	;;
	;; If you enable this:
	;;   - Ensure an external watchdog is configured
	;;   - Expect a brief full-instance restart
	;;
	;; Neither option is "wrong".
	;; Each is a tradeoff.
	;;

	;; ------------------------------------------------------------------
	;; CONFIGURATION
	;; ------------------------------------------------------------------
	;;
	;; true  = In-world region restart triggers full process exit
	;; false = Attempt in-process region restart
	;;
	InworldRestartShutsDown = true

	;; ------------------------------------------------------------------
	;; FUTURE TODO
	;; ------------------------------------------------------------------
	;;
	;; Long-term fix requires:
	;;   - Explicit module teardown APIs
	;;   - Clear region lifecycle boundaries
	;;   - Elimination of hidden global state
	;;
	;; Until then, this setting exists to let operators choose
	;; a predictable failure mode.
	;;
	;; ==================================================================

	;; ==================================================================
	;; RESTART CONTROL INTERACTIONS AND CONFLICTS
	;; ==================================================================
	;;
	;; IMPORTANT:
	;; InworldRestartShutsDown is NOT the only mechanism that affects
	;; simulator and region restart behavior.
	;;
	;; There are OTHER restart-related controls that can interact with
	;; this setting, sometimes in non-obvious ways.
	;;

	;; ------------------------------------------------------------------
	;; RELATED CONTROLS THAT AFFECT RESTART BEHAVIOR
	;; ------------------------------------------------------------------
	;;
	;; The following mechanisms may also influence restart outcomes:
	;;
	;;   - External process supervisors (systemd, Monit, Docker, etc.)
	;;   - Startup and shutdown console command files
	;;   - In-world admin tools or scripts
	;;   - Region-level restart commands
	;;
	;; These operate at DIFFERENT layers:
	;;
	;;   Layer 1: In-world or console-triggered region restart
	;;   Layer 2: Simulator process lifecycle
	;;   Layer 3: External process supervision
	;;
	;; Confusion occurs when these layers are not aligned.
	;;

	;; ------------------------------------------------------------------
	;; MUTUAL EXCLUSIVITY AND CANCELLATION EFFECTS
	;; ------------------------------------------------------------------
	;;
	;; InworldRestartShutsDown ONLY controls what OpenSim does
	;; when a region restart is requested from inside the simulator.
	;;
	;; It does NOT override:
	;;   - External supervisors
	;;   - OS-level restart policies
	;;
	;; This leads to the following scenarios:
	;;
	;; --------------------------------------------------
	;; CASE 1: InworldRestartShutsDown = true
	;;         AND external supervisor is ACTIVE
	;; --------------------------------------------------
	;;
	;; Result:
	;;   - Region restart request causes OpenSim to exit
	;;   - Supervisor restarts the process
	;;   - All regions reload cleanly
	;;
	;; This is the INTENDED and SAFE configuration.
	;;
	;;
	;; --------------------------------------------------
	;; CASE 2: InworldRestartShutsDown = true
	;;         AND NO external supervisor
	;; --------------------------------------------------
	;;
	;; Result:
	;;   - Region restart request causes OpenSim to exit
	;;   - Simulator stays offline
	;;
	;; This often appears to users as:
	;;   "The grid just died"
	;;
	;; This is NOT a bug.
	;; This is misconfiguration.
	;;
	;;
	;; --------------------------------------------------
	;; CASE 3: InworldRestartShutsDown = false
	;;         AND admin assumes clean restarts
	;; --------------------------------------------------
	;;
	;; Result:
	;;   - OpenSim attempts in-process region restart
	;;   - Some subsystems may not fully reset
	;;   - Latent instability may occur
	;;
	;; This often appears as:
	;;   - Random lag later
	;;   - Script failures
	;;   - Physics oddities
	;;
	;;
	;; --------------------------------------------------
	;; CASE 4: Conflicting admin tooling
	;; --------------------------------------------------
	;;
	;; Example:
	;;   - In-world tool requests region restart
	;;   - Startup/shutdown scripts assume full process restart
	;;   - External supervisor restarts anyway
	;;
	;; Result:
	;;   - Double restarts
	;;   - Users disconnected twice
	;;   - Regions flapping online/offline
	;;
	;; This is a REAL, observed failure mode.
	;;

	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; To avoid unintended behavior:
	;;
	;;   - Decide whether restarts are REGION-scoped or PROCESS-scoped
	;;   - Align ALL layers to that decision
	;;
	;; If using InworldRestartShutsDown = true:
	;;   - You MUST have an external supervisor
	;;   - You MUST expect full instance restarts
	;;
	;; If using InworldRestartShutsDown = false:
	;;   - You MUST accept in-process restart risks
	;;   - You MUST test restart paths thoroughly
	;;
	;; Mixing assumptions causes disruption.
	;;

	;; ------------------------------------------------------------------
	;; USER AND GRID IMPACT
	;; ------------------------------------------------------------------
	;;
	;; Misaligned restart settings can cause:
	;;
	;;   - Unexpected grid-wide outages
	;;   - Region restarts disconnecting unrelated regions
	;;   - User inventory operations interrupted mid-flight
	;;   - Corrupted perception of "random instability"
	;;
	;; These are NOT user errors.
	;; They are configuration coherence failures.
	;;

	;; ------------------------------------------------------------------
	;; SUMMARY
	;; ------------------------------------------------------------------
	;;
	;; This setting does NOT operate in isolation.
	;;
	;; Restart behavior is a SYSTEM:
	;;   Simulator logic
	;;   Admin tooling
	;;   External supervision
	;;
	;; Treat it as such.
	;;
	;; ==================================================================

	;; ==================================================================
	;; FRAME TIMING AND UPDATE CADENCE
	;; ==================================================================
	;;
	;; THIS SECTION DEFINES THE SIMULATOR'S HEARTBEAT.
	;;
	;; OpenSim does NOT run at a fixed FPS like a game engine.
	;; Instead, it runs a simulation loop where multiple subsystems
	;; (physics, scripts, movement, updates, persistence) are executed
	;; on a repeating frame cycle.
	;;
	;; These settings determine:
	;;   - How often the simulator "ticks"
	;;   - How frequently different subsystems run
	;;   - How load is distributed when the server is under stress
	;;
	;; THINK OF THIS AS:
	;;   The scheduler that decides WHAT runs, HOW OFTEN, and IN WHAT ORDER
	;;
	;; This directly affects:
	;;   - Avatar movement smoothness
	;;   - Physics stability
	;;   - Script responsiveness
	;;   - Viewer lag indicators
	;;   - Network traffic volume
	;;
	;; It does NOT:
	;;   - Magically improve performance
	;;   - Fix overloaded hardware
	;;   - Override viewer-side limits
	;;
	;; Changing values here trades CPU, network, and stability against
	;; smoothness and responsiveness.
	;;

	;; ------------------------------------------------------------------
	;; NORMALIZED FPS REPORTING
	;; ------------------------------------------------------------------
	;;
	;; Normalized55FPS does NOT change actual simulator speed.
	;;
	;; It ONLY affects how timing-related statistics are REPORTED
	;; to viewers and scripts.
	;;
	;; WHY THIS EXISTS:
	;;   - Viewers and scripts historically assume ~55 FPS behavior
	;;   - OpenSim rarely runs at exactly that rate
	;;
	;; WHEN TRUE:
	;;   - Timing values are scaled as if the sim were running at 55 FPS
	;;   - Viewer lag meters appear more "normal"
	;;   - Script timing feels closer to SL expectations
	;;
	;; WHEN FALSE:
	;;   - Viewers see the real, raw timing
	;;   - Lag meters may look worse even if behavior is acceptable
	;;
	;; RECOMMENDED:
	;;   true for public grids
	;;   false for debugging or physics tuning
	;;
	Normalized55FPS = true

	;; ------------------------------------------------------------------
	;; FRAME TIME (CORE SIMULATION RATE)
	;; ------------------------------------------------------------------
	;;
	;; FrameTime defines how long ONE simulation frame lasts, in seconds.
	;;
	;; Default (~0.0909) corresponds to ~11 frames per second.
	;;
	;; LOWER FrameTime:
	;;   - More frequent updates
	;;   - Smoother motion
	;;   - Higher CPU and network load
	;;
	;; HIGHER FrameTime:
	;;   - Less CPU usage
	;;   - Choppier movement
	;;   - Slower script and physics response
	;;
	;; CRITICAL RULE:
	;;   FrameTime MUST NOT be lower than the physics engine step time.
	;;
	;; Changing this REQUIRES adjusting the *EveryNFrames values below
	;; or subsystem timing will silently change.
	;;
	FrameTime = 0.0909

	;; ------------------------------------------------------------------
	;; VIEWER LAG METER THRESHOLDS
	;; ------------------------------------------------------------------
	;;
	;; These values DO NOT control performance.
	;;
	;; They only tell the viewer when to display:
	;;   - Yellow (warning)
	;;   - Red (critical)
	;;
	;; They are advisory hints, not enforcement.
	;;
	FrameTimeWarnPercent = 60
	FrameTimeCritPercent = 40

	;; ------------------------------------------------------------------
	;; UPDATE CADENCE (N FRAMES)
	;; ------------------------------------------------------------------
	;;
	;; The settings below define HOW OFTEN each subsystem runs,
	;; measured in simulation frames.
	;;
	;; Example:
	;;   UpdateXEveryNFrames = 1   → runs every frame
	;;   UpdateXEveryNFrames = 10  → runs once every 10 frames
	;;
	;; Increasing N:
	;;   - Reduces CPU and network load
	;;   - Increases latency and perceived lag
	;;
	;; Decreasing N:
	;;   - Improves responsiveness
	;;   - Increases load

	;; =====================================================================
	;; SIMULATION UPDATE CADENCE  (CORE BEHAVIOR VS VISUAL DELIVERY)
	;; =====================================================================
	;;
	;; THIS SECTION CONTROLS HOW OFTEN THE SIMULATOR:
	;;   - Executes internal simulation work
	;;   - Sends state updates to viewers
	;;
	;; SOME SETTINGS HERE AFFECT REAL PHYSICS AND SCRIPT BEHAVIOR.
	;; OTHERS ONLY AFFECT HOW OFTEN CLIENTS ARE NOTIFIED.
	;;
	;; DO NOT CONFUSE VISUAL SMOOTHNESS WITH SIMULATION CORRECTNESS.
	;;
	;; RULE OF THUMB:
	;;   - Anything that affects PHYSICS or EVENT EXECUTION is REAL behavior.
	;;   - Anything that affects UPDATE SENDING affects PERCEPTION and BANDWIDTH.
	;;
	;; Changing the wrong values here WILL NOT FIX LAG
	;; and CAN create instability or user-visible breakage.
	;;
	;; =====================================================================

	;; ---------------------------------------------------------------------
	;; OBJECT STATE UPDATE CADENCE
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often object position, rotation, scale, and linkset
	;; state changes are processed and sent to viewers.
	;;
	;; EFFECT:
	;;   - Objects still move internally every frame.
	;;   - Higher values delay when viewers are informed.
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Choppy object motion
	;;   - Vehicles feel sluggish
	;;   - Rotating or moving builds "step"
	;;
	;; DOES NOT FIX:
	;;   - Physics bugs
	;;   - Script inefficiency
	;;
	;; RECOMMENDED:
	;;   1 for almost all grids
	;;
	UpdateObjectsEveryNFrames = 1

	;; ---------------------------------------------------------------------
	;; AVATAR MOVEMENT UPDATE CADENCE
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often avatar movement and velocity updates
	;; are sent to OTHER viewers.
	;;
	;; EFFECT:
	;;   - Avatars still move correctly internally.
	;;   - Observers receive fewer updates.
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Other avatars appear laggy or jerky
	;;   - Combat, dancing, vehicles look broken
	;;
	;; COMMON MISDIAGNOSIS:
	;;   - Users report "lag" even when server is healthy.
	;;
	;; RECOMMENDED:
	;;   1
	;;
	UpdateAgentsEveryNFrames = 1

	;; ---------------------------------------------------------------------
	;; PHYSICS FORCE APPLICATION CADENCE
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often physics forces are applied to entities.
	;;
	;; THIS IS REAL SIMULATION BEHAVIOR.
	;;
	;; AFFECTS:
	;;   - Gravity
	;;   - Collisions
	;;   - Vehicles
	;;   - Falling and movement stability
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Floaty or unstable physics
	;;   - Vehicles break
	;;   - Collisions feel wrong
	;;
	;; WARNING:
	;;   Changing this breaks physics correctness.
	;;
	;; RECOMMENDED:
	;;   MUST BE 1
	;;
	UpdateEntityMovementEveryNFrames = 1

	;; ---------------------------------------------------------------------
	;; COARSE AVATAR LOCATION UPDATES (MINIMAP / RADAR)
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often coarse avatar locations are sent.
	;;
	;; USED BY:
	;;   - Minimap
	;;   - Radar indicators
	;;
	;; DOES NOT AFFECT:
	;;   - Actual movement
	;;   - Physics
	;;
	;; SAFE TO TUNE FOR BANDWIDTH REDUCTION.
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Slower minimap updates
	;;   - Avatar dots "jump"
	;;
	UpdateCoarseLocationsEveryNFrames = 50

	;; ---------------------------------------------------------------------
	;; PHYSICS ENGINE EXECUTION / SYNCHRONIZATION
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often the physics engine runs or synchronizes.
	;;
	;; THIS IS CORE SIMULATION TIMING.
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Reduced physics accuracy
	;;   - Collision errors
	;;   - Vehicles degrade rapidly
	;;
	;; WARNING:
	;;   DO NOT CHANGE THIS UNLESS YOU ARE MODIFYING PHYSICS ENGINE CODE.
	;;
	UpdatePhysicsEveryNFrames = 1

	;; ---------------------------------------------------------------------
	;; PER-FRAME EVENT DISPATCH
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often per-frame events are dispatched
	;; to modules and internal listeners.
	;;
	;; AFFECTS:
	;;   - Script timing
	;;   - Region logic
	;;   - Module responsiveness
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Delayed script reactions
	;;   - Subtle logic drift
	;;
	;; RECOMMENDED:
	;;   1
	;;
	UpdateEventsEveryNFrames = 1

	;; ---------------------------------------------------------------------
	;; TERRAIN UPDATE DELIVERY
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often terrain patches are sent to viewers.
	;;
	;; DOES NOT AFFECT:
	;;   - Collision
	;;   - Walking
	;;   - Physics
	;;
	;; USER IMPACT WHEN INCREASED:
	;;   - Terraforming appears delayed
	;;   - Terrain edits snap instead of flowing
	;;
	;; SAFE FOR BANDWIDTH OPTIMIZATION.
	;;
	UpdateTerrainEveryNFrames = 50

	;; ---------------------------------------------------------------------
	;; OBJECT STATE PERSISTENCE (DATABASE WRITES)
	;; ---------------------------------------------------------------------
	;;
	;; Controls how often modified objects are written to storage.
	;;
	;; AFFECTS:
	;;   - Database load
	;;   - Crash recovery window
	;;
	;; DOES NOT AFFECT:
	;;   - Physics
	;;   - Viewer updates
	;;   - Script execution
	;;
	;; TRADEOFF:
	;;   Higher values reduce DB writes but increase potential
	;;   state loss if the region crashes.
	;;
	UpdateStorageEveryNFrames = 200

	;; ------------------------------------------------------------------
	;; TEMP-ON-REZ CLEANUP
	;; ------------------------------------------------------------------
	;;
	;; Temp-on-rez objects:
	;;   - Do not persist
	;;   - Often used for effects, vendors, weapons, vehicles
	;;   - Can be abused and silently accumulate
	;;
	;; This setting controls how often they are cleaned up.
	;;
	;; LOWER values:
	;;   - More aggressive cleanup
	;;   - Less abuse potential
	;;   - Slightly higher background load
	;;
	;; HIGHER values:
	;;   - Lower overhead
	;;   - Greater risk of buildup
	;;
	;; Value is in SECONDS.
	;;
	UpdateTempCleaningEveryNSeconds = 180

	;; ------------------------------------------------------------------
	;; OPERATOR WARNING
	;; ------------------------------------------------------------------
	;;
	;; DO NOT change multiple values here at once.
	;;
	;; DO NOT tune this section to "fix lag" without profiling.
	;;
	;; These settings define SYSTEM BEHAVIOR, not content quality.
	;;
	;; Bad values here produce:
	;;   - Stutter
	;;   - Desync
	;;   - Script weirdness
	;;   - User complaints that look unrelated
	;;
	;; If you touch this section:
	;;   - Change ONE thing
	;;   - Measure
	;;   - Observe
	;;
	;; ==================================================================

	;; =====================================================================
	;; PRIM STORAGE  (OBJECT PERSISTENCE / DATABASE WRITE CONTROL)
	;; =====================================================================
	;;
	;; THIS SECTION CONTROLS WHEN MODIFIED OBJECTS ARE SAVED TO STORAGE.
	;;
	;; This does NOT control:
	;;   - Viewer updates
	;;   - Physics
	;;   - Script execution
	;;
	;; This DOES control:
	;;   - How often object state is written to the database
	;;   - How much object state may be lost in a crash
	;;   - Database load caused by frequently changing objects
	;;
	;; ---------------------------------------------------------------------
	;; WHY THIS EXISTS
	;; ---------------------------------------------------------------------
	;;
	;; Many objects change state repeatedly:
	;;   - Doors opening and closing
	;;   - Vendors updating hover text
	;;   - Scripted animations
	;;   - Vehicles
	;;
	;; Writing every tiny change immediately would:
	;;   - Hammer the database
	;;   - Increase I/O latency
	;;   - Reduce overall region performance
	;;
	;; Instead, OpenSim waits until an object "settles"
	;; before committing it to storage.
	;;
	;; ---------------------------------------------------------------------
	;; HOW PERSISTENCE ACTUALLY WORKS
	;; ---------------------------------------------------------------------
	;;
	;; Object persistence is evaluated during periodic sweeps.
	;;
	;; An object is eligible to be saved if:
	;;   - It has stopped changing for a minimum amount of time
	;;     OR
	;;   - It has existed in a changing state for too long and MUST be saved
	;;
	;; These two timers work TOGETHER.
	;;
	;; ---------------------------------------------------------------------
	;; MinimumTimeBeforePersistenceConsidered
	;; ---------------------------------------------------------------------
	;;
	;; This is a "cool-down" timer.
	;;
	;; Meaning:
	;;   - An object must remain UNCHANGED for this many seconds
	;;     before it is eligible to be saved.
	;;
	;; PURPOSE:
	;;   - Prevent saving objects that are actively changing
	;;   - Reduce write churn from scripted motion
	;;
	;; IF SET TOO LOW:
	;;   - Frequent DB writes
	;;   - Increased database load
	;;   - Worse performance on busy regions
	;;
	;; IF SET TOO HIGH:
	;;   - Objects may not be saved promptly
	;;   - More state lost on crashes
	;;
	;; USER-VISIBLE EFFECTS:
	;;   - Normally none
	;;   - Only visible after a crash or forced restart
	;;
	MinimumTimeBeforePersistenceConsidered = 60

	;; ---------------------------------------------------------------------
	;; MaximumTimeBeforePersistenceConsidered
	;; ---------------------------------------------------------------------
	;;
	;; This is a "force-save" timer.
	;;
	;; Meaning:
	;;   - Even if an object keeps changing,
	;;     it WILL be saved once this many seconds
	;;     have passed since its first change.
	;;
	;; PURPOSE:
	;;   - Prevent objects from NEVER being saved
	;;   - Protect against permanent state loss
	;;
	;; IF SET TOO LOW:
	;;   - Frequent forced saves
	;;   - Higher database load
	;;
	;; IF SET TOO HIGH:
	;;   - Large windows of unsaved state
	;;   - Significant object rollback after crashes
	;;
	;; USER-VISIBLE EFFECTS:
	;;   - Objects reverting after crashes
	;;   - Vendors losing transaction state
	;;   - Doors reverting to old positions
	;;
	MaximumTimeBeforePersistenceConsidered = 600

	;; ---------------------------------------------------------------------
	;; IMPORTANT OPERATOR NOTES
	;; ---------------------------------------------------------------------
	;;
	;; Setting BOTH values to 0 means:
	;;   - ALL changed objects are written EVERY sweep
	;;   - Maximum safety
	;;   - Maximum database load
	;;
	;; This is generally NOT recommended except for:
	;;   - Very small grids
	;;   - Debugging persistence bugs
	;;
	;; These settings do NOT affect:
	;;   - How objects behave while the region is running
	;;   - Script responsiveness
	;;
	;; They ONLY affect:
	;;   - When state is committed to storage
	;;   - What survives crashes or forced shutdowns
	;;
	;; ---------------------------------------------------------------------
	;; SAFE DEFAULT GUIDANCE
	;; ---------------------------------------------------------------------
	;;
	;; Small / hobby grids:
	;;   30 / 300
	;;
	;; Medium production grids:
	;;   60 / 600
	;;
	;; Heavy scripted / vendor-heavy regions:
	;;   90 / 900
	;;
	;; Database-constrained environments:
	;;   Increase both values cautiously
	;;
	;; =====================================================================


    ;; ##
    ;; ## PHYSICS
    ;; ##

	;; =====================================================================
	;; PRIM COLLISION, PHYSICS, AND MESHING
	;; =====================================================================
	;;
	;; THIS SECTION DIRECTLY AFFECTS:
	;;   - Avatar movement and collisions
	;;   - Vehicles and physical objects
	;;   - Pushability, gravity, and forces
	;;   - User perception of "solid" vs "ghost" objects
	;;
	;; THIS SECTION IS A MAJOR USER EXPERIENCE CONTROL POINT.
	;;
	;; Misunderstanding these settings leads to:
	;;   - "Physics is broken" complaints
	;;   - Vehicles behaving unpredictably
	;;   - Avatars walking through builds
	;;   - Incorrect assumptions about performance
	;;
	;; ---------------------------------------------------------------------
	;; collidable_prim
	;; ---------------------------------------------------------------------
	;;
	;; Controls whether prims participate in COLLISION detection.
	;;
	;; If true:
	;;   - Avatars collide with prims
	;;   - Prims collide with other prims
	;;   - Phantom flag on individual prims is respected
	;;
	;; If false:
	;;   - ALL prims behave as phantom
	;;   - Avatar can walk through everything
	;;   - NO prim participates in physics
	;;   - Physics engine is effectively bypassed
	;;
	;; IMPORTANT:
	;;   - This does NOT disable physics code
	;;   - It disables collision participation entirely
	;;
	;; USER-VISIBLE EFFECTS IF FALSE:
	;;   - Buildings become non-solid
	;;   - Floors do not stop avatars
	;;   - Vehicles fall through terrain
	;;
	;; PERFORMANCE NOTE:
	;;   - Turning this off does NOT meaningfully improve performance
	;;   - It simply breaks the world
	;;
	collidable_prim = true

	;; ---------------------------------------------------------------------
	;; physical_prim
	;; ---------------------------------------------------------------------
	;;
	;; Controls whether prims can be made PHYSICAL.
	;;
	;; Physical prims are affected by:
	;;   - Gravity
	;;   - Forces
	;;   - Collisions that impart momentum
	;;
	;; If true:
	;;   - Scripts can set objects physical
	;;   - Vehicles work
	;;   - Push, fall, slide, roll behaviors exist
	;;
	;; If false:
	;;   - Physics flag is ignored
	;;   - Objects remain solid but static
	;;   - Gravity does not apply
	;;
	;; IMPORTANT DISTINCTION:
	;;   - collidable_prim controls solidity
	;;   - physical_prim controls motion and forces
	;;
	;; USER-VISIBLE EFFECTS IF FALSE:
	;;   - Vehicles stop working
	;;   - Physical puzzles break
	;;   - Objects no longer fall or move
	;;
	;; PERFORMANCE NOTE:
	;;   - Disabling physics may reduce load
	;;   - But removes a major interactive feature
	;;
	physical_prim = true

	;; ---------------------------------------------------------------------
	;; meshing
	;; ---------------------------------------------------------------------
	;;
	;; Selects the MESHER used to generate collision shapes
	;; for the physics engine.
	;;
	;; The mesher determines:
	;;   - How accurately shapes match visible geometry
	;;   - How expensive collision calculations are
	;;
	;; THIS DOES NOT:
	;;   - Affect rendering
	;;   - Change visible meshes
	;;
	;; It ONLY affects physics collision shapes.
	;;
	;; AVAILABLE OPTIONS:
	;;
	;; ubODEMeshmerizer
	;;   - Required for ubODE physics
	;;   - Best accuracy
	;;   - Supports mesh, sculpt, tortured prims
	;;   - Higher CPU cost
	;;
	;; Meshmerizer
	;;   - Legacy mesher
	;;   - Lower accuracy
	;;   - Not compatible with ubODE
	;;
	;; ZeroMesher
	;;   - Extremely simplified shapes
	;;   - Lowest CPU usage
	;;   - Poor collision fidelity
	;;
	;; IMPORTANT:
	;;   - ubODE physics REQUIRES ubODEMeshmerizer
	;;   - Mismatching physics engine and mesher
	;;     WILL break collisions
	;;
	;; USER EXPERIENCE IMPACT:
	;;   - Poor meshing leads to:
	;;       - Invisible walls
	;;       - Falling through objects
	;;       - Vehicles snagging
	;;
	;; PERFORMANCE REALITY:
	;;   - Meshing cost is paid at rez time
	;;   - Not per-frame
	;;   - Accuracy usually outweighs cost
	;;
	meshing = ubODEMeshmerizer

	;; ---------------------------------------------------------------------
	;; COMMON MISCONCEPTIONS
	;; ---------------------------------------------------------------------
	;;
	;; "Turning physics off reduces lag"
	;;   - False. It removes features, not load sources.
	;;
	;; "Collision and physics are the same thing"
	;;   - False. Collision is solidity.
	;;     Physics is motion and force.
	;;
	;; "Meshing affects graphics"
	;;   - False. It affects collision shapes only.
	;;
	;; ---------------------------------------------------------------------
	;; SAFE OPERATION GUIDANCE
	;; ---------------------------------------------------------------------
	;;
	;; Production grids:
	;;   collidable_prim = true
	;;   physical_prim   = true
	;;   meshing         = ubODEMeshmerizer
	;;
	;; Experimental or static art grids:
	;;   physical_prim may be false
	;;   collidable_prim should remain true
	;;
	;; NEVER disable collidable_prim on a live grid.
	;;
	;; =====================================================================
	;;
	;; =====================================================================
	;; PHYSICS AND PERFORMANCE REALITY CHECK
	;; =====================================================================
	;;
	;; Physics performance and user perception are NOT controlled by a single
	;; setting or even a single subsystem.
	;;
	;; What users experience as:
	;;   - "Lag"
	;;   - "Jitter"
	;;   - "Broken physics"
	;;   - "Vehicles not working"
	;;
	;; is the RESULT of a COMBINED SYSTEM.
	;;
	;; ---------------------------------------------------------------------
	;; MAJOR CONTRIBUTORS TO PHYSICS PERFORMANCE AND PERCEPTION
	;; ---------------------------------------------------------------------
	;;
	;; Server-side factors:
	;;   - Physics engine choice (ubODE, etc.)
	;;   - Mesher choice and accuracy
	;;   - Physics tuning values
	;;   - Script load and script behavior
	;;   - Number of active physical objects
	;;   - Number of avatars in the scene
	;;   - Region size (varregions amplify cost)
	;;   - Region frame time and scheduling
	;;   - Storage and persistence load
	;;
	;; Build and content quality:
	;;   - Excessive use of physical prims
	;;   - Poorly optimized meshes
	;;   - Overuse of convex hulls
	;;   - Large linksets with physics enabled
	;;   - Vehicles with unstable mass or force models
	;;
	;; Infrastructure factors:
	;;   - CPU single-core performance
	;;   - Memory pressure and GC behavior
	;;   - Disk latency
	;;   - Network latency and packet loss
	;;   - Cross-region traffic
	;;
	;; Client-side factors:
	;;   - Viewer physics interpolation
	;;   - Draw distance
	;;   - Viewer FPS stability
	;;   - Client hardware capability
	;;   - Network stability on the user end
	;;
	;; ---------------------------------------------------------------------
	;; IMPORTANT OPERATOR REALITY
	;; ---------------------------------------------------------------------
	;;
	;; Changing a physics or meshing setting MAY:
	;;   - Improve one symptom
	;;   - Expose another bottleneck
	;;
	;; It will NOT:
	;;   - Magically fix bad content
	;;   - Compensate for underpowered hardware
	;;   - Override viewer-side limits
	;;
	;; Physics tuning is always a TRADE SPACE between:
	;;   - Accuracy
	;;   - Stability
	;;   - Performance
	;;   - User expectations
	;;
	;; ---------------------------------------------------------------------
	;; MITIGATION STRATEGIES THAT ACTUALLY WORK
	;; ---------------------------------------------------------------------
	;;
	;; Effective mitigation comes from:
	;;   - Sensible physics tuning
	;;   - Clear build quality guidelines
	;;   - Limiting unnecessary physical objects
	;;   - Educating content creators
	;;   - Managing avatar density
	;;   - Monitoring region frame time
	;;   - Understanding viewer behavior
	;;
	;; No single toggle replaces GOOD ENGINEERING PRACTICE.
	;;
	;; ---------------------------------------------------------------------
	;; NON-EXHAUSTIVE LIST
	;; ---------------------------------------------------------------------
	;;
	;; This documentation does NOT represent an exhaustive list of all
	;; performance-affecting variables.
	;;
	;; Physics behavior emerges from interaction between multiple systems.
	;; Expect iteration, measurement, and refinement over time.
	;;
	;; =====================================================================

	;; =====================================================================
	;; SCULPT MAP DECODING AND COLLISION CACHE
	;; =====================================================================
	;;
	;; This section controls how OpenSim handles DECODED sculpt maps.
	;;
	;; Sculpt maps are stored as compressed images (JPEG2000) in the asset
	;; service. For physics and collision calculations, they must be
	;; DECODED into raw height/vertex data.
	;;
	;; This decoding process is:
	;;   - CPU intensive
	;;   - Asset-service dependent
	;;   - Required for accurate sculpt collisions
	;;
	;; ---------------------------------------------------------------------
	;; WHY THIS MATTERS
	;; ---------------------------------------------------------------------
	;;
	;; If sculpt maps are NOT cached:
	;;   - They are re-decoded repeatedly
	;;   - Physics initialization is slower
	;;   - Region startup times increase
	;;   - Missing or delayed collisions may occur
	;;
	;; Users experience this as:
	;;   - Falling through sculpted objects
	;;   - Inconsistent collision behavior
	;;   - Low perceived build quality
	;;   - "Lag" or "slow rez" complaints
	;;
	;; These issues rarely generate explicit errors.
	;;
	;; ---------------------------------------------------------------------
	;; DecodedSculptMapPath
	;; ---------------------------------------------------------------------
	;;
	;; Path where decoded sculpt maps are stored on disk.
	;;
	;; PURPOSE:
	;;   - Avoid repeated decode operations
	;;   - Reduce asset fetches during startup
	;;   - Improve physics initialization consistency
	;;
	;; DEFAULT:
	;;   "j2kDecodeCache" (relative to bin/)
	;;
	;; NOTES:
	;;   - Directory must be writable
	;;   - Disk I/O quality affects performance
	;;   - Shared storage on slow disks can negate benefits
	;;
	;; ---------------------------------------------------------------------
	;; CacheSculptMaps
	;; ---------------------------------------------------------------------
	;;
	;; Controls whether decoded sculpt maps are cached on disk.
	;;
	;; EFFECT WHEN ENABLED:
	;;   - Faster region startup after restarts
	;;   - Reduced asset service load
	;;   - More consistent sculpt collisions
	;;
	;; EFFECT WHEN DISABLED:
	;;   - Sculpt maps decoded on demand
	;;   - Higher CPU usage
	;;   - Greater dependency on asset availability
	;;
	;; COMPATIBILITY WARNING:
	;;   - Some older Mono runtimes had issues reading cached files
	;;   - If you see startup crashes or corruption, disable caching
	;;
	;; MODERN REALITY:
	;;   - Generally safe on current runtimes
	;;   - Beneficial on grids using sculpt-heavy content
	;;
	;; ---------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ---------------------------------------------------------------------
	;;
	;; Enable caching when:
	;;   - Regions use many sculpted objects
	;;   - Physics collisions must be reliable
	;;   - Startup time consistency matters
	;;
	;; Disable caching when:
	;;   - Debugging asset corruption
	;;   - Running on problematic runtimes
	;;   - Disk I/O is unstable
	;;
	;; This setting affects PHYSICS RELIABILITY, not just performance.
	;;
	;; =====================================================================

    ;; ------------------------------------------------------------------
    ;; Physics Engine Selection
    ;; ------------------------------------------------------------------
    ;;
    ;; This setting selects which physics simulation backend OpenSim uses.
    ;; Each engine has VERY different behavior, performance characteristics,
    ;; and compatibility with real-world builds.
    ;;
    ;; IMPORTANT:
    ;; Physics engines are NOT interchangeable.
    ;; Switching engines WILL change how existing builds behave.
    ;; Many engines make tradeoffs that are undocumented and misleading.
    ;;

    ;; --------------------------------------------------
    ;; BulletSim
    ;; --------------------------------------------------
    ;; BulletSim is based on the Bullet physics library.
    ;;
    ;; PROS:
    ;;    Handles convex mesh collision better than legacy ODE.
    ;;    Stable for vehicles, basic rigid body motion, and avatars.
    ;;    Actively maintained within OpenSim.
    ;;
    ;; CONS:
    ;;    Poor handling of complex or concave meshes.
    ;;    Known issues with walkable surfaces, stairs, bridges, and doorways.
    ;;    Frequent physics rebuilds under load cause jitter and lag.
    ;;    Misleading reputation as "more realistic" than ODE.
    ;;
    ;; REALITY:
    ;; BulletSim often breaks legacy builds that worked fine under ODE or PhysX.
    ;; It is NOT a drop-in upgrade and is a common source of frustration.
    ;;
    ;; physics = BulletSim

    ;; --------------------------------------------------
    ;; modified_BulletX
    ;; --------------------------------------------------
    ;; Experimental fork of an older Bullet integration.
    ;;
    ;; PROS:
    ;;    None that justify use today.
    ;;
    ;; CONS:
    ;;    Incomplete.
    ;;    Poorly maintained.
    ;;    Inconsistent behavior across regions.
    ;;
    ;; REALITY:
    ;; This exists mostly for historical or experimental reasons.
    ;; Do not use on production grids.
    ;;
    ;; physics = modified_BulletX

    ;; --------------------------------------------------
    ;; basicphysics
    ;; --------------------------------------------------
    ;; Minimal, non-realistic physics engine.
    ;;
    ;; PROS:
    ;;    Extremely low CPU usage.
    ;;    Predictable and stable.
    ;;
    ;; CONS:
    ;;    No real collision handling.
    ;;    No vehicles.
    ;;    No realistic movement.
    ;;
    ;; REALITY:
    ;; Intended ONLY for placeholder regions, testing, or art-only spaces.
    ;; Not suitable for interactive worlds.
    ;;
    ;; physics = basicphysics

    ;; --------------------------------------------------
    ;; POS (Physics On a Stick)
    ;; --------------------------------------------------
    ;; Very old and mostly deprecated physics system.
    ;;
    ;; PROS:
    ;;    Simple.
    ;;    Lightweight.
    ;;
    ;; CONS:
    ;;    Outdated.
    ;;    Poor collision fidelity.
    ;;    Not actively maintained.
    ;;
    ;; REALITY:
    ;; Legacy option. Avoid unless maintaining ancient content.
    ;;
    ;; physics = POS

    ;; --------------------------------------------------
    ;; ubODE (Unified Backported ODE)
    ;; --------------------------------------------------
    ;; Modernized and heavily improved ODE-based physics engine.
    ;;
    ;; PROS:
    ;;    Excellent compatibility with legacy builds.
    ;;    Reliable walking surfaces, stairs, bridges, ramps, and doorways.
    ;;    Predictable collision behavior.
    ;;    Performs well under sustained load.
    ;;    Tunable via parameters without breaking existing content.
    ;;    Actively maintained and improved.
    ;;
    ;; CONS:
    ;;    Less "flashy" than Bullet for vehicles.
    ;;    Requires tuning for optimal performance and realism.
    ;;
    ;; REALITY:
    ;; ubODE is the closest thing OpenSim has to PhysX-like behavior
    ;; without being tied to Windows, PhysX.NET, or dead SDKs.
    ;;
    ;; This is the correct choice for grids that value:
    ;;    Build integrity
    ;;    Walkability
    ;;    Predictability
    ;;    Long-term maintainability
    ;;
    physics = ubODE

    ;; ------------------------------------------------------------------
    ;; SCRIPT ENGINE  (LEGACY-FIXED)
    ;; ------------------------------------------------------------------
    ;;
    ;; IMPORTANT HISTORICAL NOTE:
    ;;
    ;; OpenSim previously supported multiple script engines:
    ;;    XEngine (removed)
    ;;    YEngine (current and only option)
    ;;
    ;; BOTH XEngine and YEngine were Mono / .NET compatible runtimes.
    ;; YEngine was NOT a move to a "new .NET engine".
    ;;
    ;; The difference between XEngine and YEngine was ARCHITECTURAL:
    ;;    script isolation
    ;;    scheduling
    ;;    memory management
    ;;
    ;; XEngine was removed due to maintainability and stability issues.
    ;; YEngine remains because it is safer, not because it is newer tech.
    ;;
    ;; THERE IS NO ALTERNATIVE SCRIPT ENGINE IN MODERN OPENSIM.
    ;; This setting is effectively fixed and retained only for
    ;; backward compatibility and configuration clarity.
    ;;

    ;; --------------------------------------------------
    ;; DefaultScriptEngine
    ;; --------------------------------------------------
    ;;
    ;; Default script engine used by all regions.
    ;;
    ;; CURRENT STATUS:
    ;;    YEngine is mandatory
    ;;    Any other value is ignored or invalid
    ;;
    ;; WHAT YENGINE IS:
    ;;    Mono / .NET compatible runtime
    ;;    LSL compiled to C#
    ;;    Cooperative multitasking
    ;;    Event-driven execution
    ;;
    ;; WHAT YENGINE IS NOT:
    ;;    Not a native VM
    ;;    Not a JIT replacement
    ;;    Not a performance silver bullet
    ;;
    ;; REALITY:
    ;; Script performance issues must be solved by:
    ;;    reducing script count
    ;;    optimizing scripts
    ;;    spreading load across regions
    ;;
    ;; NOT by chasing non-existent engines.
    ;;
    DefaultScriptEngine = "YEngine"

    ;; --------------------------------------------------
    ;; HttpProxy
    ;; --------------------------------------------------
    ;;
    ;; Optional HTTP proxy for outbound script HTTP requests.
    ;;
    ;; AFFECTS:
    ;;    llHTTPRequest
    ;;    External API calls
    ;;    Dynamic texture loading
    ;;
    ;; LEAVE DISABLED unless you explicitly require a proxy.
    ;;
    ;; HttpProxy = "http://proxy.com:8080"

    ;; --------------------------------------------------
    ;; HttpProxyExceptions
    ;; --------------------------------------------------
    ;;
    ;; Semicolon-separated list of regular expressions for URLs
    ;; that should bypass the HTTP proxy.
    ;;
    ;; ONLY USED if HttpProxy is enabled.
    ;;
    ;; EXAMPLE:
    ;;   ".mydomain.com;localhost;127.0.0.1"
    ;;
    ;; HttpProxyExceptions = ".mydomain.com;localhost"

	;; ------------------------------------------------------------------
	;; EMAIL MODULE  (LEGACY-SINGLETON)
	;; ------------------------------------------------------------------
	;;
	;; OpenSim supports in-world email delivery via llEmail().
	;;
	;; IMPORTANT:
	;; There is ONLY ONE email module in modern OpenSim:
	;;    DefaultEmailModule
	;;
	;; This setting does NOT offer multiple implementations.
	;; It exists for historical extensibility only.
	;;
	;; IMPORTANT CONTEXT:
	;;
	;; In-world email (llEmail) is a LEGACY communication mechanism.
	;;
	;; MODERN REALITY:
	;;    Most contemporary scripts DO NOT rely on email
	;;    HTTP requests (llHTTPRequest) and external APIs are preferred
	;;    Webhooks, REST endpoints, and JSON APIs provide:
	;;       - better reliability
	;;       - authentication
	;;       - rate limiting
	;;       - auditing
	;;
	;; EMAIL LIMITATIONS:
	;;    Slow delivery
	;;    Poor error feedback
	;;    Easy to abuse
	;;    High risk of spam and blacklisting
	;;
	;; EMAIL SHOULD ONLY BE ENABLED FOR:
	;;    Legacy content that explicitly requires llEmail()
	;;    Controlled internal messaging
	;;    Transitional compatibility
	;;
	;; RECOMMENDATION:
	;; Leave SMTP disabled unless a VERIFIED use case exists.
	;;
	;; For new development, prefer:
	;;    llHTTPRequest
	;;    External API services
	;;    Authenticated webhooks
	;;
	;; This section remains ONLY for backward compatibility.
	;;

	;; --------------------------------------------------
	;; emailmodule
	;; --------------------------------------------------
	;;
	;; Enables the built-in email module.
	;;
	;; CURRENT STATUS:
	;;    DefaultEmailModule is the ONLY valid option
	;;    No alternative modules exist
	;;
	;; REALITY:
	;; This line is effectively a boolean enable flag.
	;;
	emailmodule = DefaultEmailModule

	;; If [SMTP] is missing or misconfigured:
	;;    llEmail() will NOT function
	;;    No fallback mail transport exists
	;;

[YEngine]
	;; ==================================================================
	;; YENGINE SCRIPT ENGINE
	;; ==================================================================
	;;
	;; YEngine is a non-preemptive microthreaded script engine designed to:
	;;    Prevent blocking behavior from llSleep and long event handlers
	;;    Improve simulator responsiveness under heavy script load
	;;
	;; TRADEOFFS (THIS MATTERS):
	;;    Scripts are time-sliced  some operations may execute slower
	;;    Script state is LOST on teleport or region crossing to XEngine
	;;     regions (vehicles stop, timers reset, etc.)
	;;
	;; USE CASE:
	;;    Recommended for grids prioritizing simulator stability
	;;    Recommended where script abuse or heavy scripted content exists
	;;    NOT recommended for mixed YEngine/XEngine vehicle grids
	;;
	;; OPERATOR NOTE:
	;;   These values are NOT static.
	;;   They MUST be reviewed as grid load, region count, and concurrency
	;;   increase over time.
	;;

	Enabled = true
	;; Enables YEngine.
	;;
	;; CURRENT REALITY:
	;;    YEngine is the ONLY supported and maintained script engine
	;;     in modern OpenSim builds.
	;;    Legacy XEngine fallback is deprecated, incomplete, or removed
	;;     depending on branch.
	;;
	;; BEHAVIOR:
	;;    Setting this to false will NOT reliably enable XEngine.
	;;    On many modern builds, disabling YEngine may result in:
	;;       - No script execution
	;;       - Script engine initialization failure
	;;       - Undefined or broken behavior
	;;
	;; OPERATOR GUIDANCE:
	;;    This should effectively always be TRUE on modern grids.
	;;    Do NOT rely on XEngine as a fallback.
	;;
	;; Restart REQUIRED after change.

	;; ------------------------------------------------------------------
	;; SCRIPT MEMORY LIMITS
	;; ------------------------------------------------------------------

	;ScriptStackSize = 2048
	;; PURPOSE:
	;;   Maximum stack size per script (KB).
	;;
	;; IMPACT:
	;;    Higher = allows deeper recursion and complex scripts
	;;    Lower = prevents runaway stack abuse
	;;
	;; RISKS:
	;;    Too high  memory pressure under heavy concurrency
	;;    Too low  script runtime errors
	;;
	;; RECOMMENDED:
	;;   2048 KB for modern grids with sufficient RAM


	;ScriptHeapSize = 1024
	;; PURPOSE:
	;;   Maximum heap memory per script (KB).
	;;
	;; IMPACT:
	;;    Controls list/string/object memory usage
	;;
	;; RISKS:
	;;    Too high  malicious or poorly written scripts can exhaust memory
	;;    Too low  inventory systems, vendors, HUDs may fail
	;;
	;; RECOMMENDED:
	;;   1024 KB baseline, increase cautiously


	;; ------------------------------------------------------------------
	;; SCRIPT EXECUTION THREADING
	;; ------------------------------------------------------------------

	;NumThreadScriptWorkers = 2
	;; PURPOSE:
	;;   Number of worker threads executing scripts.
	;;
	;; IMPACT:
	;;    More threads  lower event latency under load
	;;    Fewer threads  less CPU contention
	;;
	;; RISKS:
	;;    Too many threads can starve physics, networking, and scene logic
	;;
	;; GUIDANCE:
	;;    Match to AVAILABLE CPU CORES, not total cores
	;;    Start low, increase only after profiling
	;;
	;; EXAMPLES:
	;;    Small region VM: 1–2
	;;    Large dedicated host: 4–8 (after testing)

	;Priority = Normal
	;; PURPOSE:
	;;   OS thread scheduling priority for script workers.
	;;
	;; OPTIONS:
	;;   Lowest | BelowNormal | Normal | AboveNormal | Highest
	;;
	;; RISKS:
	;;    Raising priority can starve physics, UDP, and scene updates
	;;
	;; RECOMMENDED:
	;;   Normal
	;;   Do NOT raise unless you fully understand OS scheduler behavior

	;; ------------------------------------------------------------------
	;; SCRIPT COMPILATION / CACHING
	;; ------------------------------------------------------------------

	UseSourceHashCode = true
	;; PURPOSE:
	;;   Reuse compiled binaries by hashing script source.
	;;
	;; IMPACT:
	;;    Faster restarts
	;;    Reduced recompilation overhead
	;;
	;; RECOMMENDED:
	;;   true (almost always)

	MaintenanceInterval = 10
	;; PURPOSE:
	;;   Interval (seconds) between internal script maintenance tasks.
	;;
	;; IMPACT:
	;;    Handles cleanup, expired states, internal housekeeping
	;;
	;; RISKS:
	;;    Too frequent  CPU overhead
	;;    Too infrequent  memory bloat
	;;
	;; RECOMMENDED:
	;;   10–30 seconds

	;; ------------------------------------------------------------------
	;; ASYNCHRONOUS COMMAND HANDLING
	;; ------------------------------------------------------------------

	;AsyncLLCommandLoopms = 100
	;; PURPOSE:
	;;   Poll interval (ms) for asynchronous LSL command replies.
	;;
	;; IMPACT:
	;;    Lower = faster responses, higher CPU usage
	;;    Higher = slower responses, lower CPU usage
	;;
	;; RECOMMENDED:
	;;   100 ms baseline

	;; ------------------------------------------------------------------
	;; SCRIPT BEHAVIOR MODIFIERS
	;; ------------------------------------------------------------------

	;ScriptDelayFactor = 1.0
	;; PURPOSE:
	;;   Multiplier applied to script delays (llSleep, timers).
	;;
	;; USE CASE:
	;;    >1.0  globally slow scripts (anti-lag, anti-abuse)
	;;    <1.0  faster script execution (NOT recommended)
	;;
	;; WARNING:
	;;   Can break timing-sensitive content

	;ScriptDistanceLimitFactor = 1.0
	;; PURPOSE:
	;;   Multiplier applied to 10m distance limits in LSL functions.
	;;
	;; USE CASE:
	;;    Increase for large regions / varregions
	;;    Decrease for tight, performance-critical builds
	;;
	;; WARNING:
	;;   Increasing this increases physics and script query cost

	;; ------------------------------------------------------------------
	;; NOTECARD AND TIMER SAFETY
	;; ------------------------------------------------------------------

	;NotecardLineReadCharsMax = 255
	;; PURPOSE:
	;;   Maximum characters per notecard line read.
	;;
	;; SECURITY:
	;;   Increasing this opens attack surface for memory abuse
	;;
	;; RECOMMENDED:
	;;   Leave default unless absolutely required

	MinTimerInterval = 0.1
	;; PURPOSE:
	;;   Minimum allowed llSetTimerEvent interval (seconds).
	;;
	;; IMPACT:
	;;    Prevents timer-based CPU abuse
	;;
	;; RECOMMENDED:
	;;   0.1s minimum for public grids
	;;   Increase for hostile environments

	;; ------------------------------------------------------------------
	;; SENSOR LIMITS
	;; ------------------------------------------------------------------

	;SensorMaxRange = 96.0
	;; PURPOSE:
	;;   Maximum llSensor scan range (meters).
	;;
	;; PERFORMANCE:
	;;   Sensors are expensive. Large ranges scale badly.
	;;
	;; RECOMMENDED:
	;;   Keep under 96 unless absolutely required

	;SensorMaxResults = 16
	;; PURPOSE:
	;;   Maximum results returned per llSensor call.
	;;
	;; IMPACT:
	;;   Higher values increase script and scene cost

	;; ------------------------------------------------------------------
	;; LINKING / OBJECT CONTROL
	;; ------------------------------------------------------------------

	;AutomaticLinkPermission = false
	;; PURPOSE:
	;;   Allow llCreateLink / llBreakLink without permission dialogs.
	;;
	;; SECURITY WARNING:
	;;   Enables object hijacking in untrusted environments
	;;
	;; RECOMMENDED:
	;;   false except on tightly controlled grids

	;DisableUndergroundMovement = true
	;; PURPOSE:
	;;   Prevent script-controlled underground prim movement.
	;;
	;; USE CASE:
	;;    true   realism, grief prevention
	;;    false  underground infrastructure builds
	;;
	;; DEFAULT:
	;;   true

	;; ------------------------------------------------------------------
	;; SCRIPT STATE STORAGE
	;; ------------------------------------------------------------------

	;ScriptEnginesPath = "ScriptEngines"
	;; PURPOSE:
	;;   Directory for script state persistence and cache.
	;;
	;; NOTE:
	;;   Ensure this path is writable and backed up appropriately

[SMTP]
	;; ------------------------------------------------------------------
	;; SMTP CONFIGURATION  (SECURITY-CRITICAL)
	;; ------------------------------------------------------------------
	;;
	;; This section configures outbound email delivery for llEmail().
	;;
	;; EMAIL IS DANGEROUS IF MISCONFIGURED.
	;; Incorrect settings can:
	;;    Turn your server into a spam relay
	;;    Get your IP address blacklisted
	;;    Violate your hosting provider’s AUP
	;;    Expose credentials
	;;
	;; DO NOT enable this unless you fully understand the implications.
	;;

	;; ------------------------------------------------------------------
	;; SMTP CONFIGURATION  (LEGACY / LIMITED USE)
	;; ------------------------------------------------------------------
	;;
	;; IMPORTANT CONTEXT:
	;;
	;; In-world email (llEmail) is a LEGACY communication mechanism.
	;;
	;; MODERN REALITY:
	;;    Most contemporary scripts DO NOT rely on email
	;;    HTTP requests (llHTTPRequest) and external APIs are preferred
	;;    Webhooks, REST endpoints, and JSON APIs provide:
	;;       - better reliability
	;;       - authentication
	;;       - rate limiting
	;;       - auditing
	;;
	;; EMAIL LIMITATIONS:
	;;    Slow delivery
	;;    Poor error feedback
	;;    Easy to abuse
	;;    High risk of spam and blacklisting
	;;
	;; EMAIL SHOULD ONLY BE ENABLED FOR:
	;;    Legacy content that explicitly requires llEmail()
	;;    Controlled internal messaging
	;;    Transitional compatibility
	;;
	;; RECOMMENDATION:
	;; Leave SMTP disabled unless a VERIFIED use case exists.
	;;
	;; For new development, prefer:
	;;    llHTTPRequest
	;;    External API services
	;;    Authenticated webhooks
	;;
	;; This section remains ONLY for backward compatibility.

	;; Master enable switch for SMTP email sending.
	;;
	;; false = Email functionality DISABLED (safe default)
	;; true  = Email functionality ENABLED
	;;
	;; RECOMMENDATION:
	;; Leave disabled unless you explicitly need llEmail().
	;;
	enabled = false

	;; --------------------------------------------------
	;; internal_object_host
	;; --------------------------------------------------
	;;
	;; Internal hostname used when generating email headers
	;; for in-world objects sending mail.
	;;
	;; This value appears in message metadata and logs.
	;;
	;; SHOULD:
	;;    Be non-routable
	;;    NOT resolve publicly
	;;
	;; EXAMPLE:
	;;   lsl.opensim.local
	;;
	;; internal_object_host = lsl.opensim.local

	;; --------------------------------------------------
	;; host_domain_header_from
	;; --------------------------------------------------
	;;
	;; Domain or IP used in the "From:" header.
	;;
	;; MISCONFIGURATION RISK:
	;;    Using a domain you do not control may cause
	;;     immediate spam rejection.
	;;    Using localhost or raw IPs can trigger filters.
	;;
	;; SHOULD:
	;;    Match a domain you own
	;;    Have valid DNS and SPF records
	;;
	;; host_domain_header_from = mail.yourdomain.example

	;; --------------------------------------------------
	;; SMTP_SERVER_FROM
	;; --------------------------------------------------
	;;
	;; Default sender email address used by OpenSim.
	;;
	;; MUST:
	;;    Be a valid address
	;;    Belong to a domain you control
	;;
	;; SHOULD:
	;;    Be a no-reply or service mailbox
	;;
	;; EXAMPLE:
	;;   noreply@yourdomain.example
	;;
	;; SMTP_SERVER_FROM = ""

	;; --------------------------------------------------
	;; SMTP_SERVER_HOSTNAME
	;; --------------------------------------------------
	;;
	;; Hostname or IP address of the SMTP server.
	;;
	;; RECOMMENDED:
	;;    Use a real mail server
	;;    Prefer provider-managed SMTP services
	;;
	;; NEVER:
	;;    Expose your simulator directly to the internet
	;;     as an SMTP server
	;;
	;; SMTP_SERVER_HOSTNAME = smtp.yourprovider.example

	;; --------------------------------------------------
	;; SMTP_SERVER_PORT
	;; --------------------------------------------------
	;;
	;; SMTP port to connect to.
	;;
	;; COMMON VALUES:
	;;   25  = Plain SMTP (often blocked, NOT recommended)
	;;   587 = Submission (recommended)
	;;   465 = SMTPS (implicit TLS)
	;;
	;; SMTP_SERVER_PORT = 587

	;; --------------------------------------------------
	;; SMTP_SERVER_TLS
	;; --------------------------------------------------
	;;
	;; Enables TLS encryption for SMTP connections.
	;;
	;; false = Plaintext SMTP (dangerous)
	;; true  = Encrypted connection
	;;
	;; ALWAYS enable TLS when sending credentials.
	;;
	;; SMTP_SERVER_TLS = true

	;; --------------------------------------------------
	;; SMTP_SERVER_LOGIN
	;; --------------------------------------------------
	;;
	;; Username for SMTP authentication.
	;;
	;; SHOULD:
	;;    Be a dedicated account
	;;    Have limited sending permissions
	;;
	;; NEVER:
	;;    Use your primary mailbox credentials
	;;
	;; SMTP_SERVER_LOGIN = your_smtp_username

	;; --------------------------------------------------
	;; SMTP_SERVER_PASSWORD
	;; --------------------------------------------------
	;;
	;; Password for SMTP authentication.
	;;
	;; SECURITY WARNING:
	;;    Stored in plaintext
	;;    File permissions MUST restrict access
	;;
	;; RECOMMEND:
	;;    chmod 600 OpenSim.ini
	;;
	;; SMTP_SERVER_PASSWORD = your_smtp_password

	;; --------------------------------------------------
	;; SMTP_VerifyCertChain
	;; --------------------------------------------------
	;;
	;; Verify the TLS certificate chain presented by the SMTP server.
	;;
	;; true  = Reject invalid or untrusted certificates (recommended)
	;; false = Accept ANY certificate (unsafe)
	;;
	;; SMTP_VerifyCertChain = true

	;; --------------------------------------------------
	;; SMTP_VerifyCertNames
	;; --------------------------------------------------
	;;
	;; Verify that the certificate hostname matches the SMTP server hostname.
	;;
	;; true  = Prevent MITM attacks (recommended)
	;; false = Disable hostname verification (unsafe)
	;;
	;; SMTP_VerifyCertNames = true

	;; ------------------------------------------------------------------
	;; ANIMATIONS  (VIEWER STATE CONTROL)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how OpenSim selects animation STATES
	;; that are sent to the viewer.
	;;
	;; IMPORTANT:
	;; These settings do NOT affect physics.
	;; They ONLY influence which animation the viewer plays.
	;;
	;; Animation state support is limited by:
	;;    Viewer expectations
	;;    Avatar state machine
	;;    Physics engine capabilities
	;;

	;; --------------------------------------------------
	;; enableflyslow
	;; --------------------------------------------------
	;;
	;; Controls which animation state is used as the PRIMARY fly mode.
	;;
	;; false = Default behavior
	;;    Normal fly animation is primary
	;;    "Always Run" modifies ground movement only
	;;
	;; true = Alternate behavior
	;;    FLYSLOW becomes the default fly state
	;;    Normal fly is used when "Always Run" is enabled
	;;
	;; PRACTICAL EFFECT:
	;;    Subtle visual difference only
	;;    No impact on speed, lift, or physics
	;;
	;; USE CASE:
	;;    Aesthetic preference
	;;    Roleplay environments
	;;
	;; MOST GRIDS:
	;;    Leave disabled
	;;
	enableflyslow = false

	;; ------------------------------------------------------------------
	;; SIMULATOR STATISTICS  (INTERNAL HTTP ENDPOINTS)
	;; ------------------------------------------------------------------
	;;
	;; This section controls diagnostic and performance statistics
	;; exposed by the simulator via its built-in HTTP server.
	;;
	;; IMPORTANT:
	;; These endpoints are NOT web pages.
	;; They return raw machine-readable data (JSON or text).
	;;
	;; They exist for:
	;;    Monitoring
	;;    Debugging
	;;    External admin tooling
	;;
	;; THEY ARE NOT AUTHENTICATED.
	;; Access control MUST be enforced at the network level.
	;;
	;; RECOMMENDED SAFETY MODEL:
	;;    Bind simulator HTTP to localhost OR
	;;    Firewall simulator HTTP port to trusted hosts only

	;; --------------------------------------------------
	;; LogShowStatsSeconds
	;; --------------------------------------------------
	;;
	;; Controls periodic logging of simulator statistics to the console.
	;;
	;; VALUE:
	;;   0     = Disable periodic stat logging
	;;   >0    = Log stats every N seconds at INFO level
	;;
	;; WHAT THIS AFFECTS:
	;;    Console and log output only
	;;
	;; WHAT THIS DOES NOT AFFECT:
	;;    Stats_URI endpoint
	;;    ManagedStats endpoint
	;;
	;; USE CASES:
	;;    Long-term performance observation via logs
	;;    Debugging intermittent load issues
	;;
	;; CAUTION:
	;;    Frequent logging increases log volume
	;;    Not suitable for high-frequency monitoring
	;;
	;; LogShowStatsSeconds = 3600

	;; --------------------------------------------------
	;; Stats_URI  (BASIC SIMULATOR METRICS)
	;; --------------------------------------------------
	;;
	;; Enables a JSON endpoint exposing high-level simulator metrics.
	;;
	;; WHEN ENABLED:
	;;    The simulator registers an HTTP handler
	;;    The endpoint becomes available immediately
	;;
	;; URL FORMAT:
	;;   http://<sim-host>:<sim-http-port>/<Stats_URI>
	;;
	;; RETURNS TYPICALLY INCLUDE:
	;;    Simulator FPS
	;;    Physics FPS
	;;    Agent count
	;;    Frame and timing statistics
	;;
	;; EXPECTED OUTPUT:
	;;    JSON object
	;;    No HTML
	;;
	;; FAILURE MODES:
	;;    404 if not enabled
	;;    Empty or partial data if simulator is initializing
	;;
	;; SECURITY:
	;;    No authentication
	;;    No rate limiting
	;;    Treat as sensitive internal telemetry
	;;
	;; RECOMMENDED USAGE:
	;;    Poll from localhost or trusted monitoring host
	;;    Consume via scripts, not browsers
	;;
	Stats_URI = "jsonSimStats"

	;; --------------------------------------------------
	;; ManagedStatsRemoteFetchURI  (DEVELOPER / MODULE STATS)
	;; --------------------------------------------------
	;;
	;; Enables a second endpoint exposing StatsManager-registered metrics.
	;;
	;; THIS IS NOT THE SAME AS Stats_URI.
	;;
	;; THIS ENDPOINT:
	;;    Reflects stats explicitly registered by code modules
	;;    Is highly version- and module-dependent
	;;
	;; URL FORMAT:
	;;   http://<sim-host>:<sim-http-port>/<ManagedStatsRemoteFetchURI>
	;;
	;; OPTIONAL QUERY PARAMETERS:
	;;   ?cat=Category
	;;   ?cont=Container
	;;   ?stat=Statistic
	;;
	;; BEHAVIOR:
	;;    No parameters returns ALL registered stats
	;;    Filters narrow the returned dataset
	;;
	;; REALITY CHECK:
	;;    Many modules register few or no stats
	;;    Output may be sparse, noisy, or inconsistent
	;;    Intended for developers and deep diagnostics
	;;
	;; FAILURE MODES:
	;;    404 if disabled
	;;    Empty responses if no stats are registered
	;;
	;; SECURITY WARNING:
	;;    Completely unauthenticated
	;;    May expose internal state and counters
	;;
	;; RECOMMENDED:
	;;    Leave disabled unless actively needed
	;;    Never expose beyond trusted admin networks
	;;
	;; ManagedStatsRemoteFetchURI = "ManagedStats"

	;; ------------------------------------------------------------------
	;; REGION LOGIN CONTROL  (CRITICAL BEHAVIOR FLAG)
	;; ------------------------------------------------------------------
	;;
	;; Controls whether regions start with avatar logins ENABLED or DISABLED.
	;;
	;; THIS SETTING IS GLOBAL AND OVERRIDES NORMAL REGION STARTUP BEHAVIOR.
	;;
	;; MISCONFIGURATION EFFECT:
	;;    Regions load normally
	;;    Regions appear healthy
	;;    Scripts run
	;;    BUT avatar logins are BLOCKED
	;;
	;; SYMPTOMS WHEN SET INCORRECTLY:
	;;    Viewers fail to enter regions
	;;    "Login failed" or region unavailable errors
	;;    No obvious fatal errors in logs
	;;    Leads to false assumptions about:
	;;       - database corruption
	;;       - estate misconfiguration
	;;       - permissions
	;;       - network or firewall issues
	;;
	;; This is a COMMON SOURCE of wasted troubleshooting time.
	;;
	;; --------------------------------------------------
	;; StartDisabled
	;; --------------------------------------------------
	;;
	;; false = NORMAL OPERATION (recommended)
	;;    Regions start with logins enabled
	;;    No manual intervention required
	;;
	;; true = ADMIN-CONTROLLED STARTUP
	;;    ALL regions start with logins DISABLED
	;;    Regions MUST be manually enabled from the console
	;;
	;; REQUIRED ACTION WHEN true:
	;;    Connect to the region console
	;;    Run: enable region
	;;
	;; USE CASES:
	;;    Maintenance windows
	;;    Staged rollouts
	;;    Debugging without user access
	;;
	;; WARNING:
	;;    There is NO visual indicator in-world
	;;    There is NO automatic re-enable
	;;    Regions will remain inaccessible indefinitely
	;;     until manually enabled

	StartDisabled = false

	;; ------------------------------------------------------------------
	;; IMAGE DECODING  (TEXTURE PIPELINE BEHAVIOR)
	;; ------------------------------------------------------------------
	;;
	;; Controls which JPEG2000 decoder OpenSim uses for texture decoding.
	;;
	;; JPEG2000 is a layered, progressive image format.
	;; Decoder behavior directly affects:
	;;    Texture rez speed
	;;    Visual consistency
	;;    Error tolerance
	;;
	;; MISCONFIGURATION CAN CAUSE:
	;;    Blurry or incomplete textures
	;;    Delayed texture refinement
	;;    Viewer-side confusion that looks like cache issues

	;; --------------------------------------------------
	;; UseCSJ2K
	;; --------------------------------------------------
	;;
	;; Selects the JPEG2000 decoding library used by OpenSim.
	;;
	;; true  = Use CSJ2K decoder
	;; false = Use OpenJPEG decoder
	;;
	;; CSJ2K:
	;;    Pure Java implementation
	;;    Historically better at strict layer boundary handling
	;;    Slower
	;;    Less tolerant of malformed textures
	;;
	;; OpenJPEG:
	;;    Native library
	;;    Faster
	;;    More tolerant of malformed or legacy assets
	;;    Can behave inconsistently at layer boundaries
	;;
	;; REALITY:
	;;    Neither decoder is perfect
	;;    Viewer behavior and asset quality matter
	;;
	;; KNOWN ISSUES:
	;;    CSJ2K may stall or fail on certain legacy textures
	;;    OpenJPEG may cause partial rez artifacts
	;;
	;; VERGEGRID POSITION:
	;;    Prefer OpenJPEG for general use
	;;    Switch ONLY if diagnosing texture boundary artifacts
	;;
	;; TODO (IDENTIFIED):
	;;    Improve decoder error reporting
	;;    Normalize behavior across decoders
	;;    Add clearer logging when decode fallback occurs
	;;
	UseCSJ2K = false

	;; ------------------------------------------------------------------
	;; OBJECT DELETION BEHAVIOR  (USER IMPACT / DATA SAFETY)
	;; ------------------------------------------------------------------
	;;
	;; Controls what happens when users DELETE objects from the scene.
	;;
	;; This setting has DIRECT user-facing consequences and is a common
	;; source of confusion, complaints, and support requests if misunderstood.
	;;

	;; --------------------------------------------------
	;; UseTrashOnDelete
	;; --------------------------------------------------
	;;
	;; true  = SAFE DELETE (default, recommended)
	;;    Deleted objects are moved to the user's Trash
	;;     or Lost and Found folder
	;;    Objects can be recovered by the user
	;;
	;; false = PERMANENT DELETE
	;;    Deleted objects are REMOVED IMMEDIATELY
	;;    NO recovery is possible
	;;    NO undo
	;;
	;; USER EXPERIENCE DIFFERENCES:
	;;    true  -> "I deleted it but can get it back"
	;;    false -> "I deleted it and it is GONE"
	;;
	;; ADMIN CONSEQUENCES:
	;;    true  -> Fewer support tickets
	;;    false -> More complaints and accusations of data loss
	;;
	;; PERFORMANCE NOTES:
	;;    Trash-based delete has minimal overhead
	;;    Permanent delete does NOT meaningfully improve performance
	;;
	;; SECURITY / POLICY NOTES:
	;;    Permanent delete may be desired in:
	;;       - sandbox regions
	;;       - disposable build areas
	;;       - automated cleanup zones
	;;    NOT recommended for residential or creative regions
	;;
	;; WARNING:
	;; Changing this affects user expectations immediately.
	;; Communicate clearly if this is set to false.
	;;
	UseTrashOnDelete = True

	;; ------------------------------------------------------------------
	;; LOGGING  (THREAD POOL OVERLOAD DIAGNOSTICS)
	;; ------------------------------------------------------------------
	;;
	;; This section controls emergency logging related to thread pool stress.
	;;
	;; Thread pool overload occurs when the simulator has more concurrent
	;; work than available worker threads. This leads to lag, stalls, and
	;; eventual region instability.
	;;
	;; This setting exists to capture FORENSIC DATA when that happens.

	;; --------------------------------------------------
	;; LogOverloads
	;; --------------------------------------------------
	;;
	;; Forces logging when the simulator thread pool approaches overload.
	;;
	;; WHAT THIS DOES:
	;;    Temporarily emits detailed log messages
	;;    Overrides reduced logging levels when stress is detected
	;;    Captures internal state for post-mortem analysis
	;;
	;; WHERE THE LOGS APPEAR:
	;;    Normal simulator console output
	;;    The same log file configured via log4net
	;;    There is NO separate overload log file
	;;
	;; WHAT TO LOOK FOR IN LOGS:
	;;    Messages containing:
	;;       - ThreadPool
	;;       - Overload
	;;       - Worker threads
	;;       - Queue length
	;;       - Pending work items
	;;       - Slow tasks or long frames
	;;
	;; HOW TO USE THIS DATA:
	;;    Correlate timestamps with user lag reports
	;;    Look at what occurred IMMEDIATELY BEFORE the overload logs
	;;    Identify recurring triggers such as:
	;;       - script-heavy activity
	;;       - mass rezzing or deletions
	;;       - region crossings
	;;       - HTTP callbacks
	;;       - NPC or bot activity
	;;
	;; WHAT THIS DOES NOT DO:
	;;    Does NOT prevent overloads
	;;    Does NOT throttle activity
	;;    Does NOT warn users
	;;    Does NOT log anything during normal operation
	;;
	;; IMPORTANT:
	;; Silence from this setting is GOOD.
	;; Logs only appear when the simulator is already under stress.
	;;
	;; RECOMMENDED:
	;;    Leave enabled in production
	;;    Safe even with reduced logging levels
	;;    Negligible overhead unless overload occurs
	;;
	;; IMPLEMENTATION REALITY:
	;; Overload detection exists, but there is no warning light, no throttle,
	;; and no protection. By the time this logs, damage is already occurring.
	;;
	;; ------------------------------------------------------------------
	;; TODO / DESIGN DEFICIENCIES  (THREAD POOL OVERLOAD HANDLING)
	;; ------------------------------------------------------------------
	;;
	;; CURRENT LIMITATIONS:
	;;
	;; 1. Logging Destination
	;;     Overload logs are written to the general simulator log only
	;;     No dedicated overload or performance log exists
	;;     High-signal diagnostic data is mixed with unrelated output
	;;
	;;    TODO:
	;;     Add a dedicated overload / performance log file
	;;     Allow independent rotation and retention
	;;
	;;
	;; 2. Lack of Throttling or Mitigation
	;;     Overload detection is PASSIVE only
	;;     Simulator continues accepting work at full rate
	;;     No automatic backoff, shedding, or load reduction occurs
	;;
	;;    RESULT:
	;;     Repeated overload conditions can cascade
	;;     Regions may spiral into hard stalls or crashes
	;;
	;;    TODO:
	;;     Add optional throttling when overload persists
	;;     Trigger mitigation only after sustained overload
	;;     Examples:
	;;        - temporarily slow script execution
	;;        - defer non-critical tasks
	;;        - reduce update frequency
	;;
	;;
	;; 3. No Operator or User Visibility
	;;     Overload detection is silent unless logs are actively watched
	;;     No console banner
	;;     No warning message
	;;     No admin-facing notification
	;;
	;;    RESULT:
	;;     Admins assume "random lag"
	;;     Users report symptoms without root cause
	;;     Problems are only discovered AFTER failure
	;;
	;;    TODO:
	;;     Emit a clear console warning when overload is detected
	;;     Optional repeated warning if condition persists
	;;     Optional admin-only in-world notification
	;;
	;;
	;; 4. No Early Warning Thresholds
	;;     Logging triggers only when overload is imminent or occurring
	;;     No advance notice of rising pressure
	;;
	;;    TODO:
	;;     Add configurable early-warning thresholds
	;;     Allow proactive intervention before failure
	;;
	;;
	;; DESIGN GOAL:
	;; Convert overload handling from:
	;;   "silent forensic logging after damage"
	;; into:
	;;   "visible, actionable warning with optional mitigation"
	;;
	;; Analogy:
	;; This should behave like an engine warning light,
	;; not a black box recorder discovered after the engine blows.
	;;

	LogOverloads = True

	;; ------------------------------------------------------------------
	;; TELEHUBS  (AVATAR LANDING POLICY)
	;; ------------------------------------------------------------------
	;;
	;; Telehubs control WHERE avatars arrive when entering a region.
	;;
	;; This section defines landing behavior for:
	;;    Map clicks
	;;    Landmarks
	;;    Teleports from other regions
	;;
	;; Telehub configuration is a POLICY decision, not just a routing option.
	;; Poorly chosen settings are a common source of user complaints such as:
	;;    "Why do I always land in the wrong place?"
	;;    "My landmark doesn't work"
	;;    "Teleports feel random or broken"
	;;
	;; --------------------------------------------------
	;; CONFIGURATION PRECEDENCE  (IMPORTANT)
	;; --------------------------------------------------
	;;
	;; Telehub and landing behavior is subject to MULTIPLE layers of control.
	;;
	;; ORDER OF PRECEDENCE (HIGHEST WINS):
	;;
	;;   1. Region / Estate landing point enforcement
	;;   2. Telehub configuration (this section)
	;;   3. Landmark target coordinates
	;;   4. Map click destination
	;;
	;; IMPORTANT REALITY:
	;; A region owner or estate owner CAN enforce a landing point
	;; regardless of the global TelehubAllowLandmark setting.
	;;
	;; RESULTING BEHAVIOR:
	;;    Even if TelehubAllowLandmark = true,
	;;     a region-level forced landing point will OVERRIDE it.
	;;
	;; COMMON CONFUSION:
	;;    Admin checks this file and sees "correct" values
	;;    Users still land at a forced point
	;;    Admin assumes telehubs are broken
	;;
	;; THIS IS NOT A BUG.
	;; Region and estate rules have higher authority than this config.
	;;
	;; OPERATOR GUIDANCE:
	;; When diagnosing landing issues, ALWAYS verify:
	;;    Region landing point settings
	;;    Estate landing restrictions
	;;    Parcel-level landing rules
	;;
	;; --------------------------------------------------
	;; SpawnPointRouting
	;; --------------------------------------------------
	;;
	;; Determines how OpenSim selects a spawn point when a telehub is active.
	;;
	;; AVAILABLE MODES:
	;;
	;; closest
	;;    Avatar is placed at the spawn point closest to the intended
	;;     destination (map click or landmark target)
	;;    Feels the most intuitive to users
	;;    Preserves intent while still enforcing telehub usage
	;;
	;; random
	;;    Avatar is placed at a randomly selected spawn point
	;;    Useful for load spreading or crowd control
	;;    Can feel chaotic or broken to users
	;;
	;; sequence
	;;    Spawn points are used in round-robin order
	;;    Predictable distribution
	;;    Useful for event traffic management
	;;
	;; USER IMPACT:
	;;    closest  -> "I landed where I expected"
	;;    random   -> "Why am I landing all over the place?"
	;;    sequence -> "Sometimes it works, sometimes it doesn't"
	;;
	;; VERGEGRID RECOMMENDATION:
	;;    closest for general-purpose regions
	;;    random or sequence ONLY for controlled event spaces
	;;
	;; DEFAULT:
	;;    closest
	;;
	SpawnPointRouting = closest

	;; --------------------------------------------------
	;; TelehubAllowLandmark
	;; --------------------------------------------------
	;;
	;; Controls whether landmarks can BYPASS telehub routing.
	;;
	;; false = STRICT TELEHUB ENFORCEMENT (default)
	;;    All incoming avatars are routed through telehub spawn points
	;;    Landmarks do NOT override telehub behavior
	;;
	;; true = LANDMARK OVERRIDE ALLOWED
	;;    Users with landmarks land at the landmark coordinates
	;;    Telehub routing applies only when no landmark is used
	;;
	;; USER EXPECTATION GAP:
	;;    Users expect landmarks to land them at the saved location
	;;    Telehubs break that expectation unless this is enabled
	;;
	;; ADMIN TRADEOFF:
	;;    false -> Strong traffic control, more user complaints
	;;    true  -> User-friendly, less control over arrivals
	;;
	;; COMMON USE CASES:
	;;    false -> Welcome areas, themed roleplay, controlled flow
	;;    true  -> Residential, commercial, creator regions
	;;
	;; WARNING:
	;;    Changing this alters long-standing user expectations
	;;    Communicate clearly if landmarks do not land where expected
	;;
	;; TelehubAllowLandmark = false

	;; ------------------------------------------------------------------
	;; SSL / TLS CERTIFICATE HANDLING
	;; (USED BY HTTPS LISTENERS AND SECURE SERVICES)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how OpenSim obtains, converts, generates,
	;; and validates TLS certificates used by HTTPS endpoints.
	;;
	;; IMPORTANT:
	;; OpenSim itself does NOT act as a Certificate Authority.
	;; This section only manages certificate MATERIAL used by
	;; the HTTP/HTTPS listeners and secure service endpoints.
	;;
	;; Misconfiguration here can:
	;;    Break HTTPS connectivity
	;;    Cause silent TLS fallback failures
	;;    Violate security or compliance requirements

	;; ==================================================================
	;; CA-ISSUED CERTIFICATE CONVERSION (e.g. Let's Encrypt)
	;; ==================================================================
	;;
	;; OpenSim internally requires PKCS12 (.p12 / .pfx) certificates.
	;; Many Certificate Authorities provide PEM-formatted certificates.
	;;
	;; This converter exists to bridge that format mismatch.

	;; --------------------------------------------------
	;; EnableCertConverter
	;; --------------------------------------------------
	;;
	;; Enables automatic conversion of CA-issued PEM certificates
	;; into OpenSim-compatible PKCS12 (.p12 / .pfx) format.
	;;
	;; WHEN ENABLED:
	;;    Conversion runs at EVERY server startup
	;;    Output is written to:
	;;       bin/SSL/ssl/
	;;
	;; REQUIRED INPUT FILES:
	;;    Public certificate (.pem or fullchain.pem)
	;;    Private key (.pem)
	;;
	;; USE CASES:
	;;    Let's Encrypt
	;;    Enterprise or government CAs
	;;    Environments with external certificate automation
	;;
	;; SECURITY NOTE:
	;;    Private keys are read from disk at startup
	;;    File permissions MUST restrict access
	;;
	EnableCertConverter = false

	;; Absolute path to the public certificate PEM.
	;; Prefer fullchain.pem when provided by the CA.
	PemCertPublicKey = ""

	;; Absolute path to the private key PEM.
	PemCertPrivateKey = ""

	;; Output filename (without extension).
	;; Generates:
	;;   <name>.p12
	;;   <name>.pfx
	outputCertName = "letsencrypt"

	;; Password applied to generated .p12 / .pfx files.
	;; REQUIRED for PKCS12.
	outputCertPassword = ""

	;; ==================================================================
	;; SELF-SIGNED CERTIFICATE GENERATION
	;; ==================================================================
	;;
	;; This is intended ONLY for:
	;;    Local testing
	;;    Isolated environments
	;;    Non-public deployments
	;;
	;; Self-signed certificates WILL NOT satisfy:
	;;    Public trust chains
	;;    Enterprise compliance
	;;    DoD / MOSES-style requirements

	;; --------------------------------------------------
	;; EnableSelfsignedCertSupport
	;; --------------------------------------------------
	;;
	;; When enabled:
	;;    Generates a private key
	;;    Generates a self-signed certificate
	;;    Stores artifacts under:
	;;       SSL/src/  (private key)
	;;       SSL/ssl/  (certificate)
	;;
	EnableSelfsignedCertSupport = false

	;; Renew self-signed certificate on every startup.
	;; Useful for ephemeral test systems only.
	CertRenewOnStartup = false

	;; --------------------------------------------------
	;; Self-Signed Certificate Identity
	;; --------------------------------------------------
	;;
	;; Output certificate base name.
	CertFileName = "OpenSim"

	;; Password protecting the generated PKCS12 files.
	CertPassword = "mycertpass"

	;; Common Name (CN) for the certificate.
	;; MUST match the externally visible hostname
	;; used by clients.
	CertHostName = "myRegionsExternalHostName"

	;; IP address associated with the certificate.
	CertHostIp = "127.0.0.1"

	;; ==================================================================
	;; SSL CERTIFICATE VALIDATION CONTROLS
	;; ==================================================================
	;;
	;; These options control how STRICTLY OpenSim validates
	;; certificates presented by remote services.
	;;
	;; THESE SETTINGS DO NOT AFFECT ENCRYPTION.
	;; They affect TRUST and VERIFICATION ONLY.

	;; --------------------------------------------------
	;; NoVerifyCertChain
	;; --------------------------------------------------
	;;
	;; true  = ACCEPT certificates without a valid CA chain
	;; false = REQUIRE valid CA chain (recommended)
	;;
	;; Enabling this allows self-signed or untrusted certificates.
	;;
	;; NoVerifyCertChain = true

	;; --------------------------------------------------
	;; NoVerifyCertHostname
	;; --------------------------------------------------
	;;
	;; true  = DO NOT verify hostname against certificate CN
	;; false = REQUIRE hostname match (recommended)
	;;
	;; Disabling hostname verification allows MITM scenarios.
	;;
	;; NoVerifyCertHostname = true
	;;
	;; WARNING:
	;; Setting BOTH NoVerifyCertChain and NoVerifyCertHostname to true
	;; provides encryption with LOW SECURITY.
	;; This is equivalent to "encrypted but not trusted".

[Map]
	;; ------------------------------------------------------------------
	;; MAP TILE GENERATION  (WORLD MAP PIPELINE)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how WORLD MAP tiles are generated, refreshed,
	;; and rendered by the simulator.
	;;
	;; IMPORTANT REALITY:
	;; Map tiles are NOT a live view of the region.
	;; They are PERIODIC SNAPSHOTS rendered server-side.
	;;
	;; Poor configuration here causes:
	;;    Blank or outdated maps
	;;    Missing terrain or objects
	;;    Excessive CPU load
	;;    False assumptions about asset corruption
	;;
	;; --------------------------------------------------
	;; GenerateMaptiles
	;; --------------------------------------------------
	;;
	;; Controls whether OpenSim generates map tiles dynamically.
	;;
	;; true  = Generate map tiles using MapImageModule
	;; false = Use a static texture (MaptileStaticUUID)
	;;
	;; NOTES:
	;;    Disabling this does NOT disable map services by itself
	;;    To fully disable map tile generation, you must ALSO
	;;     disable MapImageServiceModule in [Modules]
	;;
	;; USE CASES:
	;;    true  -> Active worlds, normal operation
	;;    false -> Static showcase regions, custom map pipelines
	;;
	GenerateMaptiles = true

	;; --------------------------------------------------
	;; WorldMapModule
	;; --------------------------------------------------
	;;
	;; Selects the world map aggregation module.
	;;
	;; CURRENT STATUS:
	;;    "WorldMap" is effectively fixed
	;;    No alternate implementations are actively maintained
	;;
	WorldMapModule = "WorldMap"

	;; --------------------------------------------------
	;; MapImageModule
	;; --------------------------------------------------
	;;
	;; Selects the renderer used to generate map tiles.
	;;
	;; AVAILABLE OPTIONS:
	;;
	;;   MapImageModule
	;;      Default implementation
	;;      CPU-based rendering
	;;      Stable but limited fidelity
	;;
	;;   Warp3DImageModule
	;;      Experimental
	;;      Can produce better visuals
	;;      Higher CPU cost
	;;      Inconsistent behavior at scale
	;;
	;; REALITY:
	;;    Neither module produces modern-quality map imagery
	;;    Both are constrained by legacy architecture
	;;
	MapImageModule = "Warp3DImageModule"

	;; --------------------------------------------------
	;; BlacklistTimeout
	;; --------------------------------------------------
	;;
	;; Time (seconds) that a failed map tile generation is blacklisted
	;; before another attempt is made.
	;;
	;; PURPOSE:
	;;    Prevents constant re-render attempts on failing regions
	;;
	;; FAILURE SYMPTOM:
	;;    Region stays blank on the map for long periods
	;;
	BlacklistTimeout = 600

	;; --------------------------------------------------
	;; MaptileRefresh
	;; --------------------------------------------------
	;;
	;; Interval (seconds) between automatic map tile refreshes.
	;;
	;; 0 = Disable periodic refresh (manual or event-driven only)
	;;
	;; WARNING:
	;;    Frequent refresh is CPU expensive
	;;    Large grids should use conservative values
	;;
	MaptileRefresh = 3600

	;; --------------------------------------------------
	;; MaptileStaticUUID
	;; --------------------------------------------------
	;;
	;; Texture UUID used when GenerateMaptiles = false.
	;;
	;; This allows a fixed, pre-rendered map tile to be shown.
	;;
	;; Common use cases:
	;;    Custom-rendered maps
	;;    External map generation pipelines
	;;
	;; MaptileStaticUUID = "00000000-0000-0000-0000-000000000000"

	;; --------------------------------------------------
	;; DrawPrimOnMapTile
	;; --------------------------------------------------
	;;
	;; Controls whether OBJECTS are rendered onto map tiles.
	;;
	;; true  = Render objects (expensive)
	;; false = Terrain-only map tiles
	;;
	;; PERFORMANCE IMPACT:
	;;    High object counts dramatically increase render time
	;;    Large regions amplify cost
	;;
	DrawPrimOnMapTile = true

	;; --------------------------------------------------
	;; TextureOnMapTile
	;; --------------------------------------------------
	;;
	;; Controls terrain appearance on map tiles.
	;;
	;; true  = Use terrain textures
	;; false = Use shaded green height map
	;;
	TextureOnMapTile = true

	;; --------------------------------------------------
	;; TexturePrims
	;; --------------------------------------------------
	;;
	;; Enables texturing of rendered prims on the map tile.
	;;
	;; true  = Apply textures (slower, more detailed)
	;; false = Flat shading
	;;
	TexturePrims = true

	;; --------------------------------------------------
	;; TexturePrimSize
	;; --------------------------------------------------
	;;
	;; Minimum diagonal size (meters) for a prim to receive textures.
	;;
	;; Smaller prims render untextured to reduce cost.
	;;
	;; This is a PERFORMANCE FILTER.
	;;
	TexturePrimSize = 48

	;; --------------------------------------------------
	;; RenderMeshes
	;; --------------------------------------------------
	;;
	;; Controls whether mesh and sculpted objects are rendered.
	;;
	;; false = Ignore meshes (default)
	;; true  = Attempt to render meshes (slow, unreliable)
	;;
	;; REALITY:
	;;    Mesh rendering is incomplete
	;;    Many meshes do not render correctly
	;;    High cost for poor results
	;;
	RenderMeshes = false

	;; --------------------------------------------------
	;; Render Height Limits (Warp3D)
	;; --------------------------------------------------
	;;
	;; Height limits for rendering prims on map tiles.
	;; Relative to rez position, not bounding box.
	;;
	;; These exist to exclude skyboxes, overhead builds,
	;; and high-altitude clutter from maps.
	;;
	RenderMaxHeight = 200
	RenderMinHeight = 1

	;; --------------------------------------------------
	;; ShowNPCs
	;; --------------------------------------------------
	;;
	;; Controls whether NPCs appear as green dots on the world map.
	;;
	;; Useful for debugging or monitoring NPC-heavy regions.
	;;
	ShowNPCs = true

	;; ==================================================================
	;; KNOWN LIMITATIONS AND TODOs
	;; ==================================================================
	;;
	;; CURRENT PROBLEMS:
	;;    CPU-bound rendering
	;;    Poor handling of large VAR regions
	;;    Inconsistent mesh decoding
	;;    Fragile JPEG2000 decode pipeline
	;;    No GPU acceleration
	;;    No concept of LOD or semantic layers
	;;
	;; TODO (IDENTIFIED):
	;;    Replace legacy renderer with Anaximander2
	;;    GPU-accelerated tile generation
	;;    Deterministic rendering independent of viewer quirks
	;;    Robust decode and asset error handling
	;;    Support for large-scale regions without distortion
	;;    Decouple map generation from simulator frame loop
	;;
	;; DESIGN GOAL:
	;; World maps should be:
	;;    Predictable
	;;    Scalable
	;;    Visually consistent
	;;    Operationally safe
	;;
	;; NOT:
	;;    A best-effort side effect of region rendering
	;;
	;; ==================================================================
	;; CRITICAL IMPLEMENTATION DEFECT  (MAP TILE STORAGE PATHS)
	;; ==================================================================
	;;
	;; PROBLEM SUMMARY:
	;;
	;; Map tile storage paths are NOT consistently defined in the source code.
	;; At present, map tile output paths are hard-coded or inferred in
	;; MULTIPLE locations across the codebase.
	;;
	;; OBSERVED BEHAVIOR:
	;;    Map tile storage logic exists in AT LEAST THREE separate files
	;;    Different code paths choose different output directories
	;;    In some cases, tiles are written directly into the simulator
	;;     bin/ directory
	;;
	;; IMPACT:
	;;    bin/ directory pollution
	;;    Hundreds or thousands of loose map tile files
	;;    Disk bloat over time
	;;    Difficult cleanup and maintenance
	;;    Confusing behavior that appears random to operators
	;;
	;; THIS IS NOT A CONFIGURATION ERROR.
	;; This is a SOURCE CODE DESIGN FLAW.
	;;
	;; ROOT CAUSE:
	;;    No single authoritative definition of "map tile storage root"
	;;    Legacy code paths bypass central configuration
	;;    Renderer modules make assumptions about working directories
	;;
	;; WHY THIS IS UNACCEPTABLE:
	;;    Map tile storage MUST be deterministic
	;;    Generated assets MUST NOT spill into bin/
	;;    Operators MUST be able to control storage location
	;;
	;; TODO (MANDATORY FIX):
	;;
	;;    Define ONE canonical map tile storage root
	;;    Enforce usage of that path across ALL map-related code
	;;    Remove hard-coded or inferred output directories
	;;    Never default to bin/ for generated artifacts
	;;
	;; LONG-TERM DIRECTION:
	;;    Map tile storage path should be:
	;;       - explicitly configurable
	;;       - centralized
	;;       - validated at startup
	;;    Future renderers (e.g. Anaximander2) MUST NOT
	;;     repeat this architectural mistake
	;;
	;; STATUS:
	;;    Documented in CODEX
	;;    Tracked in repository
	;;    Requires source-level refactor
	;;
	;; OPERATOR NOTE:
	;; If you see map tiles accumulating in bin/,
	;; this is expected behavior under current code,
	;; NOT a misconfiguration.

[Permissions]
	;; ------------------------------------------------------------------
	;; PERMISSIONS  (SECURITY, TRUST, AND ABUSE CONTROL)
	;; ------------------------------------------------------------------
	;;
	;; This section controls SERVER-SIDE permission enforcement,
	;; administrative authority, and script creation/editing rights.
	;;
	;; MISCONFIGURATION HERE CAN:
	;;    Bypass content permissions
	;;    Enable griefing or asset theft
	;;    Grant unintended god powers
	;;    Undermine user trust in the grid
	;;
	;; This is NOT cosmetic configuration.
	;; This is core security policy.

	;; --------------------------------------------------
	;; permissionmodules
	;; --------------------------------------------------
	;;
	;; Specifies which permission enforcement modules are active.
	;;
	;; AVAILABLE MODULES:
	;;    DefaultPermissionsModule
	;;       - Standard permission enforcement
	;;       - Required for normal grid operation
	;;
	;;    PrimLimitsModule
	;;       - Enforces prim and object limits
	;;       - Often used alongside land controls
	;;
	;; NOTE:
	;; Multiple modules may be listed, comma-separated.
	;;
	;; If this is commented out, DefaultPermissionsModule
	;; is typically assumed, but explicit configuration
	;; is STRONGLY recommended.
	;;
	permissionmodules = "DefaultPermissionsModule"

	;; --------------------------------------------------
	;; serverside_object_permissions
	;; --------------------------------------------------
	;;
	;; MASTER SWITCH for server-side permission enforcement.
	;;
	;; true  = Permissions are enforced by the simulator (RECOMMENDED)
	;; false = Permissions checks may be bypassed
	;;
	;; WARNING:
	;; Setting this to false can allow:
	;;    Copying of no-copy items
	;;    Editing of protected objects
	;;    Circumvention of expected restrictions
	;;
	;; NOTE:
	;; Enforcement coverage is not uniform across all subsystems,
	;; making this EXTREMELY dangerous to disable.
	;;
	;;
	serverside_object_permissions = true

	;; --------------------------------------------------
	;; allow_grid_gods
	;; --------------------------------------------------
	;;
	;; Allows grid administrators (UserLevel >= 200)
	;; to assume god powers in ALL regions on this simulator.
	;;
	;; true  = Grid admins can god-mode anywhere
	;; false = Grid admins do NOT automatically gain god powers
	;;
	;; SECURITY REALITY:
	;;    This grants EXTENSIVE authority
	;;    Includes object, land, and avatar control
	;;
	;; OPERATOR NOTE:
	;; If you do not trust your grid admins with god powers,
	;; you already have a larger problem.
	;;
	allow_grid_gods = true

	;; --------------------------------------------------
	;; region_owner_is_god
	;; --------------------------------------------------
	;;
	;; Allows region owners to assume god powers
	;; within regions they own.
	;;
	;; true  = Region owners have god powers
	;; false = Region owners operate under normal permissions
	;;
	;; RISK:
	;;    Can enable abuse in multi-tenant grids
	;;    Can bypass estate or grid-level policy
	;;
	;; COMMON PRACTICE:
	;;    false on shared grids
	;;    true only on private or single-owner grids
	;;
	region_owner_is_god = false

	;; --------------------------------------------------
	;; region_manager_is_god
	;; --------------------------------------------------
	;;
	;; Allows region managers to assume god powers
	;; in regions they manage.
	;;
	;; HIGH RISK:
	;;    Often misunderstood
	;;    Can grant excessive authority to non-owners
	;;
	;; RECOMMENDED:
	;;    Leave disabled unless explicitly required
	;;
	region_manager_is_god = false

	;; --------------------------------------------------
	;; automatic_gods
	;; --------------------------------------------------
	;;
	;; Automatically enables god mode in the viewer
	;; whenever the user has god rights somewhere.
	;;
	;; true  = God mode auto-enabled
	;; false = User must manually enable god mode
	;;
	;; USABILITY VS SAFETY:
	;;    true  -> Convenience
	;;    false -> Reduced accidental misuse
	;;
	automatic_gods = false

	;; --------------------------------------------------
	;; implicit_gods
	;; --------------------------------------------------
	;;
	;; Allows users with god rights to execute god functions
	;; WITHOUT explicitly entering god mode in the viewer.
	;;
	;; true  = Silent god power usage
	;; false = Explicit god mode required
	;;
	;; SECURITY NOTE:
	;;    Implicit god powers reduce visibility
	;;    Makes auditing and intent less clear
	;;
	;; RECOMMENDED:
	;;    false
	;;
	implicit_gods = false

	;; --------------------------------------------------
	;; allowed_script_creators
	;; --------------------------------------------------
	;;
	;; Controls who is allowed to CREATE new scripts.
	;;
	;; ENFORCED ONLY IF:
	;;    serverside_object_permissions = true
	;;
	;; VALUES:
	;;    all  = Anyone can create scripts
	;;    gods = Only administrators can create scripts
	;;
	;; USE CASES:
	;;    all  -> Open creative grids
	;;    gods -> Locked-down or high-security environments
	;;
	allowed_script_creators = all

	;; --------------------------------------------------
	;; allowed_script_editors
	;; --------------------------------------------------
	;;
	;; Controls who is allowed to EDIT (save) scripts.
	;;
	;; ENFORCED ONLY IF:
	;;    serverside_object_permissions = true
	;;
	;; VALUES:
	;;    all  = Anyone can edit scripts they have rights to
	;;    gods = Only administrators can edit scripts
	;;
	;; SECURITY TRADEOFF:
	;;    Restricting this can prevent script-based griefing
	;;    But also breaks normal creator workflows
	;;
	allowed_script_editors = all

	;; --------------------------------------------------
	;; simple_build_permissions
	;; --------------------------------------------------
	;;
	;; Allows parcel owners to grant build rights
	;; via parcel Access Lists without using Groups.
	;;
	;; true  = Simplified build permissions enabled
	;; false = Use group-based permissions only
	;;
	;; USE CASE:
	;;    Public parcels with controlled builders
	;;
	;; RISK:
	;;    Easier to misconfigure than groups
	;;
	simple_build_permissions = false

	;; --------------------------------------------------
	;; LevelUpload  (ASSET CREATION GATE)
	;; --------------------------------------------------
	;;
	;; Controls the MINIMUM UserLevel required to UPLOAD assets
	;; (textures, sounds, animations, meshes, scripts, etc.).
	;;
	;; THIS SETTING DIRECTLY AFFECTS CREATION.
	;; If a user cannot upload assets, they cannot effectively build,
	;; script, texture, or participate in a creative grid.
	;;
	;; --------------------------------------------------
	;; VALUES
	;; --------------------------------------------------
	;;
	;; 0  = OPEN CREATION (default, creative-grid standard)
	;;       Any user can upload assets
	;;       Matches user expectations from creative platforms
	;;       Minimal friction for builders and creators
	;;
	;; >0 = RESTRICTED UPLOAD
	;;       Only users with UserLevel >= LevelUpload may upload
	;;       All others will see upload failures or disabled UI
	;;
	;; --------------------------------------------------
	;; CRITICAL REALITY
	;; --------------------------------------------------
	;;
	;; Setting this to ANYTHING OTHER THAN 0 will:
	;;    Break the assumption that "I can build things here"
	;;    Generate user confusion and support requests
	;;    Feel like a bug unless clearly communicated
	;;
	;; THIS IS NOT A TECHNICAL SETTING.
	;; THIS IS A POLICY DECISION.
	;;
	;; --------------------------------------------------
	;; WHEN NON-ZERO VALUES MAKE SENSE
	;; --------------------------------------------------
	;;
	;; Restricting uploads MAY be appropriate for:
	;;    Educational grids (student access by role or level)
	;;    Anti-spam / anti-grief mitigation
	;;    Subscription-based grids
	;;    Time-on-grid or trust-based promotion systems
	;;
	;; EXAMPLES:
	;;    New users cannot upload until X days on grid
	;;    Upload rights granted manually by staff
	;;    Upload rights tied to paid accounts
	;;
	;; NOTE:
	;; OpenSim itself provides NO automation for this.
	;; Any promotion, timing, or entitlement system must
	;; be implemented externally (admin tools, scripts, policy).
	;;
	;; --------------------------------------------------
	;; ADMIN COST
	;; --------------------------------------------------
	;;
	;; Restricting uploads:
	;;    Increases administrative workload
	;;    Requires clear onboarding documentation
	;;    Requires a defined process to grant upload rights
	;;
	;; Without that process, this setting becomes user-hostile.
	;;
	;;
	;; Creative grids:
	;;    MUST use LevelUpload = 0
	;;
	;; Restricted / controlled grids:
	;;    MAY use non-zero values
	;;    MUST clearly communicate upload policy
	;;    MUST provide a path to obtain upload rights
	;;
	LevelUpload = 0

	;; --------------------------------------------------
	;; UPLOAD ABUSE MITIGATION  (COST-BASED CONTROL)
	;; --------------------------------------------------
	;;
	;; IMPORTANT CONTEXT:
	;;
	;; Restricting uploads via UserLevel is NOT the only way
	;; to mitigate spam or grief uploads.
	;;
	;; A proven alternative model (used by Second Life) is
	;; PER-UPLOAD COST.
	;;
	;; In this model:
	;;    Anyone can upload
	;;    Each upload incurs a small fee
	;;    Spam and hit-and-run griefing becomes expensive
	;;
	;; THIS PRESERVES CREATIVE ACCESS
	;; while discouraging abuse.
	;;
	;; --------------------------------------------------
	;; PriceUpload  (MISPLACED SETTING)
	;; --------------------------------------------------
	;;
	;; PriceUpload controls the COST charged per asset upload.
	;;
	;; REALITY:
	;;    This setting directly affects creation, not economy
	;;    Its logical home is HERE, alongside LevelUpload
	;;
	;; CURRENT PROBLEM:
	;;    PriceUpload is defined under [Economy]
	;;    That placement obscures its true purpose
	;;    Leads admins to miss a key abuse-mitigation tool
	;;
	;; CODE TODO (MANDATORY):
	;;    Move PriceUpload definition to this section
	;;    Treat upload cost as a creation policy, not economy policy
	;;    Keep Economy as accounting, not access control
	;;
	;; POLICY GUIDANCE:
	;;    LevelUpload = 0  +  PriceUpload > 0
	;;       -> Open creative grid with abuse friction
	;;
	;;    LevelUpload > 0  +  PriceUpload = 0
	;;       -> Controlled-access grid
	;;
	;;    LevelUpload = 0  +  PriceUpload = 0
	;;       -> Fully open (highest abuse risk)
	;;
	;; NOTE:
	;; Upload cost MUST be clearly communicated to users.
	;; Silent charges breed distrust.

[RegionReady]
	;; ------------------------------------------------------------------
	;; REGION READY SIGNALING  (STARTUP STABILITY & ORCHESTRATION)
	;; ------------------------------------------------------------------
	;;
	;; This module provides a reliable signal when a region has:
	;;    Finished loading objects
	;;    Finished compiling scripts
	;;    Completed OAR restore (if applicable)
	;;
	;; This is CRITICAL for:
	;;    Preventing early-login instability
	;;    Large scripted regions
	;;    Automated startup pipelines
	;;    External monitoring and orchestration
	;;
	;; IMPORTANT:
	;; This module is often hidden in OpenSimDefaults.ini,
	;; making its existence easy to miss.
	;; It SHOULD be surfaced and documented in unified configs.

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Enables the RegionReady signaling module.
	;;
	;; true  = Module active (recommended)
	;; false = No readiness signaling
	;;
	;; DISABLING THIS:
	;;    Removes visibility into region startup completion
	;;    Increases risk of users entering unstable regions
	;;
	enabled = true

	;; --------------------------------------------------
	;; channel_notify
	;; --------------------------------------------------
	;;
	;; In-world chat channel used to broadcast region readiness messages.
	;;
	;; MESSAGE FORMAT:
	;;   "{server_startup|oar_file_load},{0|1},n,[oar error]"
	;;
	;; FIELD MEANINGS:
	;;   1. server_startup | oar_file_load
	;;       Indicates why the region was initialized
	;;
	;;   2. 0 or 1
	;;       1 = OAR load successful
	;;       0 = OAR load failed
	;;
	;;   3. n
	;;       Number of scripts that FAILED to compile
	;;
	;;   4. [oar error] (optional)
	;;       Error message from OAR load
	;;
	;; USE CASES:
	;;    In-world admin listeners
	;;    Automated diagnostics
	;;    Visual startup indicators
	;;
	;; NOTE:
	;; Use a NEGATIVE channel to avoid user chat collisions.
	;;
	channel_notify = -800

	;; --------------------------------------------------
	;; login_disable
	;; --------------------------------------------------
	;;
	;; Prevents avatar logins while the region is still initializing.
	;;
	;; true  = Block logins until region is fully ready (recommended)
	;; false = Allow users in during script compilation
	;;
	;; WHY THIS EXISTS:
	;;    Regions with large script counts can become unstable
	;;     if users enter before scripts finish compiling
	;;
	;; SYMPTOMS WHEN DISABLED ON SCRIPT-HEAVY REGIONS:
	;;    Lag spikes
	;;    Script failures
	;;    Perceived "random instability"
	;;    Region crashes shortly after startup
	;;
	;; THIS IS A PREVENTATIVE STABILITY CONTROL.
	;;
	login_disable = true

	;; --------------------------------------------------
	;; alert_uri
	;; --------------------------------------------------
	;;
	;; Optional HTTP endpoint that receives a JSON payload
	;; when the region reaches a READY state.
	;;
	;; WHEN ENABLED:
	;;    RegionReady sends a POST request
	;;    Payload contains the same readiness data
	;;    Enables integration with external systems
	;;
	;; USE CASES:
	;;    Web dashboards
	;;    Discord / Slack notifiers
	;;    Monitoring systems
	;;    Orchestration pipelines
	;;
	;; SECURITY NOTE:
	;;    Endpoint must be trusted
	;;    Data is unauthenticated by default
	;;    Protect with network-level controls
	;;
	;; alert_uri = "http://myappserver.net/my_handler/"

	;; ------------------------------------------------------------------
	;; TODO / IMPROVEMENTS
	;; ------------------------------------------------------------------
	;;
	;;  Surface RegionReady in primary configuration files
	;;  Add explicit startup log banner when login_disable blocks users
	;;  Provide optional retry / delay logic for failed scripts
	;;  Add authentication support for alert_uri
	;;  Standardize JSON payload schema for external consumers
	;;
	;; RegionReady is a stability and orchestration feature, not a convenience.

	;; ------------------------------------------------------------------
	;; ESTATE MANAGEMENT  (CLIENT-INITIATED CONTROL & ACCESS POLICY)
	;; ------------------------------------------------------------------
	;;
	;; This section controls what ESTATE-LEVEL ACTIONS may be initiated
	;; from the viewer (client), rather than from the simulator console.
	;;
	;; THESE ARE POLICY DECISIONS.
	;; Misconfiguration can lead to:
	;;    Unauthorized restarts
	;;    Region instability
	;;    Abuse or grief-driven disruptions
	;;    Confusion over who is actually in control
	;;

[EstateManagement]
	;; WARNING: Client-initiated restarts can fully shut down regions
	;; depending on InworldRestartShutsDown.

	;; --------------------------------------------------
	;; AllowRegionRestartFromClient
	;; --------------------------------------------------
	;;
	;; Controls whether VALID region restart requests
	;; originating from the viewer are honored.
	;;
	;; true  = Client-initiated restart requests are allowed
	;; false = ALL restart requests must come from console or admin tools
	;;
	;; IMPORTANT:
	;; This does NOT grant restart rights by itself.
	;; It only allows the request path to exist.
	;;
	;; Permissions are still enforced based on:
	;;    UserLevel
	;;    Estate ownership
	;;    God rights
	;;
	;; COUPLING WARNING:
	;; This setting interacts directly with:
	;;   InworldRestartShutsDown (elsewhere in config)
	;;
	;; IF:
	;;   AllowRegionRestartFromClient = true
	;;   AND InworldRestartShutsDown = true
	;;
	;; THEN:
	;;    A client-initiated restart will FULLY SHUT DOWN the region
	;;    Not just perform a soft restart
	;;
	;; THIS IS OFTEN MISUNDERSTOOD.
	;;
	;; OPERATOR GUIDANCE:
	;;    Enable only if you TRUST region owners/managers
	;;    Disable on grids where uptime stability is critical
	;;
	AllowRegionRestartFromClient = true

	;; --------------------------------------------------
	;; IgnoreEstateMinorAccessControl
	;; --------------------------------------------------
	;;
	;; Controls enforcement of ESTATE-LEVEL "minor access" restrictions.
	;;
	;; true  = Ignore minor access controls entirely
	;; false = Enforce minor access restrictions
	;;
	;; CONTEXT:
	;; This exists primarily for grids that implement
	;; age-based or content-based access rules.
	;;
	;; DEFAULT BEHAVIOR:
	;;    true (restrictions ignored)
	;;
	;; SECURITY / POLICY NOTE:
	;;    Enabling enforcement without clear policy
	;;     can lock users out unexpectedly
	;;
	IgnoreEstateMinorAccessControl = true

	;; --------------------------------------------------
	;; IgnoreEstatePaymentAccessControl
	;; --------------------------------------------------
	;;
	;; Controls enforcement of ESTATE-LEVEL payment information restrictions.
	;;
	;; true  = Ignore payment access checks
	;; false = Enforce payment-based access controls
	;;
	;; CONTEXT:
	;; Historically used for grids that:
	;;    Required payment info on file
	;;    Used payment status as a trust signal
	;;
	;; REALITY:
	;;    Most modern grids do NOT use this
	;;    Enforcement without infrastructure is meaningless
	;;
	;; DEFAULT BEHAVIOR:
	;;    true (ignored)
	;;
	IgnoreEstatePaymentAccessControl = true

[UserProfiles]
	;; ------------------------------------------------------------------
	;; USER PROFILES  (IN-WORLD IDENTITY & EXTERNAL INTEGRATION)
	;; ------------------------------------------------------------------
	;;
	;; This section controls USER PROFILE behavior, including:
	;;    In-world profile data
	;;    Integration with the UserProfilesService
	;;    Optional web-based profile extensions
	;;
	;; IMPORTANT:
	;; Profile support exists in TWO MODES:
	;;    BASIC (local, minimal)
	;;    FULL (service-backed, extensible)
	;;
	;; Which mode you get depends entirely on ProfileURL.
	;;
	;; --------------------------------------------------
	;; ProfileURL
	;; --------------------------------------------------
	;;
	;; URL of the UserProfilesService (typically hosted by Robust).
	;;
	;; BEHAVIOR:
	;;
	;;   ProfileURL UNSET or "":
	;;      BASIC profile support only
	;;      Minimal fields
	;;      Stored locally
	;;      No external service integration
	;;
	;;   ProfileURL SET to valid URL:
	;;      FULL profile support enabled
	;;      Extended profile fields
	;;      Centralized storage via Robust
	;;      Enables integration with:
	;;         - WebUI
	;;         - External tools
	;;         - Profile-based services
	;;
	;; EXAMPLE:
	;;   http://127.0.0.1:9000
	;;
	;; NOTE:
	;; This URL MUST point to a functioning
	;; UserProfilesService endpoint.
	;;
	;; If set incorrectly:
	;;    Profile access may fail
	;;    Viewer profile panels may break
	;;
	;; ProfileURL = http://127.0.0.1:9000

	;; --------------------------------------------------
	;; AllowUserProfileWebURLs
	;; --------------------------------------------------
	;;
	;; Controls whether users may include WEB URLs
	;; in their profile fields.
	;;
	;; true  = Allow clickable web links in profiles
	;; false = Strip or block external URLs
	;;
	;; SECURITY CONTEXT:
	;;    Profiles are user-visible
	;;    Links may point outside the grid
	;;    This can be abused for phishing or spam
	;;
	;; POLICY TRADEOFF:
	;;    true  -> More expressive profiles, higher risk
	;;    false -> Safer environment, less flexibility
	;;
	;; RECOMMENDED:
	;;    true on trusted, adult, or creator grids
	;;    false on family-friendly or closed grids
	;;
	AllowUserProfileWebURLs = true

	;; ------------------------------------------------------------------
	;; TODO / FUTURE USE
	;; ------------------------------------------------------------------
	;;
	;;  Integrate UserProfilesService with VergeGrid WebUI
	;;  Expose UserLevel and role metadata in profiles
	;;  Add profile-based access hints for moderators
	;;  Provide profile audit and moderation tools
	;;
	;; User profiles are an identity integration point, not just viewer fluff.

[Network]
	;; ------------------------------------------------------------------
	;; NETWORK & HTTP INTERFACES
	;; ------------------------------------------------------------------
	;;
	;; This section configures:
	;;    Simulator HTTP listeners
	;;    SSL/TLS handling for those listeners
	;;    Script-level outbound HTTP restrictions
	;;
	;; IMPORTANT:
	;; This section historically ALSO included a "remote admin" concept.
	;; That design is now considered OUTDATED and INSECURE.
	;;
	;; Modern grids SHOULD NOT rely on per-region HTTP admin endpoints.
	;;
	;; ------------------------------------------------------------------
	;; PORT CONFLICT WARNING  (LEGACY REMOTE ADMIN LISTENERS)
	;; ------------------------------------------------------------------
	;;
	;; CRITICAL OPERATIONAL RISK:
	;;
	;; Enabling additional HTTP/HTTPS listeners (console, remote admin,
	;; out-of-band management) on a per-instance or per-region basis
	;; introduces a HIGH RISK of PORT CONFLICTS.
	;;
	;; WHY THIS HAPPENS:
	;;    Each simulator instance requires UNIQUE ports
	;;    Estate and region counts scale horizontally
	;;    Port assignments are manual and static
	;;    No automatic port discovery or collision detection exists
	;;
	;; FAILURE MODES:
	;;    Simulator fails to bind to port
	;;    Silent listener failure
	;;    Regions appear to start but services are unreachable
	;;    Random behavior depending on startup order
	;;
	;; WORST-CASE SCENARIO:
	;;    One instance binds successfully
	;;    Another instance silently loses its admin interface
	;;    Operator believes remote admin is working everywhere
	;;     when it is not
	;;
	;; THIS DOES NOT SCALE.
	;;
	;; OPERATOR GUIDANCE:
	;;    Do NOT broadly enable legacy remote admin listeners
	;;    Do NOT rely on per-region HTTP admin endpoints
	;;    Avoid manual port sprawl entirely
	;;
	;; CORRECT ARCHITECTURAL DIRECTION:
	;;    Centralized WebUI / control plane
	;;    Single externally managed service
	;;    Role-based access via UserLevel
	;;    One network exposure point, not hundreds
	;;
	;; Port conflicts are not an edge case here.
	;; They are INEVITABLE at scale.
	;;
	;; WARNING: Per-instance admin listeners do not scale and will cause port conflicts.
	;; --------------------------------------------------
	;; LEGACY REMOTE CONSOLE ACCESS  (DEPRECATED)
	;; --------------------------------------------------
	;;
	;; ConsoleUser / ConsolePass were part of an early attempt
	;; at remote administrative access via HTTP.
	;;
	;; DESIGN FLAWS:
	;;    Credentials stored in plaintext
	;;    No role separation
	;;    No auditing
	;;    Requires per-instance configuration
	;;    Scales poorly across estates and regions
	;;
	;; SECURITY STATUS:
	;;    Considered INSECURE
	;;    Should NOT be exposed publicly
	;;    Should NOT be enabled on production grids
	;;
	;; OPERATOR GUIDANCE:
	;;    Leave unused
	;;    Prefer external orchestration via authenticated services
	;;
	;;ConsoleUser = "Test"
	;;ConsolePass = "secret"
	;;console_port = 0

	;; --------------------------------------------------
	;; MAIN HTTP LISTENER
	;; --------------------------------------------------
	;;
	;; Primary HTTP endpoint used by the simulator for:
	;;    Internal services
	;;    Capabilities
	;;    Module endpoints
	;;
	;; This listener is PER INSTANCE.
	;;
	;;http_listener_port = 9000

	;; --------------------------------------------------
	;; SSL / TLS FOR MAIN LISTENER  (EXPERIMENTAL / LIMITED)
	;; --------------------------------------------------
	;;
	;; These options replace the main HTTP listener
	;; with an HTTPS listener.
	;;
	;; LIMITATIONS:
	;;    Experimental
	;;    Requires strict hostname alignment
	;;    Poor separation of concerns
	;;
	;; RECOMMENDATION:
	;;    Prefer terminating TLS externally (reverse proxy)
	;;    Use these only in controlled environments
	;;
	;;http_listener_ssl = false
	;;http_listener_sslport = 9001
	;;http_listener_cn = "myRegionsExternalHostName"
	;;http_listener_cert_path = "mycert.p12"
	;;http_listener_cert_pass = "mycertpass"

	;; --------------------------------------------------
	;; ADDITIONAL HTTPS LISTENER  (LEGACY REMOTE ADMIN PATH)
	;; --------------------------------------------------
	;;
	;; This listener was intended for:
	;;    Remote admin modules
	;;    Out-of-band management scripts
	;;
	;; REALITY:
	;;    Each region/instance requires its own listener
	;;    No central control plane
	;;    Massive duplication
	;;    Configuration sprawl
	;;
	;; STATUS:
	;;    Deprecated by design
	;;    Do NOT use for new deployments
	;;
	;; DESIGN NOTE:
	;; A proper remote admin system should be:
	;;    Centralized
	;;    Authenticated
	;;    Role-aware
	;;    Auditable
	;;
	;; https_listener = False
	;; https_port = 0
	;; cert_path = "path/to/cert.p12"
	;; cert_pass = "password"

	;; --------------------------------------------------
	;; SCRIPT HTTP SECURITY (CRITICAL)
	;; --------------------------------------------------
	;;
	;; Controls where USER SCRIPTS may send HTTP requests.
	;;
	;; THIS IS A MAJOR SECURITY BOUNDARY.
	;;
	;; Prevents scripts from:
	;;    Scanning internal networks
	;;    Attacking local services
	;;    Exfiltrating internal data
	;;
	;; DEFAULT:
	;;    Blocks all reserved/private IP ranges
	;;
	;; MODIFY WITH EXTREME CARE.
	;;
	OutboundDisallowForUserScripts =
		0.0.0.0/8|
		10.0.0.0/8|
		100.64.0.0/10|
		127.0.0.0/8|
		169.254.0.0/16|
		172.16.0.0/12|
		192.0.0.0/24|
		192.0.2.0/24|
		192.88.99.0/24|
		192.168.0.0/16|
		198.18.0.0/15|
		198.51.100.0/24|
		203.0.113.0/24|
		224.0.0.0/4|
		240.0.0.0/4|
		255.255.255.255/32

	;; --------------------------------------------------
	;; SCRIPT IDENTITY HEADERS
	;; --------------------------------------------------
	;;
	;; Identifiers sent with llHTTPRequest.
	;;
	shard = "OpenSim"
	;; user_agent = "OpenSim LSL (Mozilla Compatible)"

	;; --------------------------------------------------
	;; REQUEST CONCURRENCY LIMITS
	;; --------------------------------------------------
	;;
	;; Limits simultaneous outbound service requests
	;; to avoid runtime hangs under Mono.
	;;
	;; Applies primarily to asset retrieval.
	;;
	;; MaxRequestConcurrency = 30
	;; ------------------------------------------------------------------
	;; TODO / DEPRECATION NOTICE
	;; ------------------------------------------------------------------
	;;
	;; Legacy remote admin via per-instance HTTP listeners
	;; is deprecated and SHOULD NOT be used.
	;;
	;; Future management MUST be:
	;;    Centralized
	;;    Authenticated
	;;    Role-based (UserLevel)
	;;    Externally orchestrated
	;;
	;; NOTE: This section contains legacy remote admin remnants.
	;; Do not confuse them with a modern management interface.

	;; WARNING:
	;; LSL HTTP features expose your simulator to the internet.
	;; Throttles here are not performance tuning knobs.
	;; They are DAMAGE LIMITERS.
	;; ------------------------------------------------------------------
	;; LSL HTTP SERVICES  (SCRIPT-EXPOSED NETWORK INTERFACE)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how in-world scripts interact with HTTP:
	;;    Outbound requests (llHttpRequest)
	;;    Inbound URLs (llRequestURL / llRequestSecureURL)
	;;
	;; THIS IS A MAJOR SECURITY AND STABILITY BOUNDARY.
	;; Poor configuration here can result in:
	;;    Abuse via scripted HTTP floods
	;;    Denial-of-service against the simulator
	;;    Unexpected public exposure of script endpoints

	;; --------------------------------------------------
	;; ExternalHostNameForLSL
	;; --------------------------------------------------
	;;
	;; Defines the externally visible hostname used when scripts
	;; request inbound HTTP URLs.
	;;
	;; AFFECTS:
	;;    llRequestURL
	;;    llRequestSecureURL
	;;
	;; REQUIRED FOR:
	;;    Any inbound HTTP callbacks to scripts
	;;    Webhook-style integrations
	;;    External API callbacks
	;;
	;; BEHAVIOR:
	;;    If UNSET or invalid:
	;;       - llRequestURL / llRequestSecureURL are DISABLED
	;;    If SET:
	;;       - Simulator generates publicly reachable URLs
	;;
	;; SECURITY IMPLICATION:
	;;    This exposes script endpoints to the outside world
	;;    Scripts may receive unsolicited traffic
	;;
	;; MUST:
	;;    Be a valid DNS hostname
	;;    Resolve to the simulator externally
	;;    Match SSL certificate if secure URLs are used
	;;
	;; COMMON USE CASES:
	;;    Tip jars
	;;    Web dashboards
	;;    External API callbacks
	;;
	;; MISCONFIGURATION SYMPTOMS:
	;;    Scripts fail silently
	;;    External services cannot reach in-world logic
	;;    Hard-to-diagnose “HTTP just doesn’t work” complaints
	;;
	ExternalHostNameForLSL = ${Const|BaseHostname}

	;; ------------------------------------------------------------------
	;; SCRIPT HTTP REQUEST THROTTLING
	;; ------------------------------------------------------------------
	;;
	;; These limits exist to PREVENT ABUSE and SELF-DOS.
	;;
	;; Scripts can generate HTTP traffic faster than humans realize.
	;; Without throttling, a single object can saturate:
	;;    CPU
	;;    Thread pools
	;;    Network sockets
	;;
	;; These limits are PER SIMULATOR INSTANCE unless noted otherwise.
	;;

[ScriptsHttpRequestModule]
	;; --------------------------------------------------
	;; MaxPoolThreads
	;; --------------------------------------------------
	;;
	;; Maximum number of concurrent HTTP connections
	;; used by llHttpRequest across ALL scenes.
	;;
	;; default = 8
	;;
	;; TOO LOW:
	;;    Legitimate scripts stall
	;;    APIs time out
	;;
	;; TOO HIGH:
	;;    Thread exhaustion
	;;    Increased memory pressure
	;;    Amplified DoS impact
	;;
	;; MaxPoolThreads = 8

	;; --------------------------------------------------
	;; PrimRequestsPerSec
	;; --------------------------------------------------
	;;
	;; Maximum HTTP requests per second
	;; for ALL scripts in a SINGLE prim.
	;;
	;; default = 1.0
	;;
	;; PURPOSE:
	;;    Prevent runaway scripts
	;;    Prevent poorly written timers from flooding
	;;
	;; PrimRequestsPerSec = 1.0

	;; --------------------------------------------------
	;; PrimRequestsBurst
	;; --------------------------------------------------
	;;
	;; Initial burst allowance before throttling applies
	;; for scripts in a single prim.
	;;
	;; default = 3.0
	;;
	;; PURPOSE:
	;;    Allow short startup bursts
	;;    Still enforce sustained rate limits
	;;
	;; PrimRequestsBurst = 3.0

	;; --------------------------------------------------
	;; PrimOwnerRequestsPerSec
	;; --------------------------------------------------
	;;
	;; Maximum HTTP requests per second
	;; for ALL objects owned by a SINGLE avatar
	;; across the entire simulator instance.
	;;
	;; default = 25.0
	;;
	;; THIS IS A CRITICAL ABUSE CONTROL.
	;;
	;; Without this:
	;;    One user can rez many objects
	;;    Each object sends requests
	;;    Aggregate flood overwhelms the sim
	;;
	;; PrimOwnerRequestsPerSec = 25.0

	;; --------------------------------------------------
	;; PrimOwnerRequestsBurst
	;; --------------------------------------------------
	;;
	;; Initial burst allowance for ALL objects
	;; owned by a single avatar.
	;;
	;; default = 5.0
	;;
	;; PURPOSE:
	;;    Permit legitimate batch operations
	;;    Prevent sustained abuse
	;;
	;; PrimOwnerRequestsBurst = 5.0

	;; --------------------------------------------------
	;; RequestsTimeOut
	;; --------------------------------------------------
	;;
	;; Maximum time (in milliseconds) the simulator will wait
	;; for an HTTP response initiated via llHttpRequest.
	;; NOTE: Long HTTP timeouts magnify failure impact.
	;; Faster failure is often safer than slow success.
	;;
	;; RANGE:
	;;    Minimum: 200 ms
	;;    Maximum: 60000 ms (60 seconds)
	;;    Default: 30000 ms (30 seconds)
	;;
	;; WHAT THIS CONTROLS:
	;;    How long a worker thread is held waiting on a response
	;;    How long external API delays block script execution
	;;
	;; WHAT THIS DOES NOT CONTROL:
	;;    Network retries
	;;    External service behavior
	;;    Viewer-side HTTP
	;;
	;; FAILURE MODES:
	;;    Too HIGH:
	;;       - Threads remain occupied for long periods
	;;       - Accumulates under slow or failing endpoints
	;;       - Contributes to thread pool exhaustion
	;;
	;;    Too LOW:
	;;       - Legitimate APIs may time out prematurely
	;;       - Scripts may see frequent HTTP failures
	;;
	;; ABUSE CONSIDERATION:
	;;    Long timeouts amplify the impact of:
	;;       - dead endpoints
	;;       - intentionally slow responses
	;;       - misconfigured services
	;;
	;; OPERATOR GUIDANCE:
	;;    Prefer shorter timeouts for real-time systems
	;;    External services should respond quickly
	;;    Slow APIs should be polled asynchronously or offloaded
	;;
	;; COMMON PRACTICE:
	;;    10000–15000 ms for responsive APIs
	;;    30000 ms only when unavoidable
	;;
	;; RequestsTimeOut = 30000

[AccessControl]	
	;; ------------------------------------------------------------------
	;; VIEWER ACCESS CONTROL  (CLIENT ADMISSION POLICY)
	;; ------------------------------------------------------------------
	;;
	;; This section controls which VIEWERS are allowed or denied
	;; access to the grid based on viewer identification strings.
	;;
	;; THIS IS A POWERFUL GATEKEEPING MECHANISM.
	;;
	;; Misuse can:
	;;    Lock out legitimate users
	;;    Trigger accusations of favoritism or censorship
	;;    Break compatibility with third-party viewers
	;;
	;; Proper use can:
	;;    Block known exploit viewers
	;;    Enforce policy or compliance requirements
	;;    Improve stability and security
	;;
	;;  Use DeniedClients to block known exploit viewers
	;;  Avoid AllowedClients except in closed environments
	;;  Communicate any viewer restrictions clearly to users
	;;
	;; NOTE: Viewer access control is policy enforcement, not security enforcement.

	;; --------------------------------------------------
	;; AllowedClients
	;; --------------------------------------------------
	;;
	;; Explicit WHITELIST of viewers allowed to connect.
	;;
	;; FORMAT:
	;;   |-separated list of viewer name substrings
	;;
	;; BEHAVIOR:
	;;    If EMPTY or UNSET:
	;;       - No whitelist is enforced
	;;       - All viewers are allowed unless denied below
	;;
	;;    If SET:
	;;       - ONLY viewers matching this list are allowed
	;;       - ALL others are rejected, even if not malicious
	;;
	;; EXAMPLES:
	;;   AllowedClients = "Firestorm|Cool VL Viewer"
	;;
	;; WARNING:
	;;    Whitelisting is EXTREMELY restrictive
	;;    New viewer versions may change identifiers
	;;    Users may be locked out without warning
	;;
	;; RECOMMENDED USE:
	;;    Closed or managed environments
	;;    Compliance-driven grids
	;;    Testing scenarios
	;;
	;; NOT RECOMMENDED FOR:
	;;    Public creative grids
	;;    Open communities
	;;
	;; AllowedClients = ""

	;; --------------------------------------------------
	;; DeniedClients
	;; --------------------------------------------------
	;;
	;; BLACKLIST of viewers that are NOT allowed to connect.
	;;
	;; FORMAT:
	;;   |-separated list of viewer name substrings
	;;
	;; BEHAVIOR:
	;;    Evaluated AFTER AllowedClients
	;;    Any match here is DENIED, even if also allowed
	;;
	;; EXAMPLES:
	;;   DeniedClients = "BadViewer|ExploitViewer"
	;;
	;; USE CASES:
	;;    Block known exploit or grief-enabling viewers
	;;    Block outdated or unstable viewers
	;;    Temporarily mitigate known client bugs
	;;
	;; RISK:
	;;    Viewer names are easy to spoof
	;;    Determined attackers can evade simple string checks
	;;
	;; REALITY:
	;;    This is a deterrent, not a security boundary
	;;
	;; DeniedClients = ""
	;; ------------------------------------------------------------------
	;; CRITICAL TODO  (USER-FACING DENIAL REASONS)
	;; ------------------------------------------------------------------
	;;
	;; CURRENT BEHAVIOR (DEFECT):
	;;
	;; When a viewer is denied via AllowedClients or DeniedClients,
	;; the login attempt FAILS with a GENERIC error.
	;;
	;; The user is NOT told:
	;;    WHY the login failed
	;;    WHETHER the server is down
	;;    WHETHER their viewer is incompatible
	;;    WHETHER access is intentionally restricted
	;;
	;; RESULT:
	;;    Users assume the grid is broken
	;;    Admins get flooded with support requests
	;;    Dangerous situations go undetected by users
	;;
	;; THIS IS UNACCEPTABLE.
	;;
	;; ------------------------------------------------------------------
	;; REQUIRED BEHAVIOR (DESIGN GOAL):
	;; ------------------------------------------------------------------
	;;
	;; Viewer access denial MUST return an EXPLICIT, USER-READABLE REASON.
	;;
	;; EXAMPLES:
	;;
	;;    "Login denied: Viewer version X.Y.Z is not supported on this grid."
	;;
	;;    "Login denied: This viewer contains features that can damage
	;;      inventories on this grid. Please use Firestorm <= 6.6.x."
	;;
	;;    "Login denied: Viewer is blacklisted due to policy violations."
	;;
	;;    "Login denied: Repeated attempts from this viewer may result
	;;      in further restrictions."
	;;
	;; ------------------------------------------------------------------
	;; OPERATIONAL BENEFITS:
	;; ------------------------------------------------------------------
	;;
	;;  Users immediately understand the cause
	;;  Users can take corrective action
	;;  Prevents irreversible data loss
	;;  Reduces admin support load
	;;  Turns denial into PROTECTION, not punishment
	;;
	;; A user who understands WHY access is denied
	;; is far less likely to escalate or retry blindly.
	;;
	;; ------------------------------------------------------------------
	;; SECURITY EXTENSIONS (FUTURE):
	;; ------------------------------------------------------------------
	;;
	;;  Optional escalating warnings for repeated denied attempts
	;;  Policy-specific messaging (IP rights, exploit prevention, etc.)
	;;  Integration with WebUI status and announcements
	;;
	;; ------------------------------------------------------------------
	;; CORE PRINCIPLE:
	;; ------------------------------------------------------------------
	;;
	;; Silent failure is indistinguishable from system failure.
	;; Explicit denial reasons are REQUIRED for safe operation.

[ClientStack.LindenUDP]
	;; ------------------------------------------------------------------
	;; CLIENT NETWORK STACK  (UDP THROTTLING & FLOW CONTROL)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how the simulator sends data to viewers
	;; over LindenUDP.
	;;
	;; THESE SETTINGS DIRECTLY AFFECT:
	;;    Perceived lag
	;;    Rez speed
	;;    Login storms
	;;    Network saturation
	;;    Client disconnects
	;;
	;; IMPORTANT:
	;; These are NOT experimental internals.
	;; These are REAL tuning controls that can dramatically
	;; improve grid performance when used correctly.
	;;
	;; They are hidden in defaults today, which prevents
	;; admins from fixing real problems.
	;;
	;; Do not remove user capability to compensate for undocumented infrastructure.
	;; Fix the infrastructure and document the tuning.
	;;	
	;;
	;; ------------------------------------------------------------------
	;; PERFORMANCE GUIDANCE  (DRAW DISTANCE & NETWORK LOAD)
	;; ------------------------------------------------------------------
	;;
	;; High draw distances increase:
	;;    Object updates
	;;    Texture transfers
	;;    UDP bandwidth demand
	;;
	;; IF USERS REPORT:
	;;    Slow rez at high draw distance
	;;    Login lag during events
	;;    Texture thrashing
	;;
	;; THEN TUNE:
	;;    scene_throttle_max_bps
	;;    client_throttle_max_bps
	;;    TextureSendLimit
	;;    AckTimeout
	;;
	;; DO NOT:
	;;    Clamp draw distance to hide network saturation
	;;
	;; Proper tuning preserves user experience
	;; while keeping the grid stable.
	;;
	;; --------------------------------------------------
	;; scene_throttle_max_bps
	;; --------------------------------------------------
	;;
	;; Maximum TOTAL outbound bandwidth for a single scene.
	;;
	;; VALUE:
	;;   Bytes per second (not bits)
	;;
	;; 0 = No scene-level throttling (default)
	;;
	;; USE CASE:
	;;    Prevent a single busy region from saturating
	;;     the host network interface
	;;
	;; EXAMPLE:
	;;   2,500,000 bytes/sec ≈ 20 Mbps
	;;
	;; WHEN TO USE:
	;;    Multi-region instances
	;;    Shared network uplinks
	;;    High-avatar-count events
	;;
	;; RISK:
	;;    Too low = slow rez for everyone
	;;
	;; scene_throttle_max_bps = 2500000

	;; --------------------------------------------------
	;; client_throttle_max_bps
	;; --------------------------------------------------
	;;
	;; Maximum outbound bandwidth PER CLIENT.
	;;
	;; Overrides viewer bandwidth preferences.
	;;
	;; VALUE:
	;;   Bytes per second
	;;
	;; 0 = No per-client aggregate throttle (default)
	;;
	;; USE CASE:
	;;    Prevent one client from monopolizing bandwidth
	;;    Enforce fairness during crowded events
	;;
	;; EXAMPLE:
	;;   187,500 bytes/sec ≈ 1.5 Mbps
	;;
	;; WHEN TO USE:
	;;    Public grids
	;;    Events with mixed client quality
	;;
	;; RISK:
	;;    Too low = slow rez, texture thrashing
	;;
	;; client_throttle_max_bps = 187500

	;; --------------------------------------------------
	;; adaptive_throttle_min_bps
	;; --------------------------------------------------
	;;
	;; Minimum bandwidth PER CLIENT when adaptive throttling
	;; is in effect.
	;;
	;; VALUE:
	;;   Bytes per second
	;;
	;; PURPOSE:
	;;    Prevent adaptive throttling from starving clients
	;;    Guarantees a minimum experience floor
	;;
	;; EXAMPLE:
	;;   32,000 bytes/sec ≈ 256 kbps
	;;
	;; adaptive_throttle_min_bps = 32000

	;; --------------------------------------------------
	;; enable_adaptive_throttles
	;; --------------------------------------------------
	;;
	;; Enables adaptive throttling during high-load conditions,
	;; especially during mass logins.
	;;
	;; STATUS:
	;;    Currently disabled upstream
	;;    Present for future or experimental use
	;;
	;; DESIGN INTENT:
	;;    Ramp clients in slowly during login storms
	;;    Reduce rez spikes and UDP floods
	;;
	;; enable_adaptive_throttles = false

	;; --------------------------------------------------
	;; TextureSendLimit
	;; --------------------------------------------------
	;;
	;; Number of texture packets queued per update cycle.
	;;
	;; PURPOSE:
	;;    Balances throughput vs responsiveness
	;;
	;; HIGHER VALUES:
	;;    Faster bulk texture rez
	;;    Slower response to priority changes or aborts
	;;
	;; LOWER VALUES:
	;;    More responsive priority changes
	;;    Lower overall throughput
	;;
	;; THIS IS A CLASSIC TRADEOFF KNOB.
	;;
	;; TextureSendLimit = 20

	;; --------------------------------------------------
	;; DisableFacelights
	;; --------------------------------------------------
	;;
	;; Removes light properties from attachments not on hands.
	;;
	;; EFFECT:
	;;    Allows legitimate lights (lanterns, flashlights)
	;;    Prevents face lights and vanity light spam
	;;
	;; PERFORMANCE BENEFIT:
	;;    Reduces per-avatar lighting load
	;;    Improves render performance
	;;
	;; SIDE EFFECT:
	;;    Head-mounted lights also removed
	;;
	;; DisableFacelights = false

	;; --------------------------------------------------
	;; AckTimeout
	;; --------------------------------------------------
	;;
	;; Time to wait before disconnecting an unresponsive client.
	;;
	;; VALUE:
	;;   Seconds
	;;
	;; DEFAULT:
	;;   60 seconds
	;;
	;; USE CASE:
	;;    Detect dead or stalled clients
	;;
	;; RISK:
	;;    Too low = false disconnects
	;;    Too high = zombie connections linger
	;;
	;; AckTimeout = 60

	;; --------------------------------------------------
	;; PausedAckTimeout
	;; --------------------------------------------------
	;;
	;; Extended timeout for paused clients.
	;;
	;; CONTEXT:
	;;    File dialogs during uploads pause network flow
	;;
	;; DEFAULT:
	;;   300 seconds (5 minutes)
	;;
	;; PURPOSE:
	;;    Prevent disconnects during legitimate pauses
	;;
	;; PausedAckTimeout = 300

	;; --------------------------------------------------
	;; SupportViewerObjectsCache
	;; --------------------------------------------------
	;;
	;; Enables viewer-side object caching support.
	;;
	;; true  = Allow viewers to cache objects (default)
	;; false = Disable object caching
	;;
	;; BENEFITS:
	;;    Faster rez after relog
	;;    Reduced network traffic
	;;
	;; COMPATIBILITY NOTE:
	;;    Some very old viewers do not support this
	;;    If prims fail to rez, users may need
	;;     to reduce viewer bandwidth settings
	;;
	;; SupportViewerObjectsCache = true

[ClientStack.LindenCaps]
	;; ------------------------------------------------------------------
	;; CLIENT CAPABILITIES (CAPS)
	;; ------------------------------------------------------------------
	;;
	;; CAPS are HTTP endpoints advertised to viewers during login.
	;; Viewers use CAPS to decide how to:
	;;    Fetch assets, textures, meshes, inventory
	;;    Upload content
	;;    Use region features (EEP, map, parcel, estate)
	;;
	;; VALUE RULES (THIS MATTERS):
	;;   "localhost"  = Capability is ENABLED and served by THIS simulator instance.
	;;                 The sim will publish a real URL to the viewer at runtime.
	;;   "" (empty)   = Capability is DISABLED and NOT advertised to the viewer.
	;;   "http(s)://…" = Capability is DELEGATED to an external service (advanced).
	;;
	;; CRITICAL SAFETY PRINCIPLE:
	;; Do NOT set a CAP to "localhost" unless the server actually supports it.
	;; Advertising unsupported CAPS can cause client malfunction and, in some cases,
	;; inventory corruption and irreversible user-impact.
	;;
	;; OPERATOR NOTE:
	;; Many CAPS names originate from Linden Lab conventions, but they are not "SL junk".
	;; They are protocol contracts used by OpenSim-compatible viewers.

	;; ==================================================================
	;; ATTACHMENTS / AVATARS
	;; ==================================================================

	;; AttachmentResources
	;; Purpose: Viewer queries server-side resource info for attachments.
	;; Typical impact: Mostly viewer UI and attachment handling; safe if supported.
	;; Risk if wrong: Usually feature failure, not data loss.
	Cap_AttachmentResources = "localhost"

	;; AvatarPickerSearch
	;; Purpose: People search picker (used in IM invite dialogs, etc.).
	;; Risk if wrong: Search UI fails or returns empty results.
	Cap_AvatarPickerSearch = "localhost"

	;; GetDisplayNames
	;; Purpose: Display name resolution (viewer label presentation).
	;; Risk if wrong: Names may display as legacy usernames only.
	Cap_GetDisplayNames = "localhost"

	;; SetDisplayName
	;; Purpose: Viewer ability to set display names through CAPS.
	;; Note: Often disabled on many grids; depends on backend support.
	Cap_SetDisplayName = ""

	;; ==================================================================
	;; CHAT / EVENTS / SESSION
	;; ==================================================================

	;; ChatSessionRequest
	;; Purpose: Some viewers use this for initiating or managing chat sessions.
	;; Reality: Often unused by OpenSim deployments; leaving disabled is common.
	Cap_ChatSessionRequest = ""

	;; EventQueueGet
	;; Purpose: Core viewer event queue. Viewer receives server events via HTTP.
	;; CRITICAL: If this is not working, viewers will appear frozen or fail to operate.
	Cap_EventQueueGet = "localhost"

	;; DispatchRegionInfo
	;; Purpose: Viewer requests additional region info. Not universally implemented.
	;; Leaving disabled avoids viewer bugs if your branch does not support it.
	Cap_DispatchRegionInfo = ""

	;; ==================================================================
	;; INVENTORY FETCH (HIGH RISK)
	;; ==================================================================
	;;
	;; Inventory CAPS are where the most catastrophic failures occur when mismatched.
	;; Modern viewers expect HTTP-based inventory fetch paths.

	;; FetchInventory (legacy)
	;; Purpose: Older inventory fetch endpoint. Many grids leave it disabled.
	Cap_FetchInventory = ""

	;; WebFetchInventoryDescendents (legacy variant)
	;; Purpose: Older web inventory descendant fetch used by some branches/viewers.
	Cap_WebFetchInventoryDescendents = ""

	;; FetchInventoryDescendents2 (modern)
	;; Purpose: HTTP fetch of inventory folder contents (descendents).
	;; Viewer dependency: Required by many modern viewers. If disabled, inventory browsing breaks.
	;; Risk if mis-implemented: Can cause incorrect inventory state and, on some stacks, corruption.
	Cap_FetchInventoryDescendents2 = "localhost"

	;; FetchInventory2 (modern)
	;; Purpose: HTTP inventory fetch helper used alongside Descendents2.
	;; Viewer dependency: Required by modern viewers. If disabled, inventory operations break.
	Cap_FetchInventory2 = "localhost"

	;; FetchLib / FetchLibDescendents (legacy library inventory)
	;; Purpose: Fetch the library inventory tree (shared system library).
	;; Many OpenSim grids disable legacy variants and only enable v2 where supported.
	Cap_FetchLib = ""
	Cap_FetchLibDescendents = ""

	;; FetchLib2 / FetchLibDescendents2 (modern library inventory)
	;; Purpose: Modern HTTP library inventory fetch.
	;; Risk if wrong: Library tab may be empty or broken.
	Cap_FetchLib2 = "localhost"
	Cap_FetchLibDescendents2 = "localhost"

	;; ==================================================================
	;; ASSET DELIVERY (HIGH IMPORTANCE)
	;; ==================================================================
	;;
	;; These do not just control "features". They control whether content loads.

	;; GetAsset
	;; Purpose: Generic asset fetch endpoint used for various asset types.
	;; Examples: scripts, notecards, animations, sounds, etc. depending on viewer path.
	;; Risk if disabled: Viewers may fail to load many asset-backed items.
	Cap_GetAsset = "localhost"

	;; GetTexture
	;; Purpose: Texture fetch endpoint (image assets). Used heavily.
	;; Risk if disabled: Textures fail to load; everything appears gray or missing.
	Cap_GetTexture = "localhost"

	;; GetMesh
	;; Purpose: Mesh asset fetch (older/standard).
	;; Risk if disabled: Mesh objects may appear as triangles, placeholders, or invisible.
	Cap_GetMesh = "localhost"

	;; GetMesh2
	;; Purpose: Mesh fetch variant used by some newer viewers or code paths.
	;; Note: If your stack supports it, keep enabled. If not, leave disabled.
	;; Risk if mis-advertised: Mesh download failures, viewer errors, possible stalls.
	Cap_GetMesh2 = "localhost"

	;; ==================================================================
	;; UPLOAD / NEW CONTENT (SECURITY SENSITIVE)
	;; ==================================================================
	;;
	;; Upload CAPS define how assets enter the grid. These are common abuse vectors.

	;; NewFileAgentInventory
	;; Purpose: Upload flow placing new items into agent inventory.
	;; Used for textures, sounds, animations, etc.
	;; Risk if disabled: Uploads fail for users.
	Cap_NewFileAgentInventory = "localhost"

	;; NewFileAgentInventoryVariablePrice
	;; Purpose: Upload endpoint that can communicate variable upload pricing.
	;; Only useful if your economy/upload pricing system supports it.
	Cap_NewFileAgentInventoryVariablePrice = "localhost"

	;; UploadBakedTexture
	;; Purpose: Upload baked textures (avatar baking pipeline).
	;; Risk if disabled: Avatar appearance bake issues, gray or wrong clothing layers.
	Cap_UploadBakedTexture = "localhost"

	;; UploadObjectAsset
	;; Purpose: Upload object assets, including mesh upload workflows depending on viewer.
	;; Risk if disabled: Object and mesh uploads fail.
	Cap_UploadObjectAsset = "localhost"

	;; ObjectAdd
	;; Purpose: Object creation via CAPS in some viewer flows.
	;; Risk if disabled: Rez/build operations may degrade in some viewers.
	Cap_ObjectAdd = "localhost"

	;; ==================================================================
	;; SCRIPT / NOTECARD / GESTURE UPDATES (CONTENT MUTATION)
	;; ==================================================================

	;; UpdateScriptAgent
	;; Purpose: Save a script in the user's inventory (agent inventory).
	;; Risk if disabled: Script saving fails.
	Cap_UpdateScriptAgent = "localhost"

	;; UpdateScriptTask
	;; Purpose: Save a script inside an in-world object (task inventory).
	;; Risk if disabled: Editing scripts in prims fails.
	Cap_UpdateScriptTask = "localhost"

	;; UpdateNotecardAgentInventory
	;; Purpose: Save a notecard in user inventory.
	Cap_UpdateNotecardAgentInventory = "localhost"

	;; UpdateNotecardTaskInventory
	;; Purpose: Save a notecard inside an object.
	Cap_UpdateNotecardTaskInventory = "localhost"

	;; UpdateGestureAgentInventory / UpdateGestureTaskInventory
	;; Purpose: Update gestures in inventory or task inventory.
	;; Often disabled if not fully supported.
	Cap_UpdateGestureAgentInventory = ""
	Cap_UpdateGestureTaskInventory = ""

	;; ==================================================================
	;; ENVIRONMENT (EEP) / WINDLIGHT STYLE SETTINGS
	;; ==================================================================

	;; EnvironmentSettings (also controls ExtEnvironment)
	;; Purpose: EEP environment settings (sky, water, day cycles) via CAPS.
	;; Risk if disabled: Viewers cannot apply region environment; defaults only.
	Cap_EnvironmentSettings = "localhost"

	;; ==================================================================
	;; MAP / WORLD MAP
	;; ==================================================================

	;; MapLayer
	;; Purpose: Region map layer data used by world map rendering and map UI.
	;; Risk if disabled: Map may not populate correctly.
	Cap_MapLayer = "localhost"

	;; MapLayerGod
	;; Purpose: Elevated map layer access (admin/god map tools in some viewers).
	;; Risk if disabled: Admin map tools limited.
	Cap_MapLayerGod = "localhost"

	;; ==================================================================
	;; PARCEL / LAND / ESTATE GOVERNANCE
	;; ==================================================================

	;; LandResources
	;; Purpose: Land and parcel resource info used by some viewer panels.
	Cap_LandResources = "localhost"

	;; ParcelPropertiesUpdate
	;; Purpose: Parcel settings update via CAPS.
	;; Risk if disabled: Parcel option changes may fail or fall back to legacy paths.
	Cap_ParcelPropertiesUpdate = "localhost"

	;; RemoteParcelRequest
	;; Purpose: Fetch parcel info remotely (used by map, search, landmarks in some flows).
	Cap_RemoteParcelRequest = "localhost"

	;; EstateAccess
	;; Purpose: Estate access list operations via CAPS.
	;; Risk if disabled: Estate access changes may not work in viewer UI.
	Cap_EstateAccess = "localhost"

	;; EstateChangeInfo
	;; Purpose: Estate info changes. Comment says broken on some viewers.
	;; Guidance: Leave disabled if it causes viewer-side issues on your target viewer set.
	;Cap_EstateChangeInfo = "localhost"

	;; ==================================================================
	;; GROUPS
	;; ==================================================================

	;; GroupMemberData
	;; Purpose: Fetch group membership data via CAPS for viewer group UI.
	Cap_GroupMemberData = "localhost"

	;; GroupProposalBallot / StartGroupProposal
	;; Purpose: Group voting and proposal features. Often unused on OpenSim grids.
	Cap_GroupProposalBallot = ""
	Cap_StartGroupProposal = ""

	;; ==================================================================
	;; MEDIA / VOICE / AUXILIARY FEATURES
	;; ==================================================================

	;; ObjectMedia / ObjectMediaNavigate
	;; Purpose: Media-on-a-prim controls and navigation.
	;; Risk if disabled: MOAP features do not work.
	Cap_ObjectMedia = "localhost"
	Cap_ObjectMediaNavigate = "localhost"

	;; ParcelNavigateMedia / ParcelMediaURLFilterList
	;; Purpose: Parcel media navigation and URL filter list.
	;; Common: Disabled if voice/media stack not deployed.
	Cap_ParcelNavigateMedia = ""
	Cap_ParcelMediaURLFilterList = ""

	;; ParcelVoiceInfoRequest / ProvisionVoiceAccountRequest
	;; Purpose: Voice integration hooks. Typically disabled unless voice service exists.
	Cap_ParcelVoiceInfoRequest = ""
	Cap_ProvisionVoiceAccountRequest = ""

	;; ==================================================================
	;; MISC / RARE / GENERALLY DISABLED CAPS
	;; ==================================================================

	;; CopyInventoryFromNotecard
	;; Purpose: Allow inventory give/copy operations from notecards in some flows.
	Cap_CopyInventoryFromNotecard = "localhost"

	;; HomeLocation
	;; Purpose: Set or fetch home location via CAPS.
	Cap_HomeLocation = "localhost"

	;; ServerReleaseNotes
	;; Purpose: Viewer requests server release notes text.
	Cap_ServerReleaseNotes = "localhost"

	;; GetObjectCost / GetObjectPhysicsData
	;; Purpose: Object cost / physics metadata. Often disabled unless supported.
	Cap_GetObjectCost = ""
	Cap_GetObjectPhysicsData = ""

	;; ProductInfoRequest, SearchStatRequest, SearchStatTracking
	;; Purpose: Commerce and analytics style endpoints. Typically disabled on OpenSim.
	Cap_ProductInfoRequest = ""
	Cap_SearchStatRequest = ""
	Cap_SearchStatTracking = ""

	;; SendPostcard
	;; Purpose: Postcard sending (email style). Usually disabled.
	Cap_SendPostcard = ""

	;; SendUserReport / SendUserReportWithScreenshot
	;; Purpose: Abuse report submission; often disabled unless a backend exists.
	Cap_SendUserReport = ""
	Cap_SendUserReportWithScreenshot = ""

	;; SimConsole / SimulatorFeatures / UntrustedSimulatorMessage / UpdateAgentInformation / UpdateAgentLanguage
	;; Purpose: Various viewer hooks. Often disabled unless you explicitly support them.
	Cap_SimConsole = ""
	Cap_SimulatorFeatures = ""
	Cap_UntrustedSimulatorMessage = ""
	Cap_UpdateAgentInformation = ""
	Cap_UpdateAgentLanguage = ""

	;; TextureStats / ViewerStats
	;; Purpose: Viewer statistics reporting endpoints. Often disabled.
	Cap_TextureStats = ""

	;; ViewerStartAuction
	;; Purpose: Legacy/unused auction feature.
	Cap_ViewerStartAuction = ""

	;; These lines are not optional fluff.
	;; Inventory HTTP CAPS are REQUIRED for modern viewers.
	;; If misconfigured, inventory browsing and transfers break.

	;; ViewerStats
	;; Purpose: Viewer submits client-side statistics to the simulator.
	;; Typical usage: Debugging/telemetry. Many grids disable it.
	;; Risk if enabled: Low direct risk, but can add noise/overhead.
	;; Risk if disabled: None for normal operation.
	Cap_ViewerStats = ""

[Chat]
	;; ------------------------------------------------------------------
	;; CHAT RANGE CONTROL  (PROXIMITY COMMUNICATION)
	;; ------------------------------------------------------------------
	;;
	;; This section controls LOCAL (proximity-based) chat behavior.
	;; These settings directly affect:
	;;
	;;    Privacy and immersion
	;;    Event usability
	;;    Noise pollution and spam
	;;    Griefing amplification
	;;
	;; IMPORTANT REALITY:
	;; Proximity chat is NOT just cosmetic.
	;; Poorly chosen ranges can:
	;;    Leak private conversations
	;;    Encourage region-wide spam
	;;    Force reliance on scripted chat relays
	;;
	;; These values should be chosen INTENTIONALLY.

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Master switch for proximity chat.
	;;
	;; true  = Enable local chat (normal operation)
	;; false = Disable all proximity chat
	;;
	;; NOTE:
	;; Disabling chat breaks basic social interaction
	;; and is almost never appropriate outside of
	;; highly controlled environments.
	;;
	enabled = true

	;; --------------------------------------------------
	;; whisper_distance
	;; --------------------------------------------------
	;;
	;; Maximum distance (in meters) that WHISPER chat travels.
	;;
	;; DEFAULT:
	;;   10 meters
	;;
	;; DESIGN INTENT:
	;;    Private, close-range conversation
	;;    Avatars standing near each other
	;;
	;; USE CASES:
	;;    Intimate conversations
	;;    Roleplay realism
	;;    Reducing accidental eavesdropping
	;;
	;; TOO HIGH:
	;;    Defeats purpose of whisper
	;;    Becomes "quiet say"
	;;
	;; TOO LOW:
	;;    Forces avatars to stand unnaturally close
	;;
	whisper_distance = 3

	;; --------------------------------------------------
	;; say_distance
	;; --------------------------------------------------
	;;
	;; Maximum distance (in meters) that NORMAL chat travels.
	;;
	;; DEFAULT:
	;;   20 meters
	;;
	;; DESIGN INTENT:
	;;    Small group conversation
	;;    Typical room-scale communication
	;;
	;; USE CASES:
	;;    Casual social interaction
	;;    Small meetings or gatherings
	;;    Build collaboration
	;;
	;; TUNING GUIDANCE:
	;;    Increase slightly for large indoor venues
	;;    Decrease for high-density regions
	;;
	;; TOO HIGH:
	;;    Bleeds conversations across parcels
	;;    Reduces privacy
	;;
	;; TOO LOW:
	;;    Forces reliance on IM for normal talk
	;;
	say_distance = 30

	;; --------------------------------------------------
	;; shout_distance
	;; --------------------------------------------------
	;;
	;; Maximum distance (in meters) that SHOUT chat travels.
	;;
	;; DEFAULT:
	;;   100 meters
	;;
	;; DESIGN INTENT:
	;;    Address large nearby groups
	;;    Event announcements
	;;    Emergency or attention-grabbing messages
	;;
	;; REALITY CHECK:
	;; Shout is the PRIMARY vector for:
	;;    Region-wide spam
	;;    Griefing noise
	;;    Scripted spam floods
	;;
	;; TUNING STRATEGIES:
	;;
	;;   REALISM / ROLEPLAY:
	;;     60–80 meters
	;;
	;;   GENERAL SOCIAL GRID:
	;;     80–120 meters
	;;
	;;   LARGE EVENTS (NO RELAYS):
	;;     120–200 meters (use with caution)
	;;
	;;   ANTI-SPAM / ANTI-GRIEF:
	;;     50–80 meters
	;;
	;; TOO HIGH:
	;;    Shout becomes pseudo region-wide chat
	;;    Encourages spam scripts
	;;
	;; TOO LOW:
	;;    Forces use of scripted relays
	;;    Reduces usefulness during events
	;;
	shout_distance = 50

	;; TODO (FUTURE):
	;;    Per-parcel or per-estate chat range overrides
	;;    Event-mode temporary shout range increases
	;;    Throttling or rate limits on shout usage
	;;
	;; Goal:
	;; Preserve communication utility while limiting abuse.

[EntityTransfer]
	;; ------------------------------------------------------------------
	;; ENTITY TRANSFER  (AVATAR & OBJECT MOVEMENT BETWEEN REGIONS)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how avatars and objects move:
	;;    Across region borders
	;;    Between simulators
	;;    Across grids (HyperGrid)
	;;
	;; THESE SETTINGS DEFINE FUNDAMENTAL GRID BEHAVIOR.
	;;
	;; Misconfiguration here can result in:
	;;    Frozen avatars
	;;    Failed teleports
	;;    Objects stuck or duplicated
	;;    Confusing or inconsistent landing behavior

	;; --------------------------------------------------
	;; AllowAvatarCrossing
	;; --------------------------------------------------
	;;
	;; Controls whether avatars are allowed to CROSS region borders.
	;;
	;; true  = Avatars can walk/fly across region boundaries normally
	;; false = Avatars are confined to the current region
	;;
	;; USE CASES FOR false:
	;;    Single-region experiences
	;;    Mini-games or controlled simulations
	;;    Training or classroom environments
	;;
	;; CONSEQUENCES:
	;;    Border crossing disabled
	;;    Walking into a border results in collision
	;;    Teleports may still function (unless otherwise restricted)
	;;
	;; NOTE:
	;; Disabling this fundamentally changes how the world feels.
	;;
	AllowAvatarCrossing = true

	;; --------------------------------------------------
	;; DisableObjectTransfer
	;; --------------------------------------------------
	;;
	;; Controls whether OBJECTS transfer across region borders.
	;;
	;; false = Objects crossing a border transfer to the neighboring region (default)
	;; true  = Objects do NOT transfer across borders
	;;
	;; WHEN true:
	;;    Objects may exist partially outside region bounds
	;;    Objects will NOT migrate to another simulator
	;;
	;; USE CASES:
	;;    Large builds intentionally spanning borders
	;;    Controlled multi-region builds with manual management
	;;
	;; RISKS:
	;;    Physics anomalies at borders
	;;    Objects visually present but logically owned by one region
	;;    Potential confusion during region restarts
	;;
	;; This should be enabled ONLY when the admin understands the implications.
	;;
	DisableObjectTransfer = false

	;; --------------------------------------------------
	;; LevelHGTeleport
	;; --------------------------------------------------
	;;
	;; Minimum UserLevel required to use HyperGrid teleports.
	;;
	;; 0 = All users may HyperGrid teleport (default)
	;;
	;; USE CASES FOR RESTRICTING:
	;;    Preventing drive-by griefing
	;;    Limiting HG access to trusted users
	;;    Subscription or role-based grids
	;;
	;; EXAMPLES:
	;;   LevelHGTeleport = 10    ; New users blocked
	;;   LevelHGTeleport = 50    ; Established residents only
	;;
	;; NOTE:
	;; This uses the UserLevel field in the database.
	;;
	LevelHGTeleport = 0

	;; --------------------------------------------------
	;; DisableInterRegionTeleportCancellation
	;; --------------------------------------------------
	;;
	;; Controls whether users can CANCEL teleports mid-transfer.
	;;
	;; false = Cancel button is shown (default)
	;; true  = Cancel button is hidden
	;;
	;; WHY THIS EXISTS:
	;; Cancelling teleports at certain stages can:
	;;    Leave avatars frozen
	;;    Create ghost sessions
	;;    Require manual intervention to fix
	;;
	;; USE CASES FOR true:
	;;    Small, closed grids
	;;    Highly reliable internal teleports
	;;    Training or kiosk-style environments
	;;
	;; USE CASES FOR false:
	;;    Large grids
	;;    HyperGrid usage
	;;    Unreliable network paths
	;;
	;; TRADEOFF:
	;;    Disabling cancellation improves session safety
	;;    But removes user control during long teleports
	;;
	DisableInterRegionTeleportCancellation = false

	;; --------------------------------------------------
	;; LandingPointBehavior
	;; --------------------------------------------------
	;;
	;; Controls how GOD / ADMIN avatars interact with:
	;;    Landing points
	;;    Telehubs
	;;
	;; AVAILABLE MODES:
	;;
	;;   LandingPointBehavior_OS
	;;      Gods obey landing points and telehubs
	;;      Consistent with normal users
	;;
	;;   LandingPointBehavior_SL
	;;      Gods bypass landing points
	;;      Can land anywhere in the region
	;;
	;; HISTORICAL CONTEXT:
	;;    OpenSim traditionally enforced landing points for everyone
	;;    Second Life allows gods to ignore them
	;;
	;; OPERATIONAL CONSIDERATIONS:
	;;    OS behavior preserves consistency and predictability
	;;    SL behavior favors admin convenience
	;;
	;; Choose based on governance philosophy.
	;;
	LandingPointBehavior = LandingPointBehavior_SL

[Messaging]
	;; ------------------------------------------------------------------
	;; MESSAGING  (INSTANT MESSAGES, OFFLINE DELIVERY, MUTES)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how instant messages (IMs), group messages,
	;; and mute lists are handled by the simulator.
	;;
	;; THESE SETTINGS DIRECTLY AFFECT:
	;;    User communication reliability
	;;    Offline message delivery
	;;    Privacy and moderation
	;;    Perceived grid stability
	;;
	;; Misconfiguration can result in:
	;;    Lost messages
	;;    Message spam floods
	;;    Privacy violations
	;;    Users believing IM is "broken"

	;; --------------------------------------------------
	;; InstantMessageModule
	;; --------------------------------------------------
	;;
	;; Defines the module responsible for handling LIVE instant messages.
	;;
	;; DEFAULT:
	;;   InstantMessageModule
	;;
	;; BEHAVIOR:
	;;    Handles IM delivery between avatars
	;;    Routes messages across regions and simulators
	;;    Does NOT persist messages for offline users
	;;
	;; IMPORTANT:
	;; This module is REQUIRED for basic IM functionality.
	;; Disabling or misnaming it breaks all instant messaging.
	;;
	InstantMessageModule = InstantMessageModule

	;; --------------------------------------------------
	;; MessageTransferModule
	;; --------------------------------------------------
	;;
	;; Optional module for routing messages between simulators or services.
	;;
	;; COMMON STATUS:
	;;    Disabled on many grids
	;;    Often unused unless custom messaging infrastructure exists
	;;
	;; USE CASES:
	;;    Custom message routing
	;;    External messaging bridges
	;;
	;; WARNING:
	;; Enabling without proper backend support can cause message loss.
	;;
	; MessageTransferModule = MessageTransferModule

	;; --------------------------------------------------
	;; OfflineMessageModule
	;; --------------------------------------------------
	;;
	;; Defines how messages to OFFLINE users are handled.
	;;
	;; WHEN ENABLED:
	;;    Messages sent to offline users are stored
	;;    Messages are delivered when the user logs in
	;;
	;; WHEN DISABLED:
	;;    Offline messages are LOST
	;;    Senders receive no guarantee of delivery
	;;
	;; COMMON IMPLEMENTATIONS:
	;;    Database-backed storage
	;;    External web services (via OfflineMessageURL)
	;;
	;; WARNING:
	;; Poorly implemented offline storage can:
	;;    Lose messages
	;;    Deliver duplicates
	;;    Leak private messages
	;;
	; OfflineMessageModule = OfflineMessageModule

	;; --------------------------------------------------
	;; OfflineMessageURL
	;; --------------------------------------------------
	;;
	;; URL of an external service that handles offline message storage.
	;;
	;; ONLY USED IF:
	;;   OfflineMessageModule is enabled
	;;
	;; SECURITY WARNING:
	;;    Messages may contain private content
	;;    Transport must be secure
	;;    Service must be trusted
	;;
	; OfflineMessageURL = http://yourserver/Offline.php

	;; --------------------------------------------------
	;; MuteListModule
	;; --------------------------------------------------
	;;
	;; Controls how user mute lists are stored and enforced.
	;;
	;; WHEN ENABLED:
	;;    Users can mute others
	;;    Mute state persists across sessions
	;;
	;; WHEN DISABLED:
	;;    Mute functionality may be inconsistent or unavailable
	;;
	;; USE CASE:
	;;    Moderation
	;;    User self-protection from harassment
	;;
	; MuteListModule = MuteListModule

	;; --------------------------------------------------
	;; MuteListURL
	;; --------------------------------------------------
	;;
	;; URL of an external service for mute list storage.
	;;
	;; ONLY USED IF:
	;;   MuteListModule is enabled
	;;
	;; SECURITY NOTE:
	;;    Exposes social graph data
	;;    Should not be publicly accessible
	;;
	; MuteListURL = http://yourserver/Mute.php

	;; --------------------------------------------------
	;; ForwardOfflineGroupMessages
	;; --------------------------------------------------
	;;
	;; Controls whether GROUP messages are delivered to users
	;; who are currently OFFLINE.
	;;
	;; true  = Forward group messages to offline users (default)
	;; false = Do NOT forward group messages to offline users
	;;
	;; BENEFITS OF true:
	;;    Users stay informed
	;;    Group coordination improves
	;;
	;; RISKS OF true:
	;;    Message floods for large groups
	;;    Offline message storage growth
	;;    Users returning to massive IM spam
	;;
	;; BENEFITS OF false:
	;;    Reduced spam and storage load
	;;    Better experience on large public grids
	;;
	;; RECOMMENDED:
	;;    true  for small or private groups
	;;    false for large, public, or announcement-heavy groups
	;;
	; ForwardOfflineGroupMessages = true
	;; TODO:
	;;    Explicit logging for failed message delivery
	;;    User-visible indicators when offline delivery is disabled
	;;    Rate limiting for group messages
	;;
	;; Goal:
	;; Messaging should fail loudly, not silently.
	;; NOTE: Lost messages destroy trust faster than crashes.

[Inventory]
	;; ------------------------------------------------------------------
	;; INVENTORY OBJECT COALESCENCE
	;; ------------------------------------------------------------------
	;;
	;; This section controls how MULTIPLE in-world objects are handled
	;; when they are sent to a user's inventory at the same time.
	;;
	;; This includes actions such as:
	;;    "Take" on multi-object selections
	;;    Scripted give operations
	;;    Bulk object returns
	;;
	;; Coalescence groups multiple objects into a SINGLE inventory item
	;; instead of creating many individual inventory entries.
	;;
	;; NOTE: Coalescence trades fidelity for convenience.

	;; --------------------------------------------------
	;; CoalesceMultipleObjectsToInventory
	;; --------------------------------------------------
	;;
	;; Controls whether multiple objects sent to inventory are:
	;;
	;;   true  = Coalesced into ONE inventory item
	;;   false = Stored as SEPARATE inventory items
	;;
	;; WHY THIS FEATURE EXISTS:
	;;    Reduce inventory clutter
	;;    Improve usability when taking large builds
	;;    Mimic Second Life–style behavior
	;;
	;; ------------------------------------------------------------------
	;; REALITY CHECK  (IMPORTANT)
	;; ------------------------------------------------------------------
	;;
	;; This feature is PARTIALLY BROKEN.
	;;
	;; KNOWN ISSUES:
	;;    Object rotation is NOT reliably preserved
	;;    Some linked relationships may be lost
	;;    Some assets may be missing when:
	;;       - Saving to OAR
	;;       - Loading from OAR
	;;       - Transferring between grids
	;;
	;; THESE ISSUES ARE NOT THEORETICAL.
	;; They are known, reproducible failure modes.
	;;
	;; ------------------------------------------------------------------
	;; CONSEQUENCES OF true
	;; ------------------------------------------------------------------
	;;
	;; PROS:
	;;    Cleaner inventories
	;;    Easier handling of large builds
	;;    Fewer inventory items
	;;
	;; CONS:
	;;    Potential build corruption
	;;    Silent loss of spatial fidelity
	;;    Archives may not faithfully restore content
	;;
	;; This is especially dangerous for:
	;;    Complex builds
	;;    Rotated assemblies
	;;    Precision alignment
	;;
	;; ------------------------------------------------------------------
	;; CONSEQUENCES OF false
	;; ------------------------------------------------------------------
	;;
	;; PROS:
	;;    Maximum fidelity
	;;    Predictable restores
	;;    Safer OAR/IAR workflows
	;;
	;; CONS:
	;;    Inventory clutter
	;;    More items to manage manually
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR GUIDANCE
	;; ------------------------------------------------------------------
	;;
	;; RECOMMENDED SETTINGS:
	;;
	;;   CREATIVE / BUILD-HEAVY GRIDS:
	;;     false
	;;
	;;   EDUCATIONAL / ARCHIVAL GRIDS:
	;;     false
	;;
	;;   CASUAL SOCIAL GRIDS:
	;;     true (with user education)
	;;
	;;   GRIDS THAT RELY ON OAR/IAR BACKUPS:
	;;     false
	;;
	;; ------------------------------------------------------------------
	;; DESIGN TODO  (UPSTREAM FIX REQUIRED)
	;; ------------------------------------------------------------------
	;;
	;; This feature should NOT be considered complete until:
	;;    Rotation is reliably preserved
	;;    Asset inclusion is deterministic
	;;    Archive restore is lossless
	;;
	;; Until then, this is a TRADEOFF, not a safe default.
	;;
	CoalesceMultipleObjectsToInventory = false

[Appearance]
	;; ------------------------------------------------------------------
	;; AVATAR APPEARANCE  (BAKING, CACHING, AND VISIBILITY)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how avatar appearance data is:
	;;    Baked
	;;    Stored
	;;    Transmitted
	;;    Resent to other users
	;;
	;; APPEARANCE FAILURES are one of the oldest and most persistent
	;; user complaints:
	;;    "Cloud avatars"
	;;    "Ruthing"
	;;    Grey or untextured avatars
	;;
	;; IMPORTANT REALITY:
	;; These symptoms have MULTIPLE causes.
	;; No single setting here "fixes" cloud avatars.
	;;
	;; NOTE: Cloud avatars are multi-cause failures. No single setting fixes them.

	;; --------------------------------------------------
	;; PersistBakedTextures
	;; --------------------------------------------------
	;;
	;; Controls whether baked avatar textures are stored persistently
	;; in the asset database.
	;;
	;; true  = Store baked textures for reuse
	;; false = Discard baked textures after use (default)
	;;
	;; WHAT THIS ACTUALLY DOES:
	;;    Reduces rebaking during login
	;;    Speeds up region crossings
	;;    Improves appearance stability in busy regions
	;;
	;; WHAT IT DOES NOT DO:
	;;    Fix failed baking
	;;    Fix viewer-side decode issues
	;;    Fix missing wearable assets
	;;
	;; TRADEOFFS:
	;;
	;; PROS:
	;;    Faster logins
	;;    Fewer rebake storms
	;;    More stable appearance propagation
	;;
	;; CONS:
	;;    Large increase in asset database size
	;;    Accumulation of obsolete baked textures
	;;    Requires asset cleanup policies
	;;
	;; RECOMMENDED:
	;;    Busy social grids with frequent crossings: true
	;;    Small grids or limited storage: false
	;;
	PersistBakedTextures = false

	;; --------------------------------------------------
	;; DelayBeforeAppearanceSave
	;; --------------------------------------------------
	;;
	;; Delay (in seconds) before saving avatar appearance
	;; to the avatar service.
	;;
	;; PURPOSE:
	;;    Reduce database churn
	;;    Avoid saving incomplete appearance states
	;;    Mitigate login/teleport appearance storms
	;;
	;; TOO LOW:
	;;    Incomplete or partial appearance saved
	;;    Increased chance of incorrect appearance persistence
	;;
	;; TOO HIGH:
	;;    Longer delay before appearance stabilizes
	;;
	DelayBeforeAppearanceSave = 5

	;; --------------------------------------------------
	;; DelayBeforeAppearanceSend
	;; --------------------------------------------------
	;;
	;; Delay (in seconds) before sending appearance data
	;; to OTHER avatars in the region.
	;;
	;; PURPOSE:
	;;    Allow appearance baking to settle
	;;    Reduce spammy appearance updates
	;;
	;; TOO LOW:
	;;    Other users see cloud/partial avatars
	;;    Increased appearance churn
	;;
	;; TOO HIGH:
	;;    Users appear grey for longer after login
	;;
	DelayBeforeAppearanceSend = 2

	;; --------------------------------------------------
	;; ResendAppearanceUpdates
	;; --------------------------------------------------
	;;
	;; Controls whether avatar appearance data is resent
	;; periodically to other avatars.
	;;
	;; true  = Resend appearance every 60 seconds
	;; false = Send once (default)
	;;
	;; WHAT THIS HELPS:
	;;    Network packet loss
	;;    Missed initial appearance update
	;;    Transient viewer sync failures
	;;
	;; WHAT THIS DOES NOT FIX:
	;;    Baking failures
	;;    Missing or corrupt assets
	;;    Viewer bugs that never accept the appearance
	;;
	;; COST:
	;;    Increased network traffic
	;;    Increased server load
	;;
	;; USE CASE:
	;;    Persistent grey avatars caused by packet loss
	;;    Unreliable network environments
	;;
	;; NOT A MAGIC FIX.
	;;
	ResendAppearanceUpdates = false

	;; --------------------------------------------------
	;; ReuseTextures
	;; --------------------------------------------------
	;;
	;; Controls whether cached textures reported by the viewer
	;; are reused instead of forcing a full rebake.
	;;
	;; true  = Attempt to reuse existing baked textures
	;; false = Force rebake (default)
	;;
	;; WHAT THIS DOES:
	;;    Can reduce rebaking on login
	;;    Speeds up appearance resolution
	;;
	;; RISKS:
	;;    Viewer cache inconsistencies
	;;    Stale or mismatched appearance
	;;
	;; COMMON FAILURE MODE:
	;;    Avatar looks correct to self
	;;    Appears wrong to others
	;;
	;; RECOMMENDED:
	;;    Leave false unless you understand your viewer population
	;;    Enable only if you have consistent viewer versions
	;;
	ReuseTextures = false

	;; TODO:
	;; Appearance failures should emit diagnostic signals:
	;;    Baking failure vs delivery failure
	;;    Missing asset vs viewer rejection
	;;    Server-side vs viewer-side fault
	;;
	;; Without visibility, admins and users guess.

[Attachments]
	;; ------------------------------------------------------------------
	;; ATTACHMENTS  (AVATAR ATTACHMENT BEHAVIOR)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how avatar attachments are handled when users
	;; wear inventory objects.
	;;
	;; Attachment behavior directly affects:
	;;    Outfit systems
	;;    Layered accessories
	;;    Viewer-side appearance expectations
	;;    User frustration when items "disappear"
	;;
	;; This is especially important given the evolution from:
	;;    One attachment per point (legacy)
	;;    To multiple attachments per point (modern)
	;;

	;; --------------------------------------------------
	;; Enabled
	;; --------------------------------------------------
	;;
	;; Master switch for avatar attachments.
	;;
	;; true  = Attachments enabled (normal operation)
	;; false = Attachments disabled
	;;
	;; USE CASE FOR false:
	;;    Debugging attachment-related bugs
	;;    Testing core avatar behavior
	;;
	;; WARNING:
	;; Disabling attachments breaks basic avatar functionality
	;; and should NEVER be used on a live grid.
	;;
	Enabled = true

	;; --------------------------------------------------
	;; WearReplacesAll
	;; --------------------------------------------------
	;;
	;; Controls how wearing an attachment affects EXISTING attachments
	;; on the SAME attachment point.
	;;
	;; true  = Wearing an attachment REPLACES ALL existing attachments
	;;         on that attachment point.
	;;
	;; false = Wearing an attachment replaces ONLY the OLDEST attachment
	;;         on that attachment point.
	;;
	;; ------------------------------------------------------------------
	;; HISTORICAL CONTEXT
	;; ------------------------------------------------------------------
	;;
	;; LEGACY BEHAVIOR (one attachment per point):
	;;    Only one object could be attached per attachment point
	;;    Wearing a new item always replaced the existing one
	;;
	;; MODERN BEHAVIOR (multiple attachments per point):
	;;    Multiple objects can share the same attachment point
	;;    Enables layered outfits (hair + hat + accessories, etc.)
	;;
	;; This flag controls which model dominates.
	;;
	;; ------------------------------------------------------------------
	;; REAL-WORLD OUTFIT WORKFLOWS
	;; ------------------------------------------------------------------
	;;
	;; Creators often used ATTACHMENT WORKAROUNDS such as:
	;;    Hats attached to chin or mouth instead of head
	;;    Hair split across multiple points
	;;    Accessories layered intentionally
	;;
	;; These workarounds exist to simulate:
	;;    More realistic outfit layering
	;;    Modular clothing systems
	;;
	;; WHEN WearReplacesAll = true:
	;;    These layered systems BREAK
	;;    Wearing a new item can silently remove others
	;;    Users experience "why did my outfit change?"
	;;
	;; WHEN WearReplacesAll = false:
	;;    Layered attachments coexist
	;;    Modern outfit behavior is preserved
	;;    Viewer expectations are met
	;;
	;; ------------------------------------------------------------------
	;; CONSEQUENCES OF EACH SETTING
	;; ------------------------------------------------------------------
	;;
	;; true  (LEGACY-STYLE):
	;;   PROS:
	;;      Predictable, old-school behavior
	;;      Simpler mental model
	;;
	;;   CONS:
	;;      Breaks modern outfit systems
	;;      Removes multiple attachments unexpectedly
	;;      Regresses user experience
	;;
	;; false (MODERN-STYLE):
	;;   PROS:
	;;      Supports layered outfits
	;;      Matches modern viewer expectations
	;;      Preserves creator workarounds
	;;
	;;   CONS:
	;;      Slightly more complex attachment state
	;;
	;; ------------------------------------------------------------------
	;; OPERATOR RECOMMENDATION
	;; ------------------------------------------------------------------
	;;
	;; For MOST modern grids:
	;;   WearReplacesAll = false
	;;
	;; Only use true if you intentionally want legacy behavior
	;; and understand the user-experience regression.
	;;
	;; NOTE: WearReplacesAll controls legacy vs modern outfit behavior.

	WearReplacesAll = false

[Mesh]
	;; ------------------------------------------------------------------
	;; MESH SUPPORT  (ASSET UPLOAD, PHYSICS, AND CACHING)
	;; ------------------------------------------------------------------
	;;
	;; Mesh support fundamentally changed content creation on SL/OpenSim.
	;;
	;; BEFORE MESH:
	;;    Prim-only construction
	;;    Sculpties as a workaround
	;;    High server and viewer cost
	;;    Fragile and opaque content pipelines
	;;
	;; AFTER MESH:
	;;    External DCC tools (Blender, 3DS Max, Maya, etc.)
	;;    Predictable geometry
	;;    Better visual fidelity
	;;    More efficient builds when done correctly
	;;
	;; HOWEVER:
	;; Mesh is NOT automatically “better”.
	;; Poor mesh configuration or misuse can:
	;;    Worsen physics performance
	;;    Increase CPU load
	;;    Break collision expectations
	;;
	;; This section controls how mesh behaves on your grid.
	;;
	;; NOTE: Mesh improves performance only when physics is treated deliberately.

	;; --------------------------------------------------
	;; AllowMeshUpload
	;; --------------------------------------------------
	;;
	;; Controls whether users are allowed to upload mesh assets.
	;;
	;; true  = Mesh uploads enabled (default)
	;; false = Mesh uploads disabled
	;;
	;; IMPACT:
	;;    Disabling mesh forces users back to prims/sculpties
	;;    Regresses creator workflows
	;;    Encourages legacy hacks with worse performance
	;;
	;; RECOMMENDED:
	;;    true on all modern grids
	;;
	AllowMeshUpload = true

	;; --------------------------------------------------
	;; LevelUpload (Mesh)
	;; --------------------------------------------------
	;;
	;; Minimum UserLevel required to upload mesh assets.
	;;
	;; 0 = Anyone may upload meshes (default)
	;;
	;; USE CASES FOR RESTRICTION:
	;;    Anti-spam / anti-grief measures
	;;    Educational grids with staged permissions
	;;    Subscription-based creator access
	;;
	;; RISK:
	;;    Restricting mesh upload blocks legitimate creators
	;;    Can cripple creative grids if misused
	;;
	;; NOTE:
	;; This uses the same UserLevel system discussed elsewhere.
	;;
	LevelUpload = 0

	;; --------------------------------------------------
	;; UseMeshiesPhysicsMesh
	;; --------------------------------------------------
	;;
	;; Controls whether mesh assets are used as their OWN physics shape.
	;;
	;; true  = Physics uses the mesh geometry
	;; false = Physics uses simplified shapes (default varies by engine)
	;;
	;; PROS:
	;;    More accurate collision
	;;    Better interaction with complex objects
	;;
	;; CONS:
	;;    VERY expensive physics calculations
	;;    High CPU usage
	;;    Can destroy region performance
	;;
	;; REALITY:
	;;    Using visual mesh as physics is rarely optimal
	;;    Well-made custom physics meshes are preferred
	;;
	;; RECOMMENDED:
	;;    Enable only if creators understand physics meshes
	;;    Otherwise leave disabled
	;;
	; UseMeshiesPhysicsMesh = true

	;; --------------------------------------------------
	;; ConvexPrims  (ubODE only)
	;; --------------------------------------------------
	;;
	;; Enables convex hull physics shapes for NORMAL prims.
	;;
	;; EFFECT:
	;;    Simplifies collision shapes
	;;    Improves physics stability
	;;
	;; PROS:
	;;    Faster physics
	;;    Fewer collision anomalies
	;;
	;; CONS:
	;;    Less precise collision
	;;
	;; RECOMMENDED:
	;;    true for performance-focused grids
	;;
	ConvexPrims = true

	;; --------------------------------------------------
	;; ConvexSculpts  (ubODE only)
	;; --------------------------------------------------
	;;
	;; Enables convex hull physics for SCULPTED prims.
	;;
	;; WHY THIS EXISTS:
	;;    Sculpties often have extremely poor physics behavior
	;;    Convex hulls mitigate worst-case scenarios
	;;
	;; REALITY:
	;;    Sculpties are a legacy workaround
	;;    They frequently cause performance and collision issues
	;;
	;; RECOMMENDED:
	;;    true if sculpties are allowed
	;;    Better: migrate away from sculpties entirely
	;;
	ConvexSculpts = true

	;; --------------------------------------------------
	;; Mesh Physics CACHING  (ubODE only)
	;; --------------------------------------------------
	;;
	;; Mesh physics generation is expensive.
	;; Caching avoids recalculating collision meshes repeatedly.
	;;

	;; Enable mesh physics caching
	;; SHOULD BE true on all production grids
	;;
	MeshFileCache = true

	;; --------------------------------------------------
	;; MeshFileCachePath
	;; --------------------------------------------------
	;;
	;; Directory used to store cached mesh physics data.
	;;
	;; PATH RULES:
	;;    Relative paths are relative to bin/
	;;    Absolute paths are allowed
	;;
	;; OPERATOR NOTE:
	;;    This directory can grow large
	;;    Should be monitored and backed up appropriately
	;;
	MeshFileCachePath = MeshCache

	;; --------------------------------------------------
	;; MeshFileCacheDoExpire
	;; --------------------------------------------------
	;;
	;; Controls whether cached mesh physics data expires.
	;;
	;; true  = Cache entries expire
	;; false = Cache grows indefinitely
	;;
	;; RECOMMENDED:
	;;    true, unless disk space is abundant
	;;
	MeshFileCacheDoExpire = true

	;; --------------------------------------------------
	;; MeshFileCacheExpireHours
	;; --------------------------------------------------
	;;
	;; Number of hours before cached mesh physics data expires.
	;;
	;; LOWER VALUES:
	;;    Less disk usage
	;;    More frequent recalculation
	;;
	;; HIGHER VALUES:
	;;    Faster performance
	;;    Higher disk usage
	;;
	;; COMMON VALUES:
	;;    24–72 hours
	;;
	MeshFileCacheExpireHours = 72

[Textures]
	;; ------------------------------------------------------------------
	;; TEXTURE GENERATION & REUSE  (DYNAMIC TEXTURES)
	;; ------------------------------------------------------------------
	;;
	;; This section controls how the simulator handles DYNAMICALLY
	;; GENERATED textures.
	;;
	;; Dynamic textures are created at runtime via scripting, such as:
	;;    osSetDynamicTextureData()
	;;    osSetDynamicTextureURL()
	;;    Scripted signs, displays, HUDs
	;;
	;; THESE SETTINGS DO NOT CONTROL:
	;;    Normal uploaded textures
	;;    Static asset delivery
	;;    Viewer texture decode speed
	;;
	;; They ONLY affect SCRIPT-GENERATED textures.
	;;
	;; IMPORTANT REALITY:
	;; Grey, blurry, or missing textures are NOT always "lag".
	;; They are often caused by:
	;;    Viewer cache inconsistencies
	;;    Partial texture resolution delivery
	;;    Dynamic texture reuse mismatches
	;;
	;; NOTE: Grey or blurry textures are often cache issues, not lag.

	;; --------------------------------------------------
	;; ReuseDynamicTextures
	;; --------------------------------------------------
	;;
	;; Controls whether dynamically generated textures are REUSED
	;; when identical data and parameters are encountered.
	;;
	;; true  = Reuse existing dynamic textures
	;; false = Always generate a new texture (default)
	;;
	;; WHAT REUSE MEANS:
	;;    Same input data
	;;    Same render settings
	;;    NO dynamic external components (e.g. HTTP images)
	;;
	;; BENEFITS:
	;;    Faster updates on the viewer
	;;    Less regeneration overhead
	;;    Reduced script execution time
	;;
	;; RISKS:
	;;    Viewer may NOT receive all mipmap resolutions
	;;    Viewer may display:
	;;       - grey textures
	;;       - blurry textures
	;;       - stale visuals
	;;
	;; THIS IS A VIEWER CACHE ISSUE, NOT SERVER LAG.
	;;
	;; ADDITIONAL COST:
	;;    Reused dynamic textures are NOT deleted
	;;    Asset cache growth increases over time
	;;
	;; CURRENT STATUS:
	;;    Considered EXPERIMENTAL
	;;    Behavior varies by viewer and version
	;;
	;; RECOMMENDED:
	;;    false for general-purpose grids
	;;    true only for controlled environments
	;;     with known viewer behavior
	;;
	ReuseDynamicTextures = false

	;; --------------------------------------------------
	;; ReuseDynamicLowDataTextures
	;; --------------------------------------------------
	;;
	;; Controls reuse behavior for dynamic textures that have
	;; a SMALL DATA SIZE relative to their PIXEL DIMENSIONS.
	;;
	;; WHY THIS EXISTS:
	;; Some older viewers (notably LL viewer 3.3.4 and earlier)
	;; mishandle cached dynamic textures of this type.
	;;
	;; EFFECT WHEN true:
	;;    Low-data dynamic textures are NOT reused
	;;    Forces regeneration to avoid cache bugs
	;;
	;; IMPORTANT:
	;; This setting ONLY applies if:
	;;   ReuseDynamicTextures = true
	;;
	;; RISKS:
	;;    Enabling this on mixed viewer populations
	;;     can produce inconsistent results
	;;
	;; RECOMMENDED:
	;;    false unless ALL viewers are known-good
	;;    true only in tightly controlled viewer environments
	;;
	ReuseDynamicLowDataTextures = false

	;; TODO:
	;; Dynamic texture reuse should include:
	;;    Viewer capability detection
	;;    Forced full-resolution resend on cache miss
	;;    Asset expiration controls
	;;
	;; Optimization without verification causes visual corruption.

[ODEPhysicsSettings]
	;; ------------------------------------------------------------------
	;; PHYSICS ENGINE CORE TUNING  (ODE / ubODE)
	;; ------------------------------------------------------------------
	;;
	;; This section defines how the PHYSICAL WORLD behaves.
	;;
	;; THESE SETTINGS CONTROL:
	;;    Gravity and movement feel
	;;    Collision stability
	;;    Walking, running, jumping realism
	;;    Object mass and interaction
	;;    CPU load vs simulation quality
	;;
	;; CRITICAL REALITY:
	;; Many grids blamed OpenSim physics when the real issue was:
	;;    Poor defaults
	;;    No documentation
	;;    Untested assumptions
	;;
	;; With correct tuning, ODE/ubODE can deliver:
	;;    Stable walking
	;;    Predictable collisions
	;;    Solid builds
	;;    Consistent user experience
	;;
	;; NOTE: Physics engines do not fail in isolation.
	;; Poor defaults plus poor documentation create bad reputations.

	;; ==================================================================
	;; PHYSICS STATS & LOGGING
	;; ==================================================================

	;; --------------------------------------------------
	;; collect_stats
	;; --------------------------------------------------
	;;
	;; Enables collection of detailed physics statistics.
	;;
	;; true  = Collect stats (MonitorModule access)
	;; false = No extra stats (default)
	;;
	;; USE CASE:
	;;    Performance analysis
	;;    Physics debugging
	;;
	;; COST:
	;;    Minor overhead
	;;
	collect_stats = false

	;; --------------------------------------------------
	;; Physics logging (DIF files)
	;; --------------------------------------------------
	;;
	;; Generates physics snapshots for deep analysis.
	;; Files are written as *.DIF.
	;;
	;; WARNING:
	;;    Large disk usage
	;;    Performance impact
	;;    NOT for production unless diagnosing issues
	;;
	physics_logging = false
	; physics_logging_interval = 50
	; physics_logging_append_existing_logfile = true

	;; ==================================================================
	;; WORLD PHYSICS BASICS
	;; ==================================================================

	;; --------------------------------------------------
	;; World gravity
	;; --------------------------------------------------
	;;
	;; Defines gravitational acceleration in meters per second squared.
	;;
	;; DEFAULT EARTH GRAVITY:
	;;   Z = -9.8
	;;
	;; POSITIVE VALUES:
	;;    Invert gravity (fall upward)
	;;
	world_gravityx = 0
	world_gravityy = 0
	world_gravityz = -9.8

	;; --------------------------------------------------
	;; avatar_terminal_velocity
	;; --------------------------------------------------
	;;
	;; Maximum falling speed for avatars.
	;;
	;; VALUE RANGE:
	;;   0 – 255
	;;
	;; REAL-WORLD REFERENCE:
	;;   ~53–55 m/s approximates human terminal velocity
	;;
	;; LOWER VALUES:
	;;    Slower falling
	;;    “Floaty” feel
	;;
	;; HIGHER VALUES:
	;;    Faster falls
	;;    More aggressive physics
	;;
	avatar_terminal_velocity = 54

	;; ==================================================================
	;; SIMULATION QUALITY vs CPU COST
	;; ==================================================================

	;; --------------------------------------------------
	;; world_stepsize
	;; --------------------------------------------------
	;;
	;; Time step per physics simulation update (seconds).
	;;
	;; LEGACY ODE:
	;;   ~0.02 recommended
	;;
	;; ubODE:
	;;    Smaller values improve accuracy
	;;    Increase CPU load
	;;
	;; IMPORTANT:
	;; Using a value that is an INTEGER SUBMULTIPLE of FrameRate
	;; reduces physics jitter.
	;;
	;; EXAMPLE:
	;;   0.01818 ≈ 55 Hz
	;;
	world_stepsize = 0.01818

	;; --------------------------------------------------
	;; world_solver_iterations
	;; --------------------------------------------------
	;;
	;; Number of constraint solver iterations per step.
	;;
	;; HIGHER VALUES:
	;;    More accurate collisions
	;;    Better stacking
	;;    Higher CPU cost
	;;
	;; DIMINISHING RETURNS APPLY:
	;;   Beyond a point, math error negates gains.
	;;
	world_solver_iterations = 10

	;; ==================================================================
	;; COLLISION BEHAVIOR & CONTACT PROPERTIES
	;; ==================================================================

	;; --------------------------------------------------
	;; filter_collisions
	;; --------------------------------------------------
	;;
	;; Enables collision filtering to improve stability.
	;;
	;; true  = More aggressive filtering
	;; false = Raw collision handling
	;;
	;; SYMPTOM WHEN TOO AGGRESSIVE:
	;;    Objects bounce unexpectedly
	;;
	filter_collisions = false

	;; --------------------------------------------------
	;; Terrain contact (avatar standing still)
	;; --------------------------------------------------
	;;
	;; nm_* = Non-moving avatar
	;;
	nm_terraincontact_friction = 255.0
	nm_terraincontact_bounce   = 0.1
	nm_terraincontact_erp      = 0.1025


	;; --------------------------------------------------
	;; Terrain contact (avatar moving)
	;; --------------------------------------------------
	;;
	;; m_* = Moving avatar
	;;
	;; Lower friction improves smooth walking
	;; Too low causes sliding
	;;
	m_terraincontact_friction = 75.0
	m_terraincontact_bounce   = 0.05
	m_terrainContact_erp      = 0.05025

	;; --------------------------------------------------
	;; Avatar ↔ object contact
	;; --------------------------------------------------
	;;
	;; Controls how avatars interact with objects.
	;;
	m_avatarobjectcontact_friction = 75.0
	m_avatarobjectcontact_bounce   = 0.1


	;; --------------------------------------------------
	;; Object ↔ object contact
	;; --------------------------------------------------
	;;
	objectcontact_friction = 250.0
	objectcontact_bounce   = 0.2

	;; ==================================================================
	;; AVATAR MASS & MOVEMENT
	;; ==================================================================

	;; --------------------------------------------------
	;; av_density
	;; --------------------------------------------------
	;;
	;; Density used to calculate avatar mass.
	;;
	;; Higher values:
	;;    Heavier avatars
	;;    Stronger interaction forces
	;;
	av_density = 80

	;; --------------------------------------------------
	;; Avatar movement divisors
	;; --------------------------------------------------
	;;
	;; Smaller values = faster movement
	;;
	;; Walk speed (Always Run OFF)
	av_movement_divisor_walk = 1.3

	;; Run speed (Always Run ON)
	av_movement_divisor_run  = 0.8

	;; ==================================================================
	;; OBJECT PHYSICS
	;; ==================================================================

	;; --------------------------------------------------
	;; geometry_default_density
	;; --------------------------------------------------
	;;
	;; Default density for physical objects.
	;;
	geometry_default_density = 10.000006836

	;; --------------------------------------------------
	;; body_frames_auto_disable
	;; --------------------------------------------------
	;;
	;; Number of frames an object must be idle
	;; before physics is suspended (“sleep”).
	;;
	;; Lower values:
	;;    Less CPU usage
	;;    Objects sleep sooner
	;;
	body_frames_auto_disable = 20

	;; --------------------------------------------------
	;; geom_updates_before_throttled_update
	;; --------------------------------------------------
	;;
	;; Controls throttling of physics updates.
	;;
	geom_updates_before_throttled_update = 15

	;; --------------------------------------------------
	;; maximum_mass_object
	;; --------------------------------------------------
	;;
	;; Hard cap on object mass.
	;;
	;; Prevents extreme physics instability.
	;;
	maximum_mass_object = 10000.01

	;; ==================================================================
	;; SCULPTED PRIMS (LEGACY CONTENT)
	;; ==================================================================

	;; --------------------------------------------------
	;; mesh_sculpted_prim
	;; --------------------------------------------------
	;;
	;; Enables mesh-based collision for sculpted prims.
	;;
	;; true  = Sculpt collisions match visual shape
	;; false = Simplified collisions
	;;
	;; WARNING:
	;; Sculpties are a legacy hack and expensive.
	;;
	mesh_sculpted_prim = true

	;; --------------------------------------------------
	;; Sculpt LOD settings
	;; --------------------------------------------------
	;;
	;; Non-physical collision detail
	mesh_lod = 32     ; 32x32 = 1024 vertices

	;; Physical collision detail
	mesh_physical_lod = 16   ; 16x16 = 256 vertices

	;; ==================================================================
	;; ADDITIONAL MESHING RULES (ubODE only)
	;; ==================================================================

	;; --------------------------------------------------
	;; MinSizeToMeshmerize
	;; --------------------------------------------------
	;;
	;; Objects smaller than this are treated as simple boxes.
	;;
	;; PURPOSE:
	;;    Prevent excessive CPU use
	;;    Simplify small-object collisions
	;;
	;; Default: 0.1 meters
	;;
	; MinSizeToMeshmerize = 0.1

[BulletSim]
	;; ------------------------------------------------------------------
	;; BULLETSIM PHYSICS ENGINE  (ALTERNATE PHYSICS BACKEND)
	;; ------------------------------------------------------------------
	;;
	;; BulletSim is an alternative physics engine to ODE / ubODE.
	;;
	;; WHY IT GAINED A REPUTATION:
	;;    More stable defaults
	;;    Fewer obvious tuning knobs exposed
	;;    Better out-of-the-box behavior for SOME builds
	;;
	;; WHY THAT REPUTATION IS MISLEADING:
	;;    Fewer knobs ≠ better physics
	;;    Defaults hide tradeoffs
	;;    Poor documentation led admins to blame ODE instead of tuning
	;;
	;; BulletSim is not inherently superior.
	;; It behaves DIFFERENTLY.
	;;
	;; NOTE: BulletSim succeeded largely because it hid complexity,
	;; not because ODE/ubODE was incapable.

	;; ==================================================================
	;; BULLET ENGINE IMPLEMENTATION
	;; ==================================================================

	;; --------------------------------------------------
	;; BulletEngine
	;; --------------------------------------------------
	;;
	;; Selects the Bullet physics backend.
	;;
	;; OPTIONS:
	;;   bulletunmanaged = Native C++ Bullet (default, faster)
	;;   bulletxna       = Managed C# Bullet (slower, legacy)
	;;
	;; RECOMMENDED:
	;;   bulletunmanaged
	;;
	BulletEngine = "bulletunmanaged"
	; BulletEngine = "bulletxna"

	;; ==================================================================
	;; THREADING MODEL
	;; ==================================================================

	;; --------------------------------------------------
	;; UseSeparatePhysicsThread
	;; --------------------------------------------------
	;;
	;; Runs physics simulation on a separate thread from the simulator
	;; heartbeat.
	;;
	;; true  = Physics runs independently
	;; false = Physics tied to main sim loop (default)
	;;
	;; PROS OF true:
	;;    Avatar movement less affected by physics spikes
	;;    Smoother motion under load
	;;
	;; CONS OF true:
	;;    Harder to reason about timing
	;;    Potential desync between physics and scene state
	;;
	;; RECOMMENDED:
	;;    false unless you have measured benefit
	;;
	UseSeparatePhysicsThread = false

	;; ==================================================================
	;; TERRAIN PHYSICS REPRESENTATION
	;; ==================================================================

	;; --------------------------------------------------
	;; TerrainImplementation
	;; --------------------------------------------------
	;;
	;; Determines how terrain collision is represented.
	;;
	;; 0 = HeightField (default)
	;; 1 = Mesh
	;;
	;; HeightField:
	;;    Fast
	;;    Stable
	;;    Matches terrain grid
	;;
	;; Mesh:
	;;    More detailed
	;;    MUCH higher memory and CPU cost
	;;
	TerrainImplementation = 0

	;; --------------------------------------------------
	;; TerrainMeshMagnification
	;; --------------------------------------------------
	;;
	;; Resolution multiplier for mesh-based terrain.
	;;
	;; 1 = 256x256
	;; 2 = 512x512
	;; 3 = 1024x1024
	;; 4 = 2048x2048 (MAX)
	;;
	;; WARNING:
	;;    Memory usage grows exponentially
	;;    Rarely justified
	;;
	TerrainMeshMagnification = 2

	;; ==================================================================
	;; AVATAR COLLISION & MOVEMENT
	;; ==================================================================

	;; --------------------------------------------------
	;; AvatarToAvatarCollisionsByDefault
	;; --------------------------------------------------
	;;
	;; Controls whether avatars collide with each other.
	;;
	;; true  = Avatars collide
	;; false = Avatars pass through each other
	;;
	;; USE CASE:
	;;    true for realism and RP
	;;    false for crowded events
	;;
	AvatarToAvatarCollisionsByDefault = true

	;; --------------------------------------------------
	;; Avatar height fudge factors
	;; --------------------------------------------------
	;;
	;; Adjusts avatar collision capsule height at different sizes.
	;; Used to correct mismatches between visual and physical height.
	;;
	AvatarHeightLowFudge  = 0
	AvatarHeightMidFudge  = 0
	AvatarHeightHighFudge = 0

	;; --------------------------------------------------
	;; Avatar stair-stepping behavior
	;; --------------------------------------------------
	;;
	;; Simulates stepping up small obstacles instead of colliding.
	;;
	;; THESE VALUES CONTROL:
	;;    Whether stairs are walkable
	;;    Whether avatars snag on edges
	;;
	;; Poor tuning here causes:
	;;    “Invisible walls”
	;;    Getting stuck on steps
	;;
	; AvatarStepHeight = 0.6
	; AvatarStepAngle = 0.3
	; AvatarStepApproachFactor = 2
	; AvatarStepGroundFudge = 0.1
	; AvatarStepForceFactor = 0
	; AvatarStepUpCorrectionFactor = 0.8
	; AvatarStepSmoothingSteps = 1

	;; --------------------------------------------------
	;; AvatarTerminalVelocity
	;; --------------------------------------------------
	;;
	;; Maximum falling speed for avatars.
	;;
	;; Negative = downward
	;; ~54 m/s approximates real-world terminal velocity
	;;
	AvatarTerminalVelocity = -54

	;; ==================================================================
	;; LINKSETS & OBJECT STRUCTURE
	;; ==================================================================

	;; --------------------------------------------------
	;; LinkImplementation
	;; --------------------------------------------------
	;;
	;; Determines how linked objects behave physically.
	;;
	;; 0 = Constraint-based
	;;      More accurate
	;;      MUCH higher CPU cost
	;;
	;; 1 = Compound shape (default)
	;;      Single combined collision shape
	;;      FAR lower CPU cost
	;;
	;; THIS SETTING ALONE EXPLAINS MANY PERFORMANCE DIFFERENCES.
	;;
	LinkImplementation = 1

	;; --------------------------------------------------
	;; LinksetOffsetCenterOfMass
	;; --------------------------------------------------
	;;
	;; Offsets linkset origin based on mass distribution.
	;;
	;; true  = Physically accurate center of mass
	;; false = Geometric center
	;;
	;; Can cause unexpected rotations if enabled.
	;;
	LinksetOffsetCenterOfMass = false

	;; ==================================================================
	;; SCULPTS, MESHES, AND COLLISION GEOMETRY
	;; ==================================================================

	;; --------------------------------------------------
	;; MeshSculptedPrim
	;; --------------------------------------------------
	;;
	;; Converts sculpted prims into meshes for collision.
	;;
	;; PROS:
	;;    More accurate collisions
	;;
	;; CONS:
	;;    Sculpties are legacy
	;;    High CPU cost
	;;
	MeshSculptedPrim = true

	;; --------------------------------------------------
	;; ForceSimplePrimMeshing
	;; --------------------------------------------------
	;;
	;; Forces boxes and spheres to use mesh collision
	;; instead of Bullet's native primitives.
	;;
	;; WARNING:
	;;    Almost never beneficial
	;;    Increases CPU cost
	;;
	ForceSimplePrimMeshing = false

	;; --------------------------------------------------
	;; ShouldRemoveZeroWidthTriangles
	;; --------------------------------------------------
	;;
	;; Removes degenerate triangles during mesh creation.
	;;
	;; WHY THIS EXISTS:
	;;    Sculpties often generate bad geometry
	;;
	;; If false:
	;;    Doorways may become impassable
	;;
	ShouldRemoveZeroWidthTriangles = true

	;; --------------------------------------------------
	;; ShouldUseAssetHulls
	;; --------------------------------------------------
	;;
	;; Uses convex hulls provided in mesh assets if present.
	;;
	;; PROS:
	;;    Faster collision
	;;    Better physics performance
	;;
	;; CONS:
	;;    Requires properly authored assets
	;;
	ShouldUseAssetHulls = true

	;; ==================================================================
	;; PERFORMANCE LIMITS  (PHYSICS LOAD SHEDDING)
	;; ==================================================================
	;;
	;; These settings DO NOT change physics accuracy.
	;; They control how MUCH physics work is allowed per simulation frame.
	;;
	;; Think of them as CIRCUIT BREAKERS, not quality knobs.
	;;
	;; Their job is to:
	;;    Prevent physics spikes from stalling the simulator
	;;    Preserve frame time under load
	;;    Fail gracefully instead of catastrophically
	;;
	;; If these limits are hit:
	;;    Extra collisions or updates are DEFERRED, not lost
	;;    Objects may appear momentarily less responsive
	;;    The simulator remains responsive instead of freezing
	;;
	;; THIS IS PREFERABLE TO:
	;;    Region lockups
	;;    Avatar rubber-banding
	;;    Watchdog-triggered crashes
	;;

	;; --------------------------------------------------
	;; MaxCollisionsPerFrame
	;; --------------------------------------------------
	;;
	;; Maximum number of collision pairs processed per physics frame.
	;;
	;; WHAT COUNTS AS A COLLISION:
	;;    Avatar ↔ terrain
	;;    Avatar ↔ object
	;;    Object ↔ object
	;;    Vehicle ↔ anything
	;;
	;; WHY THIS EXISTS:
	;;    Complex builds (meshes, sculpties, linksets)
	;;     can generate THOUSANDS of collision pairs
	;;    Without a cap, a single busy frame can
	;;     monopolize the CPU
	;;
	;; EFFECT OF HITTING THE LIMIT:
	;;    Excess collisions are deferred to later frames
	;;    Physics appears slightly "soft" under heavy load
	;;    Simulator remains alive
	;;
	;; TOO LOW:
	;;    Avatars may clip slightly
	;;    Vehicles feel less responsive
	;;
	;; TOO HIGH:
	;;    CPU spikes
	;;    Physics thread starves the simulator
	;;
	;; TUNING GUIDELINES:
	;;    Small / low-traffic regions: 1024 – 2048
	;;    Medium regions with events: 2048 – 4096
	;;    Heavy RP / vehicle regions: 4096 – 8192
	;;
	;; NOTE:
	;;   Raising this does NOT improve accuracy unless
	;;   the limit is actively being hit.
	;;
	MaxCollisionsPerFrame = 2048

	;; --------------------------------------------------
	;; MaxUpdatesPerFrame
	;; --------------------------------------------------
	;;
	;; NOTE: These limits protect simulator stability, not physics quality.
	;; Maximum number of physics object updates processed per frame.
	;;
	;; WHAT AN UPDATE IS:
	;;    Position integration
	;;    Velocity update
	;;    Constraint resolution
	;;    State synchronization
	;;
	;; This is the TOTAL physics workload cap per frame.
	;;
	;; WHY THIS EXISTS:
	;;    Large numbers of physical objects
	;;    Scripted motion
	;;    Vehicles and attachments
	;;
	;; EFFECT OF HITTING THE LIMIT:
	;;    Some objects update one frame later
	;;    Motion may appear slightly delayed
	;;    Simulator avoids frame overruns
	;;
	;; TOO LOW:
	;;    Choppy motion
	;;    Delayed object response
	;;
	;; TOO HIGH:
	;;    Physics monopolizes CPU time
	;;    Overall simulator FPS drops
	;;
	;; TUNING GUIDELINES:
	;;    Should usually be MULTIPLE of MaxCollisionsPerFrame
	;;    Small regions:   4096 – 8192
	;;    Medium regions:  8192 – 16384
	;;    Heavy physics:   16384 – 32768 (measure carefully)
	;;
	;; RULE OF THUMB:
	;;   MaxUpdatesPerFrame ≈ 4 × MaxCollisionsPerFrame
	;;
	;; WARNING:
	;;   Increasing this blindly WILL NOT fix lag caused by:
	;;      Bad scripts
	;;      Excessive mesh collisions
	;;      Poorly authored content
	;;
	MaxUpdatesPerFrame = 8192

	;; ==================================================================
	;; DEBUG LOGGING
	;; ==================================================================

	;; --------------------------------------------------
	;; PhysicsLoggingEnabled / VehicleLoggingEnabled
	;; --------------------------------------------------
	;;
	;; VERY VERBOSE DEBUG OUTPUT.
	;;
	;; DO NOT ENABLE ON PRODUCTION GRIDS.
	;;
	PhysicsLoggingEnabled = False
	PhysicsLoggingDir = "."
	VehicleLoggingEnabled = False


