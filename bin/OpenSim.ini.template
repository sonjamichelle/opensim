[RemoteAdmin]
	;; ------------------------------------------------------------------
	;; REMOTE ADMINISTRATION  (LEGACY / HIGH RISK)
	;; ------------------------------------------------------------------
	;;
	;; THIS MODULE PROVIDES:
	;;    XML-RPC based remote administrative control
	;;    Direct simulator-level execution of admin actions
	;;
	;; THIS MODULE DOES NOT PROVIDE:
	;;    Modern authentication
	;;    Encryption by default
	;;    Role-based access control
	;;    Centralized management
	;;    Audit logging
	;;
	;; STATUS:
	;;   LEGACY
	;;
	;; This system predates:
	;;    Robust services
	;;    WebUI dashboards
	;;    Centralized admin APIs
	;;    Modern security practices
	;;
	;; WARNING: This module is legacy and unsafe by modern standards.
	;;
	;; Enabling this module on a production grid is STRONGLY DISCOURAGED.

	;; --------------------------------------------------
	;; enabled
	;; --------------------------------------------------
	;;
	;; Enables the XML-RPC RemoteAdmin service.
	;;
	;; WARNING:
	;;    When enabled, this exposes administrative control
	;;     over the simulator via HTTP
	;;    Historically vulnerable to brute-force attacks
	;;    Historically exposed without TLS
	;;
	;; RECOMMENDED:
	;;   false (default)
	;;
	enabled = false

	;; --------------------------------------------------
	;; port
	;; --------------------------------------------------
	;;
	;; TCP port used by RemoteAdmin.
	;;
	;; 0 = Use main simulator HTTP port
	;;
	;; DANGER:
	;;    Sharing ports increases attack surface
	;;    Multiple regions require separate ports
	;;    Leads to port exhaustion and config sprawl
	;;
	;; RECOMMENDED:
	;;   Leave at 0 and KEEP MODULE DISABLED
	;;
	port = 0

	;; --------------------------------------------------
	;; bind_ip_address
	;; --------------------------------------------------
	;;
	;; IP address to bind the RemoteAdmin listener to.
	;;
	;; "0.0.0.0" = Bind to ALL interfaces
	;;
	;; DANGER:
	;;    Exposes admin interface to all networks
	;;
	;; MINIMUM SAFE CONFIG (if enabled at all):
	;;    Bind ONLY to 127.0.0.1
	;;
	bind_ip_address = "0.0.0.0"

	;; --------------------------------------------------
	;; access_password
	;; --------------------------------------------------
	;;
	;; Shared static password used for ALL XML-RPC calls.
	;;
	;; CRITICAL SECURITY ISSUE:
	;;    No hashing
	;;    No rotation
	;;    No per-user identity
	;;    Transmitted in plaintext unless wrapped externally
	;;
	;; This is NOT acceptable by modern standards.
	;;
	access_password = unknown

	;; --------------------------------------------------
	;; access_ip_addresses
	;; --------------------------------------------------
	;;
	;; Whitelist of IP addresses allowed to use RemoteAdmin.
	;;
	;; If NOT SET:
	;;    ALL IP addresses are allowed
	;;
	;; This is a catastrophic default.
	;;
	;; Example (minimum safe form):
	;;   access_ip_addresses = 127.0.0.1
	;;
	; access_ip_addresses =

	;; --------------------------------------------------
	;; create_region_* options
	;; --------------------------------------------------
	;;
	;; These options control behavior of the XML-RPC
	;; create_region command.
	;;
	;; PROBLEM:
	;;    Each region must expose this interface
	;;    No central grid authority
	;;    No validation layer
	;;
	;; This leads to:
	;;    Inconsistent region state
	;;    Security drift
